  <RegistroModal />
</BaseLayout>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  function openModal(planId?: string) {
    if (typeof (window as any).__openRegistroModal === "function") {
      (window as any).__openRegistroModal(planId ? { planId } : undefined);
    }
  }

  // ViewContent Meta Pixel event
  if (typeof (window as any).fbq === "function") {
    (window as any).fbq("track", "ViewContent", {
      content_name: "Planes Membresia",
      content_category: "Membresia",
    });
  }

  // Bind all "Contratar" buttons (plan cards + comparison table)
  document.querySelectorAll<HTMLButtonElement>("button[data-plan-id]").forEach((btn) => {
    btn.addEventListener("click", () => {
      openModal(btn.getAttribute("data-plan-id") || undefined);
    });
  });
</script>

<style>
  .membresia-page {
    min-height: 100vh;
    background: #060606;
    color: var(--sl-color-white, #fff);
    display: flex;
    flex-direction: column;
  }

  /* Header mínimo */
  .lp-header {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .lp-logo { height: 36px; width: auto; }

  main {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* ─── HERO ─── */
  .hero {
    background: radial-gradient(ellipse at top center, rgba(249,38,6,0.22) 0%, transparent 60%);
    padding: 4rem 1.5rem 3.5rem;
    text-align: center;
  }
  .hero-inner {
    max-width: 680px;
    margin: 0 auto;
    display: grid;
    gap: 1rem;
  }
  .eyebrow {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: #ff6b3d;
    font-weight: 700;
  }
