                  </label>`).join("")}
                <p id="rp-multi-hint" class="rp-mem-hint">Podés activar débito automático en una o varias membresías a la vez. Todas las seleccionadas pasarán al mismo plan.</p>
              </div>`
            : `<input type="hidden" id="rp-select-membresia" value="${memEfectivo[0]?.idMembresia ?? ""}"/>`;

          // Botones "Actualizar datos del vehículo" — solo para membresías NO activas (idEstado ≠ 1)
          const botonesActualizarVehiculoHTML = memEfectivo.filter((m: any) => m.idEstado !== 1).map((m: any, i: number) => `
            <button id="rp-btn-actualizar-vehiculo-${i}" type="button"
              data-id-vehiculo="${m.idVehiculo}"
              data-id-membresia="${m.idMembresia}"
              data-chapa="${m.chapa ?? ""}"
              data-id-marca="${m.idMarca ?? ""}"
              data-id-modelo="${m.idModelo ?? ""}"
              data-anio="${m.anio ?? ""}"
              data-color="${m.color ?? ""}"
              data-id-tipo-vehiculo="${m.idTipoVehiculo ?? ""}"
              style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem 1rem;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.15);border-radius:10px;color:#fff;cursor:pointer;text-align:left;">
              <span style="font-size:1.3rem;">🔧</span>
              <span>
                <strong style="display:block;font-size:0.875rem;">Actualizar datos del vehículo</strong>
                <small style="color:#aaa;font-size:0.78rem;">Membresía ${m.codigo} · Chapa ${censurar(m.chapa ?? "", 2)}</small>
              </span>
            </button>`).join("");

          // El select NO puede estar dentro del <button> — el clic en el dropdown
          // propaga al botón y dispara el checkout sin que el usuario lo pida.
          // Se usa un <div> contenedor con el select separado y un botón de confirmar.
          const btnActivarHTML = hayEfectivo ? `
            <div style="display:flex;flex-direction:column;gap:0.1rem;padding:0.75rem 1rem;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.12);border-radius:10px;color:#fff;">
              <div style="display:flex;align-items:center;gap:0.75rem;">
                <span style="font-size:1.3rem;">🔄</span>
                <span><strong style="display:block;font-size:0.875rem;">Activar débito automático</strong><small style="color:#aaa;font-size:0.78rem;">Registrá tu tarjeta y automatizá el pago mensual</small></span>
              </div>
              ${memEfectivo.length > 1
                ? `<div style="padding-left:2.2rem;padding-right:0.2rem;">${dropdownEfectivo}</div>`
                : membershipInfoHTML(memEfectivo[0]) + dropdownEfectivo}
              <button id="rp-btn-activar" type="button" style="margin-top:0.6rem;margin-left:auto;padding:0.35rem 1.1rem;background:#f9a606;border:none;border-radius:6px;color:#1a1a1a;cursor:pointer;font-size:0.82rem;font-weight:700;">Activar →</button>
            </div>` : "";

          const panel = document.createElement("div");
          panel.id = "rp-opciones-panel";
          panel.style.cssText = "margin-top:1rem;padding:1rem;background:rgba(249,166,6,0.08);border:1px solid rgba(249,166,6,0.3);border-radius:12px;";
          panel.innerHTML = `
            <p style="font-size:0.9rem;color:#f9a606;font-weight:700;margin:0 0 0.75rem;">👋 Hola ${nombreCensurado}, ya sos cliente.</p>
            <div style="display:flex;flex-direction:column;gap:0.6rem;">
              ${btnActualizarHTML}
              ${btnActivarHTML}
              ${botonesActualizarVehiculoHTML}
              <button id="rp-btn-nuevo-vehiculo" type="button" style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem 1rem;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.15);border-radius:10px;color:#fff;cursor:pointer;text-align:left;">
                <span style="font-size:1.3rem;">🚗</span>
                <span><strong style="display:block;font-size:0.875rem;">Registrar un vehículo nuevo</strong><small style="color:#aaa;font-size:0.78rem;">Añadí otro vehículo con su propia membresía</small></span>
              </button>
            </div>
          `;
          step1El?.appendChild(panel);
          // Escenario B: el panel reemplaza el form — ocultar loading, NO revelar campos
          if (loadingEl) loadingEl.style.display = "none";

          document.getElementById("rp-btn-actualizar")?.addEventListener("click", async () => {
            panel.remove();
            form.style.display = "none";
            await startRetryCheckout(data.idCliente);
          });

          // Wire "Seleccionar todas" master checkbox + sync visual cuando cambian individuales
          const chkAllEl = document.getElementById("rp-chk-all") as HTMLInputElement | null;
          const chkItems = Array.from(document.querySelectorAll<HTMLInputElement>(".rp-chk-mem"));
          if (chkAllEl) {
            chkAllEl.addEventListener("change", () => {
              chkItems.forEach((c) => { c.checked = chkAllEl.checked; });
            });
            chkItems.forEach((c) =>
              c.addEventListener("change", () => {
                const total = chkItems.length;
                const checked = chkItems.filter((x) => x.checked).length;
                chkAllEl.checked = checked === total && total > 0;
                chkAllEl.indeterminate = checked > 0 && checked < total;
              }),
            );
          }

          document.getElementById("rp-btn-activar")?.addEventListener("click", () => {
            // Modo multi (varias membresías efectivo): leer checkboxes
            // Modo simple (una sola): leer hidden input
            let idsSeleccionadas: string[] = [];
            if (chkItems.length > 0) {
              idsSeleccionadas = chkItems.filter((c) => c.checked).map((c) => c.value);
              const hint = document.getElementById("rp-multi-hint");
              if (idsSeleccionadas.length === 0) {
                if (hint) {
                  hint.textContent = "Seleccioná al menos una membresía para continuar.";
                  (hint as HTMLElement).style.color = "#ef4444";
                }
                return;
              }
              if (hint) {
                hint.textContent = "Podés activar débito automático en una o varias membresías a la vez. Todas las seleccionadas pasarán al mismo plan.";
                (hint as HTMLElement).style.color = "rgba(255,255,255,0.5)";
              }
            } else {
              const selectEl = document.getElementById("rp-select-membresia") as HTMLInputElement | null;
              const v = selectEl?.value;
              if (!v) return;
              idsSeleccionadas = [v];
            }
            const idMembresia = idsSeleccionadas[0];

            // Ocultar el botón y mostrar aviso de migración de plan antes de continuar
            const btnActivar = document.getElementById("rp-btn-activar") as HTMLElement;
            btnActivar.style.display = "none";

            const aviso = document.createElement("div");
            aviso.id = "rp-aviso-upgrade";
            aviso.style.cssText = "margin-top:0.5rem;padding:0.75rem;background:rgba(249,166,6,0.1);border:1px solid rgba(249,166,6,0.4);border-radius:8px;font-size:0.82rem;";
            const _avisoId    = (document.getElementById("idPlan") as HTMLInputElement)?.value || "";
            const _avisoMeta  = PLAN_META[_avisoId] || { name: "Plan Fórmula", price: "200.000" };
            aviso.innerHTML = `
              <p style="margin:0 0 0.4rem;font-weight:600;color:#f9a606;">⚠️ Tu plan pasará a Gs. ${_avisoMeta.price}/mes</p>
              <p style="margin:0 0 0.65rem;color:rgba(255,255,255,0.65);font-size:0.78rem;">Al activar el débito automático, tu membresía se migra al ${_avisoMeta.name} (Gs. ${_avisoMeta.price}/mes). El primer cobro se realizará el próximo ciclo.</p>
              <label style="display:flex;align-items:flex-start;gap:0.5rem;margin:0.5rem 0 0.65rem;cursor:pointer;font-size:0.78rem;color:rgba(255,255,255,0.75);">
                <input type="checkbox" id="rp-accept-legal-b" style="margin-top:2px;accent-color:#4f46e5;" />
                <span>Acepto los <a href="/terminos-y-condiciones" target="_blank" rel="noopener noreferrer" style="color:#f9a606;">Términos y Condiciones</a>, <a href="/politica-de-privacidad" target="_blank" rel="noopener noreferrer" style="color:#f9a606;">Política de Privacidad</a> y la <a href="/debito-automatico" target="_blank" rel="noopener noreferrer" style="color:#f9a606;">autorización de débito automático</a>.</span>
              </label>
              <span id="rp-legal-b-error" style="color:#ef4444;font-size:0.75rem;display:none;">Debés aceptar los Términos y Condiciones para continuar.</span>
              <div style="display:flex;gap:0.5rem;justify-content:flex-end;">
                <button id="rp-aviso-cancelar" type="button" style="padding:0.3rem 0.75rem;background:transparent;border:1px solid rgba(255,255,255,0.25);border-radius:6px;color:#fff;cursor:pointer;font-size:0.78rem;">Cancelar</button>
                <button id="rp-aviso-confirmar" type="button" style="padding:0.3rem 0.9rem;background:#4f46e5;border:none;border-radius:6px;color:#fff;cursor:pointer;font-size:0.78rem;font-weight:600;">Confirmar y registrar tarjeta →</button>
              </div>
            `;
            btnActivar.parentElement?.appendChild(aviso);

            document.getElementById("rp-aviso-cancelar")?.addEventListener("click", () => {
              aviso.remove();
              btnActivar.style.display = "";
            });

            document.getElementById("rp-aviso-confirmar")?.addEventListener("click", async () => {
              const legalCheckbox = document.getElementById("rp-accept-legal-b") as HTMLInputElement;
              const legalError = document.getElementById("rp-legal-b-error") as HTMLElement;
              if (legalCheckbox && !legalCheckbox.checked) {
                if (legalError) legalError.style.display = "block";
                return;
              }
              if (legalError) legalError.style.display = "none";
              if (idsSeleccionadas.length > 1) {
                sessionStorage.setItem("formulang_idsMembresiasActivar", JSON.stringify(idsSeleccionadas));
                sessionStorage.removeItem("formulang_idMembresiaActivar");
      sessionStorage.removeItem("formulang_idsMembresiasActivar");
              } else {
                sessionStorage.setItem("formulang_idMembresiaActivar", idMembresia);
                sessionStorage.removeItem("formulang_idsMembresiasActivar");
              }
              panel.remove();
              form.style.display = "none";
              await startRetryCheckout(data.idCliente);
            });
          });

          // Handlers para "Actualizar datos del vehículo" — solo membresías NO activas (idEstado ≠ 1)
          memEfectivo.filter((m: any) => m.idEstado !== 1).forEach((_m: any, i: number) => {
            document.getElementById(`rp-btn-actualizar-vehiculo-${i}`)?.addEventListener("click", (e) => {
              const btn = e.currentTarget as HTMLElement;
              const idVehiculo = btn.dataset.idVehiculo ?? "";
              const chapa = btn.dataset.chapa ?? "";
              const idMarca = btn.dataset.idMarca ? Number(btn.dataset.idMarca) : null;
              const idModelo = btn.dataset.idModelo ? Number(btn.dataset.idModelo) : null;
              const anio = btn.dataset.anio ? Number(btn.dataset.anio) : null;
              const color = btn.dataset.color ?? "";
              const idTipoVehiculo = btn.dataset.idTipoVehiculo ? Number(btn.dataset.idTipoVehiculo) : null;

              panel.remove();
              modoActualizarVehiculo = true;
              modoNuevoVehiculo = false;
              sessionStorage.setItem("formulang_idVehiculo", idVehiculo);

              // Pre-llenar datos del vehículo
              setVal("chapa", chapa);
              if (color) setVal("color", color);
              if (anio) setVal("anio", anio);
              if (idTipoVehiculo) {
                const tipoSel = document.getElementById("tipoVehiculo") as HTMLSelectElement | null;
                if (tipoSel) tipoSel.value = String(idTipoVehiculo);
              }
              if (idMarca) {
                const marcaSel = document.getElementById("idMarca") as HTMLSelectElement | null;
                if (marcaSel) {
                  marcaSel.value = String(idMarca);
                  marcaSel.dispatchEvent(new Event("change"));
                  if (idModelo) setTimeout(() => setVal("idModelo", idModelo), 800);
                }
              }

              const infoBanner = document.createElement("div");
              infoBanner.id = "rp-info-banner";
              infoBanner.style.cssText = "margin-top:1rem;padding:0.75rem 1rem;background:rgba(79,70,229,0.12);border:1px solid rgba(79,70,229,0.35);border-radius:10px;font-size:0.82rem;color:#a5b4fc;";
              infoBanner.innerHTML = `<strong>Actualizando datos del vehículo.</strong> Modificá los campos que necesitás y confirmá.`;
              step1El?.appendChild(infoBanner);
              goToStep(2);
            });
          });

          document.getElementById("rp-btn-nuevo-vehiculo")?.addEventListener("click", () => {
            panel.remove();
            modoNuevoVehiculo = true;
            setVal("nombre", data.nombre);
            setVal("telefono", data.telefono);
            setVal("email", data.email);
            const infoBanner = document.createElement("div");
            infoBanner.id = "rp-info-banner";
            infoBanner.style.cssText = "margin-top:1rem;padding:0.75rem 1rem;background:rgba(79,70,229,0.12);border:1px solid rgba(79,70,229,0.35);border-radius:10px;font-size:0.82rem;color:#a5b4fc;";
            infoBanner.innerHTML = `<strong>Tus datos personales ya están guardados.</strong> Completá los datos del nuevo vehículo.`;
            step1El?.appendChild(infoBanner);
            goToStep(2);
          });
          return;
        }

        // ---- Scenario C: client exists but no membership or pending registration ----
        // Pre-fill step 1 and let them register normally (via registro-vehiculo endpoint)
        setVal("nombre", data.nombre);
        setVal("telefono", data.telefono);
        setVal("email", data.email);
        sessionStorage.setItem("formulang_idCliente", data.idCliente);
        modoNuevoVehiculo = true;

        const banner = document.createElement("div");
        banner.id = "rp-resume-banner";
        banner.style.cssText = "margin-top:1rem;padding:0.85rem 1rem;background:rgba(79,70,229,0.12);border:1px solid rgba(79,70,229,0.35);border-radius:10px;font-size:0.85rem;color:#a5b4fc;";
        banner.innerHTML = `<strong>Encontramos tu cuenta, ${censurar(data.nombre, 4)}.</strong><br/>Tus datos personales fueron cargados. Completá los datos de tu vehículo para continuar.`;
        step1El?.appendChild(banner);
        revelarCamposPersonales();
      } catch {
        // Error inesperado → revelar campos para no bloquear al usuario
        revelarCamposPersonales();
      } finally {
        // Siempre liberar la guardia al terminar el lookup
        lookupInProgress = false;
      }
    }

    // Lookup manual — se dispara al hacer clic en "Confirmar" o presionar Enter
    async function confirmarCI() {
      // Eliminar dígito verificador: "755014-6" → "755014", "1234567-8" → "1234567"
      const ci = rucInput.value.replace(/\s+/g, "").replace(/-\d+$/, "");
      if (!ci || ci.length < 5) {
        showFieldError("ruc", "Ingresá tu RUC o CI para continuar.");
        return;
      }
      // Validar Turnstile captcha antes de consultar
      const turnstileField = form.querySelector("[name='cf-turnstile-response']") as HTMLInputElement | null;
      const turnstileToken = turnstileField?.value || "";
      if (!turnstileToken) {
        const tsError = document.getElementById("turnstile-error");
        if (tsError) tsError.textContent = "Completá la verificación de seguridad para continuar.";
        return;
      }
      // Limpiar error de turnstile si existía
      const tsError = document.getElementById("turnstile-error");
      if (tsError) tsError.textContent = "";
      // Resetear lastLookedUpCI para permitir re-consulta aunque sea el mismo CI
      lastLookedUpCI = "";
      await dispararLookupCI(ci);
    }

    document.getElementById("btn-confirmar-ci")?.addEventListener("click", confirmarCI);

    rucInput?.addEventListener("keydown", (e) => {
      if ((e as KeyboardEvent).key === "Enter") {
        e.preventDefault();
        confirmarCI();
      }
    });

    // Quitar espacios en RUC/CI mientras el usuario escribe o pega
    rucInput?.addEventListener("input", () => {
      if (/\s/.test(rucInput.value)) {
        const pos = rucInput.selectionStart ?? rucInput.value.length;
        const before = rucInput.value.slice(0, pos).replace(/\s+/g, "").length;
        rucInput.value = rucInput.value.replace(/\s+/g, "");
        try { rucInput.setSelectionRange(before, before); } catch {}
      }
    });

    // Quitar espacios en Teléfono/WhatsApp mientras el usuario escribe o pega
    const telefonoInput = document.getElementById("telefono") as HTMLInputElement | null;
    telefonoInput?.addEventListener("input", () => {
      if (/\s/.test(telefonoInput.value)) {
        const pos = telefonoInput.selectionStart ?? telefonoInput.value.length;
        const before = telefonoInput.value.slice(0, pos).replace(/\s+/g, "").length;
        telefonoInput.value = telefonoInput.value.replace(/\s+/g, "");
        try { telefonoInput.setSelectionRange(before, before); } catch {}
      }
    });

    // Cuando el usuario modifica el CI, resetear el estado del lookup anterior
    rucInput?.addEventListener("input", () => {
      const ci = rucInput.value.trim();
      if (ci !== lastLookedUpCI && lastLookedUpCI) {
        lastLookedUpCI = "";
        ocultarCamposPersonales();
        document.getElementById("rp-resume-banner")?.remove();
        document.getElementById("rp-opciones-panel")?.remove();
        sessionStorage.removeItem("formulang_idCliente");
        sessionStorage.removeItem("formulang_idRegistroPendiente");
        sessionStorage.removeItem("formulang_idMembresiaActivar");
      sessionStorage.removeItem("formulang_idsMembresiasActivar");
        modoNuevoVehiculo = false;
      }
    });

    // ---- Form Submission ----
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!validateStep(currentStep)) return;

      const emailVal = (document.getElementById("email") as HTMLInputElement).value.trim();
      if (!emailVal) {
        errorMsg.textContent = `El email es requerido para activar tu ${currentPlanMeta().name}. Volvé al paso 1 para completarlo.`;
        errorBanner.style.display = "block";
        goToStep(1);
        showFieldError("email", "El email es requerido para activar tu plan");
        return;
      }
      if (!emailVal.match(/^[^\s@]+@[^\s@]+\.[^\s@]+$/)) {
        errorMsg.textContent = "El email ingresado no es válido. Volvé al paso 1 para corregirlo.";
        errorBanner.style.display = "block";
        goToStep(1);
        showFieldError("email", "Email inválido");
        return;
      }

      // Disable submit
      submitBtn.disabled = true;
      submitText.style.display = "none";
      submitLoading.style.display = "inline";
      errorBanner.style.display = "none";

      // Collect form data
      const formData: any = {
        nombre: (document.getElementById("nombre") as HTMLInputElement).value.trim().toUpperCase(),
        ruc: (document.getElementById("ruc") as HTMLInputElement).value.replace(/\s+/g, ""),
        telefono: (document.getElementById("telefono") as HTMLInputElement).value.replace(/\s+/g, ""),
      };

      const email = (document.getElementById("email") as HTMLInputElement).value.trim();
      formData.email = email;

      const chapa = (document.getElementById("chapa") as HTMLInputElement).value.trim();
      formData.chapa = chapa;

      const idMarcaVal = (document.getElementById("idMarca") as HTMLSelectElement).value;
      const marcaNuevaVal = (document.getElementById("marcaNueva") as HTMLInputElement).value.trim();
      if (idMarcaVal === "otro") {
        if (marcaNuevaVal) formData.marcaNueva = marcaNuevaVal;
      } else if (idMarcaVal) {
        formData.idMarca = Number(idMarcaVal);
      }

      const idModeloVal = (document.getElementById("idModelo") as HTMLSelectElement).value;
      const modeloNuevoVal = (document.getElementById("modeloNuevo") as HTMLInputElement).value.trim();
      if (idModeloVal === "otro" || idMarcaVal === "otro") {
        if (modeloNuevoVal) formData.modeloNuevo = modeloNuevoVal;
      } else if (idModeloVal) {
        formData.idModelo = Number(idModeloVal);
      }

      const anio = (document.getElementById("anio") as HTMLInputElement).value;
      if (anio) formData.anio = Number(anio);

      const color = (document.getElementById("color") as HTMLInputElement).value.trim();
      if (color) formData.color = color;

      const tipoVehiculo = (document.getElementById("tipoVehiculo") as HTMLSelectElement).value;
      if (tipoVehiculo) formData.idTipoVehiculo = Number(tipoVehiculo);

      const idPlan = (document.getElementById("idPlan") as HTMLInputElement).value;
      if (idPlan) formData.idPlan = idPlan;

      // Turnstile captcha token (ya validado en Step 1)
      const turnstileField = form.querySelector("[name='cf-turnstile-response']") as HTMLInputElement | null;
      const turnstileToken = turnstileField?.value || "";
      formData.turnstileToken = turnstileToken;
      formData.acceptTerminos = true;

      // Adjuntar atribución UTM si está disponible
      try {
        const utmRaw = sessionStorage.getItem("fng_utm");
        if (utmRaw) formData.attribution = JSON.parse(utmRaw);
      } catch { /* ignorar errores de parsing */ }

      try {
        const idClienteExistente = sessionStorage.getItem("formulang_idCliente");
        const idRegPendienteExistente = sessionStorage.getItem("formulang_idRegistroPendiente");

        let idCliente: string;

        if (modoActualizarVehiculo && idClienteExistente) {
          // Actualizar datos de vehículo existente — sin checkout
          const idVehiculoExistente = sessionStorage.getItem("formulang_idVehiculo");
          if (!idVehiculoExistente) throw new Error("No se encontró el vehículo a actualizar.");
          const chapaMV = (document.getElementById("chapa") as HTMLInputElement)?.value.trim();
          if (!chapaMV || chapaMV.length < 3) throw new Error("Ingresá la chapa del vehículo.");

          const actualizarPayload: Record<string, unknown> = {
            idCliente: idClienteExistente,
            idVehiculo: idVehiculoExistente,
            chapa: chapaMV.toUpperCase(),
          };
          const colorMV = (document.getElementById("color") as HTMLInputElement)?.value.trim();
          if (colorMV) actualizarPayload.color = colorMV;
          const anioMV = (document.getElementById("anio") as HTMLInputElement)?.value;
          if (anioMV) actualizarPayload.anio = Number(anioMV);
          const marcaMV = (document.getElementById("idMarca") as HTMLSelectElement)?.value;
          if (marcaMV) actualizarPayload.idMarca = Number(marcaMV);
          const modeloMV = (document.getElementById("idModelo") as HTMLSelectElement)?.value;
          if (modeloMV) actualizarPayload.idModelo = Number(modeloMV);
          const tipoMV = (document.getElementById("tipoVehiculo") as HTMLSelectElement)?.value;
          if (tipoMV) actualizarPayload.idTipoVehiculo = Number(tipoMV);

          const actuRes = await fetchWithTimeout("/api/actualizar-vehiculo", {
            method: "PATCH",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(actualizarPayload),
          }, 15000);

          if (!actuRes.ok) {
            const errBody = await actuRes.json().catch(() => ({}));
            throw new Error(errBody.error || "No se pudieron actualizar los datos del vehículo.");
          }

          showResult(
            "Datos actualizados",
            "Los datos de tu vehículo fueron actualizados correctamente.",
            false,
          );
          return;

        } else if (idClienteExistente && idRegPendienteExistente) {
          // Resume existing registration — skip POST /api/registro
          idCliente = idClienteExistente;
        } else if (modoNuevoVehiculo && idClienteExistente) {
          // Existing client adding a new vehicle — use /api/registro-vehiculo
          const vehiculoPayload: Record<string, unknown> = {
            idCliente: idClienteExistente,
            chapa: (document.getElementById("chapa") as HTMLInputElement)?.value.trim().toUpperCase(),
            idPlan: (document.getElementById("idPlan") as HTMLInputElement)?.value,
          };
          const chapaMV = (document.getElementById("chapa") as HTMLInputElement)?.value.trim();
          if (!chapaMV || chapaMV.length < 3) throw new Error("Ingresá la chapa del vehículo.");
          const idPlanMV = (document.getElementById("idPlan") as HTMLInputElement)?.value;
          if (!idPlanMV) throw new Error("Seleccioná un plan para continuar.");
          const anioMV = (document.getElementById("anio") as HTMLInputElement)?.value;
          if (anioMV) vehiculoPayload.anio = Number(anioMV);
          const colorMV = (document.getElementById("color") as HTMLInputElement)?.value.trim();
          if (colorMV) vehiculoPayload.color = colorMV;
          const marcaMV = (document.getElementById("idMarca") as HTMLSelectElement)?.value;
          if (marcaMV) vehiculoPayload.idMarca = Number(marcaMV);
          const modeloMV = (document.getElementById("idModelo") as HTMLSelectElement)?.value;
          if (modeloMV) vehiculoPayload.idModelo = Number(modeloMV);
          const tipoMV = (document.getElementById("tipoVehiculo") as HTMLSelectElement)?.value;
          if (tipoMV) vehiculoPayload.idTipoVehiculo = Number(tipoMV);

          const regVehRes = await fetchWithTimeout("/api/registro-vehiculo", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(vehiculoPayload),
          }, 20000);

          const regVehBody = await regVehRes.json().catch(() => {
            throw new Error("Error al registrar el vehículo. Intentá de nuevo.");
          });

          if (!regVehRes.ok) {
            const msg = regVehBody.error || regVehBody.message || "";
            if (regVehRes.status === 409) throw new Error(msg || "Esta chapa ya está registrada.");
            throw new Error(msg || "No se pudo registrar el vehículo. Intentá de nuevo.");
          }

          const idRegPendiente = regVehBody.idRegistroPendiente;
          if (!idRegPendiente) throw new Error("No pudimos iniciar el pago. Intentá de nuevo.");
          sessionStorage.setItem("formulang_idRegistroPendiente", idRegPendiente);
          idCliente = idClienteExistente;
        } else {
          // New client — full registration
          const res = await fetchWithTimeout("/api/registro", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(formData),
          }, 30000);

          const body = await res.json().catch(() => {
            throw new Error("Error al procesar la respuesta del servidor. Intentá de nuevo.");
          });

          if (!res.ok) {
            const serverMsg = body.error || body.message || "";
            if (res.status === 409) {
              throw new Error(serverMsg || "Este RUC o chapa ya está registrado. Si ya sos cliente, comunicate con nosotros.");
            } else if (res.status === 400) {
              throw new Error(serverMsg || "Datos inválidos. Revisá los campos e intentá de nuevo.");
            } else {
              throw new Error(serverMsg || "Error inesperado al registrar. Intentá de nuevo más tarde.");
            }
          }

          idCliente = body.data?.idCliente || body.idCliente;
          if (!idCliente) {
            throw new Error("No pudimos iniciar la activacion de tu plan. Intenta nuevamente.");
          }

          sessionStorage.setItem("formulang_idCliente", idCliente);
          const idRegistroPendiente = body.data?.idRegistroPendiente;
          if (idRegistroPendiente) sessionStorage.setItem("formulang_idRegistroPendiente", idRegistroPendiente);
        }

        submitLoading.textContent = "Redirigiendo a Pagopar...";

        const checkoutRes = await fetchWithTimeout("/api/checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            idCliente: idCliente,
            diaDebito: new Date().getDate(),
            urlRedirect: window.location.origin + "/api/callback",
          }),
        }, 30000);

        const checkoutBody = await checkoutRes.json().catch(() => {
          throw new Error("Error al procesar la respuesta del checkout. Intentá de nuevo.");
        });

        if (!checkoutRes.ok) {
          sessionStorage.removeItem("formulang_idCliente");
          showResult(
            "Alta pendiente",
            "Tu registro fue recibido, pero no pudimos iniciar el pago automatico. Tu membresia no quedo activa. Contactanos para completar el alta.",
            true,
          );
          return;
        }

        const processId = checkoutBody.processId;
        if (processId) {
          form.style.display = "none";
          bancardContainer.style.display = "block";
  
          (document.querySelector(".modal-container") as HTMLElement | null)?.scrollTo({ top: 0 });
          // Meta Pixel: AddPaymentInfo
          if (typeof (window as any).fbq === "function") {
            const _pm = currentPlanMeta();
            (window as any).fbq("track", "AddPaymentInfo", {
              content_name: _pm.name,
              value: Number(_pm.price.replace(/\./g, "")),
              currency: "PYG",
            });
          }

          // Load Bancard Checkout JS SDK if not already loaded
          if (!(window as any).Bancard) {
            await new Promise<void>((resolve, reject) => {
              const script = document.createElement("script");
              script.src = "/bancard-checkout-5.0.1.js";
              script.onload = () => resolve();
              script.onerror = () => reject(new Error("Error al cargar Bancard SDK"));
              document.head.appendChild(script);
            });
          }

          // Render the Bancard card enrollment form
          _bancardResponseHandled = false;
          waitForBancardIframe();
          (window as any).Bancard.Cards.createForm("bancard-iframe", processId, {
            responseHandler: handleBancardResponse,
            styles: {
              "input-background-color": "#ffffff",
              "input-text-color": "#333333",
              "input-placeholder-color": "#999999",
              "input-border-color": "#dddddd",
              "button-background-color": "#4f46e5",
              "button-text-color": "#ffffff",
              "form-background-color": "#ffffff",
            },
          });
        } else {
          sessionStorage.removeItem("formulang_idCliente");
          showResult(
            "Alta pendiente",
            "Tu registro fue recibido, pero no pudimos completar el cobro automatico. Tu membresia no quedo activa. Contactanos para continuar.",
            true,
          );
        }
        return;
      } catch (err: any) {
        sessionStorage.removeItem("formulang_idCliente");
        sessionStorage.removeItem("formulang_idRegistroPendiente");
        // Filter out raw technical errors (SyntaxError, TypeError, etc.)
        const isTechnical = err instanceof SyntaxError || err instanceof TypeError ||
          (err.message && (err.message.includes("Unexpected token") || err.message.includes("undefined")));
        errorMsg.textContent = isTechnical
          ? "Error inesperado. Intente más tarde."
          : (err.message || "Error inesperado. Intente más tarde.");
        errorBanner.style.display = "block";
      } finally {
        submitBtn.disabled = false;
        submitText.style.display = "inline";
        submitLoading.style.display = "none";
        submitLoading.textContent = "Procesando...";
      }
    });
    // ---- Handle Pagopar Checkout Callback ----
    // When Pagopar redirects back via /api/callback, it sets ?checkout=ok|error on the landing
    (async function handleCheckoutCallback() {
      const params = new URLSearchParams(window.location.search);
      const checkoutStatus = params.get("checkout");
      if (!checkoutStatus) return;

      // Clean URL without reloading
      const cleanUrl = window.location.pathname;
      window.history.replaceState({}, "", cleanUrl);

      if (checkoutStatus === "ok") {
        // Show success notification
        openModal();
        showResult(
          "Plan activado",
          `Tu tarjeta fue registrada exitosamente. Tu ${currentPlanMeta().name} quedó activo y los débitos automáticos mensuales están habilitados.`,
        );

        // Confirm card + charge first installment in the backend
        const storedClienteId = sessionStorage.getItem("formulang_idCliente");
        const storedIdRegistroPendiente = sessionStorage.getItem("formulang_idRegistroPendiente");
        const storedIdMembresiaActivar = sessionStorage.getItem("formulang_idMembresiaActivar");
        const storedIdsMembresiasActivarRaw = sessionStorage.getItem("formulang_idsMembresiasActivar");
        let storedIdsMembresiasActivar: string[] = [];
        try {
          storedIdsMembresiasActivar = storedIdsMembresiasActivarRaw
            ? (JSON.parse(storedIdsMembresiasActivarRaw) as string[])
            : [];
        } catch { storedIdsMembresiasActivar = []; }
        if (storedClienteId) {
          try {
            const confirmPayload: Record<string, any> = { idCliente: storedClienteId, acceptTerminos: true };
            if (storedIdRegistroPendiente) confirmPayload.idRegistroPendiente = storedIdRegistroPendiente;
            if (storedIdsMembresiasActivar.length > 0) confirmPayload.idsMembresiasActivar = storedIdsMembresiasActivar;
            else if (storedIdMembresiaActivar) confirmPayload.idMembresiaActivar = storedIdMembresiaActivar;

            const confirmRes = await fetch("/api/confirmar", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(confirmPayload),
            });

            if (!confirmRes.ok) {
              const confirmBody = await confirmRes.json().catch(() => ({}));
              console.error("Error confirming card:", confirmBody);
              // Payment was rejected — offer retry with another card
              const errMsg = confirmBody.error || confirmBody.message || "Tu tarjeta fue rechazada.";
              showResult(
                "Pago rechazado",
                `${errMsg} Podés intentar registrar otra tarjeta.`,
                true,
              );
              // Inject retry button
              const retryBtn = document.createElement("button");
              retryBtn.type = "button";
              retryBtn.className = "btn-next";
              retryBtn.style.marginTop = "1rem";
              retryBtn.textContent = "Intentar con otra tarjeta";
              retryBtn.addEventListener("click", () => startRetryCheckout(storedClienteId));
              successDiv.appendChild(retryBtn);
              return;
            }
            // Success — fire Meta Pixel Purchase event and clean up
            const callbackBody = await confirmRes.json().catch(() => ({}));
            showResult(
              "Plan activado",
              `Tu tarjeta fue registrada exitosamente. Tu ${currentPlanMeta().name} quedó activo y los débitos automáticos mensuales están habilitados.`,
            );
            addReceiptButton(callbackBody.comprobante);
            if (typeof (window as any).fbq === "function") {
              const _pm = currentPlanMeta();
              (window as any).fbq("track", "Purchase", {
                value: Number(_pm.price.replace(/\./g, "")),
                currency: "PYG",
                content_name: `${_pm.name} - Débito Automático`,
                content_type: "product",
              });
            }
            sessionStorage.removeItem("formulang_idCliente");
            sessionStorage.removeItem("formulang_idRegistroPendiente");
            sessionStorage.removeItem("formulang_idMembresiaActivar");
      sessionStorage.removeItem("formulang_idsMembresiasActivar");
            sessionStorage.removeItem("formulang_planId");
          } catch (err) {
            console.error("Error confirming card:", err);
            showResult(
              "Error de conexión",
              "Tu tarjeta fue registrada pero no pudimos confirmar el cobro. Contactanos para asistencia.",
              true,
            );
            sessionStorage.removeItem("formulang_idCliente");
            sessionStorage.removeItem("formulang_idRegistroPendiente");
          }
        }
      } else {
        // Bancard enrollment error — offer retry if there's a pending registration
        const msg = params.get("checkout_msg") || "No se pudo registrar la tarjeta.";
        openModal();
        const storedClienteId = sessionStorage.getItem("formulang_idCliente");
        if (storedClienteId) {
          showResult("Error al registrar tarjeta", `${msg} Podés intentar con otra tarjeta.`, true);
          const retryBtn = document.createElement("button");
          retryBtn.type = "button";
          retryBtn.className = "btn-next";
          retryBtn.style.marginTop = "1rem";
          retryBtn.textContent = "Intentar con otra tarjeta";
          retryBtn.addEventListener("click", () => startRetryCheckout(storedClienteId));
          successDiv.appendChild(retryBtn);
        } else {
          showResult("Error al registrar tarjeta", msg, true);
        }
      }
    })();
  }
</script>
