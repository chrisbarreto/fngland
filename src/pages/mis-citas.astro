---
export const prerender = true;

import BaseLayout from "@/layouts/BaseLayout.astro";
import Footer from "@/components/Footer.astro";

const siteKey = import.meta.env.TURNSTILE_SITE_KEY;
---

<BaseLayout
  title="Mis Citas | Fórmula NG"
  description="Consultá tus citas agendadas en Fórmula NG con tu número de cédula."
  noindex={true}
>
  <div class="page">
    <main class="content">
      <section class="hero">
        <div class="hero-content">
          <p class="eyebrow">Mis turnos</p>
          <h1>Mis citas agendadas</h1>
          <p class="subtitle">
            Ingresá tu número de cédula para ver todos tus turnos reservados.
          </p>
        </div>
        <div class="hero-glow"></div>
      </section>

      <section class="main-section">
        <!-- Search form -->
        <div class="search-card">
          <form id="search-form" novalidate>
            <div class="search-row">
              <input
                id="cedulaInput"
                type="text"
                placeholder="Número de cédula (ej: 1234567)"
                maxlength="20"
                autocomplete="off"
                inputmode="numeric"
                required
              />
              <button type="submit" id="search-btn">Buscar</button>
            </div>

            <div class="search-turnstile">
              <div
                class="cf-turnstile"
                data-sitekey={siteKey}
                data-theme="dark"
              ></div>
            </div>

            <span class="search-status" id="search-status"></span>
          </form>
        </div>

        <!-- Results -->
        <div id="results" style="display:none;">
          <div class="vehicle-info" id="vehicle-info"></div>
          <div class="citas-list" id="citas-list"></div>
          <div class="no-citas" id="no-citas" style="display:none;">
            <p>No tenés citas agendadas.</p>
            <a href="/agenda" class="link-agendar">Agendar un turno →</a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>

<style>
  :global(:root) {
    --mc-bg: #0d0c0f;
    --mc-card: #15131a;
    --mc-border: rgba(255, 255, 255, 0.08);
    --mc-accent: #f92606;
    --mc-text: #f5f3f7;
    --mc-muted: #b5afbd;
    --mc-success: #34d399;
    --mc-pending: #fbbf24;
  }

  .page {
    min-height: 100vh;
    background: radial-gradient(circle at top, rgba(249, 38, 6, 0.12), transparent 45%),
      var(--mc-bg);
    color: var(--mc-text);
  }

  .header {
    z-index: 10;
    position: sticky;
    inset-block-start: 0;
    background: rgba(13, 12, 15, 0.7);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--mc-border);
  }

  .content {
    padding: 3.5rem clamp(1.5rem, 4vw, 4rem) 4rem;
  }

  .hero {
    position: relative;
    padding: 2.5rem 0 3rem;
  }

  .hero-content {
    max-width: 560px;
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.7rem;
    color: var(--mc-muted);
    margin-bottom: 0.75rem;
  }

  h1 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    margin: 0 0 0.75rem;
  }

  .subtitle {
    color: var(--mc-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .hero-glow {
    position: absolute;
    top: 10%;
    right: 5%;
    width: 240px;
    height: 240px;
    background: radial-gradient(circle, rgba(249, 38, 6, 0.25), transparent 70%);
    filter: blur(20px);
    opacity: 0.7;
  }

  .main-section {
    max-width: 800px;
  }

  .search-card {
    background: var(--mc-card);
    border: 1px solid var(--mc-border);
    border-radius: 20px;
    padding: 1.5rem 2rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35);
    margin-bottom: 2rem;
  }

  .search-row {
    display: flex;
    gap: 0.75rem;
  }

  .search-row input {
    flex: 1;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #100f14;
    color: var(--mc-text);
    padding: 0.85rem 1rem;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .search-row input:focus {
    border-color: var(--mc-accent);
  }

  .search-row button {
    border: none;
    background: linear-gradient(135deg, #f92606, #ff6b3d);
    color: white;
    padding: 0.85rem 1.5rem;
    border-radius: 999px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .search-row button:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 10px 25px rgba(249, 38, 6, 0.35);
  }

  .search-row button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .search-status {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--mc-muted);
  }

  .search-turnstile {
    margin-top: 0.85rem;
    display: inline-flex;
    padding: 0.45rem;
    border-radius: 12px;
    background: #0f0e12;
    border: 1px dashed rgba(255, 255, 255, 0.1);
  }

  .vehicle-info {
    background: var(--mc-card);
    border: 1px solid var(--mc-border);
    border-radius: 16px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    color: var(--mc-muted);
  }

  .vehicle-info :global(strong) {
    color: var(--mc-text);
  }

  .citas-list {
    display: grid;
    gap: 1rem;
  }

  .citas-list :global(.cita-card) {
    background: var(--mc-card);
    border: 1px solid var(--mc-border);
    border-radius: 16px;
    padding: 1.25rem 1.5rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: center;
  }

  .citas-list :global(.cita-fecha) {
    text-align: center;
    min-width: 60px;
  }

  .citas-list :global(.cita-fecha .dia) {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
  }

  .citas-list :global(.cita-fecha .mes) {
    display: block;
    font-size: 0.75rem;
    color: var(--mc-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .citas-list :global(.cita-info) {
    display: grid;
    gap: 0.25rem;
  }

  .citas-list :global(.cita-info .servicio) {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .citas-list :global(.cita-info .detalle) {
    font-size: 0.85rem;
    color: var(--mc-muted);
  }

  .citas-list :global(.cita-estado) {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .citas-list :global(.estado-pendiente) {
    background: rgba(251, 191, 36, 0.15);
    color: var(--mc-pending);
  }

  .citas-list :global(.estado-confirmada) {
    background: rgba(52, 211, 153, 0.15);
    color: var(--mc-success);
  }

  .citas-list :global(.estado-completada) {
    background: rgba(139, 92, 246, 0.15);
    color: #a78bfa;
  }

  .no-citas {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--mc-muted);
  }

  .link-agendar {
    color: var(--mc-accent);
    text-decoration: none;
    font-weight: 500;
  }

  .link-agendar:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .content {
      padding: 2.5rem 1.25rem 3rem;
    }
    .search-row {
      flex-direction: column;
    }
    .citas-list :global(.cita-card) {
      grid-template-columns: 1fr;
      text-align: center;
    }
  }
</style>

<script is:inline>
  const form = document.getElementById("search-form");
  const statusEl = document.getElementById("search-status");
  const resultsEl = document.getElementById("results");
  const vehicleEl = document.getElementById("vehicle-info");
  const citasListEl = document.getElementById("citas-list");
  const noCitasEl = document.getElementById("no-citas");
  const searchBtn = document.getElementById("search-btn");

  const meses = ["Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"];

  function formatFecha(fechaStr) {
    const d = new Date(fechaStr + "T12:00:00");
    return { dia: d.getDate(), mes: meses[d.getMonth()] };
  }

  function formatHora(isoTime) {
    if (!isoTime) return "";
    const raw = String(isoTime).trim();

    const hhmmssMatch = raw.match(/^(\d{2}):(\d{2})(?::\d{2})?$/);
    if (hhmmssMatch) {
      return `${hhmmssMatch[1]}:${hhmmssMatch[2]}`;
    }

    // Could be ISO datetime
    const d = new Date(isoTime);
    if (!isNaN(d.getTime())) {
      return `${String(d.getUTCHours()).padStart(2, "0")}:${String(d.getUTCMinutes()).padStart(2, "0")}`;
    }
    return raw;
  }

  function escapeHtml(value) {
    return String(value || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/\"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  function normalizeCedula(value) {
    return String(value || "").replace(/\D/g, "");
  }

  function getTurnstileToken() {
    const tokenField = form?.querySelector("[name='cf-turnstile-response']");
    return tokenField && "value" in tokenField ? tokenField.value : "";
  }

  function resetTurnstile() {
    try {
      if (window.turnstile && typeof window.turnstile.reset === "function") {
        window.turnstile.reset();
      }
    } catch {
      // no-op
    }
  }

  function estadoClass(estado) {
    if (estado === "confirmada") return "estado-confirmada";
    if (estado === "completada") return "estado-completada";
    return "estado-pendiente";
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const cedulaInput = document.getElementById("cedulaInput");
    const cedula = normalizeCedula(cedulaInput?.value || "");
    const turnstileToken = getTurnstileToken();

    if (cedulaInput && cedulaInput.value !== cedula) {
      cedulaInput.value = cedula;
    }

    if (!cedula) {
      statusEl.textContent = "Ingresá tu número de cédula.";
      return;
    }

    if (!turnstileToken) {
      statusEl.textContent = "Verificá el captcha para continuar.";
      return;
    }

    searchBtn.disabled = true;
    statusEl.textContent = "Buscando...";
    resultsEl.style.display = "none";

    try {
      const res = await fetch("/proxy/agenda/mis-citas", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ cedula, turnstileToken }),
      });
      const body = await res.json();

      if (!res.ok) {
        statusEl.textContent = body.error || "No pudimos buscar tus citas.";
        resetTurnstile();
        searchBtn.disabled = false;
        return;
      }

      statusEl.textContent = "";
      resultsEl.style.display = "block";

      const membresias = Array.isArray(body.membresias) ? body.membresias : [];
      vehicleEl.innerHTML = `
        <strong>CI:</strong> ${escapeHtml(body.cedula || cedula)} ·
        <strong>Membresías:</strong> ${escapeHtml(String(body.totalMembresias || membresias.length || 0))}
      `;

      const citas = membresias.flatMap((m) => {
        const citasMembresia = Array.isArray(m?.citas) ? m.citas : [];
        return citasMembresia.map((c) => ({
          ...c,
          codigoMembresia: m.codigoMembresia,
        }));
      });

      if (citas.length === 0) {
        citasListEl.innerHTML = "";
        noCitasEl.style.display = "block";
      } else {
        noCitasEl.style.display = "none";
        citasListEl.innerHTML = citas
          .map((c) => {
            const fechaRaw = typeof c.fechaCita === "string" ? c.fechaCita.slice(0, 10) : c.fechaCita;
            const { dia, mes } = formatFecha(fechaRaw);
            const hi = formatHora(c.horaInicio);
            const hf = formatHora(c.horaFin);

            return `
              <div class="cita-card">
                <div class="cita-fecha">
                  <span class="dia">${escapeHtml(String(dia))}</span>
                  <span class="mes">${escapeHtml(mes)}</span>
                </div>
                <div class="cita-info">
                  <span class="servicio">${escapeHtml(c.servicio?.nombre || "Servicio")}</span>
                  <span class="detalle">${escapeHtml(hi)} - ${escapeHtml(hf)} · ${escapeHtml(c.sede?.nombre || "")}</span>
                  <span class="detalle">Membresía: ${escapeHtml(c.codigoMembresia || "")}</span>
                </div>
                <span class="cita-estado ${estadoClass(c.estado)}">${escapeHtml(c.estado || "pendiente")}</span>
              </div>
            `;
          })
          .join("");
      }
    } catch {
      statusEl.textContent = "Error de red. Intentá nuevamente.";
      resetTurnstile();
    }

    searchBtn.disabled = false;
  });
</script>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
