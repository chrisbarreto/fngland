---
// This component renders a full-screen registration modal.
// All logic is client-side JavaScript (no framework needed).
const siteKey = import.meta.env.TURNSTILE_SITE_KEY;
---

<!-- Registration Modal -->
<div id="registro-modal" class="modal-overlay" style="display:none;">
  <div class="modal-container">
    <button id="modal-close" class="modal-close" aria-label="Cerrar">&times;</button>
    
    <div class="modal-header">
      <h2 class="modal-title">Activá tu Plan Premium</h2>
      <p class="modal-subtitle">Completá tus datos, elegí tu día de débito y registrá tu tarjeta para activar tu membresía de Gs. 200.000 por mes.</p>
      <!-- Step indicators -->
      <div class="steps-indicator">
        <div class="step-dot active" data-step="1"><span>1</span></div>
        <div class="step-line"></div>
        <div class="step-dot" data-step="2"><span>2</span></div>
        <div class="step-line"></div>
        <div class="step-dot" data-step="3"><span>3</span></div>
      </div>
      <div class="steps-labels">
        <span class="step-label active" data-step="1">Tus datos</span>
        <span class="step-label" data-step="2">Tu vehículo</span>
        <span class="step-label" data-step="3">Plan y pago</span>
      </div>
    </div>

    <form id="registro-form" novalidate>
      <!-- Step 1: Personal Data -->
      <div class="form-step active" data-step="1">
        <div class="form-grid">
          <div class="form-group full">
            <label for="ruc">RUC / CI <span class="required">*</span></label>
            <div style="display:flex;gap:0.5rem;align-items:stretch;">
              <input type="text" id="ruc" name="ruc" required placeholder="Ej: 1234567-8" maxlength="20" style="flex:1;min-width:0;" />
              <button type="button" id="btn-confirmar-ci" style="padding:0 1.1rem;background:#f9a606;border:none;border-radius:8px;color:#111;font-weight:700;cursor:pointer;font-size:0.85rem;white-space:nowrap;flex-shrink:0;">Confirmar</button>
            </div>
            <span class="field-error"></span>
          </div>
          <!-- Loading indicator mientras se busca el CI -->
          <div class="form-group full" id="ci-lookup-loading" style="display:none;">
            <div style="display:flex;align-items:center;gap:0.6rem;padding:0.5rem 0;color:rgba(255,255,255,0.55);font-size:0.85rem;">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="animation:ci-spin 0.8s linear infinite;flex-shrink:0;"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
              Buscando tu registro...
            </div>
          </div>
          <!-- Campos personales — ocultos hasta resolver el lookup -->
          <div class="form-group full personal-field" style="display:none;">
            <label for="nombre">Nombre completo <span class="required">*</span></label>
            <input type="text" id="nombre" name="nombre" required placeholder="Ej: Juan Pérez" maxlength="200" />
            <span class="field-error"></span>
          </div>
          <div class="form-group personal-field" style="display:none;">
            <label for="telefono">Teléfono / WhatsApp <span class="required">*</span></label>
            <input type="tel" id="telefono" name="telefono" required placeholder="Ej: 0981 123 456" maxlength="20" />
            <span class="field-error"></span>
          </div>
          <div class="form-group personal-field" style="display:none;">
            <label for="email">Email <span class="required">*</span></label>
            <input type="email" id="email" name="email" required placeholder="tu@email.com" />
            <span class="field-error"></span>
          </div>
        </div>
        <!-- Acción oculta hasta resolver el lookup -->
        <div class="form-actions" id="step1-actions" style="display:none;">
          <button type="button" class="btn-next" data-next="2">Siguiente</button>
        </div>
      </div>

      <!-- Step 2: Vehicle Data -->
      <div class="form-step" data-step="2">
        <div class="form-grid">
          <div class="form-group">
            <label for="chapa">Chapa / Matrícula <span class="required">*</span></label>
            <input type="text" id="chapa" name="chapa" required placeholder="Ej: ABC 1234" maxlength="15" style="text-transform: uppercase;" />
            <span class="field-error"></span>
          </div>
          <div class="form-group">
            <label for="anio">Año</label>
            <input type="number" id="anio" name="anio" placeholder="Ej: 2024" min="1900" max="2100" />
            <span class="field-error"></span>
          </div>
          <div class="form-group">
            <label for="idMarca">Marca</label>
            <select id="idMarca" name="idMarca">
              <option value="">Seleccionar marca...</option>
            </select>
            <span class="field-error"></span>
          </div>
          <div class="form-group">
            <label for="idModelo">Modelo</label>
            <select id="idModelo" name="idModelo" disabled>
              <option value="">Primero seleccioná la marca</option>
            </select>
            <span class="field-error"></span>
          </div>
          <div class="form-group">
            <label for="color">Color</label>
            <input type="text" id="color" name="color" placeholder="Ej: Blanco" maxlength="50" />
            <span class="field-error"></span>
          </div>
          <div class="form-group">
            <label for="tipoVehiculo">Tipo</label>
            <select id="tipoVehiculo" name="tipoVehiculo">
              <option value="">Seleccionar...</option>
              <option value="1">Auto</option>
              <option value="2">Camioneta</option>
              <option value="3">SUV</option>
              <option value="4">Moto</option>
              <option value="5">Doble Cabina</option>
            </select>
            <span class="field-error"></span>
          </div>
        </div>
        <div class="form-actions">
          <button type="button" class="btn-prev" data-prev="1">Atrás</button>
          <button type="button" class="btn-next" data-next="3">Siguiente</button>
        </div>
      </div>

      <!-- Step 3: Plan Selection -->
      <div class="form-step" data-step="3">
        <div id="planes-container" class="planes-grid">
          <div class="planes-loading">Cargando planes...</div>
        </div>
        <input type="hidden" id="idPlan" name="idPlan" />

        <!-- Auto-debit section -->
        <div class="auto-debit-section">
          <p class="auto-debit-eyebrow">Débito automático obligatorio</p>
          <h3 class="auto-debit-title">Tu membresía se activa con pago inmediato</h3>
          <p class="auto-debit-copy">
            El Plan Premium tiene permanencia mínima de 12 meses y se cobra automáticamente por Gs. 200.000 en cada ciclo mensual activo.
          </p>
          <ul class="auto-debit-list">
            <li>Tu primer débito se realizará un mes después de la activación, siempre en el mismo día del mes.</li>
            <li>Si un pago es rechazado, la membresía queda desactivada hasta regularizar.</li>
            <li>Para cambiar la fecha de débito contactá a soporte por WhatsApp.</li>
          </ul>
        </div>

        <!-- Aceptación legal -->
        <div class="legal-accept-wrapper">
          <label class="legal-accept-label">
            <input type="checkbox" id="acceptLegal" name="acceptLegal" />
            <span>
              Acepto los
              <a href="/terminos-y-condiciones" target="_blank" rel="noopener noreferrer">Términos y Condiciones</a>,
              <a href="/politica-de-privacidad" target="_blank" rel="noopener noreferrer">Política de Privacidad</a>
              y la <a href="/debito-automatico" target="_blank" rel="noopener noreferrer">autorización de débito automático</a>.
            </span>
          </label>
          <span class="field-error" id="legal-accept-error"></span>
        </div>

        <!-- Turnstile captcha -->
        <div class="turnstile-wrapper">
          <div
            class="cf-turnstile"
            data-sitekey={siteKey}
            data-theme="dark"
          ></div>
        </div>

        <div class="form-actions">
          <button type="button" class="btn-prev" data-prev="2">Atrás</button>
          <button type="submit" class="btn-submit" id="btn-submit">
            <span class="btn-submit-text">Continuar al pago</span>
            <span class="btn-submit-loading" style="display:none;">Procesando...</span>
          </button>
        </div>
      </div>
    </form>

    <!-- Success state -->
    <div id="registro-success" class="success-message" style="display:none;">
      <div class="success-icon">&#10003;</div>
      <h3>Plan activado</h3>
      <p>Tu Plan Premium quedó activo correctamente. Ya podés disfrutar de tus beneficios y agendar tus servicios.</p>
      <button type="button" class="btn-next" id="success-close">Cerrar</button>
    </div>

    <!-- Bancard Checkout iframe container -->
    <div id="bancard-checkout-container" style="display:none;">
      <div class="checkout-header">
        <h3>Registrá tu tarjeta de pago</h3>
        <p>Ingresá los datos de tu tarjeta para habilitar el débito automático obligatorio y activar tu Plan Premium.</p>
      </div>
      <!-- Loading spinner — visible while Bancard iframe is loading -->
      <div id="bancard-loading" style="display:none;text-align:center;padding:3rem 0;">
        <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="animation:ci-spin 0.8s linear infinite;display:inline-block;"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
        <p style="margin:0.75rem 0 0;color:rgba(255,255,255,0.55);font-size:0.88rem;">Cargando formulario de pago seguro…</p>
      </div>
      <div id="bancard-iframe"></div>
      <p class="checkout-secure-note">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Conexión segura. Tus datos de tarjeta son procesados directamente por Bancard.
      </p>
    </div>

    <!-- Error state -->
    <div id="registro-error" class="error-banner" style="display:none;">
      <span id="error-message"></span>
    </div>
  </div>
</div>

<style>
  /* Modal overlay */
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    animation: modalFadeIn 0.3s ease;
    overflow-y: auto;
  }

  @keyframes modalFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes ci-spin {
    to { transform: rotate(360deg); }
  }

  .modal-container {
    position: relative;
    width: 100%;
    max-width: 580px;
    background: var(--sl-color-gray-6, #1a1a1a);
    border: 1px solid var(--sl-color-hairline, rgba(255,255,255,0.1));
    border-radius: 20px;
    padding: 2.5rem 2rem;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
    max-height: 90vh;
    overflow-y: auto;
  }

  .modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    color: var(--sl-color-gray-3, #888);
    font-size: 1.8rem;
    cursor: pointer;
    line-height: 1;
    padding: 0.25rem;
    transition: color 0.2s;
  }
  .modal-close:hover {
    color: var(--sl-color-white, #fff);
  }

  /* Header */
  .modal-header {
    text-align: center;
    margin-bottom: 2rem;
  }
  .modal-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--sl-color-white, #fff);
    margin: 0 0 0.5rem;
  }
  .modal-subtitle {
    font-size: 0.9rem;
    color: var(--sl-color-gray-3, #888);
    margin: 0 0 1.5rem;
  }

  /* Steps */
  .steps-indicator {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    margin-bottom: 0.5rem;
  }
  .step-dot {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid var(--sl-color-gray-4, #555);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--sl-color-gray-4, #555);
    transition: all 0.3s;
  }
  .step-dot.active {
    border-color: #f92606;
    background: linear-gradient(135deg, #f92606, #ff6b3d);
    color: white;
  }
  .step-dot.completed {
    border-color: #22c55e;
    background: #22c55e;
    color: white;
  }
  .step-line {
    width: 40px;
    height: 2px;
    background: var(--sl-color-gray-5, #333);
    margin: 0 4px;
  }
  .steps-labels {
    display: flex;
    justify-content: center;
    gap: 2rem;
  }
  .step-label {
    font-size: 0.75rem;
    color: var(--sl-color-gray-4, #555);
    transition: color 0.3s;
  }
  .step-label.active {
    color: var(--sl-color-white, #fff);
  }

  /* Form steps */
  .form-step {
    display: none;
  }
  .form-step.active {
    display: block;
    animation: stepFadeIn 0.3s ease;
  }
  @keyframes stepFadeIn {
    from { opacity: 0; transform: translateX(20px); }
    to { opacity: 1; transform: translateX(0); }
  }

  /* Form grid */
  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .form-group.full {
    grid-column: 1 / -1;
  }
  .form-group label {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--sl-color-gray-2, #ccc);
  }
  .required {
    color: #f92606;
  }
  .optional {
    font-size: 0.75rem;
    color: var(--sl-color-gray-4, #555);
    font-weight: 400;
  }
  .form-group input,
  .form-group select {
    background: var(--sl-color-gray-5, #2a2a2a);
    border: 1px solid var(--sl-color-hairline, rgba(255,255,255,0.1));
    border-radius: 10px;
    padding: 0.75rem 1rem;
    color: var(--sl-color-white, #fff);
    font-size: 0.95rem;
    transition: border-color 0.2s;
    outline: none;
    font-family: inherit;
  }
  .form-group input::placeholder {
    color: var(--sl-color-gray-4, #555);
  }
  .form-group input:focus,
  .form-group select:focus {
    border-color: #f92606;
  }
  .form-group input.invalid,
  .form-group select.invalid {
    border-color: #ef4444;
  }
  .field-error {
    font-size: 0.75rem;
    color: #ef4444;
    min-height: 1rem;
  }

  .form-group select option {
    background: var(--sl-color-gray-5, #2a2a2a);
    color: var(--sl-color-white, #fff);
  }

  /* Form actions */
  .form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .btn-next, .btn-submit {
    background: linear-gradient(135deg, #f92606, #ff6b3d);
    color: white;
    padding: 0.75rem 2rem;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.95rem;
    border: none;
    cursor: pointer;
    transition: all 0.3s;
    box-shadow: 0 4px 15px rgba(249, 38, 6, 0.3);
  }
  .btn-next:hover, .btn-submit:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(249, 38, 6, 0.5);
  }
  .btn-submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }
  .btn-prev {
    background: transparent;
    border: 1px solid var(--sl-color-gray-4, #555);
    color: var(--sl-color-gray-2, #ccc);
    padding: 0.75rem 1.5rem;
    border-radius: 10px;
    font-weight: 500;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  .btn-prev:hover {
    border-color: var(--sl-color-gray-2, #ccc);
    color: var(--sl-color-white, #fff);
  }

  /* Plans grid — :global() needed because plan cards are rendered via innerHTML */
  .planes-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  :global(.planes-loading) {
    text-align: center;
    color: var(--sl-color-gray-3, #888);
    padding: 2rem;
  }
  :global(.plan-card) {
    position: relative;
    border: 2px solid var(--sl-color-hairline, rgba(255,255,255,0.1));
    border-radius: 14px;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    transition: all 0.3s;
    background: var(--sl-color-gray-5, #2a2a2a);
  }
  :global(.plan-card:hover) {
    border-color: var(--sl-color-gray-3, #888);
  }
  :global(.plan-card.selected) {
    border-color: #f92606;
    background: rgba(249, 38, 6, 0.08);
    box-shadow: 0 0 20px rgba(249, 38, 6, 0.15);
  }
  :global(.plan-card.destacado) {
    border-color: #ff6b3d;
  }
  :global(.plan-card-badge) {
    position: absolute;
    top: -10px;
    right: 16px;
    background: linear-gradient(135deg, #f92606, #ff6b3d);
    color: white;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 2px 12px;
    border-radius: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  :global(.plan-name) {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--sl-color-white, #fff);
    margin-bottom: 0.25rem;
  }
  :global(.plan-price) {
    font-size: 0.95rem;
    color: #ff6b3d;
    font-weight: 600;
  }
  :global(.plan-desc) {
    font-size: 0.8rem;
    color: var(--sl-color-gray-3, #888);
    margin-top: 0.35rem;
  }
  :global(.plan-check) {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid var(--sl-color-gray-4, #555);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    color: transparent;
    transition: all 0.3s;
  }
  :global(.plan-card.selected .plan-check) {
    background: #f92606;
    border-color: #f92606;
    color: white;
  }

  /* Success */
  .success-message {
    text-align: center;
    padding: 2rem 0;
  }
  .success-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #22c55e;
    color: white;
    font-size: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
  }
  .success-message h3 {
    font-size: 1.3rem;
    color: var(--sl-color-white, #fff);
    margin: 0 0 0.5rem;
  }
  .success-message p {
    color: var(--sl-color-gray-3, #888);
    margin: 0 0 2rem;
  }

  /* Error banner */

  /* Bancard Checkout */
  #bancard-checkout-container {
    padding: 1rem 0;
  }
  .checkout-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }
  .checkout-header h3 {
    font-size: 1.3rem;
    color: var(--sl-color-white, #fff);
    margin: 0 0 0.5rem;
  }
  .checkout-header p {
    color: var(--sl-color-gray-3, #888);
    margin: 0;
    font-size: 0.9rem;
  }
  #bancard-iframe {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
  }
  #bancard-iframe iframe {
    width: 100% !important;
    border: none !important;
    display: block !important;
    margin: 0 auto !important;
  }
  .checkout-secure-note {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-content: center;
    color: var(--sl-color-gray-3, #888);
    font-size: 0.8rem;
    margin-top: 1rem;
  }
  .checkout-secure-note svg {
    flex-shrink: 0;
    color: #22c55e;
  }
  .error-banner {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 10px;
    padding: 0.75rem 1rem;
    color: #ef4444;
    font-size: 0.85rem;
    margin-top: 1rem;
    text-align: center;
  }

  /* Turnstile captcha */
  /* Legal acceptance checkbox */
  .legal-accept-wrapper {
    margin-top: 1.25rem;
    display: grid;
    gap: 0.3rem;
  }
  .legal-accept-label {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    cursor: pointer;
    font-size: 0.82rem;
    color: rgba(255,255,255,0.65);
    line-height: 1.5;
  }
  .legal-accept-label input[type="checkbox"] {
    flex-shrink: 0;
    margin-top: 0.15rem;
    width: 16px;
    height: 16px;
    accent-color: #f92606;
    cursor: pointer;
  }
  .legal-accept-label a {
    color: #ff6b3d;
    text-decoration: underline;
  }
  .legal-accept-label a:hover { color: #f92606; }

  .turnstile-wrapper {
    display: inline-flex;
    margin-top: 1.25rem;
  }

  /* Auto-debit section */
  .auto-debit-section {
    margin-top: 1.25rem;
    padding: 1.25rem;
    border: 1px solid var(--sl-color-hairline, rgba(255,255,255,0.1));
    border-radius: 12px;
    background: var(--sl-color-gray-5, #2a2a2a);
  }
  .auto-debit-eyebrow {
    margin: 0 0 0.4rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ff6b3d;
    font-weight: 700;
  }
  .auto-debit-title {
    margin: 0;
    color: var(--sl-color-white, #fff);
    font-size: 1.05rem;
  }
  .auto-debit-copy {
    margin: 0.55rem 0 0;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--sl-color-gray-3, #888);
  }
  .auto-debit-list {
    margin: 0.9rem 0 0;
    padding-left: 1.1rem;
    color: var(--sl-color-gray-2, #ccc);
    display: grid;
    gap: 0.45rem;
    font-size: 0.85rem;
    line-height: 1.45;
  }
  /* Responsive */
  @media (max-width: 548px) {
    .modal-container {
      padding: 1.5rem 1.25rem;
      border-radius: 16px;
    }
    .form-grid {
      grid-template-columns: 1fr;
    }
    .form-group.full {
      grid-column: 1;
    }
    .steps-labels {
      gap: 1rem;
    }
    .step-line {
      width: 24px;
    }
  }
</style>

<script>
  {
    // ---- DOM Elements ----
    const modal = document.getElementById("registro-modal") as HTMLElement;
    const form = document.getElementById("registro-form") as HTMLFormElement;
    const closeBtn = document.getElementById("modal-close") as HTMLElement;
    const successDiv = document.getElementById("registro-success") as HTMLElement;
    const errorBanner = document.getElementById("registro-error") as HTMLElement;
    const errorMsg = document.getElementById("error-message") as HTMLElement;
    const successClose = document.getElementById("success-close") as HTMLElement;
    const submitBtn = document.getElementById("btn-submit") as HTMLButtonElement;
    const submitText = submitBtn?.querySelector(".btn-submit-text") as HTMLElement;
    const submitLoading = submitBtn?.querySelector(".btn-submit-loading") as HTMLElement;
    const bancardContainer = document.getElementById("bancard-checkout-container") as HTMLElement;
    const successTitle = successDiv?.querySelector("h3") as HTMLElement;
    const successMessage = successDiv?.querySelector("p") as HTMLElement;
    const successIcon = successDiv?.querySelector(".success-icon") as HTMLElement;

    let currentStep = 1;
    let marcasLoaded = false;
    let planesLoaded = false;
    let modoNuevoVehiculo = false;
    let modoActualizarVehiculo = false;
    let lastLookedUpCI = "";      // evita re-disparar lookup para el mismo CI
    let lookupInProgress = false; // evita lookups simultáneos (race condition)

    // Helpers for censoring displayed data
    function censurar(valor: string, visibles = 3): string {
      if (!valor || valor.length <= visibles) return valor;
      return valor.slice(0, visibles) + "***";
    }
    function censurarEmail(email: string): string {
      const [user, domain] = email.split("@");
      return (user ? user[0] + "***" : "***") + "@" + (domain ?? "");
    }

    // Revela los campos personales (nombre/tel/email) y el botón Siguiente del paso 1
    function revelarCamposPersonales() {
      document.querySelectorAll<HTMLElement>(".personal-field").forEach(el => { el.style.display = ""; });
      const actions = document.getElementById("step1-actions") as HTMLElement | null;
      if (actions) actions.style.display = "";
      const loading = document.getElementById("ci-lookup-loading") as HTMLElement | null;
      if (loading) loading.style.display = "none";
    }

    // Oculta los campos personales y el botón Siguiente (estado inicial / reset)
    function ocultarCamposPersonales() {
      document.querySelectorAll<HTMLElement>(".personal-field").forEach(el => { el.style.display = "none"; });
      const actions = document.getElementById("step1-actions") as HTMLElement | null;
      if (actions) actions.style.display = "none";
      const loading = document.getElementById("ci-lookup-loading") as HTMLElement | null;
      if (loading) loading.style.display = "none";
    }

    const defaultSuccessTitle = "Plan activado";
    const defaultSuccessMessage =
      "Tu Plan Premium quedó activo correctamente. Ya podés disfrutar de tus beneficios y agendar tus servicios.";

    function restoreSuccessState() {
      if (successTitle) successTitle.textContent = defaultSuccessTitle;
      if (successMessage) successMessage.textContent = defaultSuccessMessage;
      if (successIcon) {
        successIcon.textContent = "\u2713";
        successIcon.style.background = "#22c55e";
      }
    }

    function showResult(title: string, message: string, isError = false) {
      restoreSuccessState();
      if (successTitle) successTitle.textContent = title;
      if (successMessage) successMessage.textContent = message;
      if (successIcon && isError) {
        successIcon.textContent = "\u2717";
        successIcon.style.background = "#ef4444";
      }
      form.style.display = "none";
      bancardContainer.style.display = "none";
      successDiv.style.display = "block";
    }

    function resetModalState() {
      restoreSuccessState();
      goToStep(1);
      clearErrors();
      ocultarCamposPersonales();
      // Limpiar todos los campos del paso 1
      (document.getElementById("ruc") as HTMLInputElement).value = "";
      (document.getElementById("nombre") as HTMLInputElement).value = "";
      (document.getElementById("telefono") as HTMLInputElement).value = "";
      (document.getElementById("email") as HTMLInputElement).value = "";
      document.getElementById("rp-resume-banner")?.remove();
      document.getElementById("rp-opciones-panel")?.remove();
      document.getElementById("rp-info-banner")?.remove();
      sessionStorage.removeItem("formulang_idCliente");
      sessionStorage.removeItem("formulang_idRegistroPendiente");
      sessionStorage.removeItem("formulang_idMembresiaActivar");
      sessionStorage.removeItem("formulang_idVehiculo");
      modoNuevoVehiculo = false;
      modoActualizarVehiculo = false;
      lastLookedUpCI = "";
      lookupInProgress = false;
      form.style.display = "";
      bancardContainer.style.display = "none";

      successDiv.style.display = "none";
      submitBtn.disabled = false;
      submitText.style.display = "inline";
      submitLoading.style.display = "none";
      submitLoading.textContent = "Procesando...";
    }

    // ---- Fetch with timeout ----
    function fetchWithTimeout(url: string, options: RequestInit = {}, timeoutMs = 30000): Promise<Response> {
      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), timeoutMs);
      return fetch(url, { ...options, signal: controller.signal })
        .catch((err) => {
          if (err.name === "AbortError") {
            throw new Error("La solicitud tardó demasiado. Verificá tu conexión e intentá de nuevo.");
          }
          throw err;
        })
        .finally(() => clearTimeout(timer));
    }

    // ---- Auto-debit: día calculado automáticamente al activar ----
    // No se muestra selector; se usa el día del mes de la fecha de activación (estilo Netflix)

    // ---- Open / Close Modal ----
    function openModal() {
      resetModalState();
      modal.style.display = "flex";
      document.body.style.overflow = "hidden";
      if (!marcasLoaded) loadMarcas();
      // Meta Pixel: InitiateCheckout
      if (typeof (window as any).fbq === "function") {
        (window as any).fbq("track", "InitiateCheckout", {
          content_name: "Plan Premium",
          value: 200000,
          currency: "PYG",
        });
      }
      if (!planesLoaded) loadPlanes();
    }

    function closeModal() {
      modal.style.display = "none";
      document.body.style.overflow = "";
      resetModalState();
    }

    // Expose globally so Hero can call it
    (window as any).__openRegistroModal = openModal;

    closeBtn?.addEventListener("click", closeModal);
    successClose?.addEventListener("click", closeModal);
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });

    // ESC key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal.style.display === "flex") closeModal();
    });

    // ---- Step Navigation ----
    function goToStep(step: number) {
      currentStep = step;
      document.querySelectorAll(".form-step").forEach((el) => {
        (el as HTMLElement).classList.toggle("active", el.getAttribute("data-step") === String(step));
      });
      document.querySelectorAll(".step-dot").forEach((el) => {
        const s = Number(el.getAttribute("data-step"));
        el.classList.toggle("active", s === step);
        el.classList.toggle("completed", s < step);
      });
      document.querySelectorAll(".step-label").forEach((el) => {
        el.classList.toggle("active", el.getAttribute("data-step") === String(step));
      });
    }

    // Next buttons
    document.querySelectorAll(".btn-next[data-next]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const nextStep = Number((btn as HTMLElement).getAttribute("data-next"));
        if (validateStep(currentStep)) {
          goToStep(nextStep);
        }
      });
    });

    // Prev buttons
    document.querySelectorAll(".btn-prev[data-prev]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const prevStep = Number((btn as HTMLElement).getAttribute("data-prev"));
        goToStep(prevStep);
      });
    });

    // ---- Validation ----
    function validateStep(step: number): boolean {
      clearErrors();
      let valid = true;

      if (step === 1) {
        const nombre = (document.getElementById("nombre") as HTMLInputElement).value.trim();
        const ruc = (document.getElementById("ruc") as HTMLInputElement).value.trim();
        const telefono = (document.getElementById("telefono") as HTMLInputElement).value.trim();
        const email = (document.getElementById("email") as HTMLInputElement).value.trim();

        if (!nombre) { showFieldError("nombre", "El nombre es requerido"); valid = false; }
        if (!ruc) { showFieldError("ruc", "El RUC/CI es requerido"); valid = false; }
        if (!telefono) { showFieldError("telefono", "El teléfono es requerido"); valid = false; }
        if (!email) {
          showFieldError("email", "El email es requerido para activar tu plan");
          valid = false;
        } else if (email && !email.match(/^[^\s@]+@[^\s@]+\.[^\s@]+$/)) {
          showFieldError("email", "Email inválido");
          valid = false;
        }
      }

      if (step === 2) {
        const chapa = (document.getElementById("chapa") as HTMLInputElement).value.trim();
        if (!chapa || chapa.length < 3) { showFieldError("chapa", "La chapa es requerida (mín. 3 caracteres)"); valid = false; }
      }

      if (step === 3) {
        const acceptLegal = document.getElementById("acceptLegal") as HTMLInputElement;
        if (acceptLegal && !acceptLegal.checked) {
          const errorEl = document.getElementById("legal-accept-error");
          if (errorEl) errorEl.textContent = "Debés aceptar los Términos y Condiciones para continuar.";
          valid = false;
        }
      }

      return valid;
    }

    function showFieldError(fieldId: string, message: string) {
      const field = document.getElementById(fieldId);
      if (field) {
        field.classList.add("invalid");
        const errorSpan = field.parentElement?.querySelector(".field-error");
        if (errorSpan) errorSpan.textContent = message;
      }
    }

    function clearErrors() {
      document.querySelectorAll(".invalid").forEach(el => el.classList.remove("invalid"));
      document.querySelectorAll(".field-error").forEach(el => el.textContent = "");
      errorBanner.style.display = "none";
    }

    function normalizeText(value: unknown): string {
      return String(value || "")
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase();
    }

    function escapeHtml(value: unknown): string {
      return String(value || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/\"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function getPublicPlanName(plan: any): string {
      const normalizedName = normalizeText(plan?.nombre);
      if (normalizedName.includes("premium") || normalizedName.includes("premiun")) {
        return "Plan Premium";
      }
      return String(plan?.nombre || "Plan");
    }

    function getPublicPlanDescription(plan: any): string {
      const planDescription = String(plan?.descripcion || "").trim();
      const contractDescription =
        "Permanencia minima de 12 meses. Debito automatico obligatorio.";

      if (!planDescription) return contractDescription;

      return `${escapeHtml(planDescription).replace(/\n+/g, "<br />")}<br /><br />${contractDescription}`;
    }

    // ---- Load Marcas ----
    async function loadMarcas() {
      const select = document.getElementById("idMarca") as HTMLSelectElement;
      try {
        const res = await fetchWithTimeout("/api/marcas", {}, 15000);
        if (!res.ok) {
          const errBody = await res.json().catch(() => ({}));
          throw new Error(errBody.error || `Error ${res.status} al cargar marcas`);
        }
        const data = await res.json();
        if (Array.isArray(data)) {
          select.innerHTML = '<option value="">Seleccionar marca...</option>';
          data.forEach((marca: any) => {
            const opt = document.createElement("option");
            opt.value = marca.idMarca;
            opt.textContent = marca.nombre;
            select.appendChild(opt);
          });
          marcasLoaded = true;
        } else {
          select.innerHTML = '<option value="">Error: respuesta inválida</option>';
        }
      } catch (err: any) {
        console.error("Error loading marcas:", err);
        select.innerHTML = `<option value="">Error al cargar marcas</option>`;
      }
    }

    // ---- Load Modelos (cascading) ----
    const marcaSelect = document.getElementById("idMarca") as HTMLSelectElement;
    const modeloSelect = document.getElementById("idModelo") as HTMLSelectElement;

    marcaSelect?.addEventListener("change", async () => {
      const idMarca = marcaSelect.value;
      modeloSelect.innerHTML = '<option value="">Cargando...</option>';
      modeloSelect.disabled = true;

      if (!idMarca) {
        modeloSelect.innerHTML = '<option value="">Primero seleccioná la marca</option>';
        return;
      }

      try {
        const res = await fetchWithTimeout(`/api/modelos?idMarca=${idMarca}`, {}, 15000);
        if (!res.ok) {
          const errBody = await res.json().catch(() => ({}));
          throw new Error(errBody.error || `Error ${res.status} al cargar modelos`);
        }
        const data = await res.json();
        modeloSelect.innerHTML = '<option value="">Seleccionar modelo...</option>';
        if (Array.isArray(data)) {
          data.forEach((modelo: any) => {
            const opt = document.createElement("option");
            opt.value = modelo.idModelo;
            opt.textContent = modelo.nombre;
            modeloSelect.appendChild(opt);
          });
        }
        modeloSelect.disabled = false;
      } catch (err: any) {
        modeloSelect.innerHTML = `<option value="">Error al cargar modelos</option>`;
        console.error("Error loading modelos:", err);
      }
    });

    // ---- Load Planes ----
    async function loadPlanes() {
      const container = document.getElementById("planes-container") as HTMLElement;
      try {
        const res = await fetchWithTimeout("/api/planes", {}, 15000);
        if (!res.ok) {
          const errBody = await res.json().catch(() => ({}));
          throw new Error(errBody.error || `Error ${res.status} al cargar planes`);
        }
        const data = await res.json();

        if (Array.isArray(data) && data.length > 0) {
          container.innerHTML = data.map((plan: any) => `
            <div class="plan-card selected" data-plan-id="${escapeHtml(plan.idPlan)}">
              <div class="plan-card-badge">Plan oficial</div>
              <div class="plan-name">${escapeHtml(getPublicPlanName(plan))}</div>
              <div class="plan-price">Gs. ${Number(plan.precio).toLocaleString("es-PY")}/mes</div>
              <div class="plan-desc">${getPublicPlanDescription(plan)}</div>
              <div class="plan-check">&#10003;</div>
            </div>
          `).join("");

          // Plan selection click
          container.querySelectorAll(".plan-card").forEach((card) => {
            card.addEventListener("click", () => {
              container.querySelectorAll(".plan-card").forEach(c => c.classList.remove("selected"));
              card.classList.add("selected");
              (document.getElementById("idPlan") as HTMLInputElement).value = 
                (card as HTMLElement).getAttribute("data-plan-id") || "";
            });
          });

          // Auto-select the public plan
          const selectedCard = container.querySelector(".plan-card") as HTMLElement;
          if (selectedCard) selectedCard.click();

          planesLoaded = true;
        } else {
          container.innerHTML = '<div class="planes-loading">No hay planes disponibles en este momento.</div>';
        }
      } catch (err) {
        const container = document.getElementById("planes-container") as HTMLElement;
        container.innerHTML = '<div class="planes-loading">Error al cargar planes. Intente más tarde.</div>';
        console.error("Error loading planes:", err);
      }
    }

    // ---- Bancard iframe loading spinner helpers ----
    function showBancardLoading() {
      const spinner = document.getElementById("bancard-loading") as HTMLElement | null;
      const iframeDiv = document.getElementById("bancard-iframe") as HTMLElement | null;
      if (spinner) spinner.style.display = "block";
      if (iframeDiv) iframeDiv.style.display = "none";
    }

    function hideBancardLoading() {
      const spinner = document.getElementById("bancard-loading") as HTMLElement | null;
      const iframeDiv = document.getElementById("bancard-iframe") as HTMLElement | null;
      if (spinner) spinner.style.display = "none";
      if (iframeDiv) iframeDiv.style.display = "";
    }

    /**
     * Shows the red loading spinner and hides #bancard-iframe while Bancard SDK
     * loads. Uses MutationObserver to detect the injected <iframe>, then waits
     * for its load event (or a 15 s fallback). Guarantees the spinner is visible
     * for at least 400 ms so the browser has time to paint it.
     */
    function waitForBancardIframe() {
      showBancardLoading();
      const container = document.getElementById("bancard-iframe") as HTMLElement;
      if (!container) return;

      const shownAt = Date.now();
      const MIN_VISIBLE_MS = 400;

      function done() {
        const elapsed = Date.now() - shownAt;
        const delay = Math.max(0, MIN_VISIBLE_MS - elapsed);
        setTimeout(hideBancardLoading, delay);
      }

      const fallbackTimer = setTimeout(done, 15000);

      function forceIframeHeight(iframe: HTMLIFrameElement) {
        iframe.style.setProperty("height", "480px", "important");
        iframe.style.setProperty("min-height", "480px", "important");
        iframe.setAttribute("height", "480");
        iframe.scrollTop = 0;
      }

      const observer = new MutationObserver(() => {
        const iframe = container.querySelector("iframe");
        if (!iframe) return;
        observer.disconnect();
        forceIframeHeight(iframe);

        // Cross-origin iframes still fire the load event even if contentDocument is inaccessible.
        iframe.addEventListener("load", () => {
          forceIframeHeight(iframe);
          clearTimeout(fallbackTimer);
          done();
        }, { once: true });
      });

      observer.observe(container, { childList: true, subtree: true });
    }

    // ---- Retry checkout with another card (same idCliente + idRegistroPendiente) ----
    async function startRetryCheckout(idCliente: string) {
      // Remove old retry buttons and reset to iframe state
      successDiv.querySelectorAll("button.btn-next:not(#success-close)").forEach(b => b.remove());
      successDiv.style.display = "none";
      bancardContainer.style.display = "none";
      // Mostrar paso 3 en el stepper (registro de tarjeta = último paso)
      goToStep(3);

      try {
        const checkoutRes = await fetchWithTimeout("/api/checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            idCliente,
            diaDebito: new Date().getDate(),
            urlRedirect: window.location.origin + "/api/callback",
          }),
        }, 30000);

        const checkoutBody = await checkoutRes.json().catch(() => ({}));
        if (!checkoutRes.ok || !checkoutBody.processId) {
          showResult("Error", "No pudimos iniciar el proceso de pago. Intentá de nuevo más tarde.", true);
          return;
        }

        bancardContainer.style.display = "block";

        (document.querySelector(".modal-container") as HTMLElement | null)?.scrollTo({ top: 0 });
        const iframeDiv = document.getElementById("bancard-iframe") as HTMLElement;
        if (iframeDiv) iframeDiv.innerHTML = "";

        if (!(window as any).Bancard) {
          await new Promise<void>((resolve, reject) => {
            const script = document.createElement("script");
            script.src = "/bancard-checkout-5.0.1.js";
            script.onload = () => resolve();
            script.onerror = () => reject(new Error("Error al cargar Bancard SDK"));
            document.head.appendChild(script);
          });
        }

        waitForBancardIframe();
        (window as any).Bancard.Cards.createForm("bancard-iframe", checkoutBody.processId, {
          styles: {
            "input-background-color": "#ffffff",
            "input-text-color": "#333333",
            "input-placeholder-color": "#999999",
            "input-border-color": "#dddddd",
            "button-background-color": "#4f46e5",
            "button-text-color": "#ffffff",
            "form-background-color": "#ffffff",
          },
        });
      } catch (err: any) {
        showResult("Error", err.message || "Error al intentar de nuevo.", true);
      }
    }

    // ---- CI lookup ----
    const rucInput = document.getElementById("ruc") as HTMLInputElement;

    async function dispararLookupCI(ci: string) {
      // Guardia anti race-condition: no relanzar si ya está en curso o para el mismo CI
      if (lookupInProgress || ci === lastLookedUpCI) return;
      lookupInProgress = true;
      lastLookedUpCI = ci;

      // Mostrar loading, ocultar campos mientras busca
      const loadingEl = document.getElementById("ci-lookup-loading") as HTMLElement | null;
      if (loadingEl) loadingEl.style.display = "";

      // Clear previous lookup state
      document.getElementById("rp-resume-banner")?.remove();
      document.getElementById("rp-opciones-panel")?.remove();
      document.getElementById("rp-info-banner")?.remove();
      sessionStorage.removeItem("formulang_idCliente");
      sessionStorage.removeItem("formulang_idRegistroPendiente");
      sessionStorage.removeItem("formulang_idMembresiaActivar");
      sessionStorage.removeItem("formulang_idVehiculo");
      modoNuevoVehiculo = false;
      modoActualizarVehiculo = false;

      try {
        const res = await fetchWithTimeout(
          `/api/registro-pendiente?ci=${encodeURIComponent(ci)}`,
          {},
          12000,
        );
        if (!res.ok) {
          // Error de red/servidor → revelar campos igual para no bloquear al usuario
          revelarCamposPersonales();
          return;
        }
        const data = await res.json().catch(() => null);
        if (!data?.found) {
          // CI no registrada → cliente nuevo, revelar campos vacíos
          revelarCamposPersonales();
          return;
        }

        // Helper to set a field value by id
        const setVal = (id: string, val: string | number | null | undefined) => {
          const el = document.getElementById(id) as HTMLInputElement | null;
          if (el && val != null && val !== "") el.value = String(val);
        };

        const step1El = rucInput.closest(".form-step");

        // ---- Scenario A: has pending registration ----
        if (data.registroPendiente) {
          const rp = data.registroPendiente;

          // Pre-fill step 1
          setVal("nombre", data.nombre);
          setVal("telefono", data.telefono);
          setVal("email", data.email);

          // Pre-fill step 2
          setVal("chapa", rp.chapa ? String(rp.chapa).toUpperCase() : null);
          if (rp.anio) setVal("anio", rp.anio);
          setVal("color", rp.color);
          if (rp.idTipoVehiculo) {
            const tipoSel = document.getElementById("tipoVehiculo") as HTMLSelectElement | null;
            if (tipoSel) tipoSel.value = String(rp.idTipoVehiculo);
          }
          if (rp.idMarca) {
            const marcaSel = document.getElementById("idMarca") as HTMLSelectElement | null;
            if (marcaSel) {
              marcaSel.value = String(rp.idMarca);
              marcaSel.dispatchEvent(new Event("change"));
              if (rp.idModelo) setTimeout(() => setVal("idModelo", rp.idModelo), 800);
            }
          }
          if (rp.idPlan) {
            setVal("idPlan", rp.idPlan);
            const planCard = document.querySelector(`[data-plan-id="${rp.idPlan}"]`);
            if (planCard) {
              document.querySelectorAll(".plan-card").forEach(c => c.classList.remove("selected"));
              planCard.classList.add("selected");
            }
          }

          sessionStorage.setItem("formulang_idCliente", data.idCliente);
          sessionStorage.setItem("formulang_idRegistroPendiente", rp.idRegistroPendiente);

          const nombreCensurado = censurar(data.nombre, 4);
          const emailCensurado = censurarEmail(data.email);
          const banner = document.createElement("div");
          banner.id = "rp-resume-banner";
          banner.style.cssText = "margin-top:1rem;padding:0.85rem 1rem;background:rgba(249,166,6,0.12);border:1px solid rgba(249,166,6,0.35);border-radius:10px;font-size:0.85rem;color:#f9a606;";
          banner.innerHTML = `<strong>Encontramos tu registro: ${nombreCensurado}, ${emailCensurado}</strong><br/>Tus datos fueron completados automáticamente. Revisalos y continuá al pago.`;
          step1El?.appendChild(banner);
          revelarCamposPersonales();
          return;
        }

        // ---- Scenario B: existing membership(s), no pending registration ----
        if (data.membresias && data.membresias.length > 0) {
          sessionStorage.setItem("formulang_idCliente", data.idCliente);

          const nombreCensurado = censurar(data.nombre, 4);
          const memPagopar = data.membresias.filter((m: any) => m.renovacionAutomatica);
          const memEfectivo = data.membresias.filter((m: any) => !m.renovacionAutomatica);
          const hayPagopar = memPagopar.length > 0;
          const hayEfectivo = memEfectivo.length > 0;

          const btnActualizarHTML = hayPagopar ? `
            <button id="rp-btn-actualizar" type="button" style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem 1rem;background:rgba(255,255,255,0.05);border:1px solid rgba(249,166,6,0.4);border-radius:10px;color:#fff;cursor:pointer;text-align:left;">
              <span style="font-size:1.3rem;">💳</span>
              <span><strong style="display:block;font-size:0.875rem;">Actualizar tarjeta de débito</strong><small style="color:#aaa;font-size:0.78rem;">Registrá una nueva tarjeta para tu débito automático</small></span>
            </button>` : "";

          // Para membresía única: siempre mostrar código + chapa visibles al usuario
          const membershipInfoHTML = (m: any) =>
            `<p style="margin:0.4rem 0 0;padding-left:2.2rem;font-size:0.78rem;color:rgba(255,255,255,0.55);">Membresía <strong style="color:#fff;">${m.codigo}</strong> · Chapa <strong style="color:#fff;">${censurar(m.chapa ?? "", 2)}</strong></p>`;

          const dropdownEfectivo = memEfectivo.length > 1
            ? `<select id="rp-select-membresia" style="width:100%;margin-top:0.5rem;padding:0.4rem 0.6rem;background:#1a1a2e;border:1px solid rgba(255,255,255,0.2);border-radius:6px;color:#fff;font-size:0.82rem;">${memEfectivo.map((m: any) => `<option value="${m.idMembresia}">Chapa ${censurar(m.chapa ?? "", 2)} — ${m.codigo}</option>`).join("")}</select>`
            : `<input type="hidden" id="rp-select-membresia" value="${memEfectivo[0]?.idMembresia ?? ""}"/>`;

          // Botones "Actualizar datos del vehículo" — solo para membresías NO activas (idEstado ≠ 1)
          const botonesActualizarVehiculoHTML = memEfectivo.filter((m: any) => m.idEstado !== 1).map((m: any, i: number) => `
            <button id="rp-btn-actualizar-vehiculo-${i}" type="button"
              data-id-vehiculo="${m.idVehiculo}"
              data-id-membresia="${m.idMembresia}"
              data-chapa="${m.chapa ?? ""}"
              data-id-marca="${m.idMarca ?? ""}"
              data-id-modelo="${m.idModelo ?? ""}"
              data-anio="${m.anio ?? ""}"
              data-color="${m.color ?? ""}"
              data-id-tipo-vehiculo="${m.idTipoVehiculo ?? ""}"
              style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem 1rem;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.15);border-radius:10px;color:#fff;cursor:pointer;text-align:left;">
              <span style="font-size:1.3rem;">🔧</span>
              <span>
                <strong style="display:block;font-size:0.875rem;">Actualizar datos del vehículo</strong>
                <small style="color:#aaa;font-size:0.78rem;">Membresía ${m.codigo} · Chapa ${censurar(m.chapa ?? "", 2)}</small>
              </span>
            </button>`).join("");

          // El select NO puede estar dentro del <button> — el clic en el dropdown
          // propaga al botón y dispara el checkout sin que el usuario lo pida.
          // Se usa un <div> contenedor con el select separado y un botón de confirmar.
          const btnActivarHTML = hayEfectivo ? `
            <div style="display:flex;flex-direction:column;gap:0.1rem;padding:0.75rem 1rem;background:rgba(255,255,255,0.05);border:1px solid rgba(79,70,229,0.5);border-radius:10px;color:#fff;">
              <div style="display:flex;align-items:center;gap:0.75rem;">
                <span style="font-size:1.3rem;">🔄</span>
                <span><strong style="display:block;font-size:0.875rem;">Activar débito automático</strong><small style="color:#aaa;font-size:0.78rem;">Registrá tu tarjeta y automatizá el pago mensual</small></span>
              </div>
              ${memEfectivo.length > 1
                ? `<div style="padding-left:2.2rem;">${dropdownEfectivo}</div>`
                : membershipInfoHTML(memEfectivo[0]) + dropdownEfectivo}
              <button id="rp-btn-activar" type="button" style="margin-top:0.6rem;margin-left:auto;padding:0.35rem 1.1rem;background:#4f46e5;border:none;border-radius:6px;color:#fff;cursor:pointer;font-size:0.82rem;font-weight:600;">Activar →</button>
            </div>` : "";

          const panel = document.createElement("div");
          panel.id = "rp-opciones-panel";
          panel.style.cssText = "margin-top:1rem;padding:1rem;background:rgba(249,166,6,0.08);border:1px solid rgba(249,166,6,0.3);border-radius:12px;";
          panel.innerHTML = `
            <p style="font-size:0.9rem;color:#f9a606;font-weight:700;margin:0 0 0.75rem;">👋 Hola ${nombreCensurado}, ya sos cliente.</p>
            <div style="display:flex;flex-direction:column;gap:0.6rem;">
              ${btnActualizarHTML}
              ${btnActivarHTML}
              ${botonesActualizarVehiculoHTML}
              <button id="rp-btn-nuevo-vehiculo" type="button" style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem 1rem;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.15);border-radius:10px;color:#fff;cursor:pointer;text-align:left;">
                <span style="font-size:1.3rem;">🚗</span>
                <span><strong style="display:block;font-size:0.875rem;">Registrar un vehículo nuevo</strong><small style="color:#aaa;font-size:0.78rem;">Añadí otro vehículo con su propia membresía</small></span>
              </button>
            </div>
          `;
          step1El?.appendChild(panel);
          // Escenario B: el panel reemplaza el form — ocultar loading, NO revelar campos
          if (loadingEl) loadingEl.style.display = "none";

          document.getElementById("rp-btn-actualizar")?.addEventListener("click", async () => {
            panel.remove();
            form.style.display = "none";
            await startRetryCheckout(data.idCliente);
          });

          document.getElementById("rp-btn-activar")?.addEventListener("click", () => {
            const selectEl = document.getElementById("rp-select-membresia") as HTMLSelectElement | HTMLInputElement;
            const idMembresia = selectEl?.value;
            if (!idMembresia) return;

            // Ocultar el botón y mostrar aviso de migración de plan antes de continuar
            const btnActivar = document.getElementById("rp-btn-activar") as HTMLElement;
            btnActivar.style.display = "none";

            const aviso = document.createElement("div");
            aviso.id = "rp-aviso-upgrade";
            aviso.style.cssText = "margin-top:0.5rem;padding:0.75rem;background:rgba(249,166,6,0.1);border:1px solid rgba(249,166,6,0.4);border-radius:8px;font-size:0.82rem;";
            aviso.innerHTML = `
              <p style="margin:0 0 0.4rem;font-weight:600;color:#f9a606;">⚠️ Tu plan pasará a Gs. 200.000/mes</p>
              <p style="margin:0 0 0.65rem;color:rgba(255,255,255,0.65);font-size:0.78rem;">Al activar el débito automático, tu membresía se migra al Plan Premium (Gs. 200.000/mes). El primer cobro se realizará el próximo ciclo.</p>
              <label style="display:flex;align-items:flex-start;gap:0.5rem;margin:0.5rem 0 0.65rem;cursor:pointer;font-size:0.78rem;color:rgba(255,255,255,0.75);">
                <input type="checkbox" id="rp-accept-legal-b" style="margin-top:2px;accent-color:#4f46e5;" />
                <span>Acepto los <a href="/terminos-y-condiciones" target="_blank" rel="noopener noreferrer" style="color:#f9a606;">Términos y Condiciones</a>, <a href="/politica-de-privacidad" target="_blank" rel="noopener noreferrer" style="color:#f9a606;">Política de Privacidad</a> y la <a href="/debito-automatico" target="_blank" rel="noopener noreferrer" style="color:#f9a606;">autorización de débito automático</a>.</span>
              </label>
              <span id="rp-legal-b-error" style="color:#ef4444;font-size:0.75rem;display:none;">Debés aceptar los Términos y Condiciones para continuar.</span>
              <div style="display:flex;gap:0.5rem;justify-content:flex-end;">
                <button id="rp-aviso-cancelar" type="button" style="padding:0.3rem 0.75rem;background:transparent;border:1px solid rgba(255,255,255,0.25);border-radius:6px;color:#fff;cursor:pointer;font-size:0.78rem;">Cancelar</button>
                <button id="rp-aviso-confirmar" type="button" style="padding:0.3rem 0.9rem;background:#4f46e5;border:none;border-radius:6px;color:#fff;cursor:pointer;font-size:0.78rem;font-weight:600;">Confirmar y registrar tarjeta →</button>
              </div>
            `;
            btnActivar.parentElement?.appendChild(aviso);

            document.getElementById("rp-aviso-cancelar")?.addEventListener("click", () => {
              aviso.remove();
              btnActivar.style.display = "";
            });

            document.getElementById("rp-aviso-confirmar")?.addEventListener("click", async () => {
              const legalCheckbox = document.getElementById("rp-accept-legal-b") as HTMLInputElement;
              const legalError = document.getElementById("rp-legal-b-error") as HTMLElement;
              if (legalCheckbox && !legalCheckbox.checked) {
                if (legalError) legalError.style.display = "block";
                return;
              }
              if (legalError) legalError.style.display = "none";
              sessionStorage.setItem("formulang_idMembresiaActivar", idMembresia);
              panel.remove();
              form.style.display = "none";
              await startRetryCheckout(data.idCliente);
            });
          });

          // Handlers para "Actualizar datos del vehículo" — solo membresías NO activas (idEstado ≠ 1)
          memEfectivo.filter((m: any) => m.idEstado !== 1).forEach((_m: any, i: number) => {
            document.getElementById(`rp-btn-actualizar-vehiculo-${i}`)?.addEventListener("click", (e) => {
              const btn = e.currentTarget as HTMLElement;
              const idVehiculo = btn.dataset.idVehiculo ?? "";
              const chapa = btn.dataset.chapa ?? "";
              const idMarca = btn.dataset.idMarca ? Number(btn.dataset.idMarca) : null;
              const idModelo = btn.dataset.idModelo ? Number(btn.dataset.idModelo) : null;
              const anio = btn.dataset.anio ? Number(btn.dataset.anio) : null;
              const color = btn.dataset.color ?? "";
              const idTipoVehiculo = btn.dataset.idTipoVehiculo ? Number(btn.dataset.idTipoVehiculo) : null;

              panel.remove();
              modoActualizarVehiculo = true;
              modoNuevoVehiculo = false;
              sessionStorage.setItem("formulang_idVehiculo", idVehiculo);

              // Pre-llenar datos del vehículo
              setVal("chapa", chapa);
              if (color) setVal("color", color);
              if (anio) setVal("anio", anio);
              if (idTipoVehiculo) {
                const tipoSel = document.getElementById("tipoVehiculo") as HTMLSelectElement | null;
                if (tipoSel) tipoSel.value = String(idTipoVehiculo);
              }
              if (idMarca) {
                const marcaSel = document.getElementById("idMarca") as HTMLSelectElement | null;
                if (marcaSel) {
                  marcaSel.value = String(idMarca);
                  marcaSel.dispatchEvent(new Event("change"));
                  if (idModelo) setTimeout(() => setVal("idModelo", idModelo), 800);
                }
              }

              const infoBanner = document.createElement("div");
              infoBanner.id = "rp-info-banner";
              infoBanner.style.cssText = "margin-top:1rem;padding:0.75rem 1rem;background:rgba(79,70,229,0.12);border:1px solid rgba(79,70,229,0.35);border-radius:10px;font-size:0.82rem;color:#a5b4fc;";
              infoBanner.innerHTML = `<strong>Actualizando datos del vehículo.</strong> Modificá los campos que necesitás y confirmá.`;
              step1El?.appendChild(infoBanner);
              goToStep(2);
            });
          });

          document.getElementById("rp-btn-nuevo-vehiculo")?.addEventListener("click", () => {
            panel.remove();
            modoNuevoVehiculo = true;
            setVal("nombre", data.nombre);
            setVal("telefono", data.telefono);
            setVal("email", data.email);
            const infoBanner = document.createElement("div");
            infoBanner.id = "rp-info-banner";
            infoBanner.style.cssText = "margin-top:1rem;padding:0.75rem 1rem;background:rgba(79,70,229,0.12);border:1px solid rgba(79,70,229,0.35);border-radius:10px;font-size:0.82rem;color:#a5b4fc;";
            infoBanner.innerHTML = `<strong>Tus datos personales ya están guardados.</strong> Completá los datos del nuevo vehículo.`;
            step1El?.appendChild(infoBanner);
            goToStep(2);
          });
          return;
        }

        // ---- Scenario C: client exists but no membership or pending registration ----
        // Pre-fill step 1 and let them register normally (via registro-vehiculo endpoint)
        setVal("nombre", data.nombre);
        setVal("telefono", data.telefono);
        setVal("email", data.email);
        sessionStorage.setItem("formulang_idCliente", data.idCliente);
        modoNuevoVehiculo = true;

        const banner = document.createElement("div");
        banner.id = "rp-resume-banner";
        banner.style.cssText = "margin-top:1rem;padding:0.85rem 1rem;background:rgba(79,70,229,0.12);border:1px solid rgba(79,70,229,0.35);border-radius:10px;font-size:0.85rem;color:#a5b4fc;";
        banner.innerHTML = `<strong>Encontramos tu cuenta, ${censurar(data.nombre, 4)}.</strong><br/>Tus datos personales fueron cargados. Completá los datos de tu vehículo para continuar.`;
        step1El?.appendChild(banner);
        revelarCamposPersonales();
      } catch {
        // Error inesperado → revelar campos para no bloquear al usuario
        revelarCamposPersonales();
      } finally {
        // Siempre liberar la guardia al terminar el lookup
        lookupInProgress = false;
      }
    }

    // Lookup manual — se dispara al hacer clic en "Confirmar" o presionar Enter
    async function confirmarCI() {
      const ci = rucInput.value.trim();
      if (!ci || ci.length < 5) {
        showFieldError("ruc", "Ingresá tu RUC o CI para continuar.");
        return;
      }
      // Resetear lastLookedUpCI para permitir re-consulta aunque sea el mismo CI
      lastLookedUpCI = "";
      await dispararLookupCI(ci);
    }

    document.getElementById("btn-confirmar-ci")?.addEventListener("click", confirmarCI);

    rucInput?.addEventListener("keydown", (e) => {
      if ((e as KeyboardEvent).key === "Enter") {
        e.preventDefault();
        confirmarCI();
      }
    });

    // Cuando el usuario modifica el CI, resetear el estado del lookup anterior
    rucInput?.addEventListener("input", () => {
      const ci = rucInput.value.trim();
      if (ci !== lastLookedUpCI && lastLookedUpCI) {
        lastLookedUpCI = "";
        ocultarCamposPersonales();
        document.getElementById("rp-resume-banner")?.remove();
        document.getElementById("rp-opciones-panel")?.remove();
        sessionStorage.removeItem("formulang_idCliente");
        sessionStorage.removeItem("formulang_idRegistroPendiente");
        sessionStorage.removeItem("formulang_idMembresiaActivar");
        modoNuevoVehiculo = false;
      }
    });

    // ---- Form Submission ----
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!validateStep(currentStep)) return;

      const emailVal = (document.getElementById("email") as HTMLInputElement).value.trim();
      if (!emailVal) {
        errorMsg.textContent = "El email es requerido para activar tu Plan Premium. Volvé al paso 1 para completarlo.";
        errorBanner.style.display = "block";
        goToStep(1);
        showFieldError("email", "El email es requerido para activar tu plan");
        return;
      }
      if (!emailVal.match(/^[^\s@]+@[^\s@]+\.[^\s@]+$/)) {
        errorMsg.textContent = "El email ingresado no es válido. Volvé al paso 1 para corregirlo.";
        errorBanner.style.display = "block";
        goToStep(1);
        showFieldError("email", "Email inválido");
        return;
      }

      // Disable submit
      submitBtn.disabled = true;
      submitText.style.display = "none";
      submitLoading.style.display = "inline";
      errorBanner.style.display = "none";

      // Collect form data
      const formData: any = {
        nombre: (document.getElementById("nombre") as HTMLInputElement).value.trim(),
        ruc: (document.getElementById("ruc") as HTMLInputElement).value.trim(),
        telefono: (document.getElementById("telefono") as HTMLInputElement).value.trim(),
      };

      const email = (document.getElementById("email") as HTMLInputElement).value.trim();
      formData.email = email;

      const chapa = (document.getElementById("chapa") as HTMLInputElement).value.trim();
      formData.chapa = chapa;

      const idMarcaVal = (document.getElementById("idMarca") as HTMLSelectElement).value;
      if (idMarcaVal) formData.idMarca = Number(idMarcaVal);

      const idModeloVal = (document.getElementById("idModelo") as HTMLSelectElement).value;
      if (idModeloVal) formData.idModelo = Number(idModeloVal);

      const anio = (document.getElementById("anio") as HTMLInputElement).value;
      if (anio) formData.anio = Number(anio);

      const color = (document.getElementById("color") as HTMLInputElement).value.trim();
      if (color) formData.color = color;

      const tipoVehiculo = (document.getElementById("tipoVehiculo") as HTMLSelectElement).value;
      if (tipoVehiculo) formData.idTipoVehiculo = Number(tipoVehiculo);

      const idPlan = (document.getElementById("idPlan") as HTMLInputElement).value;
      if (idPlan) formData.idPlan = idPlan;

      // Turnstile captcha token
      const turnstileField = form.querySelector("[name='cf-turnstile-response']") as HTMLInputElement | null;
      const turnstileToken = turnstileField?.value || "";
      if (!turnstileToken) {
        errorMsg.textContent = "Completá la verificación de seguridad (captcha) para continuar.";
        errorBanner.style.display = "block";
        submitBtn.disabled = false;
        submitText.style.display = "inline";
        submitLoading.style.display = "none";
        return;
      }
      formData.turnstileToken = turnstileToken;
      formData.acceptTerminos = true;

      // Adjuntar atribución UTM si está disponible
      try {
        const utmRaw = sessionStorage.getItem("fng_utm");
        if (utmRaw) formData.attribution = JSON.parse(utmRaw);
      } catch { /* ignorar errores de parsing */ }

      try {
        const idClienteExistente = sessionStorage.getItem("formulang_idCliente");
        const idRegPendienteExistente = sessionStorage.getItem("formulang_idRegistroPendiente");

        let idCliente: string;

        if (modoActualizarVehiculo && idClienteExistente) {
          // Actualizar datos de vehículo existente — sin checkout
          const idVehiculoExistente = sessionStorage.getItem("formulang_idVehiculo");
          if (!idVehiculoExistente) throw new Error("No se encontró el vehículo a actualizar.");
          const chapaMV = (document.getElementById("chapa") as HTMLInputElement)?.value.trim();
          if (!chapaMV || chapaMV.length < 3) throw new Error("Ingresá la chapa del vehículo.");

          const actualizarPayload: Record<string, unknown> = {
            idCliente: idClienteExistente,
            idVehiculo: idVehiculoExistente,
            chapa: chapaMV.toUpperCase(),
          };
          const colorMV = (document.getElementById("color") as HTMLInputElement)?.value.trim();
          if (colorMV) actualizarPayload.color = colorMV;
          const anioMV = (document.getElementById("anio") as HTMLInputElement)?.value;
          if (anioMV) actualizarPayload.anio = Number(anioMV);
          const marcaMV = (document.getElementById("idMarca") as HTMLSelectElement)?.value;
          if (marcaMV) actualizarPayload.idMarca = Number(marcaMV);
          const modeloMV = (document.getElementById("idModelo") as HTMLSelectElement)?.value;
          if (modeloMV) actualizarPayload.idModelo = Number(modeloMV);
          const tipoMV = (document.getElementById("tipoVehiculo") as HTMLSelectElement)?.value;
          if (tipoMV) actualizarPayload.idTipoVehiculo = Number(tipoMV);

          const actuRes = await fetchWithTimeout("/api/actualizar-vehiculo", {
            method: "PATCH",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(actualizarPayload),
          }, 15000);

          if (!actuRes.ok) {
            const errBody = await actuRes.json().catch(() => ({}));
            throw new Error(errBody.error || "No se pudieron actualizar los datos del vehículo.");
          }

          showResult(
            "Datos actualizados",
            "Los datos de tu vehículo fueron actualizados correctamente.",
            false,
          );
          return;

        } else if (idClienteExistente && idRegPendienteExistente) {
          // Resume existing registration — skip POST /api/registro
          idCliente = idClienteExistente;
        } else if (modoNuevoVehiculo && idClienteExistente) {
          // Existing client adding a new vehicle — use /api/registro-vehiculo
          const vehiculoPayload: Record<string, unknown> = {
            idCliente: idClienteExistente,
            chapa: (document.getElementById("chapa") as HTMLInputElement)?.value.trim().toUpperCase(),
            idPlan: (document.getElementById("idPlan") as HTMLInputElement)?.value,
          };
          const chapaMV = (document.getElementById("chapa") as HTMLInputElement)?.value.trim();
          if (!chapaMV || chapaMV.length < 3) throw new Error("Ingresá la chapa del vehículo.");
          const idPlanMV = (document.getElementById("idPlan") as HTMLInputElement)?.value;
          if (!idPlanMV) throw new Error("Seleccioná un plan para continuar.");
          const anioMV = (document.getElementById("anio") as HTMLInputElement)?.value;
          if (anioMV) vehiculoPayload.anio = Number(anioMV);
          const colorMV = (document.getElementById("color") as HTMLInputElement)?.value.trim();
          if (colorMV) vehiculoPayload.color = colorMV;
          const marcaMV = (document.getElementById("idMarca") as HTMLSelectElement)?.value;
          if (marcaMV) vehiculoPayload.idMarca = Number(marcaMV);
          const modeloMV = (document.getElementById("idModelo") as HTMLSelectElement)?.value;
          if (modeloMV) vehiculoPayload.idModelo = Number(modeloMV);
          const tipoMV = (document.getElementById("tipoVehiculo") as HTMLSelectElement)?.value;
          if (tipoMV) vehiculoPayload.idTipoVehiculo = Number(tipoMV);

          const regVehRes = await fetchWithTimeout("/api/registro-vehiculo", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(vehiculoPayload),
          }, 20000);

          const regVehBody = await regVehRes.json().catch(() => {
            throw new Error("Error al registrar el vehículo. Intentá de nuevo.");
          });

          if (!regVehRes.ok) {
            const msg = regVehBody.error || regVehBody.message || "";
            if (regVehRes.status === 409) throw new Error(msg || "Esta chapa ya está registrada.");
            throw new Error(msg || "No se pudo registrar el vehículo. Intentá de nuevo.");
          }

          const idRegPendiente = regVehBody.idRegistroPendiente;
          if (!idRegPendiente) throw new Error("No pudimos iniciar el pago. Intentá de nuevo.");
          sessionStorage.setItem("formulang_idRegistroPendiente", idRegPendiente);
          idCliente = idClienteExistente;
        } else {
          // New client — full registration
          const res = await fetchWithTimeout("/api/registro", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(formData),
          }, 30000);

          const body = await res.json().catch(() => {
            throw new Error("Error al procesar la respuesta del servidor. Intentá de nuevo.");
          });

          if (!res.ok) {
            const serverMsg = body.error || body.message || "";
            if (res.status === 409) {
              throw new Error(serverMsg || "Este RUC o chapa ya está registrado. Si ya sos cliente, comunicate con nosotros.");
            } else if (res.status === 400) {
              throw new Error(serverMsg || "Datos inválidos. Revisá los campos e intentá de nuevo.");
            } else {
              throw new Error(serverMsg || "Error inesperado al registrar. Intentá de nuevo más tarde.");
            }
          }

          idCliente = body.data?.idCliente || body.idCliente;
          if (!idCliente) {
            throw new Error("No pudimos iniciar la activacion de tu plan. Intenta nuevamente.");
          }

          sessionStorage.setItem("formulang_idCliente", idCliente);
          const idRegistroPendiente = body.data?.idRegistroPendiente;
          if (idRegistroPendiente) sessionStorage.setItem("formulang_idRegistroPendiente", idRegistroPendiente);
        }

        submitLoading.textContent = "Redirigiendo a Pagopar...";

        const checkoutRes = await fetchWithTimeout("/api/checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            idCliente: idCliente,
            diaDebito: new Date().getDate(),
            urlRedirect: window.location.origin + "/api/callback",
          }),
        }, 30000);

        const checkoutBody = await checkoutRes.json().catch(() => {
          throw new Error("Error al procesar la respuesta del checkout. Intentá de nuevo.");
        });

        if (!checkoutRes.ok) {
          sessionStorage.removeItem("formulang_idCliente");
          showResult(
            "Alta pendiente",
            "Tu registro fue recibido, pero no pudimos iniciar el pago automatico. Tu membresia no quedo activa. Contactanos para completar el alta.",
            true,
          );
          return;
        }

        const processId = checkoutBody.processId;
        if (processId) {
          form.style.display = "none";
          bancardContainer.style.display = "block";
  
          (document.querySelector(".modal-container") as HTMLElement | null)?.scrollTo({ top: 0 });
          // Meta Pixel: AddPaymentInfo
          if (typeof (window as any).fbq === "function") {
            (window as any).fbq("track", "AddPaymentInfo", {
              content_name: "Plan Premium",
              value: 200000,
              currency: "PYG",
            });
          }

          // Load Bancard Checkout JS SDK if not already loaded
          if (!(window as any).Bancard) {
            await new Promise<void>((resolve, reject) => {
              const script = document.createElement("script");
              script.src = "/bancard-checkout-5.0.1.js";
              script.onload = () => resolve();
              script.onerror = () => reject(new Error("Error al cargar Bancard SDK"));
              document.head.appendChild(script);
            });
          }

          // Render the Bancard card enrollment form
          waitForBancardIframe();
          (window as any).Bancard.Cards.createForm("bancard-iframe", processId, {
            styles: {
              "input-background-color": "#ffffff",
              "input-text-color": "#333333",
              "input-placeholder-color": "#999999",
              "input-border-color": "#dddddd",
              "button-background-color": "#4f46e5",
              "button-text-color": "#ffffff",
              "form-background-color": "#ffffff",
            },
          });
        } else {
          sessionStorage.removeItem("formulang_idCliente");
          showResult(
            "Alta pendiente",
            "Tu registro fue recibido, pero no pudimos completar el cobro automatico. Tu membresia no quedo activa. Contactanos para continuar.",
            true,
          );
        }
        return;
      } catch (err: any) {
        sessionStorage.removeItem("formulang_idCliente");
        sessionStorage.removeItem("formulang_idRegistroPendiente");
        // Filter out raw technical errors (SyntaxError, TypeError, etc.)
        const isTechnical = err instanceof SyntaxError || err instanceof TypeError ||
          (err.message && (err.message.includes("Unexpected token") || err.message.includes("undefined")));
        errorMsg.textContent = isTechnical
          ? "Error inesperado. Intente más tarde."
          : (err.message || "Error inesperado. Intente más tarde.");
        errorBanner.style.display = "block";
      } finally {
        submitBtn.disabled = false;
        submitText.style.display = "inline";
        submitLoading.style.display = "none";
        submitLoading.textContent = "Procesando...";
      }
    });
    // ---- Handle Pagopar Checkout Callback ----
    // When Pagopar redirects back via /api/callback, it sets ?checkout=ok|error on the landing
    (async function handleCheckoutCallback() {
      const params = new URLSearchParams(window.location.search);
      const checkoutStatus = params.get("checkout");
      if (!checkoutStatus) return;

      // Clean URL without reloading
      const cleanUrl = window.location.pathname;
      window.history.replaceState({}, "", cleanUrl);

      if (checkoutStatus === "ok") {
        // Show success notification
        openModal();
        showResult(
          "Plan activado",
          "Tu tarjeta fue registrada exitosamente. Tu Plan Premium quedó activo y los débitos automáticos mensuales están habilitados.",
        );

        // Confirm card + charge first installment in the backend
        const storedClienteId = sessionStorage.getItem("formulang_idCliente");
        const storedIdRegistroPendiente = sessionStorage.getItem("formulang_idRegistroPendiente");
        const storedIdMembresiaActivar = sessionStorage.getItem("formulang_idMembresiaActivar");
        if (storedClienteId) {
          try {
            const confirmPayload: Record<string, any> = { idCliente: storedClienteId, acceptTerminos: true };
            if (storedIdRegistroPendiente) confirmPayload.idRegistroPendiente = storedIdRegistroPendiente;
            if (storedIdMembresiaActivar) confirmPayload.idMembresiaActivar = storedIdMembresiaActivar;

            const confirmRes = await fetch("/api/confirmar", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(confirmPayload),
            });

            if (!confirmRes.ok) {
              const confirmBody = await confirmRes.json().catch(() => ({}));
              console.error("Error confirming card:", confirmBody);
              // Payment was rejected — offer retry with another card
              const errMsg = confirmBody.error || confirmBody.message || "Tu tarjeta fue rechazada.";
              showResult(
                "Pago rechazado",
                `${errMsg} Podés intentar registrar otra tarjeta.`,
                true,
              );
              // Inject retry button
              const retryBtn = document.createElement("button");
              retryBtn.type = "button";
              retryBtn.className = "btn-next";
              retryBtn.style.marginTop = "1rem";
              retryBtn.textContent = "Intentar con otra tarjeta";
              retryBtn.addEventListener("click", () => startRetryCheckout(storedClienteId));
              successDiv.appendChild(retryBtn);
              return;
            }
            // Success — fire Meta Pixel Purchase event and clean up
            if (typeof (window as any).fbq === "function") {
              (window as any).fbq("track", "Purchase", {
                value: 200000,
                currency: "PYG",
                content_name: "Plan Premium - Débito Automático",
                content_type: "product",
              });
            }
            sessionStorage.removeItem("formulang_idCliente");
            sessionStorage.removeItem("formulang_idRegistroPendiente");
            sessionStorage.removeItem("formulang_idMembresiaActivar");
          } catch (err) {
            console.error("Error confirming card:", err);
            showResult(
              "Error de conexión",
              "Tu tarjeta fue registrada pero no pudimos confirmar el cobro. Contactanos para asistencia.",
              true,
            );
            sessionStorage.removeItem("formulang_idCliente");
            sessionStorage.removeItem("formulang_idRegistroPendiente");
          }
        }
      } else {
        // Bancard enrollment error — offer retry if there's a pending registration
        const msg = params.get("checkout_msg") || "No se pudo registrar la tarjeta.";
        openModal();
        const storedClienteId = sessionStorage.getItem("formulang_idCliente");
        if (storedClienteId) {
          showResult("Error al registrar tarjeta", `${msg} Podés intentar con otra tarjeta.`, true);
          const retryBtn = document.createElement("button");
          retryBtn.type = "button";
          retryBtn.className = "btn-next";
          retryBtn.style.marginTop = "1rem";
          retryBtn.textContent = "Intentar con otra tarjeta";
          retryBtn.addEventListener("click", () => startRetryCheckout(storedClienteId));
          successDiv.appendChild(retryBtn);
        } else {
          showResult("Error al registrar tarjeta", msg, true);
        }
      }
    })();
  }
</script>
