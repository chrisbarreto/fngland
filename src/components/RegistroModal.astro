    const closeBtn = document.getElementById("modal-close") as HTMLElement;
    const successDiv = document.getElementById("registro-success") as HTMLElement;
    const errorBanner = document.getElementById("registro-error") as HTMLElement;
    const errorMsg = document.getElementById("error-message") as HTMLElement;
    const submitBtn = document.getElementById("btn-submit") as HTMLButtonElement;
    const submitText = submitBtn?.querySelector(".btn-submit-text") as HTMLElement;
    const submitLoading = submitBtn?.querySelector(".btn-submit-loading") as HTMLElement;
    const bancardContainer = document.getElementById("bancard-checkout-container") as HTMLElement;
    const processingOverlay = document.getElementById("processing-overlay") as HTMLElement;
    const successTitle = successDiv?.querySelector("h3") as HTMLElement;
    const successMessage = successDiv?.querySelector("p") as HTMLElement;
    const successIcon = successDiv?.querySelector(".success-icon") as HTMLElement;

    let currentStep = 1;
    let marcasLoaded = false;
    let planesLoaded = false;
    let modoNuevoVehiculo = false;
    let modoActualizarVehiculo = false;
    let lastLookedUpCI = "";      // evita re-disparar lookup para el mismo CI
    let lookupInProgress = false; // evita lookups simultáneos (race condition)

    // ---- Turnstile token state ----
    interface TurnstileInstance {
      reset: (container?: HTMLElement | string) => void;
      getResponse: (container?: HTMLElement | string) => string | undefined;
      remove: (container?: HTMLElement | string) => void;
      render: (container: HTMLElement | string, params: Record<string, string>) => string;
      execute: (container?: HTMLElement | string) => void;
    }
    declare global {
      interface Window {
        turnstile?: TurnstileInstance;
        __tsOnSuccess: (token: string) => void;
        __tsOnExpired: () => void;
        __tsOnError: () => void;
      }
    }

    let _tsTokenReady = false;
    let _tsTokenValue = "";
    let _tsPendingResolves: Array<() => void> = [];

    window.__tsOnSuccess = (token: string) => {
      _tsTokenReady = true;
      _tsTokenValue = token;
      const resolvers = _tsPendingResolves.splice(0);
      resolvers.forEach((r) => r());
    };
    window.__tsOnExpired = () => {
      _tsTokenReady = false;
      _tsTokenValue = "";
    };
    window.__tsOnError = () => {
      _tsTokenReady = false;
      _tsTokenValue = "";
    };

    // Paleta oscura para el iframe de Bancard — alineada con los design tokens del modal
    // (--card-bg, --navy-700, --input-bg, --input-border, --text-primary, --text-muted, --accent-blue).
    // El SDK de Bancard solo acepta hex sólidos (no rgba).
    const BANCARD_DARK_STYLES = {
      "form-background-color":   "#ffffff",
      "form-border-color":       "#e5e7eb",
      "header-background-color": "#f9fafb",
      "header-text-color":       "#111827",
      "input-background-color":  "#f3f4f6",
      "input-text-color":        "#111827",
      "input-placeholder-color": "#9ca3af",
      "input-border-color":      "#d1d5db",
      "button-background-color": "#2d5be3",
      "button-text-color":       "#ffffff",
      "button-border-color":     "#1e4bc7",
      "hr-border-color":         "#e5e7eb",
      "label-kyc-text-color":    "#374151",
    } as const;

    // Helpers for censoring displayed data
    function censurar(valor: string, visibles = 3): string {
      if (!valor || valor.length <= visibles) return valor;
      return valor.slice(0, visibles) + "***";
    }
    function censurarEmail(email: string): string {
      const [user, domain] = email.split("@");
      return (user ? user[0] + "***" : "***") + "@" + (domain ?? "");
    }

    // Revela los campos personales (nombre/tel/email) y el botón Siguiente del paso 1
    function revelarCamposPersonales() {
      _modalDirty = true;
      updateBeforeUnload();
      document.querySelectorAll<HTMLElement>(".personal-field").forEach(el => { el.style.display = ""; });
      const actions = document.getElementById("step1-actions") as HTMLElement | null;
      if (actions) actions.style.display = "";
      const loading = document.getElementById("ci-lookup-loading") as HTMLElement | null;
      if (loading) loading.style.display = "none";
      const rucSuccess = document.getElementById("ruc-success") as HTMLElement | null;
      if (rucSuccess) rucSuccess.style.display = "flex";
    }

    // Oculta los campos personales y el botón Siguiente (estado inicial / reset)
    function ocultarCamposPersonales() {
      document.querySelectorAll<HTMLElement>(".personal-field").forEach(el => { el.style.display = "none"; });
      const actions = document.getElementById("step1-actions") as HTMLElement | null;
      if (actions) actions.style.display = "none";
      const loading = document.getElementById("ci-lookup-loading") as HTMLElement | null;
      if (loading) loading.style.display = "none";
      const rucSuccess = document.getElementById("ruc-success") as HTMLElement | null;
      if (rucSuccess) rucSuccess.style.display = "none";
    }

    const defaultSuccessTitle = "Plan activado";
    function getSuccessMessage() {
      const meta = currentPlanMeta();
      return `Tu ${meta.name} quedó activo correctamente. Ya podés disfrutar de tus beneficios y agendar tus servicios.`;
    }

    function restoreSuccessState() {
      if (successTitle) successTitle.textContent = defaultSuccessTitle;
      if (successMessage) successMessage.textContent = getSuccessMessage();
      if (successIcon) {
        successIcon.textContent = "\u2713";
        successIcon.style.background = "#22c55e";
      }
      hideProcessing();
      unlockModal();
      // Ocultar y resetear botón de comprobante
      const receiptBtn = document.getElementById("btn-download-receipt") as HTMLButtonElement | null;
      if (receiptBtn) { receiptBtn.style.display = "none"; receiptBtn.textContent = "Descargar comprobante"; receiptBtn.disabled = false; }
      _receiptListenerAttached = false;
      if (successDiv) {
        successDiv.querySelectorAll("button").forEach((b) => {
          if (b.id !== "btn-download-receipt") b.remove();
        });
      }
    }

    function showProcessing() {
      if (processingOverlay) processingOverlay.style.display = "";
    }
    function hideProcessing() {
      if (processingOverlay) processingOverlay.style.display = "none";
    }

    function showResult(title: string, message: string, isError = false) {
      hideProcessing();
      restoreSuccessState();
      if (successTitle) successTitle.textContent = title;
      if (successMessage) successMessage.textContent = message;
      if (successIcon && isError) {
        successIcon.textContent = "\u2717";
        successIcon.style.background = "#ef4444";
      }
      form.style.display = "none";
      bancardContainer.style.display = "none";
      successDiv.style.display = "block";
    }

    let _receiptListenerAttached = false;

    function addReceiptButton(comprobante: any) {
      if (!comprobante) return;
      const btn = document.getElementById("btn-download-receipt") as HTMLButtonElement | null;
      if (!btn) return;
      btn.style.display = "";
      if (!_receiptListenerAttached) {
        _receiptListenerAttached = true;
        btn.addEventListener("click", async () => {
          btn.disabled = true;
          btn.textContent = "Generando PDF...";
          try {
            const { generateReceipt } = await import("../lib/receipt");
            await generateReceipt((btn as any)._comprobante);
            unlockModal();
            btn.textContent = "Descargar de nuevo";
          } catch (err) {
            console.error("Error generando PDF:", err);
            btn.textContent = "Descargar comprobante";
          }
          btn.disabled = false;
        });
      }
      (btn as any)._comprobante = comprobante;
      lockModal();
    }

    function resetModalState() {
      restoreSuccessState();
      goToStep(1);
      clearErrors();
      ocultarCamposPersonales();
      // Limpiar todos los campos del paso 1
      (document.getElementById("ruc") as HTMLInputElement).value = "";
      (document.getElementById("nombre") as HTMLInputElement).value = "";
      (document.getElementById("telefono") as HTMLInputElement).value = "";
      (document.getElementById("email") as HTMLInputElement).value = "";
      document.getElementById("rp-resume-banner")?.remove();
      document.getElementById("rp-opciones-panel")?.remove();
      document.getElementById("rp-info-banner")?.remove();
      sessionStorage.removeItem("formulang_idCliente");
      sessionStorage.removeItem("formulang_idRegistroPendiente");
      sessionStorage.removeItem("formulang_idMembresiaActivar");
      sessionStorage.removeItem("formulang_idsMembresiasActivar");
      sessionStorage.removeItem("formulang_idVehiculo");
      modoNuevoVehiculo = false;
      modoActualizarVehiculo = false;
      lastLookedUpCI = "";
      lookupInProgress = false;
      // Ocultar inputs de "Otro" y limpiar valores
      const _otrosRow = document.getElementById("otros-row") as HTMLElement | null;
      if (_otrosRow) _otrosRow.style.display = "none";
      (document.getElementById("marcaNueva-group") as HTMLElement | null)?.style && ((document.getElementById("marcaNueva-group") as HTMLElement).style.display = "none");
      (document.getElementById("modeloNuevo-group") as HTMLElement | null)?.style && ((document.getElementById("modeloNuevo-group") as HTMLElement).style.display = "none");
      (document.getElementById("marcaNueva") as HTMLInputElement | null) && ((document.getElementById("marcaNueva") as HTMLInputElement).value = "");
      (document.getElementById("modeloNuevo") as HTMLInputElement | null) && ((document.getElementById("modeloNuevo") as HTMLInputElement).value = "");
      form.style.display = "";
      bancardContainer.style.display = "none";

      successDiv.style.display = "none";
      submitBtn.disabled = false;
      submitText.style.display = "inline";
      submitLoading.style.display = "none";
      submitLoading.textContent = "Procesando...";
    }

    // ---- Fetch with timeout ----
    function fetchWithTimeout(url: string, options: RequestInit = {}, timeoutMs = 30000): Promise<Response> {
      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), timeoutMs);
      return fetch(url, { ...options, signal: controller.signal })
        .catch((err) => {
          if (err.name === "AbortError") {
            throw new Error("La solicitud tardó demasiado. Verificá tu conexión e intentá de nuevo.");
          }
          throw err;
        })
        .finally(() => clearTimeout(timer));
    }

    // ---- Auto-debit: día calculado automáticamente al activar ----
    // No se muestra selector; se usa el día del mes de la fecha de activación (estilo Netflix)

    // ---- Plan metadata map (UUID → display info) ----
    const PLAN_META: Record<string, { name: string; price: string }> = {
      "a9ee77bc-96ce-4217-ad0f-c817b9e58687": { name: "Plan Fórmula",            price: "200.000" },
      "7ad4bfae-b1f2-47c9-8c3c-d4615607ad04": { name: "Plan Premium",            price: "250.000" },
      "5a9b7b48-2e37-45f2-8ba9-f1a234b85f80": { name: "Plan Gold",               price: "350.000" },
      "ae949f1e-90c5-4d4e-879c-3e2724c89c79": { name: "Plan Lavado a Domicilio", price: "500.000" },
    };

    function currentPlanMeta() {
      const id = _pendingPlanId
        || (document.getElementById("idPlan") as HTMLInputElement)?.value
        || "";
      return PLAN_META[id] || { name: "Plan Fórmula", price: "200.000" };
    }

    function updateModalHeader(planId?: string) {
      const meta = planId ? (PLAN_META[planId] || { name: "Plan Fórmula", price: "200.000" }) : { name: "tu plan", price: "—" };
      const headerName  = document.getElementById("modal-plan-name");
      const headerPrice = document.getElementById("modal-plan-price");
      const headerBadge = document.getElementById("modal-plan-badge");
      if (headerName)  headerName.textContent  = meta.name;
      if (headerPrice) headerPrice.textContent = meta.price !== "—" ? `Gs. ${meta.price}` : "—";
      if (headerBadge) headerBadge.textContent = meta.name && meta.name !== "tu plan" ? meta.name : "Plan";

      // También actualiza el subtítulo del checkout de Bancard
      const checkoutInfo = document.getElementById("checkout-plan-info");
      if (checkoutInfo && meta.name !== "tu plan") {
        checkoutInfo.textContent =
          `Ingresá los datos de tu tarjeta para habilitar el débito automático obligatorio y activar tu ${meta.name}.`;
      }
    }

    // ---- Open / Close Modal ----
    let _pendingPlanId: string | undefined;

    function openModal(options?: { planId?: string }) {
      // Sincronizar estado del token con el widget actual al abrir el modal
      const tsField = document.querySelector("[name='cf-turnstile-response']") as HTMLInputElement | null;
      if (tsField?.value) {
        _tsTokenReady = true;
        _tsTokenValue = tsField.value;
      }

      // Preserve planId: if called without options (e.g. from Bancard callback),
      // restore from sessionStorage so currentPlanMeta() keeps working.
      if (options?.planId) {
        _pendingPlanId = options.planId;
        sessionStorage.setItem("formulang_planId", _pendingPlanId);
      } else if (!_pendingPlanId) {
        _pendingPlanId = sessionStorage.getItem("formulang_planId") || undefined;
      }
      updateModalHeader(_pendingPlanId);
      resetModalState();
      modal.style.display = "flex";
      document.body.style.overflow = "hidden";
      if (!marcasLoaded) loadMarcas();
      // Meta Pixel: InitiateCheckout
      if (typeof (window as any).fbq === "function") {
        (window as any).fbq("track", "InitiateCheckout", {
          content_name: "Membresia Fórmula NG",
          currency: "PYG",
        });
      }
      if (!planesLoaded) loadPlanes(_pendingPlanId);
      else if (_pendingPlanId) preselectPlanById(_pendingPlanId);
    }

    function preselectPlanById(planId: string) {
      const container = document.getElementById("planes-container") as HTMLElement;
      // Aplicar estado visual directamente sin click
      container.querySelectorAll<HTMLElement>(".plan-card").forEach(c => {
        const isTarget = c.getAttribute("data-plan-id") === planId;
        c.classList.toggle("selected", isTarget);
        c.classList.toggle("plan-card-hidden", !isTarget);
        c.style.display = isTarget ? "" : "none";
      });
      // Actualizar campo oculto e header
      const card = container.querySelector<HTMLElement>(`[data-plan-id="${planId}"]`);
      if (!card) return;
      (document.getElementById("idPlan") as HTMLInputElement).value = planId;
      const planPrice = card.getAttribute("data-plan-price") || "";
      const planName = (card.querySelector(".plan-name") as HTMLElement)?.textContent?.trim() || "plan";
      const priceSpan = document.getElementById("auto-debit-price");
      if (priceSpan && planPrice) priceSpan.textContent = `Gs. ${planPrice}`;
      const headerName = document.getElementById("modal-plan-name");
      const headerPrice = document.getElementById("modal-plan-price");
      if (headerName) headerName.textContent = planName;
      if (headerPrice && planPrice) headerPrice.textContent = `Gs. ${planPrice}`;
    }

    let _modalLocked = false;   // true = bloqueo total (iframe/cobro en curso)
    let _modalDirty = false;    // true = datos cargados, pedir confirmación al salir

    function closeModal() {
      if (_modalLocked) return;
      if (_modalDirty) {
        if (!confirm("¿Estás seguro que querés salir? Se perderán los datos ingresados.")) return;
      }
      _modalDirty = false;
      _modalLocked = false;
      updateBeforeUnload();
      modal.style.display = "none";
      document.body.style.overflow = "";
      resetModalState();
    }

    // Expose globally so Hero can call it
    (window as any).__openRegistroModal = openModal;

    closeBtn?.addEventListener("click", closeModal);
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });

    // ESC key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal.style.display === "flex") closeModal();
    });

    // ---- Step Navigation ----
    function goToStep(step: number) {
      currentStep = step;
      if (step >= 2) _modalDirty = true;
      document.querySelectorAll(".form-step").forEach((el) => {
        const isActive = el.getAttribute("data-step") === String(step);
        (el as HTMLElement).classList.toggle("active", isActive);
        // Step 1 contiene el widget de Turnstile — nunca debe ser display:none
        // porque el SDK de Cloudflare necesita el iframe en el render tree para
        // poder auto-refrescar el token mientras el usuario está en Steps 2/3.
        if (el.getAttribute("data-step") === "1") {
          if (isActive) {
            (el as HTMLElement).style.cssText = "";
          } else {
            (el as HTMLElement).style.cssText =
              "display:block;position:absolute;left:-9999px;top:0;pointer-events:none;";
          }
        }
      });
      document.querySelectorAll(".step-dot").forEach((el) => {
        const s = Number(el.getAttribute("data-step"));
        el.classList.toggle("active", s === step);
        el.classList.toggle("completed", s < step);
      });
      document.querySelectorAll(".step-label").forEach((el) => {
        el.classList.toggle("active", el.getAttribute("data-step") === String(step));
      });
      // Stepper unificado (.step-item) — sincronizar con el step actual
      document.querySelectorAll(".step-item").forEach((el) => {
        const s = Number(el.getAttribute("data-step-item"));
        el.classList.toggle("active", s === step);
        el.classList.toggle("done", s < step);
      });

      // Footer dinámico: paso 1 usa #step1-actions interno; pasos 2/3 usan footer
      const footer = document.getElementById("form-actions-footer") as HTMLElement | null;
      const btnPrevFooter = document.getElementById("btn-prev-footer") as HTMLElement | null;
      const btnNextFooter = document.getElementById("btn-next-footer") as HTMLElement | null;
      const btnSubFooter = document.getElementById("btn-submit") as HTMLElement | null;
      const secureNote = document.getElementById("secure-note") as HTMLElement | null;
      if (footer && btnPrevFooter && btnNextFooter && btnSubFooter) {
        if (step === 1) {
          footer.style.display = "none";
          if (secureNote) secureNote.style.display = "none";
        } else {
          footer.style.display = "";
          if (secureNote) secureNote.style.display = step === 3 ? "" : "none";
          btnPrevFooter.style.display = "";
          btnPrevFooter.setAttribute("data-prev", String(step - 1));
          if (step === 3) {
            btnNextFooter.style.display = "none";
            btnSubFooter.style.display = "";
          } else {
            btnNextFooter.style.display = "";
            btnNextFooter.setAttribute("data-next", String(step + 1));
            btnSubFooter.style.display = "none";
          }
        }
      }

      // Al llegar a step 3, asegurar que el plan quede visualmente seleccionado
      if (step === 3 && planesLoaded && _pendingPlanId) {
        requestAnimationFrame(() => preselectPlanById(_pendingPlanId!));
      }

      // Scroll body to top
      const body = document.querySelector(".modal-body") as HTMLElement | null;
      if (body) body.scrollTop = 0;
    }

    // Payment method toggle (Bancard / Upay)
    const metodoPagoHintNombre = document.getElementById("metodo-pago-hint-nombre");
    document.querySelectorAll<HTMLButtonElement>(".pay-btn[data-method]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const method = btn.getAttribute("data-method") || "upay";
        document.querySelectorAll<HTMLButtonElement>(".pay-btn[data-method]").forEach((b) => {
          const isActive = b === btn;
          b.classList.toggle("active", isActive);
          b.setAttribute("aria-selected", String(isActive));
        });
        const hidden = document.getElementById("metodoPago") as HTMLInputElement | null;
        if (hidden) hidden.value = method;
        if (metodoPagoHintNombre) {
          metodoPagoHintNombre.textContent =
            method === "bancard"
              ? "Bancard (Visa / Mastercard)"
              : "Pagopar / Upay";
        }
      });
    });

    // Next buttons
    document.querySelectorAll(".btn-next[data-next]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const nextStep = Number((btn as HTMLElement).getAttribute("data-next"));
        if (validateStep(currentStep)) {
          goToStep(nextStep);
        }
      });
    });

    // Prev buttons
    document.querySelectorAll(".btn-prev[data-prev]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const prevStep = Number((btn as HTMLElement).getAttribute("data-prev"));
        goToStep(prevStep);
      });
    });

    // ---- Validation ----
    function validateStep(step: number): boolean {
      clearErrors();
      let valid = true;

      if (step === 1) {
        const nombre = (document.getElementById("nombre") as HTMLInputElement).value.trim();
        const ruc = (document.getElementById("ruc") as HTMLInputElement).value.replace(/\s+/g, "");
        const telefono = (document.getElementById("telefono") as HTMLInputElement).value.replace(/[^0-9]/g, "");
        const email = (document.getElementById("email") as HTMLInputElement).value.trim();

        if (!nombre) { showFieldError("nombre", "El nombre es requerido"); valid = false; }
        if (!ruc) { showFieldError("ruc", "El RUC/CI es requerido"); valid = false; }
        if (!telefono) {
          showFieldError("telefono", "El teléfono es requerido");
          valid = false;
        } else if (telefono.replace(/\D/g, "").length < 10) {
          showFieldError("telefono", "El teléfono debe tener al menos 10 dígitos");
          valid = false;
        }
        if (!email) {
          showFieldError("email", "El email es requerido para activar tu plan");
          valid = false;
        } else if (email && !email.match(/^[^\s@]+@[^\s@]+\.[^\s@]+$/)) {
          showFieldError("email", "Email inválido");
          valid = false;
        }
      }

      if (step === 2) {
        const chapa = (document.getElementById("chapa") as HTMLInputElement).value.trim();
        if (!chapa || chapa.length < 3) { showFieldError("chapa", "La chapa es requerida (mín. 3 caracteres)"); valid = false; }
        const idMarcaV = (document.getElementById("idMarca") as HTMLSelectElement).value;
        if (idMarcaV === "otro") {
          const mn = (document.getElementById("marcaNueva") as HTMLInputElement).value.trim();
          if (!mn) { showFieldError("marcaNueva", "Especificá la marca del vehículo"); valid = false; }
        }
        const idModeloV = (document.getElementById("idModelo") as HTMLSelectElement).value;
        if (idModeloV === "otro") {
          const mo = (document.getElementById("modeloNuevo") as HTMLInputElement).value.trim();
          if (!mo) { showFieldError("modeloNuevo", "Especificá el modelo del vehículo"); valid = false; }
        }
      }

      if (step === 3) {
        const acceptLegal = document.getElementById("acceptLegal") as HTMLInputElement;
        if (acceptLegal && !acceptLegal.checked) {
          const errorEl = document.getElementById("legal-accept-error");
          if (errorEl) errorEl.textContent = "Debés aceptar los Términos y Condiciones para continuar.";
          valid = false;
        }
      }

      return valid;
    }

    function showFieldError(fieldId: string, message: string) {
      const field = document.getElementById(fieldId);
      if (field) {
        field.classList.add("invalid");
        const errorSpan = field.parentElement?.querySelector(".field-error");
        if (errorSpan) errorSpan.textContent = message;
      }
    }

    function clearErrors() {
      document.querySelectorAll(".invalid").forEach(el => el.classList.remove("invalid"));
      document.querySelectorAll(".field-error").forEach(el => el.textContent = "");
      errorBanner.style.display = "none";
    }

    function normalizeText(value: unknown): string {
      return String(value || "")
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase();
    }

    function escapeHtml(value: unknown): string {
      return String(value || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/\"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function getPublicPlanName(plan: any): string {
      const n = normalizeText(plan?.nombre);
      if (n.includes("gold")) return "Plan Gold";
      if (n.includes("domicilio")) return "Plan Lavado a Domicilio";
      if (n.includes("premium") || n.includes("premiun")) return "Plan Premium";
      if (n.includes("formula") || n.includes("fórmula")) return "Plan Fórmula";
      return String(plan?.nombre || "Plan");
    }

    function getPublicPlanDescription(plan: any): string {
      const planDescription = String(plan?.descripcion || "").trim();
      const contractDescription =
        "Permanencia minima de 12 meses. Debito automatico obligatorio.";

      if (!planDescription) return contractDescription;

      return `${escapeHtml(planDescription).replace(/\n+/g, "<br />")}<br /><br />${contractDescription}`;
    }

    // ---- Load Marcas ----
    async function loadMarcas() {
      const select = document.getElementById("idMarca") as HTMLSelectElement;
      try {
        const res = await fetchWithTimeout("/api/marcas", {}, 15000);
        if (!res.ok) {
          const errBody = await res.json().catch(() => ({}));
          throw new Error(errBody.error || `Error ${res.status} al cargar marcas`);
        }
        const data = await res.json();
        if (Array.isArray(data)) {
          select.innerHTML = '<option value="">Seleccionar marca...</option>';
          data.forEach((marca: any) => {
            const opt = document.createElement("option");
            opt.value = marca.idMarca;
            opt.textContent = marca.nombre;
            select.appendChild(opt);
          });
          const otroMarca = document.createElement("option");
          otroMarca.value = "otro";
          otroMarca.textContent = "Otro";
          select.appendChild(otroMarca);
          marcasLoaded = true;
        } else {
          select.innerHTML = '<option value="">Error: respuesta inválida</option>';
        }
      } catch (err: any) {
        console.error("Error loading marcas:", err);
        select.innerHTML = `<option value="">Error al cargar marcas</option>`;
      }
    }

    // ---- Load Modelos (cascading) ----
    const marcaSelect = document.getElementById("idMarca") as HTMLSelectElement;
    const modeloSelect = document.getElementById("idModelo") as HTMLSelectElement;

    const otrosRow = document.getElementById("otros-row") as HTMLElement;
    const marcaNuevaGroup = document.getElementById("marcaNueva-group") as HTMLElement;
    const modeloNuevoGroup = document.getElementById("modeloNuevo-group") as HTMLElement;
    const marcaNuevaInput = document.getElementById("marcaNueva") as HTMLInputElement;
    const modeloNuevoInput = document.getElementById("modeloNuevo") as HTMLInputElement;

    function syncOtrosRow() {
      const anyVisible =
        marcaNuevaGroup.style.display !== "none" ||
        modeloNuevoGroup.style.display !== "none";
      otrosRow.style.display = anyVisible ? "" : "none";
    }

    marcaSelect?.addEventListener("change", async () => {
      const idMarca = marcaSelect.value;
      modeloSelect.innerHTML = '<option value="">Cargando...</option>';
      modeloSelect.disabled = true;
      modeloNuevoGroup.style.display = "none";

      if (!idMarca) {
        marcaNuevaGroup.style.display = "none";
        modeloSelect.innerHTML = '<option value="">Primero seleccioná la marca</option>';
        syncOtrosRow();
        return;
      }

      if (idMarca === "otro") {
        marcaNuevaGroup.style.display = "";
        modeloSelect.innerHTML = '<option value="">Seleccionar modelo...</option>';
        modeloSelect.disabled = true;
        modeloNuevoGroup.style.display = "";
        syncOtrosRow();
        return;
      }

      marcaNuevaGroup.style.display = "none";
      marcaNuevaInput.value = "";
      syncOtrosRow();

      try {
        const res = await fetchWithTimeout(`/api/modelos?idMarca=${idMarca}`, {}, 15000);
        if (!res.ok) {
          const errBody = await res.json().catch(() => ({}));
          throw new Error(errBody.error || `Error ${res.status} al cargar modelos`);
        }
        const data = await res.json();
        modeloSelect.innerHTML = '<option value="">Seleccionar modelo...</option>';
        if (Array.isArray(data)) {
          data.forEach((modelo: { idModelo: string; nombre: string }) => {
            const opt = document.createElement("option");
            opt.value = modelo.idModelo;
            opt.textContent = modelo.nombre;
            modeloSelect.appendChild(opt);
          });
        }
        const otroModelo = document.createElement("option");
        otroModelo.value = "otro";
        otroModelo.textContent = "Otro";
        modeloSelect.appendChild(otroModelo);
        modeloSelect.disabled = false;
      } catch (err: unknown) {
        modeloSelect.innerHTML = `<option value="">Error al cargar modelos</option>`;
        console.error("Error loading modelos:", err);
      }
    });

    modeloSelect?.addEventListener("change", () => {
      if (modeloSelect.value === "otro") {
        modeloNuevoGroup.style.display = "";
      } else {
        modeloNuevoGroup.style.display = "none";
        modeloNuevoInput.value = "";
      }
      syncOtrosRow();
    });

    // ---- Load Planes ----
    async function loadPlanes(planId?: string) {
      const container = document.getElementById("planes-container") as HTMLElement;
      try {
        const res = await fetchWithTimeout("/api/planes", {}, 15000);
        if (!res.ok) {
          const errBody = await res.json().catch(() => ({}));
          throw new Error(errBody.error || `Error ${res.status} al cargar planes`);
        }
        const data = await res.json();

        if (Array.isArray(data) && data.length > 0) {
          // Determinar cuál card mostrar primero (el plan pre-seleccionado o el primero)
          const selectedId = planId || data[0]?.idPlan || "";

          const cardsHtml = data.map((plan: any) => {
            const isSelected = plan.idPlan === selectedId;
            return `
              <div class="plan-card${isSelected ? " selected" : " plan-card-hidden"}" data-plan-id="${escapeHtml(plan.idPlan)}" data-plan-price="${Number(plan.precio).toLocaleString("es-PY")}">
                <div class="plan-card-badge">Plan oficial</div>
                <div class="plan-name">${escapeHtml(PLAN_META[plan.idPlan]?.name || getPublicPlanName(plan))}</div>
                <div class="plan-price">Gs. ${Number(plan.precio).toLocaleString("es-PY")}/mes</div>

                <div class="plan-check">&#10003;</div>
              </div>
            `;
          }).join("");

          container.innerHTML = cardsHtml + `
            <button type="button" id="btn-cambiar-plan" class="btn-cambiar-plan">
              Elegir otro plan
            </button>
          `;

          // Toggle: mostrar/ocultar todos los planes
          const btnCambiar = document.getElementById("btn-cambiar-plan") as HTMLButtonElement;
          let todosVisibles = false;
          btnCambiar.addEventListener("click", () => {
            todosVisibles = !todosVisibles;
            container.querySelectorAll<HTMLElement>(".plan-card-hidden").forEach(c => {
              c.style.display = todosVisibles ? "" : "none";
            });
            btnCambiar.textContent = todosVisibles ? "Ocultar planes" : "Elegir otro plan";
          });
          // Asegurar estado inicial oculto
          container.querySelectorAll<HTMLElement>(".plan-card-hidden").forEach(c => {
            c.style.display = "none";
          });

          // Plan selection click
          container.querySelectorAll(".plan-card").forEach((card) => {
            card.addEventListener("click", () => {
              container.querySelectorAll(".plan-card").forEach(c => c.classList.remove("selected"));
              card.classList.add("selected");
              (document.getElementById("idPlan") as HTMLInputElement).value =
                (card as HTMLElement).getAttribute("data-plan-id") || "";

              const planPrice = (card as HTMLElement).getAttribute("data-plan-price") || "";
              const planName = (card.querySelector(".plan-name") as HTMLElement)?.textContent?.trim() || "plan";

              // Update auto-debit price display
              const priceSpan = document.getElementById("auto-debit-price");
              if (priceSpan && planPrice) priceSpan.textContent = `Gs. ${planPrice}`;

              // Update modal header
              const headerName = document.getElementById("modal-plan-name");
              const headerPrice = document.getElementById("modal-plan-price");
              if (headerName) headerName.textContent = planName;
              if (headerPrice && planPrice) headerPrice.textContent = `Gs. ${planPrice}`;

              // Al elegir un plan diferente, colapsar los otros
              if (todosVisibles) {
                todosVisibles = false;
                container.querySelectorAll<HTMLElement>(".plan-card-hidden").forEach(c => {
                  c.style.display = "none";
                });
                if (btnCambiar) btnCambiar.textContent = "Elegir otro plan";
              }
            });
          });

          // Pre-seleccionar (siempre via preselectPlanById para evitar que el
          // click handler quite la clase .selected de todos primero)
          planesLoaded = true;
          const toSelect = planId || selectedId;
          if (toSelect) preselectPlanById(toSelect);
        } else {
          container.innerHTML = '<div class="planes-loading">No hay planes disponibles en este momento.</div>';
        }
      } catch (err) {
        const container = document.getElementById("planes-container") as HTMLElement;
        container.innerHTML = '<div class="planes-loading">Error al cargar planes. Intente más tarde.</div>';
        console.error("Error loading planes:", err);
      }
    }

    // ---- Bancard iframe loading spinner helpers ----
    function showBancardLoading() {
      const spinner = document.getElementById("bancard-loading") as HTMLElement | null;
      const iframeDiv = document.getElementById("bancard-iframe") as HTMLElement | null;
      if (spinner) spinner.style.display = "block";
      if (iframeDiv) iframeDiv.style.display = "none";
    }

    function hideBancardLoading() {
      const spinner = document.getElementById("bancard-loading") as HTMLElement | null;
      const iframeDiv = document.getElementById("bancard-iframe") as HTMLElement | null;
      if (spinner) spinner.style.display = "none";
      if (iframeDiv) iframeDiv.style.display = "";
    }

    /**
     * Handler para la respuesta del iframe de Bancard.
     * Bancard SDK llama a este callback en lugar de hacer window.location.replace().
     * El objeto data contiene: { status, description, ... }
     */
    let _bancardResponseHandled = false;

    function preventUnload(e: BeforeUnloadEvent) {
      e.preventDefault();
    }

    function updateBeforeUnload() {
      if (_modalLocked || _modalDirty) {
        window.addEventListener("beforeunload", preventUnload);
      } else {
        window.removeEventListener("beforeunload", preventUnload);
      }
    }

    function lockModal() {
      _modalLocked = true;
      closeBtn.style.display = "none";
      updateBeforeUnload();
    }

    function unlockModal() {
      _modalLocked = false;
      closeBtn.style.display = "";
      updateBeforeUnload();
    }

    function handleBancardResponse(data: any) {
      console.log("[Bancard responseHandler] data:", JSON.stringify(data));
      if (_bancardResponseHandled) {
        console.warn("[Bancard responseHandler] duplicate call ignored");
        return;
      }
      _bancardResponseHandled = true;

      const status = data?.message || data?.status || data?.Status || "";
      const description = data?.details || data?.description || data?.Description || "";

      if (status === "add_new_card_success") {
        // Tarjeta catastrada exitosamente — confirmar y cobrar
        lockModal();
        const storedClienteId = sessionStorage.getItem("formulang_idCliente");
        const storedIdRegistroPendiente = sessionStorage.getItem("formulang_idRegistroPendiente");
        const storedIdMembresiaActivar = sessionStorage.getItem("formulang_idMembresiaActivar");
        const storedIdsMembresiasActivarRaw = sessionStorage.getItem("formulang_idsMembresiasActivar");
        let storedIdsMembresiasActivar: string[] = [];
        try {
          storedIdsMembresiasActivar = storedIdsMembresiasActivarRaw
            ? (JSON.parse(storedIdsMembresiasActivarRaw) as string[])
            : [];
        } catch { storedIdsMembresiasActivar = []; }

        if (!storedClienteId) {
          showResult("Error", "No se encontró el cliente. Intentá de nuevo.", true);
          return;
        }

        bancardContainer.style.display = "none";
        showProcessing();

        const confirmPayload: Record<string, any> = { idCliente: storedClienteId, acceptTerminos: true };
        if (storedIdRegistroPendiente) confirmPayload.idRegistroPendiente = storedIdRegistroPendiente;
        if (storedIdsMembresiasActivar.length > 0) confirmPayload.idsMembresiasActivar = storedIdsMembresiasActivar;
        else if (storedIdMembresiaActivar) confirmPayload.idMembresiaActivar = storedIdMembresiaActivar;

        fetch("/api/confirmar", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(confirmPayload),
        })
          .then(async (res) => {
            if (!res.ok) {
              const body = await res.json().catch(() => ({}));
              const errMsg = body.error || body.message || "El cobro fue rechazado.";
              showResult(
                "Cobro rechazado",
                `Tu tarjeta fue registrada correctamente, pero el cobro de Gs. 200.000 fue rechazado (${errMsg}). ` +
                `El sistema reintentará automáticamente en las próximas horas.`,
                true,
              );

              unlockModal();

              // Botón "Reintentar cobro"
              const retryPayBtn = document.createElement("button");
              retryPayBtn.type = "button";
              retryPayBtn.className = "btn-next";
              retryPayBtn.style.marginTop = "1rem";
              retryPayBtn.textContent = "Reintentar cobro";
              retryPayBtn.addEventListener("click", () => {
                retryPayBtn.disabled = true;
                retryPayBtn.textContent = "Procesando...";
                fetch("/api/confirmar", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify(confirmPayload),
                })
                  .then(async (r) => {
                    if (!r.ok) {
                      const b = await r.json().catch(() => ({}));
                      const msg = b.error || b.message || "Cobro rechazado nuevamente.";
                      showResult("Cobro rechazado", `${msg} El sistema reintentará automáticamente.`, true);
                      // Re-agregar botones
                      successDiv.appendChild(retryPayBtn);
                      successDiv.appendChild(newCardBtn);
                      retryPayBtn.disabled = false;
                      retryPayBtn.textContent = "Reintentar cobro";
                      return;
                    }
                    const retryBody = await r.json().catch(() => ({}));
                    showResult(
                      "Plan activado",
                      `El cobro se realizó exitosamente. Tu ${currentPlanMeta().name} quedó activo.`,
                    );
                    addReceiptButton(retryBody.comprobante);
                    if (typeof (window as any).fbq === "function") {
                      const _pm = currentPlanMeta();
                      (window as any).fbq("track", "Purchase", {
                        value: Number(_pm.price.replace(/\./g, "")),
                        currency: "PYG",
                        content_name: `${_pm.name} - Débito Automático`,
                        content_type: "product",
                      });
                    }
                    sessionStorage.removeItem("formulang_idCliente");
                    sessionStorage.removeItem("formulang_idRegistroPendiente");
                    sessionStorage.removeItem("formulang_idMembresiaActivar");
      sessionStorage.removeItem("formulang_idsMembresiasActivar");
                  })
                  .catch(() => {
                    retryPayBtn.disabled = false;
                    retryPayBtn.textContent = "Reintentar cobro";
                    showResult("Error de conexión", "No se pudo procesar. Intentá de nuevo.", true);
                    successDiv.appendChild(retryPayBtn);
                    successDiv.appendChild(newCardBtn);
                  });
              });
              successDiv.appendChild(retryPayBtn);

              // Botón "Intentar con otra tarjeta"
              const newCardBtn = document.createElement("button");
              newCardBtn.type = "button";
              newCardBtn.className = "btn-next";
              newCardBtn.style.cssText = "margin-top:1rem;display:block;width:100%;";
              newCardBtn.textContent = "Intentar con otra tarjeta";
              newCardBtn.addEventListener("click", () => {
                if (newCardBtn.disabled) return;
                newCardBtn.disabled = true;
                startRetryCheckout(storedClienteId);
              });
              successDiv.appendChild(newCardBtn);

              // Botón "Probar con método alternativo"
              successDiv.appendChild(createAltMethodBtn(storedClienteId));

              return;
            }
            // Éxito
            unlockModal();
            const successBody = await res.json().catch(() => ({}));
            showResult(
              "Plan activado",
              `Tu tarjeta fue registrada exitosamente. Tu ${currentPlanMeta().name} quedó activo y los débitos automáticos mensuales están habilitados.`,
            );
            addReceiptButton(successBody.comprobante);
            if (typeof (window as any).fbq === "function") {
              const _pm = currentPlanMeta();
              (window as any).fbq("track", "Purchase", {
                value: Number(_pm.price.replace(/\./g, "")),
                currency: "PYG",
                content_name: `${_pm.name} - Débito Automático`,
                content_type: "product",
              });
            }
            sessionStorage.removeItem("formulang_idCliente");
            sessionStorage.removeItem("formulang_idRegistroPendiente");
            sessionStorage.removeItem("formulang_idMembresiaActivar");
      sessionStorage.removeItem("formulang_idsMembresiasActivar");
          })
          .catch(() => {
            unlockModal();
            showResult(
              "Error de conexión",
              "Tu tarjeta fue registrada pero no pudimos confirmar el cobro. El sistema reintentará automáticamente en las próximas horas.",
              true,
            );
            const retryCatchBtn = document.createElement("button");
            retryCatchBtn.type = "button";
            retryCatchBtn.className = "btn-next";
            retryCatchBtn.style.marginTop = "1rem";
            retryCatchBtn.textContent = "Reintentar cobro";
            retryCatchBtn.addEventListener("click", () => {
              retryCatchBtn.disabled = true;
              retryCatchBtn.textContent = "Procesando...";
              fetch("/api/confirmar", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(confirmPayload),
              })
                .then(async (r) => {
                  if (!r.ok) {
                    const b = await r.json().catch(() => ({}));
                    showResult("Cobro rechazado", b.error || b.message || "No se pudo cobrar.", true);
                    successDiv.appendChild(retryCatchBtn);
                    retryCatchBtn.disabled = false;
                    retryCatchBtn.textContent = "Reintentar cobro";
                    return;
                  }
                  const catchRetryBody = await r.json().catch(() => ({}));
                  showResult("Plan activado", `El cobro se realizó exitosamente. Tu ${currentPlanMeta().name} quedó activo.`);
                  addReceiptButton(catchRetryBody.comprobante);
                  sessionStorage.removeItem("formulang_idCliente");
                  sessionStorage.removeItem("formulang_idRegistroPendiente");
                  sessionStorage.removeItem("formulang_idMembresiaActivar");
      sessionStorage.removeItem("formulang_idsMembresiasActivar");
                })
                .catch(() => {
                  retryCatchBtn.disabled = false;
                  retryCatchBtn.textContent = "Reintentar cobro";
                });
            });
            successDiv.appendChild(retryCatchBtn);
          });
      } else {
        // Error en catastro
        bancardContainer.style.display = "none";
        const storedClienteId = sessionStorage.getItem("formulang_idCliente");

        const renderError = (msg: string) => {
          const currentMethod = (document.getElementById("metodoPago") as HTMLInputElement | null)?.value || "upay";
          const currentLabel  = currentMethod === "bancard" ? "Bancard" : "Upay";
          if (storedClienteId) {
            showResult(
              `Rechazo de ${currentLabel}`,
              `${msg} Podés reintentar con otra tarjeta o probar con el método alternativo.`,
              true,
            );
            const retryBtn = document.createElement("button");
            retryBtn.type = "button";
            retryBtn.style.cssText =
              "margin-top:1rem;padding:0.6rem 1.4rem;background:#f9a606;border:none;border-radius:8px;" +
              "color:#111;font-weight:700;cursor:pointer;font-size:0.95rem;display:block;width:100%;";
            retryBtn.textContent = "Reintentar con otra tarjeta";
            retryBtn.addEventListener("click", () => {
              if (retryBtn.disabled) return;
              retryBtn.disabled = true;
              startRetryCheckout(storedClienteId);
            });
            successDiv.appendChild(retryBtn);
            successDiv.appendChild(createAltMethodBtn(storedClienteId));
          } else {
            showResult("Error al registrar tarjeta", msg, true);
          }
        };

        if (description) {
          // El SDK ya entregó un motivo legible: usarlo directo.
          renderError(description);
        } else if (storedClienteId) {
          // El SDK no entregó description; preguntar al backend el motivo real.
          showProcessing();
          fetch("/api/consultar-rechazo", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ idCliente: storedClienteId }),
          })
            .then(async (r) => {
              const body = await r.json().catch(() => ({}));
              const motivo = (r.ok && body?.motivo) || body?.error || "No se pudo registrar la tarjeta.";
              renderError(motivo);
            })
            .catch(() => {
              renderError("No se pudo registrar la tarjeta.");
            });
        } else {
          renderError("No se pudo registrar la tarjeta.");
        }
      }
    }

    /**
     * Shows the red loading spinner and hides #bancard-iframe while Bancard SDK
     * loads. Uses MutationObserver to detect the injected <iframe>, then waits
     * for its load event (or a 15 s fallback). Guarantees the spinner is visible
     * for at least 400 ms so the browser has time to paint it.
     */
    function waitForBancardIframe() {
      showBancardLoading();
      const container = document.getElementById("bancard-iframe") as HTMLElement;
      if (!container) return;

      const shownAt = Date.now();
      const MIN_VISIBLE_MS = 400;

      function done() {
        const elapsed = Date.now() - shownAt;
        const delay = Math.max(0, MIN_VISIBLE_MS - elapsed);
        setTimeout(hideBancardLoading, delay);
      }

      const fallbackTimer = setTimeout(done, 15000);

      function forceIframeHeight(iframe: HTMLIFrameElement) {
        iframe.style.setProperty("height", "480px", "important");
        iframe.style.setProperty("min-height", "480px", "important");
        iframe.setAttribute("height", "480");
        iframe.scrollTop = 0;
      }

      const observer = new MutationObserver(() => {
        const iframe = container.querySelector("iframe");
        if (!iframe) return;
        observer.disconnect();
        forceIframeHeight(iframe);

        // Cross-origin iframes still fire the load event even if contentDocument is inaccessible.
        iframe.addEventListener("load", () => {
          forceIframeHeight(iframe);
          clearTimeout(fallbackTimer);
          done();
        }, { once: true });
      });

      observer.observe(container, { childList: true, subtree: true });
    }

    // Crea el botón "Probar con [método alternativo]" para el caso de rechazo.
    // Cambia el hidden `metodoPago` al método opuesto y relanza el checkout.
    function createAltMethodBtn(storedClienteId: string): HTMLButtonElement {
      const currentMethod = (document.getElementById("metodoPago") as HTMLInputElement | null)?.value || "upay";
      const altMethod = currentMethod === "bancard" ? "upay" : "bancard";
      const altLabel  = altMethod === "bancard" ? "Bancard (débito/crédito)" : "Upay (Visa / Mastercard)";

      const btn = document.createElement("button");
      btn.type = "button";
      btn.style.cssText =
        "margin-top:0.5rem;padding:0.6rem 1.4rem;background:#2d5be3;border:none;border-radius:8px;" +
        "color:#fff;font-weight:700;cursor:pointer;font-size:0.95rem;display:block;width:100%;";
      btn.textContent = `Probar con ${altLabel}`;
      btn.addEventListener("click", () => {
        if (btn.disabled) return;
        btn.disabled = true;
        const hidden = document.getElementById("metodoPago") as HTMLInputElement | null;
        if (hidden) hidden.value = altMethod;
        startRetryCheckout(storedClienteId);
      });
      return btn;
    }


    // ---- Retry checkout with another card (same idCliente + idRegistroPendiente) ----
    // Guard contra disparos múltiples: cada llamada a /api/checkout genera un nuevo
    // process_id en Pagopar e invalida el anterior. Doble-click o re-renders crearían
    // process_ids huérfanos que rompen el iframe ya abierto con "ID form no válido".
    let _checkoutInFlight = false;
    async function startRetryCheckout(idCliente: string, metodoPago: string = "upay") {
      if (_checkoutInFlight) return;
      _checkoutInFlight = true;
      _bancardResponseHandled = false; // reset para nuevo intento
      // Remove old retry buttons and reset to iframe state
      successDiv.querySelectorAll("#btn-download-receipt").forEach(b => b.remove());
      successDiv.style.display = "none";
      bancardContainer.style.display = "none";
      // Mostrar paso 3 en el stepper (registro de tarjeta = último paso)
      goToStep(3);

      try {
        const _retryCbUrl = new URL(`${window.location.origin}/api/callback`);
        _retryCbUrl.searchParams.set("idCliente", idCliente);

        const _retryMetodoPago = metodoPago;
        const checkoutRes = await fetchWithTimeout("/api/checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            idCliente,
            diaDebito: new Date().getDate(),
            urlRedirect: _retryCbUrl.toString(),
            metodoPago: _retryMetodoPago,
          }),
        }, 30000);

        const checkoutBody = await checkoutRes.json().catch(() => ({}));
        if (!checkoutRes.ok || !checkoutBody.processId) {
          console.error("[startRetryCheckout] Error:", checkoutRes.status, checkoutBody);
          showResult("Error", `No pudimos iniciar el proceso de pago (${checkoutBody?.error || checkoutRes.status}). Intentá de nuevo más tarde.`, true);
          return;
        }

        bancardContainer.style.display = "block";

        (document.querySelector(".modal-container") as HTMLElement | null)?.scrollTo({ top: 0 });
        const iframeDiv = document.getElementById("bancard-iframe") as HTMLElement;
        if (iframeDiv) iframeDiv.innerHTML = "";

        const retryProveedor: "Bancard" | "uPay" = checkoutBody.proveedor === "Bancard" ? "Bancard" : "uPay";

        if (retryProveedor === "uPay") {
          const upayIframe = document.createElement("iframe");
          upayIframe.src = `https://www.pagopar.com/upay-iframe/?id-form=${encodeURIComponent(checkoutBody.processId)}`;
          upayIframe.style.cssText = "width:100%;height:520px;border:0;display:block;";
            upayIframe.allow = "payment";
          upayIframe.addEventListener("load", () => {
            try {
              const href = upayIframe.contentWindow?.location.href ?? "";
              if (!href.startsWith(window.location.origin)) return;
              const qs = new URL(href).searchParams;
              const status = qs.get("status") || qs.get("checkout") || "";
              const description = qs.get("description") || qs.get("checkout_msg") || "";
              if (!_bancardResponseHandled) {
                handleBancardResponse({
                  status: status.includes("success") || status === "ok" ? "add_new_card_success" : "add_new_card_fail",
                  description,
                });
              }
            } catch { /* cross-origin: ignorar */ }
          });
          if (iframeDiv) iframeDiv.appendChild(upayIframe);
        } else {
          if (!(window as any).Bancard) {
            await new Promise<void>((resolve, reject) => {
              const script = document.createElement("script");
              script.src = "/bancard-checkout-5.0.1.js";
              script.onload = () => resolve();
              script.onerror = () => reject(new Error("Error al cargar Bancard SDK"));
              document.head.appendChild(script);
            });
          }
          waitForBancardIframe();
          (window as any).Bancard.Cards.createForm("bancard-iframe", checkoutBody.processId, {
            responseHandler: handleBancardResponse,
            styles: BANCARD_DARK_STYLES,
          });
        }
      } catch (err: any) {
        showResult("Error", err.message || "Error al intentar de nuevo.", true);
      } finally {
        _checkoutInFlight = false;
      }
    }

    // ---- Turnstile helpers ----
    async function ensureFreshTurnstileToken(timeoutMs = 20000): Promise<string | null> {
      const field = form.querySelector("[name='cf-turnstile-response']") as HTMLInputElement | null;
      const currentVal = field?.value || _tsTokenValue;
      if (currentVal) {
        _tsTokenReady = true;
        _tsTokenValue = currentVal;
        return currentVal;
      }

      const cfWidget = document.querySelector(".cf-turnstile") as HTMLElement | null;
      if (cfWidget && window.turnstile) {
        try {
          window.turnstile.reset(cfWidget);
        } catch { /* ignorar si el widget no está listo */ }
      }

      return new Promise<string | null>((resolve) => {
        let resolved = false;

        const timer = setTimeout(() => {
          if (resolved) return;
          resolved = true;
          _tsPendingResolves = _tsPendingResolves.filter((r) => r !== resolver);
          resolve(null);
        }, timeoutMs);

        const resolver = () => {
          if (resolved) return;
          resolved = true;
          clearTimeout(timer);
          resolve(_tsTokenValue || null);
        };

        _tsPendingResolves.push(resolver);
      });
    }

    function showTurnstileSubmitError(msg: string) {
      const el = document.getElementById("turnstile-submit-error");
      if (!el) return;
      el.textContent = msg;
      el.style.display = "block";
      el.scrollIntoView({ behavior: "smooth", block: "center" });
    }

    function clearTurnstileSubmitError() {
      const el = document.getElementById("turnstile-submit-error");
      if (!el) return;
      el.textContent = "";
      el.style.display = "none";
    }

    // ---- CI lookup ----
    const rucInput = document.getElementById("ruc") as HTMLInputElement;

    async function dispararLookupCI(ci: string) {
      // Guardia anti race-condition: no relanzar si ya está en curso o para el mismo CI
      if (lookupInProgress || ci === lastLookedUpCI) return;
      lookupInProgress = true;
      lastLookedUpCI = ci;

      // Mostrar loading, ocultar campos mientras busca
      const loadingEl = document.getElementById("ci-lookup-loading") as HTMLElement | null;
      if (loadingEl) loadingEl.style.display = "";

      // Clear previous lookup state
      document.getElementById("rp-resume-banner")?.remove();
      document.getElementById("rp-opciones-panel")?.remove();
      document.getElementById("rp-info-banner")?.remove();
      sessionStorage.removeItem("formulang_idCliente");
      sessionStorage.removeItem("formulang_idRegistroPendiente");
      sessionStorage.removeItem("formulang_idMembresiaActivar");
      sessionStorage.removeItem("formulang_idsMembresiasActivar");
      sessionStorage.removeItem("formulang_idVehiculo");
      modoNuevoVehiculo = false;
      modoActualizarVehiculo = false;

      try {
        const res = await fetchWithTimeout(
          `/api/registro-pendiente?ci=${encodeURIComponent(ci)}`,
          {},
          12000,
        );
        if (!res.ok) {
          // Error de red/servidor → revelar campos igual para no bloquear al usuario
          revelarCamposPersonales();
          return;
        }
        const data = await res.json().catch(() => null);
        if (!data?.found) {
          // CI no registrada → cliente nuevo, revelar campos vacíos
          revelarCamposPersonales();
          return;
        }

        // Identidad verificada (cliente existente) — alert success
        const rucSuccess = document.getElementById("ruc-success") as HTMLElement | null;
        if (rucSuccess) rucSuccess.style.display = "flex";
        const loadingEl0 = document.getElementById("ci-lookup-loading") as HTMLElement | null;
        if (loadingEl0) loadingEl0.style.display = "none";

        // Helper to set a field value by id
        const setVal = (id: string, val: string | number | null | undefined) => {
          const el = document.getElementById(id) as HTMLInputElement | null;
          if (el && val != null && val !== "") el.value = String(val);
        };

        const step1El = rucInput.closest(".form-step");

        // ---- Scenario A: has pending registration ----
        if (data.registroPendiente) {
          const rp = data.registroPendiente;

          // Pre-fill step 1
          setVal("nombre", data.nombre);
          setVal("telefono", data.telefono);
          setVal("email", data.email);

          // Pre-fill step 2
          setVal("chapa", rp.chapa ? String(rp.chapa).toUpperCase() : null);
          if (rp.anio) setVal("anio", rp.anio);
          setVal("color", rp.color);
          if (rp.idTipoVehiculo) {
            const tipoSel = document.getElementById("tipoVehiculo") as HTMLSelectElement | null;
            if (tipoSel) tipoSel.value = String(rp.idTipoVehiculo);
          }
          if (rp.idMarca) {
            const marcaSel = document.getElementById("idMarca") as HTMLSelectElement | null;
            if (marcaSel) {
              marcaSel.value = String(rp.idMarca);
              marcaSel.dispatchEvent(new Event("change"));
              if (rp.idModelo) setTimeout(() => setVal("idModelo", rp.idModelo), 800);
            }
          }
          if (rp.idPlan) {
            setVal("idPlan", rp.idPlan);
            const planCard = document.querySelector(`[data-plan-id="${rp.idPlan}"]`);
            if (planCard) {
              document.querySelectorAll(".plan-card").forEach(c => c.classList.remove("selected"));
              planCard.classList.add("selected");
            }
          }

          sessionStorage.setItem("formulang_idCliente", data.idCliente);
          sessionStorage.setItem("formulang_idRegistroPendiente", rp.idRegistroPendiente);

          const nombreCensurado = censurar(data.nombre, 4);
          const emailCensurado = censurarEmail(data.email);
          const banner = document.createElement("div");
          banner.id = "rp-resume-banner";
          banner.style.cssText = "margin-top:1rem;padding:0.85rem 1rem;background:rgba(249,166,6,0.12);border:1px solid rgba(249,166,6,0.35);border-radius:10px;font-size:0.85rem;color:#f9a606;";
          banner.innerHTML = `<strong>Encontramos tu registro: ${nombreCensurado}, ${emailCensurado}</strong><br/>Tus datos fueron completados automáticamente. Revisalos y continuá al pago.`;
          step1El?.appendChild(banner);
          revelarCamposPersonales();
          return;
        }

        // ---- Scenario B: existing membership(s), no pending registration ----
        if (data.membresias && data.membresias.length > 0) {
