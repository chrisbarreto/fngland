---
// This component renders a full-screen registration modal.
// All logic is client-side JavaScript (no framework needed).
const siteKey = import.meta.env.TURNSTILE_SITE_KEY;
// El selector queda habilitado por defecto; puede desactivarse explícitamente.
const providerSelectorEnabled =
  import.meta.env.PUBLIC_PAGOPAR_PROVIDER_SELECTOR_ENABLED !== "false";
---

<!-- Registration Modal -->
<div
  id="registro-modal"
  class="modal-overlay"
  style="display:none;"
  data-provider-selector-enabled={String(providerSelectorEnabled)}
>
  <div class="modal-container modal">
    <!-- Overlay de procesamiento -->
    <div id="processing-overlay" class="processing-overlay" style="display:none;">
      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#2d5be3" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="processing-spinner"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
      <p class="processing-text">Procesando pago...</p>
      <p class="processing-subtext">Esperá un momento, no cierres esta ventana.</p>
    </div>

    <!-- HEADER -->
    <div class="modal-header">
      <button id="modal-close" class="modal-close close-btn" aria-label="Cerrar">&times;</button>
      <div class="gold-badge" id="modal-plan-badge">Plan</div>
      <h2 class="modal-title">Activá tu <span id="modal-plan-name">plan</span></h2>
      <p class="modal-subtitle">Completá tus datos, registrá tu tarjeta y activá tu membresía de <strong><span id="modal-plan-price">—</span></strong> por mes.</p>

      <!-- STEPPER -->
      <div class="stepper" id="stepper">
        <div class="step-item active" data-step-item="1">
          <div class="step-dot" data-step="1"><span>1</span></div>
          <span class="step-label" data-step="1">Tus datos</span>
        </div>
        <div class="step-item" data-step-item="2">
          <div class="step-dot" data-step="2"><span>2</span></div>
          <span class="step-label" data-step="2">Tu vehículo</span>
        </div>
        <div class="step-item" data-step-item="3">
          <div class="step-dot" data-step="3"><span>3</span></div>
          <span class="step-label" data-step="3">Plan y pago</span>
        </div>
      </div>
    </div>

    <!-- BODY -->
    <div class="modal-body">
      <form id="registro-form" novalidate>
        <!-- Step 1: Personal Data -->
        <div class="form-step active" data-step="1">
          <p class="step-body-title">Tus datos personales</p>
          <p class="step-body-sub">Ingresá tu RUC o CI para verificar tu identidad.</p>

          <div class="form-group full">
            <label for="ruc">RUC / CI <span class="required req">*</span></label>
            <div class="input-btn-row">
              <input type="text" id="ruc" name="ruc" required placeholder="Ej: 1234567-8" maxlength="20" />
              <button type="button" id="btn-confirmar-ci" class="btn-confirm">Confirmar</button>
            </div>
            <span class="field-error"></span>
          </div>

          <!-- Alert: identidad verificada (se muestra al recibir lookup OK) -->
          <div class="alert alert-success" id="ruc-success" style="display:none;">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="10" fill="#22c55e"/><path d="M6 10l3 3 5-5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>¡Operación exitosa! Identidad verificada.</span>
          </div>

          <!-- Turnstile captcha — validar antes de consultar CI -->
          <div class="form-group full" id="turnstile-step1">
            <div class="turnstile-wrapper">
              <div
                class="cf-turnstile"
                data-sitekey={siteKey}
                data-theme="dark"
                data-refresh-expired="auto"
                data-callback="__tsOnSuccess"
                data-expired-callback="__tsOnExpired"
                data-error-callback="__tsOnError"
              ></div>
            </div>
            <span class="field-error" id="turnstile-error"></span>
          </div>

          <!-- Loading indicator mientras se busca el CI -->
          <div class="form-group full" id="ci-lookup-loading" style="display:none;">
            <div class="ci-lookup-row">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ci-spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
              Buscando tu registro...
            </div>
          </div>

          <!-- Campos personales — ocultos hasta resolver el lookup -->
          <div class="form-group full personal-field" style="display:none;">
            <label for="nombre">Nombre completo <span class="required req">*</span></label>
            <input type="text" id="nombre" name="nombre" required placeholder="Tu nombre completo" maxlength="200" />
            <span class="field-error"></span>
          </div>
          <div class="form-row personal-field" style="display:none;">
            <div class="form-group">
              <label for="telefono">Teléfono / WhatsApp <span class="required req">*</span></label>
              <input type="tel" id="telefono" name="telefono" required placeholder="09XXXXXXXX" maxlength="20" minlength="10" inputmode="numeric" pattern="[0-9]*" />
              <span class="field-error"></span>
            </div>
            <div class="form-group">
              <label for="email">Email <span class="required req">*</span></label>
              <input type="email" id="email" name="email" required placeholder="tu@email.com" />
              <span class="field-error"></span>
            </div>
          </div>

          <!-- Acción oculta hasta resolver el lookup -->
          <div class="form-actions" id="step1-actions" style="display:none;">
            <button type="button" class="btn-primary btn-next" data-next="2">Siguiente</button>
          </div>
        </div>

        <!-- Step 2: Vehicle Data -->
        <div class="form-step" data-step="2">
          <p class="step-body-title">Tu vehículo</p>
          <p class="step-body-sub">Registrá el vehículo que querés asegurar con el plan.</p>

          <div class="form-row">
            <div class="form-group">
              <label for="chapa">Chapa / Matrícula <span class="required req">*</span></label>
              <input type="text" id="chapa" name="chapa" required placeholder="Ej: ABCD123" maxlength="15" minlength="3" pattern="[A-Za-z0-9]+" class="uppercase" />
              <span class="field-error"></span>
            </div>
            <div class="form-group">
              <label for="anio">Año</label>
              <input type="number" id="anio" name="anio" placeholder="Ej: 2024" min="1900" max="2100" />
              <span class="field-error"></span>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="idMarca">Marca</label>
              <select id="idMarca" name="idMarca">
                <option value="">Seleccionar marca...</option>
              </select>
              <span class="field-error"></span>
            </div>
            <div class="form-group">
              <label for="idModelo">Modelo</label>
              <select id="idModelo" name="idModelo" disabled>
                <option value="">Primero seleccioná la marca</option>
              </select>
              <span class="field-error"></span>
            </div>
          </div>

          <div class="form-row" id="otros-row" style="display:none;">
            <div class="form-group" id="marcaNueva-group" style="display:none;">
              <label for="marcaNueva">Especificá la marca</label>
              <input type="text" id="marcaNueva" name="marcaNueva" placeholder="Ej: BYD" maxlength="80" />
              <span class="field-error"></span>
            </div>
            <div class="form-group" id="modeloNuevo-group" style="display:none;">
              <label for="modeloNuevo">Especificá el modelo</label>
              <input type="text" id="modeloNuevo" name="modeloNuevo" placeholder="Ej: Dolphin" maxlength="80" />
              <span class="field-error"></span>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="color">Color</label>
              <input type="text" id="color" name="color" placeholder="Ej: Blanco" maxlength="50" />
              <span class="field-error"></span>
            </div>
            <div class="form-group">
              <label for="tipoVehiculo">Tipo</label>
              <select id="tipoVehiculo" name="tipoVehiculo">
                <option value="">Seleccionar...</option>
                <option value="1">Auto</option>
                <option value="2">Camioneta</option>
                <option value="3">SUV</option>
                <option value="4">Moto</option>
                <option value="5">Doble Cabina</option>
              </select>
              <span class="field-error"></span>
            </div>
          </div>
        </div>

        <!-- Step 3: Plan Selection + Payment -->
        <div class="form-step" data-step="3">
          <p class="step-body-title">Plan y pago</p>
          <p class="step-body-sub">Confirmá tu plan para continuar con el débito automático.</p>

          <div id="planes-container" class="planes-grid">
            <div class="planes-loading">Cargando planes...</div>
          </div>
          <input type="hidden" id="idPlan" name="idPlan" />

          {providerSelectorEnabled && (
            <!-- El selector puede reactivarse con PUBLIC_PAGOPAR_PROVIDER_SELECTOR_ENABLED=true. -->
            <div class="pay-toggle" id="pay-toggle" role="tablist" aria-label="Método de pago">
              <button type="button" class="pay-btn" data-method="bancard" id="pay-bancard" role="tab" aria-selected="false">
                <span class="method-label">
                  <span class="method-title">Bancard</span>
                  <span class="method-sub">Pago alternativo</span>
                </span>
              </button>
              <button type="button" class="pay-btn active" data-method="upay" id="pay-upay" role="tab" aria-selected="true">
                <span class="method-label">
                  <span class="method-title">Upay
                    <span class="visa-badge">VISA</span><span class="mc-badge"></span>
                  </span>
                  <span class="method-sub">Visa / Mastercard</span>
                </span>
              </button>
            </div>
          )}
          <input type="hidden" id="metodoPago" name="metodoPago" value="upay" />
          <p id="metodo-pago-hint" style="margin:0 0 16px;font-size:12px;color:var(--text-secondary);text-align:center;">
            Se abrirá el formulario de <strong id="metodo-pago-hint-nombre" style="color:var(--text-primary);">Pagopar / Upay</strong> para registrar tu tarjeta.
          </p>

          <!-- Security badges -->
          <div class="security-row">
            <div class="sec-badge">
              <div class="sec-icon">
                <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
                  <rect x="1" y="1" width="20" height="20" rx="4" fill="#0d1526" stroke="#2d5be3" stroke-width="1.5"/>
                  <text x="11" y="9.5" font-family="Arial" font-size="5" font-weight="900" fill="#2d5be3" text-anchor="middle">PCI</text>
                  <text x="11" y="15" font-family="Arial" font-size="4" font-weight="700" fill="#8b9bbf" text-anchor="middle">DSS</text>
                </svg>
              </div>
              PCI DSS
            </div>
            <div class="sec-badge">
              <div class="sec-icon">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                  <circle cx="10" cy="10" r="9" stroke="#22c55e" stroke-width="1.5" fill="none"/>
                  <path d="M6.5 10.2l2.5 2.5 4.5-4.5" stroke="#22c55e" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              Pago Seguro
            </div>
            <div class="sec-badge">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <rect width="14" height="14" rx="3" fill="#1a3a8f"/>
                <rect x="1" y="4" width="12" height="2.5" fill="#2d5be3"/>
              </svg>
              uPay
            </div>
          </div>

          <!-- Turnstile refresh — aparece solo cuando el token venció al intentar pagar -->
          <div id="ts-refresh-box" style="display:none; margin:16px 0 8px;">
            <p class="ts-refresh-msg">Por seguridad, completá esta verificación final antes de continuar.</p>
            <div class="turnstile-wrapper" style="justify-content:center;">
              <div id="ts-step3-widget"></div>
            </div>
          </div>

          <!-- Aceptación legal -->
          <div class="legal-accept-wrapper">
            <label class="legal-accept-label checkbox-row">
              <input type="checkbox" id="acceptLegal" name="acceptLegal" />
              <span>
                Acepto los
                <a href="/terminos-y-condiciones" target="_blank" rel="noopener noreferrer">Términos y Condiciones</a>,
                <a href="/politica-de-privacidad" target="_blank" rel="noopener noreferrer">Política de Privacidad</a>
                y la <a href="/debito-automatico" target="_blank" rel="noopener noreferrer">autorización de débito automático</a>.
              </span>
            </label>
            <span class="field-error" id="legal-accept-error"></span>
          </div>
        </div>

        <!-- Mensajes informativos (van ANTES del footer sticky en mobile
             para que no queden tapados por el botón "Pagar Ahora"). -->
        <span class="field-error" id="turnstile-submit-error" style="display:none; text-align:center; margin-top:8px;"></span>

        <p class="secure-note" id="secure-note">
          <svg width="12" height="14" viewBox="0 0 12 14" fill="none">
            <rect x="1" y="5" width="10" height="8" rx="2" fill="none" stroke="#4e6088" stroke-width="1.3"/>
            <path d="M3.5 5V3.5a2.5 2.5 0 015 0V5" stroke="#4e6088" stroke-width="1.3" stroke-linecap="round"/>
            <circle cx="6" cy="9.5" r="1" fill="#4e6088"/>
          </svg>
          Conexión segura · Datos procesados por Pagopar / Upay
        </p>

        <!-- FOOTER ACTIONS — fuera de los pasos, dinámico según step.
             En mobile se vuelve sticky bottom para que el botón "Pagar Ahora"
             siempre esté visible sin que el cliente tenga que hacer scroll. -->
        <div class="form-actions form-actions-footer" id="form-actions-footer" style="display:none;">
          <button type="button" class="btn-back btn-prev" id="btn-prev-footer" data-prev="1">← Atrás</button>
          <button type="button" class="btn-primary btn-next" id="btn-next-footer" data-next="2">Siguiente</button>
          <button type="submit" class="btn-primary btn-submit" id="btn-submit" style="display:none;">
            <span class="btn-submit-text">Pagar Ahora</span>
            <span class="btn-submit-loading" style="display:none;">Procesando...</span>
          </button>
        </div>
      </form>

      <!-- Success state -->
      <div id="registro-success" class="success-message" style="display:none;">
        <div class="success-icon">&#10003;</div>
        <h3>Plan activado</h3>
        <p>Tu membresía quedó activa correctamente. Ya podés disfrutar de tus beneficios y agendar tus servicios.</p>
        <button type="button" class="btn-primary btn-receipt-green" id="btn-download-receipt" style="display:none;">Descargar comprobante</button>
      </div>

      <!-- Bancard / Upay Checkout iframe container -->
      <div id="bancard-checkout-container" style="display:none;">
        <div class="checkout-header">
          <h3>Registrá tu tarjeta de pago</h3>
          <p id="checkout-plan-info">Ingresá los datos de tu tarjeta para habilitar el débito automático y activar tu membresía.</p>
        </div>
        <div id="bancard-loading" style="display:none;text-align:center;padding:3rem 0;">
          <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#2d5be3" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ci-spin" style="display:inline-block;"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
          <p class="bancard-loading-text">Cargando formulario de pago seguro…</p>
        </div>
        <div id="bancard-iframe"></div>
        <p class="checkout-secure-note">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          Conexión segura. Tus datos de tarjeta son procesados directamente por el proveedor.
        </p>
      </div>

      <!-- Error state -->
      <div id="registro-error" class="error-banner" style="display:none;">
        <span id="error-message"></span>
      </div>
    </div><!-- /modal-body -->
  </div>
</div>

<style>
  /* ── OUTFIT FONT (auto-hosted) ── */
  @font-face {
    font-family: 'Outfit';
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url('/fonts/outfit-latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Outfit';
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url('/fonts/outfit-latin-ext.woff2') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }

  /* ── DESIGN TOKENS ── */
  .modal-overlay {
    --navy-900: #0a0a0f;
    --navy-800: #111115;
    --navy-700: #18181f;
    --navy-600: #1e1e28;
    --navy-500: #22222e;
    --navy-400: #2a2a3a;
    --card-bg: #161618;
    --input-bg: #0e0e12;
    --input-border: #272730;
    --input-border-focus: #3d5a9a;
    --text-primary: #ffffff;
    --text-secondary: #8b9bbf;
    --text-muted: #4e6088;
    --accent-blue: #2d5be3;
    --accent-blue-hover: #3a6af0;
    --accent-blue-light: #1a3a8f;
    --gold: #f0b429;
    --gold-light: #ffd166;
    --success: #22c55e;
    --warning-bg: #2a2010;
    --warning-border: #5a4010;
    --warning-text: #f0b429;
    --stepper-done: #22c55e;
    --stepper-active: #2d5be3;
    --stepper-inactive: #1e2f50;
    font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
  }

  /* ── MODAL OVERLAY ── */
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(5, 10, 22, 0.85);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    animation: modalFadeIn 0.3s ease;
    overflow-y: auto;
  }

  @keyframes modalFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes modalIn {
    from { opacity: 0; transform: scale(0.94) translateY(16px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
  }
  @keyframes ci-spin {
    to { transform: rotate(360deg); }
  }
  @keyframes stepFadeIn {
    from { opacity: 0; transform: translateX(8px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  /* ── MODAL BOX ── */
  .modal-container {
    position: relative;
    width: 100%;
    max-width: 480px;
    background: var(--card-bg);
    border: 1px solid rgba(45, 91, 227, 0.18);
    border-radius: 20px;
    box-shadow:
      0 0 0 1px rgba(255,255,255,0.04),
      0 24px 64px rgba(0,0,0,0.6),
      0 0 120px rgba(45, 91, 227, 0.08);
    overflow: hidden;
    max-height: calc(100vh - 32px);
    display: flex;
    flex-direction: column;
    animation: modalIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* ── PROCESSING OVERLAY ── */
  .processing-overlay {
    position: absolute;
    inset: 0;
    z-index: 100;
    background: rgba(10, 10, 15, 0.92);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }
  .processing-spinner { animation: ci-spin 0.8s linear infinite; }
  .processing-text {
    color: var(--text-primary);
    font-size: 1.2rem;
    font-weight: 600;
    margin: 0;
  }
  .processing-subtext {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin: 0;
  }
  .ci-spin { animation: ci-spin 0.8s linear infinite; }

  /* ── HEADER ── */
  .modal-header {
    background: linear-gradient(160deg, var(--navy-700) 0%, var(--navy-800) 60%);
    padding: 32px 32px 24px;
    text-align: center;
    border-bottom: 1px solid rgba(45, 91, 227, 0.12);
    position: relative;
  }

  .modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    color: var(--text-secondary);
    font-size: 18px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    line-height: 1;
    padding: 0;
  }
  .modal-close:hover {
    background: rgba(255,255,255,0.12);
    color: white;
  }

  .gold-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: linear-gradient(135deg, rgba(240,180,41,0.18), rgba(240,180,41,0.06));
    border: 1px solid rgba(240,180,41,0.3);
    border-radius: 100px;
    padding: 4px 14px;
    font-size: 11px;
    font-weight: 700;
    color: var(--gold);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 12px;
  }
  .gold-badge::before { content: "★"; font-size: 10px; }

  .modal-title {
    font-size: 26px;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.2;
    margin: 0 0 8px;
  }
  .modal-subtitle {
    font-size: 13.5px;
    color: var(--text-secondary);
    line-height: 1.5;
    max-width: 340px;
    margin: 0 auto;
  }
  .modal-subtitle strong { color: var(--text-primary); }

  /* ── STEPPER ── */
  .stepper {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0;
