---
export const prerender = false;

import BaseLayout from "@/layouts/BaseLayout.astro";

/**
 * /tarjetas/callback — Callback del catastro de tarjeta (link estable del panel).
 *
 * Bancard/uPay redirige acá tras completar (o cancelar) el iframe. Los
 * catastros nuevos usan un state corto cuyo contexto se resuelve en el
 * backend; los parámetros extensos anteriores siguen admitidos durante la
 * transición.
 *
 * Flujo (replica de la página del panel apps/web):
 *   1. POST /api/confirmar con idMembresiaActivar = idMembresia → confirma la
 *      tarjeta y, si la membresía está vencida/desactivada, ACTIVA débito y
 *      programa el cobro (diferido 40s por antifraude del banco).
 *   2. Si cobroDiferido → "Procesando pago" + polling a /api/verificar-cobro
 *      hasta ~110s para mostrar éxito (con nueva fechaFin) o fallo del cobro.
 *   3. Si la membresía ya estaba activa → "Tarjeta registrada" (sin cobro).
 *
 * Toda la lógica corre en el cliente; los proxies /api/* mantienen la API key
 * en el servidor.
 */

const idCliente = Astro.url.searchParams.get("idCliente") ?? "";
const token = Astro.url.searchParams.get("token") ?? "";
const idMembresia = Astro.url.searchParams.get("idMembresia") ?? "";
const idCotizacion = Astro.url.searchParams.get("idCotizacion") ?? "";
const tokenVersion = Astro.url.searchParams.get("tokenVersion") ?? "";
const purpose = Astro.url.searchParams.get("purpose") ?? "";
const callbackState = Astro.url.searchParams.get("state") ?? "";
const bancardStatus = Astro.url.searchParams.get("status") ?? "";
const bancardDescription = Astro.url.searchParams.get("description") ?? "";
---

<BaseLayout
  title="Registro de tarjeta | Fórmula NG"
  description="Resultado del registro de tarjeta para débito automático."
  noindex={true}
>
  <div
    class="callback-page"
    id="cb-root"
    data-id-cliente={idCliente}
    data-token={token}
    data-id-membresia={idMembresia}
    data-id-cotizacion={idCotizacion}
    data-token-version={tokenVersion}
    data-purpose={purpose}
    data-callback-state={callbackState}
    data-status={bancardStatus}
    data-description={bancardDescription}
  >
    <div class="callback-card">
      {/* ── Confirmando ── */}
      <div id="st-confirmando" class="callback-content">
        <div class="spinner"></div>
        <h1 class="callback-title">Confirmando tarjeta…</h1>
        <p class="callback-message">
          Estamos sincronizando tu tarjeta con el sistema. No cierres esta ventana.
        </p>
      </div>

      {/* ── Esperando cobro ── */}
      <div id="st-esperando" class="callback-content" hidden>
        <div class="spinner"></div>
        <h1 class="callback-title">Procesando pago automático</h1>
        <p class="callback-message">
          Tu tarjeta fue registrada. Estamos cobrando la renovación de tu
          membresía. Esto puede tardar hasta 90 segundos.
        </p>
        <div class="progress">
          <div id="progress-bar" class="progress-bar" style="width: 0%"></div>
        </div>
        <p class="callback-hint">No cierres ni recargues esta ventana.</p>
      </div>

      {/* ── Éxito (con o sin cobro) ── */}
      <div id="st-exito" class="callback-content" hidden>
        <div class="icon-circle icon-success">
          <svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h1 id="exito-title" class="callback-title">Tarjeta registrada</h1>
        <p id="exito-message" class="callback-message"></p>

        <div id="fecha-box" class="fecha-box" hidden>
          <p class="fecha-label">Membresía activa hasta</p>
          <p id="fecha-valor" class="fecha-valor"></p>
        </div>

        <div id="comprobante" class="comprobante" hidden></div>

        <p class="callback-hint">Puedes cerrar esta ventana.</p>
      </div>

      {/* ── Cobro fallido ── */}
      <div id="st-cobro-fallido" class="callback-content" hidden>
        <div class="icon-circle icon-warning">
          <svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <h1 class="callback-title">Tarjeta registrada, pero el cobro falló</h1>
        <p class="callback-message">
          Tu tarjeta quedó registrada correctamente, pero el banco rechazó el
          cobro de la renovación.
        </p>
        <p id="cobro-fallido-msg" class="callback-error-msg" hidden></p>
        <p class="callback-hint">
          Comunicate con tu proveedor de servicio para regularizar el pago.
        </p>
      </div>

      {/* ── Error ── */}
      <div id="st-error" class="callback-content" hidden>
        <div class="icon-circle icon-error">
          <svg width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </div>
        <h1 class="callback-title">No se pudo registrar la tarjeta</h1>
        <p id="error-msg" class="callback-error-msg"></p>
        <p id="error-hint" class="callback-hint"></p>
        <div class="callback-actions">
          <a id="retry-btn" href="#" class="btn btn-primary" hidden>Intentar de nuevo</a>
        </div>
      </div>
    </div>

    <div class="callback-footer">
      <p>
        Tus datos son procesados de forma segura por el banco.
        No almacenamos información de tu tarjeta.
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  import {
    guardarContextoMembresiaV2,
    reintentarCobroMembresiaV2,
  } from "@/lib/membresias-v2";

  const root = document.getElementById("cb-root");
  if (root) {
    let idCliente = root.dataset.idCliente || "";
    let token = root.dataset.token || "";
    let idMembresia = root.dataset.idMembresia || "";
    let idCotizacion = root.dataset.idCotizacion || "";
    let tokenVersion = root.dataset.tokenVersion || "";
    let purpose = root.dataset.purpose || "";
    const callbackState = root.dataset.callbackState || "";
    const bancardStatus = root.dataset.status || "";
    const bancardDescription = root.dataset.description || "";

    const $ = (id: string) => document.getElementById(id);
    const showState = (id: string) => {
      ["st-confirmando", "st-esperando", "st-exito", "st-cobro-fallido", "st-error"].forEach(
        (s) => $(s)?.toggleAttribute("hidden", s !== id),
      );
    };

    type Comprobante = {
      cliente: { nombre: string; ci: string };
      membresia: { codigo: string; plan: string; precioMensual: number };
      vehiculo: { chapa: string; descripcion: string } | null;
      tarjeta: { numero: string; marca: string | null } | null;
      fechaProximoDebito: string | null;
    };

    function formatFecha(fechaIso: string): string {
      const d = fechaIso.includes("T") ? fechaIso.split("T")[0] : fechaIso;
      const [y, m, day] = d.split("-").map(Number);
      if (!y || !m || !day) return d;
      return new Date(y, m - 1, day).toLocaleDateString("es-PY");
    }

    function renderComprobante(c: Comprobante | null, tarjetasCount: number) {
      const box = $("comprobante");
      if (!box || !c) return;
      const rows: string[] = [];
      const row = (label: string, value: string, mono = false) =>
        `<div class="comprobante-row"><dt>${label}</dt><dd${mono ? ' class="mono"' : ""}>${value}</dd></div>`;
      rows.push(row("Cliente", c.cliente.nombre));
      rows.push(row("Membresía", c.membresia.codigo, true));
      rows.push(row("Plan", c.membresia.plan));
      if (c.vehiculo) {
        rows.push(row("Vehículo", `${c.vehiculo.descripcion} (${c.vehiculo.chapa})`));
      }
      if (c.tarjeta) {
        const marca = c.tarjeta.marca ? `${c.tarjeta.marca} · ` : "";
        rows.push(row("Tarjeta", `${marca}${c.tarjeta.numero}`, true));
      }
      const monto = new Intl.NumberFormat("es-PY").format(
        Math.round(c.membresia.precioMensual),
      );
      rows.push(row("Monto mensual", `${monto} Gs.`));
      box.innerHTML =
        `<p class="comprobante-titulo">Comprobante de registro</p>` +
        `<dl class="comprobante-list">${rows.join("")}</dl>`;
      box.removeAttribute("hidden");
    }

    function showExito(opts: {
      conCobro: boolean;
      tarjetasCount: number;
      comprobante: Comprobante | null;
      fechaFin?: string | null;
    }) {
      const title = $("exito-title");
      const msg = $("exito-message");
      if (opts.conCobro) {
        if (title) title.textContent = "¡Pago realizado!";
        if (msg)
          msg.textContent =
            "Tu tarjeta fue registrada y el cobro de tu membresía se realizó correctamente.";
        if (opts.fechaFin) {
          const fv = $("fecha-valor");
          if (fv) fv.textContent = formatFecha(opts.fechaFin);
          $("fecha-box")?.removeAttribute("hidden");
        }
      } else {
        if (title) title.textContent = "Tarjeta registrada";
        if (msg) {
          const extra =
            opts.tarjetasCount > 0
              ? ` Tienes ${opts.tarjetasCount} tarjeta${opts.tarjetasCount > 1 ? "s" : ""} activa${opts.tarjetasCount > 1 ? "s" : ""}.`
              : "";
          msg.textContent = `Tu tarjeta quedó habilitada para el débito automático.${extra}`;
        }
      }
      renderComprobante(opts.comprobante, opts.tarjetasCount);
      showState("st-exito");
    }

    function showError(msg: string) {
      const el = $("error-msg");
      if (el) el.textContent = msg;
      const canRetry = !!idCliente && !!token;
      const hint = $("error-hint");
      if (hint)
        hint.textContent = canRetry
          ? "Puedes intentar nuevamente con el mismo enlace."
          : "Solicita un nuevo enlace a tu proveedor de servicio para intentar de nuevo.";
      const retry = $("retry-btn") as HTMLAnchorElement | null;
      if (retry && canRetry) {
        const params = new URLSearchParams({ idCliente, token });
        if (idMembresia) params.set("idMembresia", idMembresia);
        retry.href = `/tarjetas/registrar?${params.toString()}`;
        retry.removeAttribute("hidden");
      }
      showState("st-error");
    }

    function showCobroFallido(motivo: string | null) {
      if (motivo) {
        const el = $("cobro-fallido-msg");
        if (el) {
          el.textContent = motivo;
          el.removeAttribute("hidden");
        }
      }
      showState("st-cobro-fallido");
    }

    // ── Polling del cobro diferido ──
    let pollingActive = true;
    function startPollingCobro(fechaFinPrevia: string) {
      const maxIntervals = 22; // 22 * 5s = 110s
      const intervalMs = 5000;
      let intentos = 0;

      const tick = async () => {
        if (!pollingActive) return;
        intentos++;
        const bar = $("progress-bar");
        if (bar)
          bar.style.width = `${Math.min(100, Math.round((intentos / maxIntervals) * 100))}%`;
        try {
          const res = await fetch("/api/verificar-cobro", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ idCliente, idMembresia, token }),
          });
          const r = await res.json();
          if (!pollingActive) return;

          const fechaFinCambio =
            r.fechaFin && r.fechaFin.slice(0, 10) !== fechaFinPrevia.slice(0, 10);

          if (r.cobroExitoso || (fechaFinCambio && r.estado === "activa")) {
            showExito({
              conCobro: true,
              tarjetasCount: pollingCtx.tarjetasCount,
              comprobante: pollingCtx.comprobante,
              fechaFin: r.fechaFin,
            });
            return;
          }
          if (r.cobroFallido) {
            showCobroFallido(
              r.ultimoIntento?.errorMensaje ||
                "No se pudo procesar el cobro automático. Comunicate con tu proveedor.",
            );
            return;
          }
          if (intentos >= maxIntervals) {
            // Sin respuesta concluyente: el cron del backend reintentará igual.
            showExito({
              conCobro: false,
              tarjetasCount: pollingCtx.tarjetasCount,
              comprobante: pollingCtx.comprobante,
            });
            return;
          }
          setTimeout(tick, intervalMs);
        } catch {
          if (intentos >= maxIntervals) {
            showExito({
              conCobro: false,
              tarjetasCount: pollingCtx.tarjetasCount,
              comprobante: pollingCtx.comprobante,
            });
            return;
          }
          setTimeout(tick, intervalMs);
        }
      };
      setTimeout(tick, intervalMs);
    }

    const pollingCtx: { tarjetasCount: number; comprobante: Comprobante | null } = {
      tarjetasCount: 0,
      comprobante: null,
    };

    window.addEventListener("beforeunload", () => {
      pollingActive = false;
    });

    // ── Determinar fallo terminal de Bancard ──
    const bancardFailed =
      bancardStatus !== "" && !bancardStatus.toLowerCase().includes("success");
    // "ya ha sido catastrada" = la tarjeta ya existe en el banco; solo hay que
    // confirmar/sincronizar, no es un fallo real.
    const isAlreadyRegistered =
      bancardFailed &&
      bancardDescription.toLowerCase().includes("ya ha sido catastrada");
    const isTerminalFailure = bancardFailed && !isAlreadyRegistered;

    async function run() {
      if (callbackState) {
        try {
          const contextResponse = await fetch("/api/resolver-callback-catastro", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ state: callbackState }),
          });
          const context = await contextResponse.json();
          if (!contextResponse.ok) {
            throw new Error(
              context.error || context.message || `Error ${contextResponse.status}`,
            );
          }
          idCliente = context.idCliente || "";
          token = context.token || "";
          idMembresia = context.idMembresia || "";
          idCotizacion = context.idCotizacion || "";
          tokenVersion = context.tokenVersion || "";
          purpose = context.purpose || "";
        } catch (err) {
          const error = err as { message?: string };
          showError(
            error.message ||
              "No se pudo recuperar el contexto del registro de tarjeta.",
          );
          return;
        }
      }

      if (isTerminalFailure) {
        showError(bancardDescription || "La tarjeta no pudo ser registrada.");
        return;
      }
      if (!idCliente) {
        showError("Falta el parámetro idCliente en la URL.");
        return;
      }

      try {
        const esCotizacionV2 =
          tokenVersion === "V2" &&
          purpose !== "AGREGAR_TARJETA_MEMBRESIA" &&
          !!idCotizacion;
        const esCambioTarjetaV2 =
          tokenVersion === "V2" &&
          purpose === "AGREGAR_TARJETA_MEMBRESIA" &&
          !!idMembresia;
        const endpoint = esCotizacionV2
          ? "/api/membresias-v2?accion=catastro%2Fconfirmar"
          : "/api/confirmar";
        const payload = esCotizacionV2
          ? { idCliente, idMembresia, idCotizacion, token }
          : esCambioTarjetaV2
            ? { idCliente, idMembresia }
            : {
                idCliente,
                ...(idMembresia
                  ? { idMembresiaActivar: idMembresia }
                  : {}),
              };

        const res = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const data = await res.json();

        if (!res.ok) {
          throw new Error(data.error || data.message || `Error ${res.status}`);
        }

        if (esCotizacionV2 || (esCambioTarjetaV2 && !!idCotizacion)) {
          if (esCambioTarjetaV2) {
            await reintentarCobroMembresiaV2({
              idCliente,
              idMembresia,
              idCotizacion,
              token,
            });
          }
          guardarContextoMembresiaV2(sessionStorage, {
            idCliente,
            idMembresia,
            idCotizacion,
            token,
            tipoOperacion: esCambioTarjetaV2
              ? "CAMBIO_TARJETA"
              : purpose === "REACTIVACION_MEMBRESIA_V2"
                ? "REACTIVACION"
                : "ALTA",
          });
          const params = new URLSearchParams({
            checkout: "ok",
            billingVersion: "V2",
            cobroDiferido: "true",
            idCliente,
            idMembresia,
            idCotizacion,
            token,
          });
          window.location.replace(`/gracias?${params.toString()}`);
          return;
        }

        if (!data.tarjetas || data.tarjetas.length === 0) {
          showError(
            "La confirmación fue procesada pero no se encontraron tarjetas registradas. " +
              "Es posible que el banco emisor haya rechazado la tarjeta.",
          );
          return;
        }

        const tarjetasCount = data.tarjetas.length as number;
        const comprobante = (data.catastro ?? null) as Comprobante | null;

        // Cobro diferido (membresía vencida/desactivada) → polling.
        if (data.cobroDiferido && idMembresia && comprobante?.fechaProximoDebito) {
          pollingCtx.tarjetasCount = tarjetasCount;
          pollingCtx.comprobante = comprobante;
          showState("st-esperando");
          startPollingCobro(comprobante.fechaProximoDebito);
          return;
        }

        // Membresía ya activa → solo registro de tarjeta, sin cobro.
        showExito({ conCobro: false, tarjetasCount, comprobante });
      } catch (err) {
        const e = err as { message?: string };
        showError(e?.message ?? "Error al confirmar la tarjeta con el servidor.");
      }
    }

    run();
  }
</script>

<style>
  .callback-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 1.5rem;
    background: var(--sl-color-black);
  }

  .callback-card {
    width: 100%;
    max-width: 28rem;
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.04);
    padding: 2.5rem 2rem;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
  }

  .callback-content {
    text-align: center;
  }

  .spinner {
    width: 3rem;
    height: 3rem;
    margin: 0 auto 1.25rem;
    border-radius: 50%;
    border: 3px solid rgba(255, 255, 255, 0.15);
    border-top-color: #f92606;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .icon-circle {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem;
  }

  .icon-success {
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
  }

  .icon-warning {
    background: rgba(245, 158, 11, 0.15);
    color: #fbbf24;
  }

  .icon-error {
    background: rgba(239, 68, 68, 0.15);
    color: #f87171;
  }

  .callback-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--sl-color-white);
    margin: 0 0 0.75rem;
  }

  .callback-message {
    font-size: 0.9375rem;
    color: var(--sl-color-gray-3);
    margin: 0 0 0.5rem;
    line-height: 1.5;
  }

  .callback-error-msg {
    font-size: 0.9375rem;
    color: #f87171;
    margin: 0 0 0.75rem;
    line-height: 1.5;
  }

  .callback-hint {
    font-size: 0.8125rem;
    color: var(--sl-color-gray-4);
    margin: 0.75rem 0 0;
  }

  .progress {
    margin: 1rem 0 0.25rem;
    height: 0.5rem;
    width: 100%;
    overflow: hidden;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.1);
  }

  .progress-bar {
    height: 100%;
    background: #3b82f6;
    transition: width 0.4s ease;
  }

  .fecha-box {
    margin: 1.25rem 0 0;
    border-radius: 0.75rem;
    border: 1px solid rgba(16, 185, 129, 0.3);
    background: rgba(16, 185, 129, 0.1);
    padding: 0.75rem 1rem;
  }

  .fecha-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #34d399;
    margin: 0;
  }

  .fecha-valor {
    font-size: 1.125rem;
    font-weight: 600;
    color: #6ee7b7;
    margin: 0.125rem 0 0;
  }

  .comprobante {
    margin: 1.25rem 0 0;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
    padding: 1rem 1.125rem;
    text-align: left;
  }

  .comprobante-titulo {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sl-color-gray-4);
    margin: 0 0 0.75rem;
  }

  .comprobante-list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .comprobante-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .comprobante-row dt {
    font-size: 0.75rem;
    color: var(--sl-color-gray-4);
    flex-shrink: 0;
  }

  .comprobante-row dd {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--sl-color-white);
    text-align: right;
  }

  .comprobante-row dd.mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: #34d399;
  }

  .callback-actions {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .btn {
    padding: 0.75rem 1.75rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
    border: none;
  }

  .btn-primary {
    background: linear-gradient(135deg, #f92606, #ff6b3d);
    color: white;
    box-shadow: 0 4px 20px rgba(249, 38, 6, 0.3);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(249, 38, 6, 0.5);
  }

  .callback-footer {
    margin-top: 1.25rem;
    text-align: center;
  }

