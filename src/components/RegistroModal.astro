     Global porque el HTML se inyecta vía innerHTML dinámicamente y
     no recibe el atributo data-astro-cid que usa la scoped CSS. */
  .rp-mem-list {
    margin-top: 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .rp-mem-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.9);
    cursor: pointer;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .rp-mem-row:last-of-type { border-bottom: none; }
  .rp-mem-row-master {
    color: #f9a606;
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid rgba(249, 166, 6, 0.2);
    padding-bottom: 0.55rem;
    margin-bottom: 0.15rem;
  }
  .rp-mem-row-master strong { color: #f9a606; }
  .rp-mem-label { flex: 1; line-height: 1.35; }
  .rp-mem-hint {
    margin: 0.55rem 0 0;
    font-size: 0.74rem;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.45;
  }
  /* Switch (toggle iOS-style) */
  .rp-switch {
    position: relative;
    display: inline-block;
    width: 46px;
    height: 26px;
    flex-shrink: 0;
  }
  .rp-switch input.checkbox,
  .rp-switch input[type="checkbox"] {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    margin: 0;
    padding: 0;
  }
  .rp-slider {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 26px;
    transition: background 0.2s ease;
