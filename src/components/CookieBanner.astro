---
// Banner de cookies — se muestra una sola vez hasta que el usuario acepta.
// La preferencia se guarda en localStorage ("fng_cookies_accepted").
---

<div id="cookie-banner" class="cookie-banner" role="dialog" aria-label="Aviso de cookies" style="display:none;">
  <p class="cookie-text">
    Usamos cookies propias y de terceros (Meta Pixel) para mejorar tu experiencia y medir el rendimiento de nuestras campañas.
    <a href="/politica-de-cookies" target="_blank" rel="noopener noreferrer">Más información</a>.
  </p>
  <div class="cookie-actions">
    <button id="cookie-accept" class="cookie-btn cookie-btn-accept">Aceptar</button>
    <a href="/politica-de-cookies" class="cookie-btn cookie-btn-more">Ver política</a>
  </div>
</div>

<script>
  const STORAGE_KEY = "fng_cookies_accepted";
  const banner = document.getElementById("cookie-banner");

  if (banner && !localStorage.getItem(STORAGE_KEY)) {
    // Pequeño delay para no distraer el primer render
    setTimeout(() => {
      banner.style.display = "flex";
    }, 1200);
  }

  document.getElementById("cookie-accept")?.addEventListener("click", () => {
    localStorage.setItem(STORAGE_KEY, "1");
    if (banner) {
      banner.style.opacity = "0";
      banner.style.transform = "translateY(20px)";
      setTimeout(() => { banner.style.display = "none"; }, 300);
    }
  });
</script>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9998;
    max-width: 680px;
    width: calc(100% - 2rem);
    background: #18181b;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 14px;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    box-shadow: 0 8px 32px rgba(0,0,0,0.5);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .cookie-text {
    flex: 1;
    margin: 0;
    font-size: 0.82rem;
    color: rgba(255,255,255,0.65);
    line-height: 1.5;
    min-width: 200px;
  }

  .cookie-text a {
    color: #ff6b3d;
    text-decoration: underline;
  }

  .cookie-actions {
    display: flex;
    gap: 0.6rem;
    flex-shrink: 0;
  }

  .cookie-btn {
    border-radius: 8px;
    padding: 0.5rem 1rem;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: transform 0.15s, box-shadow 0.15s;
  }

  .cookie-btn-accept {
    background: linear-gradient(135deg, #f92606, #ff6b3d);
    color: #fff;
    border: none;
    box-shadow: 0 4px 12px rgba(249,38,6,0.3);
  }
  .cookie-btn-accept:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(249,38,6,0.45);
  }

  .cookie-btn-more {
    background: transparent;
    color: rgba(255,255,255,0.5);
    border: 1px solid rgba(255,255,255,0.15);
  }
  .cookie-btn-more:hover {
    color: #fff;
    border-color: rgba(255,255,255,0.35);
  }

  @media (max-width: 500px) {
    .cookie-banner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .cookie-actions { width: 100%; }
    .cookie-btn { flex: 1; justify-content: center; }
  }
</style>
