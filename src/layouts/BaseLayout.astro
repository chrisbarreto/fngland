---
import { AstroFont } from "astro-font";
import "@/styles/global.css";
import theme from "@/config/theme.json";
import config from "@/config/config.json";
import MetaPixel from "@/components/MetaPixel.astro";
import CookieBanner from "@/components/CookieBanner.astro";
import UtmCapture from "@/components/UtmCapture.astro";

const {
  title: titleProp,
  description: descriptionProp,
  ogImage: ogImageProp,
  canonicalPath,
  noindex = false,
} = Astro.props;

const siteName = config.site?.title || "Fórmula NG";
const searchSiteName = "Fórmula NG - Detailing";
const defaultDescription =
  "Membresía de estética automotriz en Asunción, Paraguay. Detailing premium con lavado exterior y aspirado. Estrená tu vehículo cada mañana.";
const description = descriptionProp || defaultDescription;
const pageTitle = titleProp ? `${titleProp}` : siteName;
const siteUrl = Astro.site || new URL("https://formulang.com.py");
const canonicalUrl = new URL(
  canonicalPath || Astro.url.pathname,
  siteUrl
).toString();
const ogImageUrl = new URL(ogImageProp || "/og-image.webp", siteUrl).toString();
const robotsValue = noindex ? "noindex, nofollow" : "index, follow";
const isHomePage = Astro.url.pathname === "/";

// Font setup
const pf = theme.fonts.font_family.primary;
let fontPrimary: string | undefined;
if (pf) {
  fontPrimary = pf
    .replace(/\+/g, " ")
    .replace(/:[ital,]*[ital@]*[wght@]*[0-9,;.]+/gi, "");
}
---

<!doctype html>
<html lang="es-PY">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content={robotsValue} />
    <meta name="author" content="Fórmula NG" />
    <meta name="application-name" content={searchSiteName} />
    <meta name="theme-color" content="#f92606" />
    <meta name="keywords" content="formulang, formula ng, formula ng detailing, lavado de autos, lavado premium, membresía lavados ilimitados, detailing asunción, car wash paraguay, lavadero asunción, servicio de chofer, lavado de motor, cera líquida, limpieza interior" />
    <meta name="geo.region" content="PY-ASU" />
    <meta name="geo.placename" content="Asunción" />
    <meta name="geo.position" content="-25.2637;-57.5759" />
    <meta name="ICBM" content="-25.2637, -57.5759" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PY" />
    <meta property="og:site_name" content={searchSiteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:alt" content="Fórmula NG - Membresía de Estética Automotriz" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Fórmula NG - Membresía de Estética Automotriz" />

    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "@id": "https://formulang.com.py",
        name: "Fórmula NG - Detailing",
        legalName: "FORMULA NG E.A.S.",
        taxID: "80156407-7",
        alternateName: ["Fórmula NG", "Formula NG Detailing"],
        description:
          "Membresía de estética automotriz en Asunción, Paraguay. Lavados ilimitados, detailing premium, lavado exterior, aspirado, cera líquida, lavado de motor y servicio de chofer.",
        url: "https://formulang.com.py",
        telephone: "+595992789328",
        email: "info@formulang.com.py",
        address: {
          "@type": "PostalAddress",
          streetAddress: "23 de Octubre 687 c/ Toribio Pacheco",
          addressLocality: "Asunción",
          addressRegion: "Central",
          postalCode: "",
          addressCountry: "PY",
        },
        geo: {
          "@type": "GeoCoordinates",
          latitude: -25.2637,
          longitude: -57.5759,
        },
        openingHoursSpecification: {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
          opens: "08:00",
          closes: "18:00",
        },
        priceRange: "$$",
        currenciesAccepted: "PYG",
        paymentAccepted: "Credit Card, Debit Card, PagoPar",
        image: ogImageUrl,
        sameAs: [
          "https://www.instagram.com/formulang.py/",
          "https://www.facebook.com/p/Formula-NG-Detailing-61575717490017/",
          "https://wa.me/595992789328",
          "https://maps.app.goo.gl/5LLTf7d9pWUXao6fA",
        ],
        hasOfferCatalog: {
          "@type": "OfferCatalog",
          name: "Membresía Fórmula NG",
          itemListElement: [
            {
              "@type": "Offer",
              itemOffered: {
                "@type": "Service",
                name: "Plan Fórmula",
                description: "Lavados ilimitados, cera líquida, lavado de motor, hidratación de plásticos y 2 traslados gratis al mes.",
              },
              price: "200000",
              priceCurrency: "PYG",
              availability: "https://schema.org/InStock",
            },
            {
              "@type": "Offer",
              itemOffered: {
                "@type": "Service",
                name: "Plan Premium",
                description: "Lavados ilimitados, cera líquida, lavado de motor y 2 lavados a domicilio al mes.",
              },
              price: "250000",
              priceCurrency: "PYG",
              availability: "https://schema.org/InStock",
            },
            {
              "@type": "Offer",
              itemOffered: {
                "@type": "Service",
                name: "Plan Gold",
                description: "Lavados ilimitados, cera líquida, limpieza de tapizado superficial anual, servicio nano cerámico anual, pulida comercial anual y 1 traslado al mes.",
              },
              price: "350000",
              priceCurrency: "PYG",
              availability: "https://schema.org/InStock",
            },
            {
              "@type": "Offer",
              itemOffered: {
                "@type": "Service",
                name: "Plan Lavado a Domicilio",
                description: "4 servicios de detailing profesional a domicilio por mes.",
              },
              price: "500000",
              priceCurrency: "PYG",
              availability: "https://schema.org/InStock",
            },
          ],
        },
      })}
    </script>

    {isHomePage && (
      <script type="application/ld+json">
        {JSON.stringify({
          "@context": "https://schema.org",
          "@type": "WebSite",
          url: "https://formulang.com.py/",
          name: "Fórmula NG - Detailing",
          alternateName: ["Fórmula NG", "Formula NG", "Formula NG Detailing"],
        })}
      </script>
    )}

    <!-- Meta Pixel (condicional vía PUBLIC_META_PIXEL_ID) -->
    <MetaPixel />

    <!-- Google Font -->
    <AstroFont
      config={[
        {
          src: [],
          preload: false,
          display: "swap",
          name: fontPrimary!,
          fallback: "sans-serif",
          cssVariable: "font-primary",
          googleFontsURL: `https://fonts.googleapis.com/css2?family=${pf}&display=swap`,
        },
      ]}
    />
  </head>
  <body>
    <UtmCapture />
    <slot />
    <CookieBanner />
  </body>
</html>
