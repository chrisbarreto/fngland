---
// This component renders a full-screen registration modal.
// All logic is client-side JavaScript (no framework needed).
const siteKey = import.meta.env.TURNSTILE_SITE_KEY;
---

<!-- Registration Modal -->
<div id="registro-modal" class="modal-overlay" style="display:none;">
  <div class="modal-container">
    <button id="modal-close" class="modal-close" aria-label="Cerrar">&times;</button>
    
    <div class="modal-header">
      <h2 class="modal-title">Activá tu Plan Premium</h2>
      <p class="modal-subtitle">Completá tus datos, elegí tu día de débito y registrá tu tarjeta para activar tu membresía de Gs. 200.000 por mes.</p>
      <!-- Step indicators -->
      <div class="steps-indicator">
        <div class="step-dot active" data-step="1"><span>1</span></div>
        <div class="step-line"></div>
        <div class="step-dot" data-step="2"><span>2</span></div>
        <div class="step-line"></div>
        <div class="step-dot" data-step="3"><span>3</span></div>
      </div>
      <div class="steps-labels">
        <span class="step-label active" data-step="1">Tus datos</span>
        <span class="step-label" data-step="2">Tu vehículo</span>
        <span class="step-label" data-step="3">Plan y pago</span>
      </div>
    </div>

    <form id="registro-form" novalidate>
      <!-- Step 1: Personal Data -->
      <div class="form-step active" data-step="1">
        <div class="form-grid">
          <div class="form-group full">
            <label for="nombre">Nombre completo <span class="required">*</span></label>
            <input type="text" id="nombre" name="nombre" required placeholder="Ej: Juan Pérez" maxlength="200" />
            <span class="field-error"></span>
          </div>
          <div class="form-group">
            <label for="ruc">RUC / CI <span class="required">*</span></label>
            <input type="text" id="ruc" name="ruc" required placeholder="Ej: 1234567-8" maxlength="20" />
            <span class="field-error"></span>
          </div>
          <div class="form-group">
            <label for="telefono">Teléfono / WhatsApp <span class="required">*</span></label>
            <input type="tel" id="telefono" name="telefono" required placeholder="Ej: 0981 123 456" maxlength="20" />
            <span class="field-error"></span>
          </div>
          <div class="form-group full">
            <label for="email">Email <span class="required">*</span></label>
            <input type="email" id="email" name="email" required placeholder="tu@email.com" />
            <span class="field-error"></span>
          </div>
        </div>
        <div class="form-actions">
          <button type="button" class="btn-next" data-next="2">Siguiente</button>
        </div>
      </div>

      <!-- Step 2: Vehicle Data -->
      <div class="form-step" data-step="2">
        <div class="form-grid">
          <div class="form-group">
            <label for="chapa">Chapa / Matrícula <span class="required">*</span></label>
            <input type="text" id="chapa" name="chapa" required placeholder="Ej: ABC 1234" maxlength="15" style="text-transform: uppercase;" />
            <span class="field-error"></span>
          </div>
          <div class="form-group">
            <label for="anio">Año</label>
            <input type="number" id="anio" name="anio" placeholder="Ej: 2024" min="1900" max="2100" />
            <span class="field-error"></span>
          </div>
          <div class="form-group">
            <label for="idMarca">Marca</label>
            <select id="idMarca" name="idMarca">
              <option value="">Seleccionar marca...</option>
            </select>
            <span class="field-error"></span>
          </div>
          <div class="form-group">
            <label for="idModelo">Modelo</label>
            <select id="idModelo" name="idModelo" disabled>
              <option value="">Primero seleccioná la marca</option>
            </select>
            <span class="field-error"></span>
          </div>
          <div class="form-group">
            <label for="color">Color</label>
            <input type="text" id="color" name="color" placeholder="Ej: Blanco" maxlength="50" />
            <span class="field-error"></span>
          </div>
          <div class="form-group">
            <label for="tipoVehiculo">Tipo</label>
            <select id="tipoVehiculo" name="tipoVehiculo">
              <option value="">Seleccionar...</option>
              <option value="1">Auto</option>
              <option value="2">Camioneta</option>
              <option value="3">SUV</option>
              <option value="6">Pickup</option>
              <option value="7">Van</option>
              <option value="4">Moto</option>
              <option value="8">Otro</option>
            </select>
            <span class="field-error"></span>
          </div>
        </div>
        <div class="form-actions">
          <button type="button" class="btn-prev" data-prev="1">Atrás</button>
          <button type="button" class="btn-next" data-next="3">Siguiente</button>
        </div>
      </div>

      <!-- Step 3: Plan Selection -->
      <div class="form-step" data-step="3">
        <div id="planes-container" class="planes-grid">
          <div class="planes-loading">Cargando planes...</div>
        </div>
        <input type="hidden" id="idPlan" name="idPlan" />

        <!-- Auto-debit section -->
        <div class="auto-debit-section">
          <p class="auto-debit-eyebrow">Débito automático obligatorio</p>
          <h3 class="auto-debit-title">Tu membresía se activa con pago inmediato</h3>
          <p class="auto-debit-copy">
            El Plan Premium tiene permanencia mínima de 12 meses y se cobra automáticamente por Gs. 200.000 en cada ciclo mensual activo.
          </p>
          <ul class="auto-debit-list">
            <li>Tu primer débito se realizará un mes después de la activación, siempre en el mismo día del mes.</li>
            <li>Si un pago es rechazado, la membresía queda desactivada hasta regularizar.</li>
            <li>Para cambiar la fecha de débito contactá a soporte por WhatsApp.</li>
          </ul>
        </div>

        <!-- Aceptación legal -->
        <div class="legal-accept-wrapper">
          <label class="legal-accept-label">
            <input type="checkbox" id="acceptLegal" name="acceptLegal" />
            <span>
              Acepto los
              <a href="/terminos-y-condiciones" target="_blank" rel="noopener noreferrer">Términos y Condiciones</a>,
              <a href="/politica-de-privacidad" target="_blank" rel="noopener noreferrer">Política de Privacidad</a>
              y la <a href="/debito-automatico" target="_blank" rel="noopener noreferrer">autorización de débito automático</a>.
            </span>
          </label>
          <span class="field-error" id="legal-accept-error"></span>
        </div>

        <!-- Turnstile captcha -->
        <div class="turnstile-wrapper">
          <div
            class="cf-turnstile"
            data-sitekey={siteKey}
            data-theme="dark"
          ></div>
        </div>

        <div class="form-actions">
          <button type="button" class="btn-prev" data-prev="2">Atrás</button>
          <button type="submit" class="btn-submit" id="btn-submit">
            <span class="btn-submit-text">Continuar al pago</span>
            <span class="btn-submit-loading" style="display:none;">Procesando...</span>
          </button>
        </div>
      </div>
    </form>

    <!-- Success state -->
    <div id="registro-success" class="success-message" style="display:none;">
      <div class="success-icon">&#10003;</div>
      <h3>Plan activado</h3>
      <p>Tu Plan Premium quedó activo correctamente. Ya podés disfrutar de tus beneficios y agendar tus servicios.</p>
      <button type="button" class="btn-next" id="success-close">Cerrar</button>
    </div>

    <!-- Bancard Checkout iframe container -->
    <div id="bancard-checkout-container" style="display:none;">
      <div class="checkout-header">
        <h3>Registrá tu tarjeta de pago</h3>
        <p>Ingresá los datos de tu tarjeta para habilitar el débito automático obligatorio y activar tu Plan Premium.</p>
      </div>
      <div id="bancard-iframe"></div>
      <p class="checkout-secure-note">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Conexión segura. Tus datos de tarjeta son procesados directamente por Bancard.
      </p>
    </div>

    <!-- Error state -->
    <div id="registro-error" class="error-banner" style="display:none;">
      <span id="error-message"></span>
    </div>
  </div>
</div>

<style>
  /* Modal overlay */
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    animation: modalFadeIn 0.3s ease;
    overflow-y: auto;
  }

  @keyframes modalFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .modal-container {
    position: relative;
    width: 100%;
    max-width: 580px;
    background: var(--sl-color-gray-6, #1a1a1a);
    border: 1px solid var(--sl-color-hairline, rgba(255,255,255,0.1));
    border-radius: 20px;
    padding: 2.5rem 2rem;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
    max-height: 90vh;
    overflow-y: auto;
  }

  .modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    color: var(--sl-color-gray-3, #888);
    font-size: 1.8rem;
    cursor: pointer;
    line-height: 1;
    padding: 0.25rem;
    transition: color 0.2s;
  }
  .modal-close:hover {
    color: var(--sl-color-white, #fff);
  }

  /* Header */
  .modal-header {
    text-align: center;
    margin-bottom: 2rem;
  }
  .modal-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--sl-color-white, #fff);
    margin: 0 0 0.5rem;
  }
  .modal-subtitle {
    font-size: 0.9rem;
    color: var(--sl-color-gray-3, #888);
    margin: 0 0 1.5rem;
  }

  /* Steps */
  .steps-indicator {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    margin-bottom: 0.5rem;
  }
  .step-dot {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid var(--sl-color-gray-4, #555);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--sl-color-gray-4, #555);
    transition: all 0.3s;
  }
  .step-dot.active {
    border-color: #f92606;
    background: linear-gradient(135deg, #f92606, #ff6b3d);
    color: white;
  }
  .step-dot.completed {
    border-color: #22c55e;
    background: #22c55e;
    color: white;
  }
  .step-line {
    width: 40px;
    height: 2px;
    background: var(--sl-color-gray-5, #333);
    margin: 0 4px;
  }
  .steps-labels {
    display: flex;
    justify-content: center;
    gap: 2rem;
  }
  .step-label {
    font-size: 0.75rem;
    color: var(--sl-color-gray-4, #555);
    transition: color 0.3s;
  }
  .step-label.active {
    color: var(--sl-color-white, #fff);
  }

  /* Form steps */
  .form-step {
    display: none;
  }
  .form-step.active {
    display: block;
    animation: stepFadeIn 0.3s ease;
  }
  @keyframes stepFadeIn {
    from { opacity: 0; transform: translateX(20px); }
    to { opacity: 1; transform: translateX(0); }
  }

  /* Form grid */
  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .form-group.full {
    grid-column: 1 / -1;
  }
  .form-group label {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--sl-color-gray-2, #ccc);
  }
  .required {
    color: #f92606;
  }
  .optional {
    font-size: 0.75rem;
    color: var(--sl-color-gray-4, #555);
    font-weight: 400;
  }
  .form-group input,
  .form-group select {
    background: var(--sl-color-gray-5, #2a2a2a);
    border: 1px solid var(--sl-color-hairline, rgba(255,255,255,0.1));
    border-radius: 10px;
    padding: 0.75rem 1rem;
    color: var(--sl-color-white, #fff);
    font-size: 0.95rem;
    transition: border-color 0.2s;
    outline: none;
    font-family: inherit;
  }
  .form-group input::placeholder {
    color: var(--sl-color-gray-4, #555);
  }
  .form-group input:focus,
  .form-group select:focus {
    border-color: #f92606;
  }
  .form-group input.invalid,
  .form-group select.invalid {
    border-color: #ef4444;
  }
  .field-error {
    font-size: 0.75rem;
    color: #ef4444;
    min-height: 1rem;
  }

  .form-group select option {
    background: var(--sl-color-gray-5, #2a2a2a);
    color: var(--sl-color-white, #fff);
  }

  /* Form actions */
  .form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .btn-next, .btn-submit {
    background: linear-gradient(135deg, #f92606, #ff6b3d);
    color: white;
    padding: 0.75rem 2rem;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.95rem;
    border: none;
    cursor: pointer;
    transition: all 0.3s;
    box-shadow: 0 4px 15px rgba(249, 38, 6, 0.3);
  }
  .btn-next:hover, .btn-submit:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(249, 38, 6, 0.5);
  }
  .btn-submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }
  .btn-prev {
    background: transparent;
    border: 1px solid var(--sl-color-gray-4, #555);
    color: var(--sl-color-gray-2, #ccc);
    padding: 0.75rem 1.5rem;
    border-radius: 10px;
    font-weight: 500;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  .btn-prev:hover {
    border-color: var(--sl-color-gray-2, #ccc);
    color: var(--sl-color-white, #fff);
  }

  /* Plans grid — :global() needed because plan cards are rendered via innerHTML */
  .planes-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  :global(.planes-loading) {
    text-align: center;
    color: var(--sl-color-gray-3, #888);
    padding: 2rem;
  }
  :global(.plan-card) {
    position: relative;
    border: 2px solid var(--sl-color-hairline, rgba(255,255,255,0.1));
    border-radius: 14px;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    transition: all 0.3s;
    background: var(--sl-color-gray-5, #2a2a2a);
  }
  :global(.plan-card:hover) {
    border-color: var(--sl-color-gray-3, #888);
  }
  :global(.plan-card.selected) {
    border-color: #f92606;
    background: rgba(249, 38, 6, 0.08);
    box-shadow: 0 0 20px rgba(249, 38, 6, 0.15);
  }
  :global(.plan-card.destacado) {
    border-color: #ff6b3d;
  }
  :global(.plan-card-badge) {
    position: absolute;
    top: -10px;
    right: 16px;
    background: linear-gradient(135deg, #f92606, #ff6b3d);
    color: white;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 2px 12px;
    border-radius: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  :global(.plan-name) {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--sl-color-white, #fff);
    margin-bottom: 0.25rem;
  }
  :global(.plan-price) {
    font-size: 0.95rem;
    color: #ff6b3d;
    font-weight: 600;
  }
  :global(.plan-desc) {
    font-size: 0.8rem;
    color: var(--sl-color-gray-3, #888);
    margin-top: 0.35rem;
  }
  :global(.plan-check) {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid var(--sl-color-gray-4, #555);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    color: transparent;
    transition: all 0.3s;
  }
  :global(.plan-card.selected .plan-check) {
    background: #f92606;
    border-color: #f92606;
    color: white;
  }

  /* Success */
  .success-message {
    text-align: center;
    padding: 2rem 0;
  }
  .success-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #22c55e;
    color: white;
    font-size: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
  }
  .success-message h3 {
    font-size: 1.3rem;
    color: var(--sl-color-white, #fff);
    margin: 0 0 0.5rem;
  }
  .success-message p {
    color: var(--sl-color-gray-3, #888);
    margin: 0 0 2rem;
  }

  /* Error banner */

  /* Bancard Checkout */
  #bancard-checkout-container {
    padding: 1rem 0;
  }
  .checkout-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }
  .checkout-header h3 {
    font-size: 1.3rem;
    color: var(--sl-color-white, #fff);
    margin: 0 0 0.5rem;
  }
  .checkout-header p {
    color: var(--sl-color-gray-3, #888);
    margin: 0;
    font-size: 0.9rem;
  }
  #bancard-iframe {
    min-height: 400px;
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
  }
  #bancard-iframe iframe {
    width: 100% !important;
    min-height: 400px !important;
    border: none !important;
  }
  .checkout-secure-note {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-content: center;
    color: var(--sl-color-gray-3, #888);
    font-size: 0.8rem;
    margin-top: 1rem;
  }
  .checkout-secure-note svg {
    flex-shrink: 0;
    color: #22c55e;
  }
  .error-banner {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 10px;
    padding: 0.75rem 1rem;
    color: #ef4444;
    font-size: 0.85rem;
    margin-top: 1rem;
    text-align: center;
  }

  /* Turnstile captcha */
  /* Legal acceptance checkbox */
  .legal-accept-wrapper {
    margin-top: 1.25rem;
    display: grid;
    gap: 0.3rem;
  }
  .legal-accept-label {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    cursor: pointer;
    font-size: 0.82rem;
    color: rgba(255,255,255,0.65);
    line-height: 1.5;
  }
  .legal-accept-label input[type="checkbox"] {
    flex-shrink: 0;
    margin-top: 0.15rem;
    width: 16px;
    height: 16px;
    accent-color: #f92606;
    cursor: pointer;
  }
  .legal-accept-label a {
    color: #ff6b3d;
    text-decoration: underline;
  }
  .legal-accept-label a:hover { color: #f92606; }

  .turnstile-wrapper {
    display: inline-flex;
    margin-top: 1.25rem;
    padding: 0.5rem;
    border-radius: 12px;
    background: #0f0e12;
    border: 1px dashed rgba(255, 255, 255, 0.1);
  }

  /* Auto-debit section */
  .auto-debit-section {
    margin-top: 1.25rem;
    padding: 1.25rem;
    border: 1px solid var(--sl-color-hairline, rgba(255,255,255,0.1));
    border-radius: 12px;
    background: var(--sl-color-gray-5, #2a2a2a);
  }
  .auto-debit-eyebrow {
    margin: 0 0 0.4rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ff6b3d;
    font-weight: 700;
  }
  .auto-debit-title {
    margin: 0;
    color: var(--sl-color-white, #fff);
    font-size: 1.05rem;
  }
  .auto-debit-copy {
    margin: 0.55rem 0 0;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--sl-color-gray-3, #888);
  }
  .auto-debit-list {
    margin: 0.9rem 0 0;
    padding-left: 1.1rem;
    color: var(--sl-color-gray-2, #ccc);
    display: grid;
    gap: 0.45rem;
    font-size: 0.85rem;
    line-height: 1.45;
  }
  .debit-day-wrapper {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .debit-day-wrapper label {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--sl-color-gray-2, #ccc);
  }
  .debit-day-wrapper select {
    background: var(--sl-color-gray-6, #1a1a1a);
    border: 1px solid var(--sl-color-hairline, rgba(255,255,255,0.1));
    border-radius: 10px;
    padding: 0.75rem 1rem;
    color: var(--sl-color-white, #fff);
    font-size: 0.95rem;
    outline: none;
    font-family: inherit;
    transition: border-color 0.2s;
  }
  .debit-day-wrapper select:focus {
    border-color: #f92606;
  }
  .debit-day-wrapper select option {
    background: var(--sl-color-gray-6, #1a1a1a);
    color: var(--sl-color-white, #fff);
  }
  .debit-day-hint {
    font-size: 0.75rem;
    color: var(--sl-color-gray-4, #555);
    font-style: italic;
  }

  /* Responsive */
  @media (max-width: 548px) {
    .modal-container {
      padding: 1.5rem 1.25rem;
      border-radius: 16px;
    }
    .form-grid {
      grid-template-columns: 1fr;
    }
    .form-group.full {
      grid-column: 1;
    }
    .steps-labels {
      gap: 1rem;
    }
    .step-line {
      width: 24px;
    }
  }
</style>

<script>
  {
    // ---- DOM Elements ----
    const modal = document.getElementById("registro-modal") as HTMLElement;
    const form = document.getElementById("registro-form") as HTMLFormElement;
    const closeBtn = document.getElementById("modal-close") as HTMLElement;
    const successDiv = document.getElementById("registro-success") as HTMLElement;
    const errorBanner = document.getElementById("registro-error") as HTMLElement;
    const errorMsg = document.getElementById("error-message") as HTMLElement;
    const successClose = document.getElementById("success-close") as HTMLElement;
    const submitBtn = document.getElementById("btn-submit") as HTMLButtonElement;
    const submitText = submitBtn?.querySelector(".btn-submit-text") as HTMLElement;
    const submitLoading = submitBtn?.querySelector(".btn-submit-loading") as HTMLElement;
    const bancardContainer = document.getElementById("bancard-checkout-container") as HTMLElement;
    const successTitle = successDiv?.querySelector("h3") as HTMLElement;
    const successMessage = successDiv?.querySelector("p") as HTMLElement;
    const successIcon = successDiv?.querySelector(".success-icon") as HTMLElement;

    let currentStep = 1;
    let marcasLoaded = false;
    let planesLoaded = false;
    const defaultSuccessTitle = "Plan activado";
    const defaultSuccessMessage =
      "Tu Plan Premium quedó activo correctamente. Ya podés disfrutar de tus beneficios y agendar tus servicios.";

    function restoreSuccessState() {
      if (successTitle) successTitle.textContent = defaultSuccessTitle;
      if (successMessage) successMessage.textContent = defaultSuccessMessage;
      if (successIcon) {
        successIcon.textContent = "\u2713";
        successIcon.style.background = "#22c55e";
      }
    }

    function showResult(title: string, message: string, isError = false) {
      restoreSuccessState();
      if (successTitle) successTitle.textContent = title;
      if (successMessage) successMessage.textContent = message;
      if (successIcon && isError) {
        successIcon.textContent = "\u2717";
        successIcon.style.background = "#ef4444";
      }
      form.style.display = "none";
      bancardContainer.style.display = "none";
      successDiv.style.display = "block";
    }

    function resetModalState() {
      restoreSuccessState();
      goToStep(1);
      clearErrors();
      form.style.display = "";
      bancardContainer.style.display = "none";
      successDiv.style.display = "none";
      submitBtn.disabled = false;
      submitText.style.display = "inline";
      submitLoading.style.display = "none";
      submitLoading.textContent = "Procesando...";
    }

    // ---- Fetch with timeout ----
    function fetchWithTimeout(url: string, options: RequestInit = {}, timeoutMs = 30000): Promise<Response> {
      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), timeoutMs);
      return fetch(url, { ...options, signal: controller.signal })
        .catch((err) => {
          if (err.name === "AbortError") {
            throw new Error("La solicitud tardó demasiado. Verificá tu conexión e intentá de nuevo.");
          }
          throw err;
        })
        .finally(() => clearTimeout(timer));
    }

    // ---- Auto-debit: día calculado automáticamente al activar ----
    // No se muestra selector; se usa el día del mes de la fecha de activación (estilo Netflix)

    // ---- Open / Close Modal ----
    function openModal() {
      resetModalState();
      modal.style.display = "flex";
      document.body.style.overflow = "hidden";
      if (!marcasLoaded) loadMarcas();
      // Meta Pixel: InitiateCheckout
      if (typeof (window as any).fbq === "function") {
        (window as any).fbq("track", "InitiateCheckout", {
          content_name: "Plan Premium",
          value: 200000,
          currency: "PYG",
        });
      }
      if (!planesLoaded) loadPlanes();
    }

    function closeModal() {
      modal.style.display = "none";
      document.body.style.overflow = "";
      resetModalState();
    }

    // Expose globally so Hero can call it
    (window as any).__openRegistroModal = openModal;

    closeBtn?.addEventListener("click", closeModal);
    successClose?.addEventListener("click", closeModal);
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });

    // ESC key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal.style.display === "flex") closeModal();
    });

    // ---- Step Navigation ----
    function goToStep(step: number) {
      currentStep = step;
      document.querySelectorAll(".form-step").forEach((el) => {
        (el as HTMLElement).classList.toggle("active", el.getAttribute("data-step") === String(step));
      });
      document.querySelectorAll(".step-dot").forEach((el) => {
        const s = Number(el.getAttribute("data-step"));
        el.classList.toggle("active", s === step);
        el.classList.toggle("completed", s < step);
      });
      document.querySelectorAll(".step-label").forEach((el) => {
        el.classList.toggle("active", el.getAttribute("data-step") === String(step));
      });
    }

    // Next buttons
    document.querySelectorAll(".btn-next[data-next]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const nextStep = Number((btn as HTMLElement).getAttribute("data-next"));
        if (validateStep(currentStep)) {
          goToStep(nextStep);
        }
      });
    });

    // Prev buttons
    document.querySelectorAll(".btn-prev[data-prev]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const prevStep = Number((btn as HTMLElement).getAttribute("data-prev"));
        goToStep(prevStep);
      });
    });

    // ---- Validation ----
    function validateStep(step: number): boolean {
      clearErrors();
      let valid = true;

      if (step === 1) {
        const nombre = (document.getElementById("nombre") as HTMLInputElement).value.trim();
        const ruc = (document.getElementById("ruc") as HTMLInputElement).value.trim();
        const telefono = (document.getElementById("telefono") as HTMLInputElement).value.trim();
        const email = (document.getElementById("email") as HTMLInputElement).value.trim();

        if (!nombre) { showFieldError("nombre", "El nombre es requerido"); valid = false; }
        if (!ruc) { showFieldError("ruc", "El RUC/CI es requerido"); valid = false; }
        if (!telefono) { showFieldError("telefono", "El teléfono es requerido"); valid = false; }
        if (!email) {
          showFieldError("email", "El email es requerido para activar tu plan");
          valid = false;
        } else if (email && !email.match(/^[^\s@]+@[^\s@]+\.[^\s@]+$/)) {
          showFieldError("email", "Email inválido");
          valid = false;
        }
      }

      if (step === 2) {
        const chapa = (document.getElementById("chapa") as HTMLInputElement).value.trim();
        if (!chapa || chapa.length < 3) { showFieldError("chapa", "La chapa es requerida (mín. 3 caracteres)"); valid = false; }
      }

      if (step === 3) {
        const acceptLegal = document.getElementById("acceptLegal") as HTMLInputElement;
        if (acceptLegal && !acceptLegal.checked) {
          const errorEl = document.getElementById("legal-accept-error");
          if (errorEl) errorEl.textContent = "Debés aceptar los Términos y Condiciones para continuar.";
          valid = false;
        }
      }

      return valid;
    }

    function showFieldError(fieldId: string, message: string) {
      const field = document.getElementById(fieldId);
      if (field) {
        field.classList.add("invalid");
        const errorSpan = field.parentElement?.querySelector(".field-error");
        if (errorSpan) errorSpan.textContent = message;
      }
    }

    function clearErrors() {
      document.querySelectorAll(".invalid").forEach(el => el.classList.remove("invalid"));
      document.querySelectorAll(".field-error").forEach(el => el.textContent = "");
      errorBanner.style.display = "none";
    }

    function normalizeText(value: unknown): string {
      return String(value || "")
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase();
    }

    function escapeHtml(value: unknown): string {
      return String(value || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/\"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function getPublicPlanName(plan: any): string {
      const normalizedName = normalizeText(plan?.nombre);
      if (normalizedName.includes("premium") || normalizedName.includes("premiun")) {
        return "Plan Premium";
      }
      return String(plan?.nombre || "Plan");
    }

    function getPublicPlanDescription(plan: any): string {
      const planDescription = String(plan?.descripcion || "").trim();
      const contractDescription =
        "Permanencia minima de 12 meses. Debito automatico obligatorio.";

      if (!planDescription) return contractDescription;

      return `${escapeHtml(planDescription).replace(/\n+/g, "<br />")}<br /><br />${contractDescription}`;
    }

    // ---- Load Marcas ----
    async function loadMarcas() {
      const select = document.getElementById("idMarca") as HTMLSelectElement;
      try {
        const res = await fetchWithTimeout("/api/marcas", {}, 15000);
        if (!res.ok) {
          const errBody = await res.json().catch(() => ({}));
          throw new Error(errBody.error || `Error ${res.status} al cargar marcas`);
        }
        const data = await res.json();
        if (Array.isArray(data)) {
          select.innerHTML = '<option value="">Seleccionar marca...</option>';
          data.forEach((marca: any) => {
            const opt = document.createElement("option");
            opt.value = marca.idMarca;
            opt.textContent = marca.nombre;
            select.appendChild(opt);
          });
          marcasLoaded = true;
        } else {
          select.innerHTML = '<option value="">Error: respuesta inválida</option>';
        }
      } catch (err: any) {
        console.error("Error loading marcas:", err);
        select.innerHTML = `<option value="">Error al cargar marcas</option>`;
      }
    }

    // ---- Load Modelos (cascading) ----
    const marcaSelect = document.getElementById("idMarca") as HTMLSelectElement;
    const modeloSelect = document.getElementById("idModelo") as HTMLSelectElement;

    marcaSelect?.addEventListener("change", async () => {
      const idMarca = marcaSelect.value;
      modeloSelect.innerHTML = '<option value="">Cargando...</option>';
      modeloSelect.disabled = true;

      if (!idMarca) {
        modeloSelect.innerHTML = '<option value="">Primero seleccioná la marca</option>';
        return;
      }

      try {
        const res = await fetchWithTimeout(`/api/modelos?idMarca=${idMarca}`, {}, 15000);
        if (!res.ok) {
          const errBody = await res.json().catch(() => ({}));
          throw new Error(errBody.error || `Error ${res.status} al cargar modelos`);
        }
        const data = await res.json();
        modeloSelect.innerHTML = '<option value="">Seleccionar modelo...</option>';
        if (Array.isArray(data)) {
          data.forEach((modelo: any) => {
            const opt = document.createElement("option");
            opt.value = modelo.idModelo;
            opt.textContent = modelo.nombre;
            modeloSelect.appendChild(opt);
          });
        }
        modeloSelect.disabled = false;
      } catch (err: any) {
        modeloSelect.innerHTML = `<option value="">Error al cargar modelos</option>`;
        console.error("Error loading modelos:", err);
      }
    });

    // ---- Load Planes ----
    async function loadPlanes() {
      const container = document.getElementById("planes-container") as HTMLElement;
      try {
        const res = await fetchWithTimeout("/api/planes", {}, 15000);
        if (!res.ok) {
          const errBody = await res.json().catch(() => ({}));
          throw new Error(errBody.error || `Error ${res.status} al cargar planes`);
        }
        const data = await res.json();

        if (Array.isArray(data) && data.length > 0) {
          container.innerHTML = data.map((plan: any) => `
            <div class="plan-card selected" data-plan-id="${escapeHtml(plan.idPlan)}">
              <div class="plan-card-badge">Plan oficial</div>
              <div class="plan-name">${escapeHtml(getPublicPlanName(plan))}</div>
              <div class="plan-price">Gs. ${Number(plan.precio).toLocaleString("es-PY")}/mes</div>
              <div class="plan-desc">${getPublicPlanDescription(plan)}</div>
              <div class="plan-check">&#10003;</div>
            </div>
          `).join("");

          // Plan selection click
          container.querySelectorAll(".plan-card").forEach((card) => {
            card.addEventListener("click", () => {
              container.querySelectorAll(".plan-card").forEach(c => c.classList.remove("selected"));
              card.classList.add("selected");
              (document.getElementById("idPlan") as HTMLInputElement).value = 
                (card as HTMLElement).getAttribute("data-plan-id") || "";
            });
          });

          // Auto-select the public plan
          const selectedCard = container.querySelector(".plan-card") as HTMLElement;
          if (selectedCard) selectedCard.click();

          planesLoaded = true;
        } else {
          container.innerHTML = '<div class="planes-loading">No hay planes disponibles en este momento.</div>';
        }
      } catch (err) {
        const container = document.getElementById("planes-container") as HTMLElement;
        container.innerHTML = '<div class="planes-loading">Error al cargar planes. Intente más tarde.</div>';
        console.error("Error loading planes:", err);
      }
    }

    // ---- Form Submission ----
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!validateStep(currentStep)) return;

      const emailVal = (document.getElementById("email") as HTMLInputElement).value.trim();
      if (!emailVal) {
        errorMsg.textContent = "El email es requerido para activar tu Plan Premium. Volvé al paso 1 para completarlo.";
        errorBanner.style.display = "block";
        goToStep(1);
        showFieldError("email", "El email es requerido para activar tu plan");
        return;
      }
      if (!emailVal.match(/^[^\s@]+@[^\s@]+\.[^\s@]+$/)) {
        errorMsg.textContent = "El email ingresado no es válido. Volvé al paso 1 para corregirlo.";
        errorBanner.style.display = "block";
        goToStep(1);
        showFieldError("email", "Email inválido");
        return;
      }

      // Disable submit
      submitBtn.disabled = true;
      submitText.style.display = "none";
      submitLoading.style.display = "inline";
      errorBanner.style.display = "none";

      // Collect form data
      const formData: any = {
        nombre: (document.getElementById("nombre") as HTMLInputElement).value.trim(),
        ruc: (document.getElementById("ruc") as HTMLInputElement).value.trim(),
        telefono: (document.getElementById("telefono") as HTMLInputElement).value.trim(),
      };

      const email = (document.getElementById("email") as HTMLInputElement).value.trim();
      formData.email = email;

      const chapa = (document.getElementById("chapa") as HTMLInputElement).value.trim();
      formData.chapa = chapa;

      const idMarcaVal = (document.getElementById("idMarca") as HTMLSelectElement).value;
      if (idMarcaVal) formData.idMarca = Number(idMarcaVal);

      const idModeloVal = (document.getElementById("idModelo") as HTMLSelectElement).value;
      if (idModeloVal) formData.idModelo = Number(idModeloVal);

      const anio = (document.getElementById("anio") as HTMLInputElement).value;
      if (anio) formData.anio = Number(anio);

      const color = (document.getElementById("color") as HTMLInputElement).value.trim();
      if (color) formData.color = color;

      const tipoVehiculo = (document.getElementById("tipoVehiculo") as HTMLSelectElement).value;
      if (tipoVehiculo) formData.idTipoVehiculo = Number(tipoVehiculo);

      const idPlan = (document.getElementById("idPlan") as HTMLInputElement).value;
      if (idPlan) formData.idPlan = idPlan;

      // Turnstile captcha token
      const turnstileField = form.querySelector("[name='cf-turnstile-response']") as HTMLInputElement | null;
      const turnstileToken = turnstileField?.value || "";
      if (!turnstileToken) {
        errorMsg.textContent = "Completá la verificación de seguridad (captcha) para continuar.";
        errorBanner.style.display = "block";
        submitBtn.disabled = false;
        submitText.style.display = "inline";
        submitLoading.style.display = "none";
        return;
      }
      formData.turnstileToken = turnstileToken;

      // Adjuntar atribución UTM si está disponible
      try {
        const utmRaw = sessionStorage.getItem("fng_utm");
        if (utmRaw) formData.attribution = JSON.parse(utmRaw);
      } catch { /* ignorar errores de parsing */ }

      try {
        // Step 1: Register client + vehicle + membership
        const res = await fetchWithTimeout("/api/registro", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(formData),
        }, 30000);

        const body = await res.json().catch(() => {
          throw new Error("Error al procesar la respuesta del servidor. Intentá de nuevo.");
        });

        if (!res.ok) {
          const serverMsg = body.error || body.message || "";
          // Show user-friendly error based on status code
          if (res.status === 409) {
            throw new Error(serverMsg || "Este RUC o chapa ya está registrado. Si ya sos cliente, comunicate con nosotros.");
          } else if (res.status === 400) {
            throw new Error(serverMsg || "Datos inválidos. Revisá los campos e intentá de nuevo.");
          } else {
            throw new Error(serverMsg || "Error inesperado al registrar. Intentá de nuevo más tarde.");
          }
        }

        const idCliente = body.data?.idCliente || body.idCliente;
        if (!idCliente) {
          throw new Error("No pudimos iniciar la activacion de tu plan. Intenta nuevamente.");
        }

        submitLoading.textContent = "Redirigiendo a Pagopar...";

        // Store idCliente for callback confirmation
        sessionStorage.setItem("formulang_idCliente", idCliente);

        const checkoutRes = await fetchWithTimeout("/api/checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            idCliente: idCliente,
            diaDebito: new Date().getDate(),
            urlRedirect: window.location.origin + "/api/callback",
          }),
        }, 30000);

        const checkoutBody = await checkoutRes.json().catch(() => {
          throw new Error("Error al procesar la respuesta del checkout. Intentá de nuevo.");
        });

        if (!checkoutRes.ok) {
          sessionStorage.removeItem("formulang_idCliente");
          showResult(
            "Alta pendiente",
            "Tu registro fue recibido, pero no pudimos iniciar el pago automatico. Tu membresia no quedo activa. Contactanos para completar el alta.",
            true,
          );
          return;
        }

        const processId = checkoutBody.processId;
        if (processId) {
          form.style.display = "none";
          bancardContainer.style.display = "block";
          // Meta Pixel: AddPaymentInfo
          if (typeof (window as any).fbq === "function") {
            (window as any).fbq("track", "AddPaymentInfo", {
              content_name: "Plan Premium",
              value: 200000,
              currency: "PYG",
            });
          }

          // Load Bancard Checkout JS SDK if not already loaded
          if (!(window as any).Bancard) {
            await new Promise<void>((resolve, reject) => {
              const script = document.createElement("script");
              script.src = "/bancard-checkout-5.0.1.js";
              script.onload = () => resolve();
              script.onerror = () => reject(new Error("Error al cargar Bancard SDK"));
              document.head.appendChild(script);
            });
          }

          // Render the Bancard card enrollment form
          (window as any).Bancard.Cards.createForm("bancard-iframe", processId, {
            styles: {
              "input-background-color": "#ffffff",
              "input-text-color": "#333333",
              "input-placeholder-color": "#999999",
              "input-border-color": "#dddddd",
              "button-background-color": "#4f46e5",
              "button-text-color": "#ffffff",
              "form-background-color": "#ffffff",
            },
          });
        } else {
          sessionStorage.removeItem("formulang_idCliente");
          showResult(
            "Alta pendiente",
            "Tu registro fue recibido, pero no pudimos completar el cobro automatico. Tu membresia no quedo activa. Contactanos para continuar.",
            true,
          );
        }
        return;
      } catch (err: any) {
        sessionStorage.removeItem("formulang_idCliente");
        // Filter out raw technical errors (SyntaxError, TypeError, etc.)
        const isTechnical = err instanceof SyntaxError || err instanceof TypeError ||
          (err.message && (err.message.includes("Unexpected token") || err.message.includes("undefined")));
        errorMsg.textContent = isTechnical
          ? "Error inesperado. Intente más tarde."
          : (err.message || "Error inesperado. Intente más tarde.");
        errorBanner.style.display = "block";
      } finally {
        submitBtn.disabled = false;
        submitText.style.display = "inline";
        submitLoading.style.display = "none";
        submitLoading.textContent = "Procesando...";
      }
    });
    // ---- Handle Pagopar Checkout Callback ----
    // When Pagopar redirects back via /api/callback, it sets ?checkout=ok|error on the landing
    (async function handleCheckoutCallback() {
      const params = new URLSearchParams(window.location.search);
      const checkoutStatus = params.get("checkout");
      if (!checkoutStatus) return;

      // Clean URL without reloading
      const cleanUrl = window.location.pathname;
      window.history.replaceState({}, "", cleanUrl);

      if (checkoutStatus === "ok") {
        // Show success notification
        openModal();
        showResult(
          "Plan activado",
          "Tu tarjeta fue registrada exitosamente. Tu Plan Premium quedó activo y los débitos automáticos mensuales están habilitados.",
        );

        // Confirm tarjeta in the backend (await result to ensure consistency)
        const storedClienteId = sessionStorage.getItem("formulang_idCliente");
        if (storedClienteId) {
          try {
            const confirmRes = await fetch("/api/confirmar", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ idCliente: storedClienteId }),
            });
            if (!confirmRes.ok) {
              const confirmBody = await confirmRes.json().catch(() => ({}));
              console.error("Error confirming card:", confirmBody);
              if (successMessage) {
                successMessage.textContent =
                  "Tu tarjeta fue registrada, pero hubo un problema confirmando la activación automática de tu plan. Contactanos para asistencia.";
              }
            }
          } catch (err) {
            console.error("Error confirming card:", err);
            if (successMessage) {
              successMessage.textContent =
                "Tu tarjeta fue registrada, pero no pudimos confirmar la activación automática de tu plan. Contactanos para asistencia.";
            }
          } finally {
            sessionStorage.removeItem("formulang_idCliente");
          }
        }
      } else {
        // Show error
        const msg = params.get("checkout_msg") || "No se pudo registrar la tarjeta. Intentá de nuevo más tarde.";
        openModal();
        showResult("Error al registrar tarjeta", msg, true);
      }
    })();
  }
</script>
