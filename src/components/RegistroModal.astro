    border-bottom: 1px solid rgba(240, 180, 41, 0.2);
    padding-bottom: 0.55rem;
    margin-bottom: 0.15rem;
  }
  .rp-mem-row-master strong { color: #f0b429; }
  .rp-mem-label { flex: 1; line-height: 1.35; }
  .rp-mem-hint {
    margin: 0.55rem 0 0;
    font-size: 0.74rem;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.45;
  }
  /* Switch (toggle iOS-style) */
  .rp-switch {
    position: relative;
    display: inline-block;
    width: 46px;
    height: 26px;
