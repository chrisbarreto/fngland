---
import config from "@/config/config.json" assert { type: "json" };
import social from "@/config/social.json" assert { type: "json" };
import { markdownify } from "@/lib/utils/textConverter";
import logoDark from "@/assets/logos/logo-dark.svg";
---

<footer id="contacto">
  <div class="footer-inner">
    <!-- Logo -->
    <div class="footer-logo">
      <a href="/" aria-label="Ir al inicio - Fórmula NG">
        <img src={logoDark.src} alt="Fórmula NG" width="160" height="40" />
      </a>
    </div>

    <!-- Tagline -->
    <p class="footer-tagline">Membresía de estética automotriz en Asunción, Paraguay.</p>

    <!-- Contact -->
    <div class="footer-contact">
      <a href="mailto:info@formulang.com.py" class="contact-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m3 7 9 6 9-6" />
        </svg>
        info@formulang.com.py
      </a>
      <a href="https://wa.me/595992789328" class="contact-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z" />
        </svg>
        0992 789 328
      </a>
      <a href="https://maps.app.goo.gl/5LLTf7d9pWUXao6fA" class="contact-item" target="_blank" rel="noopener noreferrer">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
          <circle cx="12" cy="10" r="3" />
        </svg>
        23 de Octubre 687 c/ Toribio Pacheco, Asunción
      </a>
    </div>

    <!-- Social Icons -->
    <div class="footer-social">
      {social.main.map((item) => (
        <a href={item.href} aria-label={item.label} class={`social-btn social-${item.icon}`} target="_blank" rel="noopener noreferrer">
          {item.icon === "instagram" && (
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          )}
          {item.icon === "facebook" && (
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          )}
          {item.icon === "whatsapp" && (
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
          )}
          {item.icon === "email" && (
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
            </svg>
          )}
          {item.icon === "googlemaps" && (
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="30" viewBox="0 0 92.3 132.3">
              <path fill="#1a73e8" d="M60.2 2.2C55.8.8 51 0 46.1 0 32 0 19.3 6.4 10.8 16.5l21.8 18.3L60.2 2.2z"/>
              <path fill="#ea4335" d="M10.8 16.5C4.1 24.5 0 34.9 0 46.1c0 8.7 1.7 15.7 4.6 22l28-33.3-21.8-18.3z"/>
              <path fill="#4285f4" d="M46.2 28.5c9.8 0 17.7 7.9 17.7 17.7 0 4.3-1.6 8.3-4.2 11.4 0 0 13.9-16.6 27.5-32.7-5.6-10.8-15.3-19-27-22.7L32.6 34.8c3.3-3.8 8.1-6.3 13.6-6.3"/>
              <path fill="#fbbc04" d="M46.2 63.8c-9.8 0-17.7-7.9-17.7-17.7 0-4.3 1.5-8.3 4.1-11.3l-28 33.3c4.8 10.6 12.8 19.2 21 29.9l34.1-40.5c-3.3 3.9-8.1 6.3-13.5 6.3"/>
              <path fill="#34a853" d="M59.1 109.2c15.4-24.1 33.3-35 33.3-63 0-7.7-1.9-14.9-5.2-21.3L25.6 98c2.6 3.4 5.3 7.3 7.9 11.3 9.4 14.5 6.8 23.1 12.8 23.1s3.4-8.7 12.8-23.2"/>
            </svg>
          )}
        </a>
      ))}
    </div>

    <!-- Divider -->
    <div class="footer-divider"></div>

    <!-- Copyright -->
    <div class="footer-bottom">
      <p set:html={markdownify(config?.params?.copyright)} />
    </div>
  </div>
</footer>

<style>
  footer {
    background: var(--sl-color-black);
    border-top: 1px solid rgba(249, 38, 6, 0.15);
  }

  .footer-inner {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 1.5rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
  }

  .footer-logo img {
    height: 40px;
    width: auto;
    opacity: 0.9;
    transition: opacity 0.3s ease;
  }

  .footer-logo img:hover {
    opacity: 1;
  }

  .footer-tagline {
    color: var(--sl-color-gray-3);
    font-size: 0.95rem;
    margin: 0;
    max-width: 400px;
    line-height: 1.5;
  }

  .footer-contact {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem;
  }

  .contact-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--sl-color-gray-3);
    text-decoration: none;
    font-size: 0.85rem;
    transition: color 0.3s ease;
  }

  a.contact-item:hover {
    color: #f92606;
  }

  .footer-social {
    display: flex;
    gap: 1rem;
    margin-top: 0.25rem;
  }

  .social-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    transition: all 0.3s ease;
    text-decoration: none;
  }

  /* Instagram gradient */
  .social-instagram {
    background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
    box-shadow: 0 0 14px rgba(225, 48, 108, 0.5);
  }
  .social-instagram:hover {
    box-shadow: 0 0 22px rgba(225, 48, 108, 0.8);
    transform: translateY(-3px);
  }

  /* Facebook blue */
  .social-facebook {
    background: #1877f2;
    box-shadow: 0 0 14px rgba(24, 119, 242, 0.5);
  }
  .social-facebook:hover {
    box-shadow: 0 0 22px rgba(24, 119, 242, 0.8);
    transform: translateY(-3px);
  }

  /* WhatsApp green */
  .social-whatsapp {
    background: #25d366;
    box-shadow: 0 0 14px rgba(37, 211, 102, 0.5);
  }
  .social-whatsapp:hover {
    box-shadow: 0 0 22px rgba(37, 211, 102, 0.8);
    transform: translateY(-3px);
  }

  /* Email red */
  .social-email {
    background: #f92606;
    box-shadow: 0 0 14px rgba(249, 38, 6, 0.5);
  }
  .social-email:hover {
    box-shadow: 0 0 22px rgba(249, 38, 6, 0.8);
    transform: translateY(-3px);
  }

  /* Google Maps - dark background to show colorful icon */
  .social-googlemaps {
    background: #1a1a1a;
    box-shadow: 0 0 14px rgba(26, 115, 232, 0.4);
  }
  .social-googlemaps:hover {
    box-shadow: 0 0 22px rgba(26, 115, 232, 0.7);
    transform: translateY(-3px);
  }

  .footer-divider {
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(249, 38, 6, 0.3), transparent);
  }

  .footer-bottom {
    color: var(--sl-color-gray-4);
    font-size: 0.8rem;
  }

  .footer-bottom p {
    margin: 0;
  }

  @media (max-width: 600px) {
    .footer-contact {
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }
  }
</style>
