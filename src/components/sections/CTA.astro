---
import Section from "./Section.astro";

const title = "¿Listo para tener tu auto <span class='light-text'>siempre impecable?</span>";

---

<div class="cta-container">
  <div class="cta-bg">
    <img src="/cta-bg.webp" alt="" class="cta-bg-img" />
    <div class="cta-bg-overlay"></div>
  </div>
  <Section title={title}>
    <div class="cta-buttons">
      <button
        type="button"
        class="cta-btn"
        id="cta-registro-btn"
      >
        QUIERO MI AUTO IMPECABLE
      </button>
    </div>
  </Section>
</div>

<style>
  .cta-container {
    padding: 1rem;
    position: relative;
    overflow: hidden;
  }
  .cta-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .cta-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cta-bg-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    pointer-events: none;
  }
  .cta-container :global(.section) {
    position: relative;
    z-index: 1;
  }

  .cta-btn {
    background: linear-gradient(135deg, #f92606, #ff6b3d);
    color: white;
    padding: 1rem 2.5rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    display: inline-block;
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(249, 38, 6, 0.3);
    border: 2px solid transparent;
    cursor: pointer;
  }

  .cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(249, 38, 6, 0.5);
    border-color: rgba(249, 38, 6, 0.5);
  }

  .cta-buttons {
    display: flex;
    justify-content: center;
  }
</style>

<script>
  const ctaBtn = document.getElementById("cta-registro-btn");
  ctaBtn?.addEventListener("click", () => {
    if (typeof (window as any).__openRegistroModal === "function") {
      (window as any).__openRegistroModal();
    }
  });
</script>
