  .rp-slider {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 26px;
    transition: background 0.2s ease;
    cursor: pointer;
    display: block;
  }
  .rp-slider::before {
    content: "";
    position: absolute;
    left: 3px;
    top: 3px;
    width: 20px;
