---
export const prerender = true;
import BaseLayout from "@/layouts/BaseLayout.astro";
import Footer from "@/components/Footer.astro";
import logoDark from "@/assets/logos/logo-dark.svg";
import termsMarkdown from "@/legal/terminos-y-condiciones-v2-4.md?raw";
import { marked } from "marked";

const termsHtml = marked.parse(termsMarkdown, { async: false });
---

<BaseLayout
  title="Términos y Condiciones | Fórmula NG"
  description="Condiciones de Essential, Plus, Black, Domicilio y del Plan Gold financiado de Fórmula NG."
  canonicalPath="/terminos-y-condiciones"
  noindex={true}
>
  <div class="legal-page">
    <header class="legal-header">
      <a href="/" aria-label="Volver al inicio">
        <img src={logoDark.src} alt="Fórmula NG" width="130" height="32" />
      </a>
      <a href="/membresia" class="back-link">← Volver</a>
    </header>
    <main class="legal-main" set:html={termsHtml} />
    <Footer />
  </div>
</BaseLayout>
<style>
  .legal-page { min-height: 100vh; background: #060606; display: flex; flex-direction: column; width: 100%; max-width: 100%; overflow-x: hidden; }
  .legal-header { display: flex; align-items: center; justify-content: space-between; padding: 1.1rem 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.07); max-width: 860px; margin: 0 auto; width: 100%; box-sizing: border-box; }
  .legal-header img { height: 32px; width: auto; }
  .back-link { font-size: 0.85rem; color: rgba(255,255,255,0.45); text-decoration: none; }
  .back-link:hover { color: #ff6b3d; }
  .legal-main { flex: 1; max-width: 860px; margin: 0 auto; width: 100%; padding: 3rem 1.5rem 4rem; box-sizing: border-box; color: rgba(255,255,255,0.8); line-height: 1.7; }
  :global(.legal-main h1) { margin: 0 0 0.4rem; font-size: clamp(1.6rem, 4vw, 2.2rem); color: #fff; }
  :global(.legal-main > p:first-of-type) { margin: 0 0 2.5rem; font-size: 0.8rem; color: rgba(255,255,255,0.55); }
  :global(.legal-main h2) { margin: 2rem 0 0.6rem; font-size: 1.05rem; color: #fff; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 0.4rem; }
  :global(.legal-main p) { margin: 0 0 0.8rem; font-size: 0.9rem; }
  :global(.legal-main ul) { margin: 0 0 0.8rem; padding-left: 1.3rem; font-size: 0.9rem; }
  :global(.legal-main li) { margin-bottom: 0.45rem; }
  :global(.legal-main a) { color: #ff6b3d; text-decoration: underline; }
  :global(.legal-main a:hover) { color: #f92606; }
</style>
