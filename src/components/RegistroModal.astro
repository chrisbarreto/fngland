  @media (max-width: 480px) {
    .rp-switch { width: 52px; height: 30px; }
    .rp-slider::before { width: 24px; height: 24px; }
    .rp-switch input:checked + .rp-slider::before { transform: translateX(22px); }
  }
</style>


<script>
  import { logEvent } from "@/lib/telemetry";
  import {
    cambiarPlanAltaPendienteMembresiaV2,
    consultarDisponibilidadMembresiasV2,
    cotizarAltaMembresiaV2,
    cotizarReactivacionMembresiaV2,
    guardarContextoMembresiaV2,
    limpiarContextoMembresiaV2,
    prepararCambioTarjetaMembresiaV2,
    prepararCatastroMembresiaV2,
  } from "@/lib/membresias-v2";

  interface TurnstileInstance {
    reset: (container?: HTMLElement | string) => void;
    getResponse: (container?: HTMLElement | string) => string | undefined;
    remove: (container?: HTMLElement | string) => void;
    render: (
      container: HTMLElement | string,
      params: Record<string, unknown>,
    ) => string;
    execute: (container?: HTMLElement | string) => void;
  }
  declare global {
    interface Window {
      turnstile?: TurnstileInstance;
      __tsOnSuccess: (token: string) => void;
      __tsOnExpired: () => void;
      __tsOnError: () => void;
    }
  }
  {
    // ---- DOM Elements ----
    const modal = document.getElementById("registro-modal") as HTMLElement;
    const providerSelectorEnabled =
      modal?.dataset.providerSelectorEnabled === "true";
    const form = document.getElementById("registro-form") as HTMLFormElement;
    const closeBtn = document.getElementById("modal-close") as HTMLElement;
    const successDiv = document.getElementById("registro-success") as HTMLElement;
    const errorBanner = document.getElementById("registro-error") as HTMLElement;
    const errorMsg = document.getElementById("error-message") as HTMLElement;
    const submitBtn = document.getElementById("btn-submit") as HTMLButtonElement;
    const submitText = submitBtn?.querySelector(".btn-submit-text") as HTMLElement;
    const submitLoading = submitBtn?.querySelector(".btn-submit-loading") as HTMLElement;
    const bancardContainer = document.getElementById("bancard-checkout-container") as HTMLElement;
    const processingOverlay = document.getElementById("processing-overlay") as HTMLElement;
    const successTitle = successDiv?.querySelector("h3") as HTMLElement;
    const successMessage = successDiv?.querySelector("p") as HTMLElement;
    const successIcon = successDiv?.querySelector(".success-icon") as HTMLElement;

    let currentStep = 1;
    let marcasLoaded = false;
    let planesLoaded = false;
    let modoNuevoVehiculo = false;
    let modoVehiculoConservado = false;
    let modoActualizarVehiculo = false;
    let cuentaExpulsadaActual = false;
    let lastLookedUpCI = "";      // evita re-disparar lookup para el mismo CI
    let lookupInProgress = false; // evita lookups simultáneos (race condition)
    let membresiasV2EnabledCache: boolean | null = null;
    // Cuando el backend rechaza la chapa por duplicada (409) y el usuario
    // confirma que sí es suya, esta bandera hace que el próximo submit envíe
    // `chapa + "DP"` para evitar el constraint y dejar la operación marcada
    // para revisión manual desde el panel admin. Se usa "DP" (Duplicada
    // Pendiente) en lugar de "*" porque el validador del backend exige
    // /^[A-Z0-9]+$/ y rechaza símbolos. "DP" no aparece como sufijo de
    // chapas legítimas en Paraguay, por lo que es un marcador inequívoco.
    let _chapaMarcadaParaRevisionManual = false;

    // ---- Turnstile token state ----
    const _tsSiteKey = (document.querySelector(".cf-turnstile") as HTMLElement | null)?.getAttribute("data-sitekey") ?? "";
    let _tsTokenReady = false;
    let _tsTokenValue = "";
    let _tsPendingResolves: Array<() => void> = [];
    let _submitPendingAfterTs = false;
    // Timer de refresh proactivo: re-emite token cada 240s (TTL real ~300s)
    // para evitar que expire mientras el usuario llena los 3 pasos del wizard.
    let _tsRefreshTimer: number | null = null;

    function startProactiveTurnstileRefresh() {
      if (_tsRefreshTimer != null) return;
      _tsRefreshTimer = window.setInterval(() => {
        try {
          // Cast explícito: las propiedades turnstile/__tsOn* viven en window
          // pero el `declare global` está dentro del IIFE y no se propaga
          // (ts(1234)). Es el mismo patrón que usan otras secciones del file.
          const ts = (window as unknown as { turnstile?: TurnstileInstance }).turnstile;
          if (ts && typeof ts.reset === "function") {
            ts.reset();
            logEvent({
              paso: "turnstile",
              severidad: "info",
              codigo: "TS_PROACTIVE_REFRESH",
              contexto: { currentStep },
            });
          }
        } catch { /* swallow — Turnstile no debe romper el modal */ }
      }, 240_000);
    }

    function stopProactiveTurnstileRefresh() {
      if (_tsRefreshTimer != null) {
        clearInterval(_tsRefreshTimer);
        _tsRefreshTimer = null;
      }
    }

    // Cast helper: el `declare global { ... }` está dentro de la IIFE y no
    // se propaga a `Window` (ts(1234)). Usamos un alias local tipado para
    // asignar los callbacks Turnstile sin disparar ts(2339).
    const _winAny = window as unknown as {
      __tsOnSuccess: (token: string) => void;
      __tsOnExpired: () => void;
      __tsOnError: () => void;
      turnstile?: TurnstileInstance;
    };

    _winAny.__tsOnSuccess = (token: string) => {
      _tsTokenReady = true;
      _tsTokenValue = token;
      const resolvers = _tsPendingResolves.splice(0);
      resolvers.forEach((r) => r());
      // Si el submit estaba esperando el token, ocultar el widget y reanudar
      if (_submitPendingAfterTs) {
        _submitPendingAfterTs = false;
        hideTurnstileStep3();
        form.requestSubmit();
      }
    };
    _winAny.__tsOnExpired = () => {
      _tsTokenReady = false;
      _tsTokenValue = "";
      logEvent({
        paso: "turnstile",
        severidad: "warn",
        codigo: "TS_EXPIRED",
        contexto: { currentStep },
      });
      // Si el usuario ya está en el paso final (aceptando términos), mostrar
      // proactivamente el widget de refresh para que no se sorprenda al hacer
      // click en "Pagar ahora".
      if (currentStep === 3) {
        try { showTurnstileStep3(); } catch { /* widget might not be available yet */ }
      }
    };
    _winAny.__tsOnError = () => {
      _tsTokenReady = false;
      _tsTokenValue = "";
      logEvent({
        paso: "turnstile",
        severidad: "warn",
        codigo: "TS_ERROR",
        contexto: { currentStep },
      });
    };

    // Paleta oscura para el iframe de Bancard — alineada con los design tokens del modal
    // (--card-bg, --navy-700, --input-bg, --input-border, --text-primary, --text-muted, --accent-blue).
    // El SDK de Bancard solo acepta hex sólidos (no rgba).
    const BANCARD_DARK_STYLES = {
      "form-background-color":   "#ffffff",
      "form-border-color":       "#e5e7eb",
      "header-background-color": "#f9fafb",
      "header-text-color":       "#111827",
      "input-background-color":  "#f3f4f6",
      "input-text-color":        "#111827",
      "input-placeholder-color": "#9ca3af",
      "input-border-color":      "#d1d5db",
      "button-background-color": "#2d5be3",
      "button-text-color":       "#ffffff",
      "button-border-color":     "#1e4bc7",
      "hr-border-color":         "#e5e7eb",
      "label-kyc-text-color":    "#374151",
    } as const;

    // Helpers for censoring displayed data
    function censurar(valor: string, visibles = 3): string {
      if (!valor || valor.length <= visibles) return valor;
      return valor.slice(0, visibles) + "***";
    }
    function censurarEmail(email: string): string {
      const [user, domain] = email.split("@");
      return (user ? user[0] + "***" : "***") + "@" + (domain ?? "");
    }

    // Revela los campos personales (nombre/tel/email) y el botón Siguiente del paso 1
    function revelarCamposPersonales() {
      _modalDirty = true;
      updateBeforeUnload();
      document.querySelectorAll<HTMLElement>(".personal-field").forEach(el => { el.style.display = ""; });
      const actions = document.getElementById("step1-actions") as HTMLElement | null;
      if (actions) actions.style.display = "";
      const loading = document.getElementById("ci-lookup-loading") as HTMLElement | null;
      if (loading) loading.style.display = "none";
      const rucSuccess = document.getElementById("ruc-success") as HTMLElement | null;
      if (rucSuccess) rucSuccess.style.display = "flex";
    }

    // Oculta los campos personales y el botón Siguiente (estado inicial / reset)
    function ocultarCamposPersonales() {
      document.querySelectorAll<HTMLElement>(".personal-field").forEach(el => { el.style.display = "none"; });
      const actions = document.getElementById("step1-actions") as HTMLElement | null;
      if (actions) actions.style.display = "none";
      const loading = document.getElementById("ci-lookup-loading") as HTMLElement | null;
      if (loading) loading.style.display = "none";
      const rucSuccess = document.getElementById("ruc-success") as HTMLElement | null;
      if (rucSuccess) rucSuccess.style.display = "none";
    }

    const defaultSuccessTitle = "Plan activado";
    function getSuccessMessage() {
      const meta = currentPlanMeta();
      return `Tu ${meta.name} quedó activo correctamente. Ya podés disfrutar de tus beneficios y agendar tus servicios.`;
    }

    function restoreSuccessState() {
      if (successTitle) successTitle.textContent = defaultSuccessTitle;
      if (successMessage) successMessage.textContent = getSuccessMessage();
      if (successIcon) {
        successIcon.textContent = "\u2713";
        successIcon.style.background = "#22c55e";
      }
      hideProcessing();
      unlockModal();
      // Ocultar y resetear botón de comprobante
      const receiptBtn = document.getElementById("btn-download-receipt") as HTMLButtonElement | null;
      if (receiptBtn) { receiptBtn.style.display = "none"; receiptBtn.textContent = "Descargar comprobante"; receiptBtn.disabled = false; }
      _receiptListenerAttached = false;
      if (successDiv) {
        successDiv.querySelectorAll("button").forEach((b) => {
          if (b.id !== "btn-download-receipt") b.remove();
        });
      }
    }

    function showProcessing() {
      if (processingOverlay) processingOverlay.style.display = "";
    }
    function hideProcessing() {
      if (processingOverlay) processingOverlay.style.display = "none";
    }

    function showResult(title: string, message: string, isError = false) {
      hideProcessing();
      restoreSuccessState();
      if (successTitle) successTitle.textContent = title;
      if (successMessage) successMessage.textContent = message;
      if (successIcon && isError) {
        successIcon.textContent = "\u2717";
        successIcon.style.background = "#ef4444";
      }
      form.style.display = "none";
      bancardContainer.style.display = "none";
      successDiv.style.display = "block";
    }

    let _receiptListenerAttached = false;

    function addReceiptButton(comprobante: any) {
      if (!comprobante) return;
      const btn = document.getElementById("btn-download-receipt") as HTMLButtonElement | null;
      if (!btn) return;
      btn.style.display = "";
      if (!_receiptListenerAttached) {
        _receiptListenerAttached = true;
        btn.addEventListener("click", async () => {
          btn.disabled = true;
          btn.textContent = "Generando PDF...";
          try {
            const { generateReceipt } = await import("../lib/receipt");
            await generateReceipt((btn as any)._comprobante);
            unlockModal();
            btn.textContent = "Descargar de nuevo";
          } catch (err) {
            console.error("Error generando PDF:", err);
            btn.textContent = "Descargar comprobante";
          }
          btn.disabled = false;
        });
      }
      (btn as any)._comprobante = comprobante;
      lockModal();
    }

    function resetModalState() {
      restoreSuccessState();
      goToStep(1);
      clearErrors();
      ocultarCamposPersonales();
      // Limpiar todos los campos del paso 1
      (document.getElementById("ruc") as HTMLInputElement).value = "";
      (document.getElementById("nombre") as HTMLInputElement).value = "";
      (document.getElementById("telefono") as HTMLInputElement).value = "";
      (document.getElementById("email") as HTMLInputElement).value = "";
      document.getElementById("rp-resume-banner")?.remove();
      document.getElementById("rp-opciones-panel")?.remove();
      document.getElementById("rp-info-banner")?.remove();
      sessionStorage.removeItem("formulang_idCliente");
      sessionStorage.removeItem("formulang_idRegistroPendiente");
      sessionStorage.removeItem("formulang_idPlanPendiente");
      sessionStorage.removeItem("formulang_idMembresiaAltaPendiente");
      sessionStorage.removeItem("formulang_idMembresiaActivar");
      sessionStorage.removeItem("formulang_idsMembresiasActivar");
      sessionStorage.removeItem("formulang_idVehiculo");
      modoNuevoVehiculo = false;
      modoVehiculoConservado = false;
      modoActualizarVehiculo = false;
      cuentaExpulsadaActual = false;
      lastLookedUpCI = "";
      lookupInProgress = false;
      // Ocultar inputs de "Otro" y limpiar valores
      const _otrosRow = document.getElementById("otros-row") as HTMLElement | null;
      if (_otrosRow) _otrosRow.style.display = "none";
      (document.getElementById("marcaNueva-group") as HTMLElement | null)?.style && ((document.getElementById("marcaNueva-group") as HTMLElement).style.display = "none");
      (document.getElementById("modeloNuevo-group") as HTMLElement | null)?.style && ((document.getElementById("modeloNuevo-group") as HTMLElement).style.display = "none");
      (document.getElementById("marcaNueva") as HTMLInputElement | null) && ((document.getElementById("marcaNueva") as HTMLInputElement).value = "");
      (document.getElementById("modeloNuevo") as HTMLInputElement | null) && ((document.getElementById("modeloNuevo") as HTMLInputElement).value = "");
      form.style.display = "";
      bancardContainer.style.display = "none";
      _submitPendingAfterTs = false;
      _chapaMarcadaParaRevisionManual = false;
      document.getElementById("chapa-duplicada-dialogo")?.remove();
      hideTurnstileStep3();
      clearTurnstileSubmitError();

      successDiv.style.display = "none";
      submitBtn.disabled = false;
      submitText.style.display = "inline";
      submitLoading.style.display = "none";
      submitLoading.textContent = "Procesando...";
    }

    // ---- Fetch with timeout ----
    function fetchWithTimeout(url: string, options: RequestInit = {}, timeoutMs = 30000): Promise<Response> {
      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), timeoutMs);
      return fetch(url, { ...options, signal: controller.signal })
        .catch((err) => {
          if (err.name === "AbortError") {
            throw new Error("La solicitud tardó demasiado. Verificá tu conexión e intentá de nuevo.");
          }
          throw err;
        })
        .finally(() => clearTimeout(timer));
    }

    async function membresiasV2Habilitadas(): Promise<boolean> {
      if (membresiasV2EnabledCache !== null) return membresiasV2EnabledCache;
      membresiasV2EnabledCache = await consultarDisponibilidadMembresiasV2();
      return membresiasV2EnabledCache;
    }

    async function redirigirACatastroV2(input: {
      idCliente: string;
      idCotizacion: string;
      tipoOperacion: "ALTA" | "REACTIVACION";
    }): Promise<void> {
      const preparado = await prepararCatastroMembresiaV2({
        idCliente: input.idCliente,
        idCotizacion: input.idCotizacion,
      });
      const idMembresia = preparado.materializacion?.idMembresia;
      if (!idMembresia || !preparado.catastro?.url) {
        throw new Error("No se pudo preparar el registro seguro de la tarjeta.");
      }
      guardarContextoMembresiaV2(sessionStorage, {
        idCliente: input.idCliente,
        idMembresia,
        idCotizacion: input.idCotizacion,
        token: preparado.catastro.token,
        tipoOperacion: input.tipoOperacion,
      });
      if (input.tipoOperacion === "ALTA") {
        sessionStorage.setItem(
          "formulang_idMembresiaAltaPendiente",
          idMembresia,
        );
      }
      // La navegación al catastro es parte normal del flujo V2. Liberar el
      // guard evita que el navegador muestre "Es posible que los cambios no se
      // guarden" antes de abrir la página segura de registro de tarjeta.
      _modalDirty = false;
      _modalLocked = false;
      updateBeforeUnload();
      window.location.assign(preparado.catastro.url);
    }

    async function iniciarAltaMembresiaV2(
      idCliente: string,
      idRegistroPendiente: string,
    ): Promise<void> {
      submitLoading.textContent = "Calculando cobro inicial...";
      const cotizacion = await cotizarAltaMembresiaV2({
        idCliente,
        idRegistroPendiente,
      });
      submitLoading.textContent = "Preparando registro seguro...";
      await redirigirACatastroV2({
        idCliente,
        idCotizacion: cotizacion.idCotizacion,
        tipoOperacion: "ALTA",
      });
    }

    async function iniciarReactivacionMembresiaV2(
      idCliente: string,
      idMembresia: string,
    ): Promise<void> {
      showProcessing();
      try {
        const cotizacion = await cotizarReactivacionMembresiaV2({
          idCliente,
          idMembresia,
        });
        await redirigirACatastroV2({
          idCliente,
          idCotizacion: cotizacion.idCotizacion,
          tipoOperacion: "REACTIVACION",
        });
      } catch (error) {
        showResult(
          "No pudimos iniciar la reactivación",
          error instanceof Error ? error.message : "Intentá nuevamente.",
          true,
        );
      }
    }

    async function continuarCatastroMembresiaV2(input: {
      idCliente: string;
      idCotizacion: string;
      tipoOperacion: "ALTA" | "REACTIVACION";
    }): Promise<void> {
      showProcessing();
      try {
        await redirigirACatastroV2(input);
      } catch (error) {
        showResult(
          "No pudimos continuar el registro",
          error instanceof Error ? error.message : "Intentá nuevamente.",
          true,
        );
      }
    }

    async function cambiarTarjetaMembresiaV2(
      idCliente: string,
      idMembresia: string,
    ): Promise<void> {
      showProcessing();
      try {
        const preparado = await prepararCambioTarjetaMembresiaV2({
          idCliente,
          idMembresia,
        });
        if (!preparado.catastro?.url) {
          throw new Error("No se pudo generar el enlace seguro de tarjeta.");
        }
        guardarContextoMembresiaV2(sessionStorage, {
          idCliente,
          idMembresia,
          idCotizacion: null,
          token: preparado.catastro.token,
          tipoOperacion: "CAMBIO_TARJETA",
        });
        // El cambio de tarjeta también es una salida esperada hacia el
        // catastro seguro, por lo que no debe activar la advertencia nativa.
        _modalDirty = false;
        _modalLocked = false;
        updateBeforeUnload();
        window.location.assign(preparado.catastro.url);
      } catch (error) {
        showResult(
          "No pudimos preparar el cambio de tarjeta",
          error instanceof Error ? error.message : "Intentá nuevamente.",
          true,
        );
      }
    }

    // ---- Auto-debit: día calculado automáticamente al activar ----
    // No se muestra selector; se usa el día del mes de la fecha de activación (estilo Netflix)

    // ---- Plan metadata map (UUID → display info) ----
    const PLAN_META: Record<string, { name: string; price: string }> = {
      "a9ee77bc-96ce-4217-ad0f-c817b9e58687": { name: "Plan Fórmula",            price: "200.000" },
      "7ad4bfae-b1f2-47c9-8c3c-d4615607ad04": { name: "Plan Premium",            price: "250.000" },
      "5a9b7b48-2e37-45f2-8ba9-f1a234b85f80": { name: "Plan Gold",               price: "350.000" },
      "ae949f1e-90c5-4d4e-879c-3e2724c89c79": { name: "Plan Lavado a Domicilio", price: "500.000" },
    };

    function currentPlanMeta() {
      const id = _pendingPlanId
        || (document.getElementById("idPlan") as HTMLInputElement)?.value
        || "";
      return PLAN_META[id] || { name: "Plan Fórmula", price: "200.000" };
    }

    function updateModalHeader(planId?: string) {
      const meta = planId ? (PLAN_META[planId] || { name: "Plan Fórmula", price: "200.000" }) : { name: "tu plan", price: "—" };
      const headerName  = document.getElementById("modal-plan-name");
      const headerPrice = document.getElementById("modal-plan-price");
      const headerBadge = document.getElementById("modal-plan-badge");
      if (headerName)  headerName.textContent  = meta.name;
      if (headerPrice) headerPrice.textContent = meta.price !== "—" ? `Gs. ${meta.price}` : "—";
      if (headerBadge) headerBadge.textContent = meta.name && meta.name !== "tu plan" ? meta.name : "Plan";

      // También actualiza el subtítulo del checkout de Bancard
      const checkoutInfo = document.getElementById("checkout-plan-info");
      if (checkoutInfo && meta.name !== "tu plan") {
        checkoutInfo.textContent =
          `Ingresá los datos de tu tarjeta para habilitar el débito automático y activar tu ${meta.name}.`;
      }
    }

    // ---- Open / Close Modal ----
    let _pendingPlanId: string | undefined;

    function openModal(options?: { planId?: string }) {
      // Sincronizar estado del token con el widget actual al abrir el modal
      const tsField = document.querySelector("[name='cf-turnstile-response']") as HTMLInputElement | null;
      if (tsField?.value) {
        _tsTokenReady = true;
        _tsTokenValue = tsField.value;
      }

      // Preserve planId: if called without options (e.g. from Bancard callback),
      // restore from sessionStorage so currentPlanMeta() keeps working.
      if (options?.planId) {
        _pendingPlanId = options.planId;
        sessionStorage.setItem("formulang_planId", _pendingPlanId);
      } else if (!_pendingPlanId) {
        _pendingPlanId = sessionStorage.getItem("formulang_planId") || undefined;
      }
      updateModalHeader(_pendingPlanId);
      resetModalState();
      modal.style.display = "flex";
      document.body.style.overflow = "hidden";
      document.documentElement.style.overflow = "hidden";
      if (!marcasLoaded) loadMarcas();
      // Meta Pixel: InitiateCheckout
      if (typeof (window as any).fbq === "function") {
        (window as any).fbq("track", "InitiateCheckout", {
          content_name: "Membresia Fórmula NG",
          currency: "PYG",
        });
      }
      if (!planesLoaded) loadPlanes(_pendingPlanId);
      else if (_pendingPlanId) preselectPlanById(_pendingPlanId);
      // Iniciar refresh proactivo de Turnstile (cada 240s) mientras el modal
      // esté abierto, para evitar que el token expire antes del submit.
      startProactiveTurnstileRefresh();
    }

    function preselectPlanById(planId: string) {
      const container = document.getElementById("planes-container") as HTMLElement;
      // Aplicar estado visual directamente sin click
      container.querySelectorAll<HTMLElement>(".plan-card").forEach(c => {
        const isTarget = c.getAttribute("data-plan-id") === planId;
        c.classList.toggle("selected", isTarget);
        c.classList.toggle("plan-card-hidden", !isTarget);
        c.style.display = isTarget ? "" : "none";
      });
      // Actualizar campo oculto e header
      const card = container.querySelector<HTMLElement>(`[data-plan-id="${planId}"]`);
      if (!card) return;
      (document.getElementById("idPlan") as HTMLInputElement).value = planId;
      const planPrice = card.getAttribute("data-plan-price") || "";
      const planName = (card.querySelector(".plan-name") as HTMLElement)?.textContent?.trim() || "plan";
      const priceSpan = document.getElementById("auto-debit-price");
      if (priceSpan && planPrice) priceSpan.textContent = `Gs. ${planPrice}`;
      const headerName = document.getElementById("modal-plan-name");
      const headerPrice = document.getElementById("modal-plan-price");
      if (headerName) headerName.textContent = planName;
      if (headerPrice && planPrice) headerPrice.textContent = `Gs. ${planPrice}`;

      logEvent({
        paso: "select_plan",
        severidad: "info",
        codigo: "PRESELECT",
        contexto: {
          idPlan: planId,
          precioMostrado: planPrice,
          planName,
          source: "preselect",
        },
      });
    }

    let _modalLocked = false;   // true = bloqueo total (iframe/cobro en curso)
    let _modalDirty = false;    // true = datos cargados, pedir confirmación al salir

    function closeModal() {
      if (_modalLocked) return;

      // Opción C (Fix bloqueo cierre iframe): si el iframe de pasarela está
      // abierto, pedir confirmación específica antes de cerrar. NO se usa
      // `beforeunload` para no romper el redirect top-level de uPay al
      // finalizar el catastro — esto solo intercepta cierres explícitos
      // (X, ESC, click en overlay).
      const iframeAbierto = bancardContainer?.style.display === "block";
      if (iframeAbierto && !_bancardResponseHandled) {
        const ok = confirm(
          "¿Cancelar el pago? El proceso de cobro se interrumpirá y vas a tener que empezar de nuevo.",
        );
        if (!ok) return;
        logEvent({
          paso: "bancard_response",
          severidad: "warn",
          codigo: "CIERRE_MANUAL_IFRAME",
          mensaje: "Cliente cerró el modal manualmente con el iframe de pasarela abierto",
          contexto: {
            proveedor: _bancardProveedorActual,
            segundosAbierto:
              _bancardIframeOpenSince != null
                ? Math.round((Date.now() - _bancardIframeOpenSince) / 1000)
                : null,
          },
        });
      } else if (_modalDirty) {
        if (!confirm("¿Estás seguro que querés salir? Se perderán los datos ingresados.")) return;
      }
      logAbandonoBancardSiAplica("cerro_modal");
      endBancardLifecycle();
      _modalDirty = false;
      _modalLocked = false;
      updateBeforeUnload();
      modal.style.display = "none";
      document.body.style.overflow = "";
      document.documentElement.style.overflow = "";
      // Detener refresh proactivo de Turnstile — se reinicia en el próximo openModal()
      stopProactiveTurnstileRefresh();
      resetModalState();
    }

    // Expose globally so Hero can call it
    (window as any).__openRegistroModal = openModal;

    closeBtn?.addEventListener("click", closeModal);
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });

    // ESC key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal.style.display === "flex") closeModal();
    });

    // ---- Step Navigation ----
    function goToStep(step: number) {
      currentStep = step;
      if (step >= 2) _modalDirty = true;
      document.querySelectorAll(".form-step").forEach((el) => {
        const isActive = el.getAttribute("data-step") === String(step);
        (el as HTMLElement).classList.toggle("active", isActive);
        // Step 1 contiene el widget de Turnstile — nunca debe ser display:none
        // porque el SDK de Cloudflare necesita el iframe en el render tree para
        // poder auto-refrescar el token mientras el usuario está en Steps 2/3.
        if (el.getAttribute("data-step") === "1") {
          if (isActive) {
            (el as HTMLElement).style.cssText = "";
          } else {
            (el as HTMLElement).style.cssText =
              "display:block;position:absolute;left:-9999px;top:0;pointer-events:none;";
          }
        }
      });
      document.querySelectorAll(".step-dot").forEach((el) => {
        const s = Number(el.getAttribute("data-step"));
        el.classList.toggle("active", s === step);
        el.classList.toggle("completed", s < step);
      });
      document.querySelectorAll(".step-label").forEach((el) => {
        el.classList.toggle("active", el.getAttribute("data-step") === String(step));
      });
      // Stepper unificado (.step-item) — sincronizar con el step actual
      document.querySelectorAll(".step-item").forEach((el) => {
        const s = Number(el.getAttribute("data-step-item"));
        el.classList.toggle("active", s === step);
        el.classList.toggle("done", s < step);
      });

      // Footer dinámico: paso 1 usa #step1-actions interno; pasos 2/3 usan footer
      const footer = document.getElementById("form-actions-footer") as HTMLElement | null;
      const btnPrevFooter = document.getElementById("btn-prev-footer") as HTMLElement | null;
      const btnNextFooter = document.getElementById("btn-next-footer") as HTMLElement | null;
      const btnSubFooter = document.getElementById("btn-submit") as HTMLElement | null;
      const secureNote = document.getElementById("secure-note") as HTMLElement | null;
      if (footer && btnPrevFooter && btnNextFooter && btnSubFooter) {
        if (step === 1) {
          footer.style.display = "none";
          if (secureNote) secureNote.style.display = "none";
        } else {
          footer.style.display = "";
          if (secureNote) secureNote.style.display = step === 3 ? "" : "none";
          btnPrevFooter.style.display = "";
          btnPrevFooter.setAttribute("data-prev", String(step - 1));
          if (step === 3) {
            btnNextFooter.style.display = "none";
            btnSubFooter.style.display = "";
          } else {
            btnNextFooter.style.display = "";
            btnNextFooter.setAttribute("data-next", String(step + 1));
            btnSubFooter.style.display = "none";
          }
        }
      }

      // Al llegar a step 3, asegurar que el plan quede visualmente seleccionado
      if (step === 3 && planesLoaded && _pendingPlanId) {
        requestAnimationFrame(() => preselectPlanById(_pendingPlanId!));
      }

      // Scroll body to top
      const body = document.querySelector(".modal-body") as HTMLElement | null;
      if (body) body.scrollTop = 0;
    }

    // Payment method toggle (Bancard / Upay)
    const metodoPagoHintNombre = document.getElementById("metodo-pago-hint-nombre");
    document.querySelectorAll<HTMLButtonElement>(".pay-btn[data-method]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const method = btn.getAttribute("data-method") || "upay";
        document.querySelectorAll<HTMLButtonElement>(".pay-btn[data-method]").forEach((b) => {
          const isActive = b === btn;
          b.classList.toggle("active", isActive);
          b.setAttribute("aria-selected", String(isActive));
        });
        const hidden = document.getElementById("metodoPago") as HTMLInputElement | null;
        if (hidden) hidden.value = method;
        if (metodoPagoHintNombre) {
          metodoPagoHintNombre.textContent =
            method === "bancard"
              ? "Bancard (Visa / Mastercard)"
              : "Pagopar / Upay";
        }
      });
    });

    // Next buttons
    document.querySelectorAll(".btn-next[data-next]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const nextStep = Number((btn as HTMLElement).getAttribute("data-next"));
        if (validateStep(currentStep)) {
          // Refresh on-demand del Turnstile al entrar al paso final.
          // Garantiza que el usuario llegue al "Aceptar términos" con un token
          // recién emitido (~5 min de margen) y no se encuentre con el captcha
          // de fallback al hacer click en "Pagar ahora".
          if (currentStep === 2 && nextStep === 3) {
            try {
              const ts = (window as unknown as { turnstile?: TurnstileInstance }).turnstile;
              if (ts && typeof ts.reset === "function") {
                ts.reset();
                logEvent({
                  paso: "turnstile",
                  severidad: "info",
                  codigo: "TS_ONDEMAND_REFRESH_STEP3",
                });
              }
            } catch { /* swallow */ }
          }
          logEvent({
            paso: "wizard_step",
            severidad: "info",
            contexto: { from: currentStep, to: nextStep, direction: "next" },
          });
          goToStep(nextStep);
        } else {
          const camposInvalidos = Array.from(document.querySelectorAll(".invalid"))
            .map((el) => (el as HTMLElement).id || (el as HTMLElement).getAttribute("name") || "?");
          logEvent({
            paso: "validation_fail",
            severidad: "warn",
            codigo: `STEP_${currentStep}_INVALID`,
            contexto: { step: currentStep, campos: camposInvalidos },
          });
        }
      });
    });

    // Prev buttons
    document.querySelectorAll(".btn-prev[data-prev]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const prevStep = Number((btn as HTMLElement).getAttribute("data-prev"));
        logEvent({
          paso: "wizard_step",
          severidad: "info",
          contexto: { from: currentStep, to: prevStep, direction: "prev" },
        });
        goToStep(prevStep);
      });
    });

    // ---- Validation ----
    function validateStep(step: number): boolean {
      clearErrors();
      let valid = true;

      if (step === 1) {
        const nombre = (document.getElementById("nombre") as HTMLInputElement).value.trim();
        const ruc = (document.getElementById("ruc") as HTMLInputElement).value.replace(/\s+/g, "");
        const telefono = (document.getElementById("telefono") as HTMLInputElement).value.replace(/[^0-9]/g, "");
        const email = (document.getElementById("email") as HTMLInputElement).value.trim();

        if (!nombre) { showFieldError("nombre", "El nombre es requerido"); valid = false; }
        if (!ruc) { showFieldError("ruc", "El RUC/CI es requerido"); valid = false; }
        if (!telefono) {
          showFieldError("telefono", "El teléfono es requerido");
          valid = false;
        } else if (telefono.replace(/\D/g, "").length < 10) {
          showFieldError("telefono", "El teléfono debe tener al menos 10 dígitos");
          valid = false;
        }
        if (!email) {
          showFieldError("email", "El email es requerido para activar tu plan");
          valid = false;
        } else if (email && !email.match(/^[^\s@]+@[^\s@]+\.[^\s@]+$/)) {
          showFieldError("email", "Email inválido");
          valid = false;
        }
      }

      if (step === 2) {
        const chapa = (document.getElementById("chapa") as HTMLInputElement).value.trim();
        if (!chapa || chapa.length < 3) { showFieldError("chapa", "La chapa es requerida (mín. 3 caracteres)"); valid = false; }
        const idMarcaV = (document.getElementById("idMarca") as HTMLSelectElement).value;
        if (idMarcaV === "otro") {
          const mn = (document.getElementById("marcaNueva") as HTMLInputElement).value.trim();
          if (!mn) { showFieldError("marcaNueva", "Especificá la marca del vehículo"); valid = false; }
        }
        const idModeloV = (document.getElementById("idModelo") as HTMLSelectElement).value;
        if (idModeloV === "otro") {
          const mo = (document.getElementById("modeloNuevo") as HTMLInputElement).value.trim();
          if (!mo) { showFieldError("modeloNuevo", "Especificá el modelo del vehículo"); valid = false; }
        }
      }

      if (step === 3) {
        const acceptLegal = document.getElementById("acceptLegal") as HTMLInputElement;
        if (acceptLegal && !acceptLegal.checked) {
          const errorEl = document.getElementById("legal-accept-error");
          if (errorEl) errorEl.textContent = "Debés aceptar los Términos y Condiciones para continuar.";
          valid = false;
        }
      }

      return valid;
    }

    function showFieldError(fieldId: string, message: string) {
      const field = document.getElementById(fieldId);
      if (field) {
        field.classList.add("invalid");
        const errorSpan = field.parentElement?.querySelector(".field-error");
        if (errorSpan) errorSpan.textContent = message;
      }
    }

    function clearErrors() {
      document.querySelectorAll(".invalid").forEach(el => el.classList.remove("invalid"));
      document.querySelectorAll(".field-error").forEach(el => el.textContent = "");
      errorBanner.style.display = "none";
    }

    function normalizeText(value: unknown): string {
      return String(value || "")
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase();
    }

    function escapeHtml(value: unknown): string {
      return String(value || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/\"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function getPublicPlanName(plan: any): string {
      const n = normalizeText(plan?.nombre);
      if (n.includes("gold")) return "Plan Gold";
      if (n.includes("domicilio")) return "Plan Lavado a Domicilio";
      if (n.includes("premium") || n.includes("premiun")) return "Plan Premium";
      if (n.includes("formula") || n.includes("fórmula")) return "Plan Fórmula";
      return String(plan?.nombre || "Plan");
    }

    function getPublicPlanDescription(plan: any): string {
      const planDescription = String(plan?.descripcion || "").trim();
      const contractDescription =
        "Permanencia minima de 12 meses. Debito automatico obligatorio.";

      if (!planDescription) return contractDescription;

      return `${escapeHtml(planDescription).replace(/\n+/g, "<br />")}<br /><br />${contractDescription}`;
    }

    // ---- Load Marcas ----
    async function loadMarcas() {
      const select = document.getElementById("idMarca") as HTMLSelectElement;
      try {
        const res = await fetchWithTimeout("/api/marcas", {}, 15000);
        if (!res.ok) {
          const errBody = await res.json().catch(() => ({}));
          throw new Error(errBody.error || `Error ${res.status} al cargar marcas`);
        }
        const data = await res.json();
        if (Array.isArray(data)) {
          select.innerHTML = '<option value="">Seleccionar marca...</option>';
          data.forEach((marca: any) => {
            const opt = document.createElement("option");
            opt.value = marca.idMarca;
            opt.textContent = marca.nombre;
            select.appendChild(opt);
          });
          const otroMarca = document.createElement("option");
          otroMarca.value = "otro";
          otroMarca.textContent = "Otro";
          select.appendChild(otroMarca);
          marcasLoaded = true;
        } else {
          select.innerHTML = '<option value="">Error: respuesta inválida</option>';
        }
      } catch (err: any) {
        console.error("Error loading marcas:", err);
        select.innerHTML = `<option value="">Error al cargar marcas</option>`;
      }
    }

    // ---- Load Modelos (cascading) ----
    const marcaSelect = document.getElementById("idMarca") as HTMLSelectElement;
    const modeloSelect = document.getElementById("idModelo") as HTMLSelectElement;

    const otrosRow = document.getElementById("otros-row") as HTMLElement;
    const marcaNuevaGroup = document.getElementById("marcaNueva-group") as HTMLElement;
    const modeloNuevoGroup = document.getElementById("modeloNuevo-group") as HTMLElement;
    const marcaNuevaInput = document.getElementById("marcaNueva") as HTMLInputElement;
    const modeloNuevoInput = document.getElementById("modeloNuevo") as HTMLInputElement;

    function syncOtrosRow() {
      const anyVisible =
        marcaNuevaGroup.style.display !== "none" ||
        modeloNuevoGroup.style.display !== "none";
      otrosRow.style.display = anyVisible ? "" : "none";
    }

    marcaSelect?.addEventListener("change", async () => {
      const idMarca = marcaSelect.value;
      modeloSelect.innerHTML = '<option value="">Cargando...</option>';
      modeloSelect.disabled = true;
      modeloNuevoGroup.style.display = "none";

      if (!idMarca) {
        marcaNuevaGroup.style.display = "none";
        modeloSelect.innerHTML = '<option value="">Primero seleccioná la marca</option>';
        syncOtrosRow();
        return;
      }

      if (idMarca === "otro") {
        marcaNuevaGroup.style.display = "";
        modeloSelect.innerHTML = '<option value="">Seleccionar modelo...</option>';
        modeloSelect.disabled = true;
        modeloNuevoGroup.style.display = "";
        syncOtrosRow();
        return;
      }

      marcaNuevaGroup.style.display = "none";
      marcaNuevaInput.value = "";
      syncOtrosRow();

      try {
        const res = await fetchWithTimeout(`/api/modelos?idMarca=${idMarca}`, {}, 15000);
        if (!res.ok) {
          const errBody = await res.json().catch(() => ({}));
          throw new Error(errBody.error || `Error ${res.status} al cargar modelos`);
        }
        const data = await res.json();
        modeloSelect.innerHTML = '<option value="">Seleccionar modelo...</option>';
        if (Array.isArray(data)) {
          data.forEach((modelo: { idModelo: string; nombre: string }) => {
            const opt = document.createElement("option");
            opt.value = modelo.idModelo;
            opt.textContent = modelo.nombre;
            modeloSelect.appendChild(opt);
          });
        }
        const otroModelo = document.createElement("option");
        otroModelo.value = "otro";
        otroModelo.textContent = "Otro";
        modeloSelect.appendChild(otroModelo);
        modeloSelect.disabled = false;
      } catch (err: unknown) {
        modeloSelect.innerHTML = `<option value="">Error al cargar modelos</option>`;
        console.error("Error loading modelos:", err);
      }
    });

    modeloSelect?.addEventListener("change", () => {
      if (modeloSelect.value === "otro") {
        modeloNuevoGroup.style.display = "";
      } else {
        modeloNuevoGroup.style.display = "none";
        modeloNuevoInput.value = "";
      }
      syncOtrosRow();
    });

    // ---- Load Planes ----
    async function loadPlanes(planId?: string) {
      const container = document.getElementById("planes-container") as HTMLElement;
      try {
        const res = await fetchWithTimeout("/api/planes", {}, 15000);
        if (!res.ok) {
          const errBody = await res.json().catch(() => ({}));
          throw new Error(errBody.error || `Error ${res.status} al cargar planes`);
        }
        const rawPlans = await res.json();
        const allowedPlanIds = Object.keys(PLAN_META);
        const data = Array.isArray(rawPlans) ? rawPlans.filter((p: any) => allowedPlanIds.includes(p.idPlan)) : [];

        if (data.length > 0) {
          // Determinar cuál card mostrar primero (el plan pre-seleccionado o el primero)
          const selectedId = planId || data[0]?.idPlan || "";

          const cardsHtml = data.map((plan: any) => {
            const isSelected = plan.idPlan === selectedId;
            return `
              <div class="plan-card${isSelected ? " selected" : " plan-card-hidden"}" data-plan-id="${escapeHtml(plan.idPlan)}" data-plan-price="${Number(plan.precio).toLocaleString("es-PY")}">
                <div class="plan-card-badge">Plan oficial</div>
                <div class="plan-name">${escapeHtml(PLAN_META[plan.idPlan]?.name || getPublicPlanName(plan))}</div>
                <div class="plan-price">Gs. ${Number(plan.precio).toLocaleString("es-PY")}/mes</div>

                <div class="plan-check">&#10003;</div>
              </div>
            `;
          }).join("");

          container.innerHTML = cardsHtml + `
            <button type="button" id="btn-cambiar-plan" class="btn-cambiar-plan">
              Elegir otro plan
            </button>
          `;

          // Toggle: mostrar/ocultar todos los planes
          const btnCambiar = document.getElementById("btn-cambiar-plan") as HTMLButtonElement;
          let todosVisibles = false;
          btnCambiar.addEventListener("click", () => {
            todosVisibles = !todosVisibles;
            container.querySelectorAll<HTMLElement>(".plan-card-hidden").forEach(c => {
              c.style.display = todosVisibles ? "" : "none";
            });
            btnCambiar.textContent = todosVisibles ? "Ocultar planes" : "Elegir otro plan";
          });
          // Asegurar estado inicial oculto
          container.querySelectorAll<HTMLElement>(".plan-card-hidden").forEach(c => {
            c.style.display = "none";
          });

          // Plan selection click
          container.querySelectorAll(".plan-card").forEach((card) => {
            card.addEventListener("click", () => {
              container.querySelectorAll(".plan-card").forEach(c => c.classList.remove("selected"));
              card.classList.add("selected");
              const idPlanClickeado = (card as HTMLElement).getAttribute("data-plan-id") || "";
              (document.getElementById("idPlan") as HTMLInputElement).value = idPlanClickeado;

              const planPrice = (card as HTMLElement).getAttribute("data-plan-price") || "";
              const planName = (card.querySelector(".plan-name") as HTMLElement)?.textContent?.trim() || "plan";

              logEvent({
                paso: "select_plan",
                severidad: "info",
                codigo: "CLICK",
                contexto: { idPlan: idPlanClickeado, precioMostrado: planPrice, planName, source: "click" },
              });

              // Update auto-debit price display
              const priceSpan = document.getElementById("auto-debit-price");
              if (priceSpan && planPrice) priceSpan.textContent = `Gs. ${planPrice}`;

              // Update modal header
              const headerName = document.getElementById("modal-plan-name");
              const headerPrice = document.getElementById("modal-plan-price");
              if (headerName) headerName.textContent = planName;
              if (headerPrice && planPrice) headerPrice.textContent = `Gs. ${planPrice}`;

              // Al elegir un plan diferente, colapsar los otros
              if (todosVisibles) {
                todosVisibles = false;
                container.querySelectorAll<HTMLElement>(".plan-card-hidden").forEach(c => {
                  c.style.display = "none";
                });
                if (btnCambiar) btnCambiar.textContent = "Elegir otro plan";
              }
            });
          });

          // Pre-seleccionar (siempre via preselectPlanById para evitar que el
          // click handler quite la clase .selected de todos primero)
          planesLoaded = true;
          const toSelect = planId || selectedId;
          if (toSelect) preselectPlanById(toSelect);
        } else {
          container.innerHTML = '<div class="planes-loading">No hay planes disponibles en este momento.</div>';
        }
      } catch (err) {
        const container = document.getElementById("planes-container") as HTMLElement;
        container.innerHTML = '<div class="planes-loading">Error al cargar planes. Intente más tarde.</div>';
        console.error("Error loading planes:", err);
        logEvent({
          paso: "load_planes",
          severidad: "error",
          mensaje: err instanceof Error ? err.message : String(err),
          contexto: { stack: err instanceof Error ? err.stack : undefined },
        });
      }
    }

    // ---- Bancard iframe loading spinner helpers ----
    function showBancardLoading() {
      const spinner = document.getElementById("bancard-loading") as HTMLElement | null;
      const iframeDiv = document.getElementById("bancard-iframe") as HTMLElement | null;
      if (spinner) spinner.style.display = "block";
      if (iframeDiv) iframeDiv.style.display = "none";
    }

    function hideBancardLoading() {
      const spinner = document.getElementById("bancard-loading") as HTMLElement | null;
      const iframeDiv = document.getElementById("bancard-iframe") as HTMLElement | null;
      if (spinner) spinner.style.display = "none";
      if (iframeDiv) iframeDiv.style.display = "";
    }

    /**
     * Handler para la respuesta del iframe de Bancard.
     * Bancard SDK llama a este callback en lugar de hacer window.location.replace().
     * El objeto data contiene: { status, description, ... }
     */
    let _bancardResponseHandled = false;
    // Estado del ciclo de vida del iframe Bancard/Upay para detectar abandono y timeouts.
    let _bancardIframeOpenSince: number | null = null;
    let _bancardTimeoutId: ReturnType<typeof setTimeout> | null = null;
    let _bancardAbandonoLogged = false;
    let _bancardProveedorActual: "Bancard" | "uPay" | null = null;

    /**
     * Marca que el iframe de pasarela está abierto. Arranca un timeout de 90 s
     * que loguea si el SDK nunca llamó al responseHandler.
     */
    function startBancardLifecycle(proveedor: "Bancard" | "uPay") {
      _bancardIframeOpenSince = Date.now();
      _bancardAbandonoLogged = false;
      _bancardProveedorActual = proveedor;
      // El cliente ya fue creado en backend y el iframe de pasarela está abierto.
      // Para uPay especialmente, la pasarela hace un redirect top-level a /api/callback
      // al confirmar/rechazar el pago: si dejamos activo el guard de beforeunload
      // (vía _modalDirty), el navegador muestra "Es posible que los cambios no se
      // guarden" justo en ese redirect y obliga al usuario a confirmar manualmente.
      // Liberamos el guard acá; el botón de cerrar sigue oculto por bancardContainer.
      _modalDirty = false;
      _modalLocked = false;
      updateBeforeUnload();
      if (_bancardTimeoutId) clearTimeout(_bancardTimeoutId);
      _bancardTimeoutId = setTimeout(() => {
        if (_bancardResponseHandled) return;
        const segundos = Math.round((Date.now() - (_bancardIframeOpenSince ?? Date.now())) / 1000);
        logEvent({
          paso: "bancard_response",
          severidad: "error",
          codigo: "TIMEOUT_SIN_RESPUESTA",
          mensaje: `El iframe de ${proveedor} no respondió tras ${segundos}s`,
          contexto: { proveedor, segundos },
        });
      }, 90 * 1000);
    }

    /** Cancela el timeout pendiente y marca el iframe como cerrado limpio. */
    function endBancardLifecycle() {
      if (_bancardTimeoutId) {
        clearTimeout(_bancardTimeoutId);
        _bancardTimeoutId = null;
      }
      _bancardIframeOpenSince = null;
      _bancardProveedorActual = null;
    }

    /**
     * Loguea abandono si el cliente cierra/oculta la pestaña mientras el iframe
     * estaba abierto y sin respuesta. Se idempotente.
     */
    function logAbandonoBancardSiAplica(motivo: "cerro_pestana" | "cerro_modal") {
      if (_bancardAbandonoLogged) return;
      if (_bancardIframeOpenSince == null) return;
      if (_bancardResponseHandled) return;
      // uPay redirige window.top a /api/callback al finalizar el catastro: el
      // pagehide resultante NO es abandono. Si el cobro se concretó, /gracias
      // emitirá los eventos finales; si realmente se abandonó, la ausencia de
      // `confirmar` en la sesión ya lo refleja sin generar falso positivo.
      if (motivo === "cerro_pestana" && _bancardProveedorActual === "uPay") return;
      _bancardAbandonoLogged = true;
      const segundos = Math.round((Date.now() - _bancardIframeOpenSince) / 1000);
      logEvent({
        paso: "bancard_response",
        severidad: "warn",
        codigo: "ABANDONO_IFRAME",
        mensaje: `El cliente ${motivo === "cerro_pestana" ? "cerró la pestaña/recargó" : "cerró el modal"} con el iframe abierto sin completar`,
        contexto: { motivo, segundos },
      });
    }

    if (typeof window !== "undefined") {
      window.addEventListener("pagehide", () => logAbandonoBancardSiAplica("cerro_pestana"));
    }

    function preventUnload(e: BeforeUnloadEvent) {
      e.preventDefault();
    }

    function updateBeforeUnload() {
      if (_modalLocked || _modalDirty) {
        window.addEventListener("beforeunload", preventUnload);
      } else {
        window.removeEventListener("beforeunload", preventUnload);
      }
    }

    function lockModal() {
      _modalLocked = true;
      closeBtn.style.display = "none";
      updateBeforeUnload();
    }

    function unlockModal() {
      _modalLocked = false;
      closeBtn.style.display = "";
      updateBeforeUnload();
    }

    async function handleBancardResponse(data: any) {
      console.log("[Bancard responseHandler] data:", JSON.stringify(data));
      if (_bancardResponseHandled) {
        console.warn("[Bancard responseHandler] duplicate call ignored");
        return;
      }
      _bancardResponseHandled = true;
      endBancardLifecycle();

      // La tarjeta ya fue procesada dentro del iframe (catastro success o fail).
      // A partir de acá liberamos el bloqueo de unload/cierre: si Bancard/uPay
      // dispara una redirección top-level no queremos que el navegador muestre
      // el aviso de "¿salir de la página?".
      unlockModal();

      const status = data?.message || data?.status || data?.Status || "";
      const description = data?.details || data?.description || data?.Description || "";

      // Si el catastro falló, consultar a Pagopar el motivo real del rechazo
      // (dato mal cargado, tarjeta bloqueada, etc.) para enriquecer la telemetría
      let motivoPagopar: string | null = null;
      if (status !== "add_new_card_success") {
        const storedId = sessionStorage.getItem("formulang_idCliente");
        if (storedId) {
          try {
            const consultaRes = await fetch("/api/consultar-rechazo", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ idCliente: storedId }),
            });
            if (consultaRes.ok) {
              const consultaBody = await consultaRes.json();
              if (consultaBody.status === "rechazado" && consultaBody.motivo) {
                motivoPagopar = consultaBody.motivo;
              }
            }
          } catch {
            // non-blocking — la telemetría del rechazo de Bancard ya se registró
          }
        }
      }

      logEvent({
        paso: "bancard_response",
        severidad: status === "add_new_card_success" ? "info" : "warn",
        codigo: status || "BANCARD_UNKNOWN",
        mensaje: description || undefined,
        contexto: {
          status,
          description,
          raw: data,
          ...(motivoPagopar ? { motivoPagopar } : {}),
          processId: sessionStorage.getItem("formulang_processId") || null,
        },
      });

      if (status === "add_new_card_success") {
        // Tarjeta catastrada exitosamente — confirmar y cobrar.
        // Ocultamos el botón cerrar mientras corre /api/confirmar, pero NO
        // re-bloqueamos el unload: la tarjeta ya está confirmada en el iframe
        // y queremos permitir que un eventual redirect top-level fluya sin el
        // aviso del navegador.
        closeBtn.style.display = "none";
        const storedClienteId = sessionStorage.getItem("formulang_idCliente");
        const storedIdRegistroPendiente = sessionStorage.getItem("formulang_idRegistroPendiente");
        const storedIdMembresiaActivar = sessionStorage.getItem("formulang_idMembresiaActivar");
        const storedIdsMembresiasActivarRaw = sessionStorage.getItem("formulang_idsMembresiasActivar");
        let storedIdsMembresiasActivar: string[] = [];
        try {
          storedIdsMembresiasActivar = storedIdsMembresiasActivarRaw
            ? (JSON.parse(storedIdsMembresiasActivarRaw) as string[])
            : [];
        } catch { storedIdsMembresiasActivar = []; }

        if (!storedClienteId) {
          showResult("Error", "No se encontró el cliente. Intentá de nuevo.", true);
          return;
        }

        bancardContainer.style.display = "none";
        showProcessing();

        const confirmPayload: Record<string, any> = { idCliente: storedClienteId, acceptTerminos: true };
        if (storedIdRegistroPendiente) confirmPayload.idRegistroPendiente = storedIdRegistroPendiente;
        if (storedIdsMembresiasActivar.length > 0) confirmPayload.idsMembresiasActivar = storedIdsMembresiasActivar;
        else if (storedIdMembresiaActivar) confirmPayload.idMembresiaActivar = storedIdMembresiaActivar;

        // Llamar a /api/confirmar — ahora el backend responde al instante
        // con los datos del catastro. El cobro se procesa en segundo plano
        // con 40s de delay (antifraude bancario).
        fetch("/api/confirmar", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(confirmPayload),
        })
          .then(async (res) => {
            const body = await res.json().catch(() => ({}));

            if (!res.ok) {
              const errMsg = body.error || body.message || "El cobro fue rechazado.";
              logEvent({
                paso: "confirmar",
                severidad: "error",
                codigo: `HTTP_${res.status}`,
                mensaje: errMsg,
                contexto: {
                  httpStatus: res.status,
                  escenario: "post_bancard_catastro",
                  pagoparErrorMessage: body.pagoparErrorMessage ?? null,
                  bancardReason: body.bancardReason ?? null,
                  idTransaccion: body.idTransaccion ?? null,
                },
              });
              unlockModal();
              showResult(
                "Cobro rechazado",
                `Tu tarjeta fue registrada, pero el cobro fue rechazado (${errMsg}). El sistema reintentará automáticamente.`,
                true,
              );
              const retryPayBtn = document.createElement("button");
              retryPayBtn.type = "button";
              retryPayBtn.className = "btn-next";
              retryPayBtn.style.marginTop = "1rem";
              retryPayBtn.textContent = "Reintentar cobro";
              retryPayBtn.addEventListener("click", () => {
                retryPayBtn.disabled = true;
                retryPayBtn.textContent = "Procesando...";
                fetch("/api/confirmar", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify(confirmPayload),
                }).then(() => { window.location.reload(); });
              });
              successDiv.appendChild(retryPayBtn);
              return;
            }

            // Éxito — redirigir a /gracias con los datos del catastro
            const params = new URLSearchParams({ checkout: "ok" });
            if (body.cobroDiferido) params.set("cobroDiferido", "true");
            if (body.idMembresia) params.set("idMembresia", body.idMembresia);
            if (body.comprobante?.numeroComprobante) {
              params.set("numeroComprobante", String(body.comprobante.numeroComprobante));
            }

            // Datos del catastro para mostrar en /gracias
            const cat = body.catastro;
            if (cat) {
              if (cat.cliente?.nombre) params.set("nombre", cat.cliente.nombre);
              if (cat.cliente?.ci) params.set("ci", cat.cliente.ci);
              if (cat.membresia?.codigo) params.set("codigo", cat.membresia.codigo);
              if (cat.membresia?.plan) params.set("plan", cat.membresia.plan);
              if (cat.vehiculo?.chapa) {
                // Strip del sufijo "DP" (revisión manual, Fix 4) antes de mostrar
                // al cliente. Seguro: no hay chapas legítimas terminando en DP.
                params.set("chapa", String(cat.vehiculo.chapa).replace(/DP$/, ""));
              }
              if (cat.vehiculo?.descripcion) params.set("vehiculo", cat.vehiculo.descripcion);
              if (cat.tarjeta?.numero) params.set("tarjeta", cat.tarjeta.numero);
              if (cat.tarjeta?.marca) params.set("tarjetaMarca", cat.tarjeta.marca);
              if (cat.fechaProximoDebito) params.set("fechaProximoDebito", cat.fechaProximoDebito);
            }

            logEvent({
              paso: "confirmar",
              severidad: body.cobroDiferido ? "warn" : "info",
              codigo: body.cobroDiferido ? "CONFIRMAR_OK_CATASTRO" : "CONFIRMAR_OK",
              contexto: { escenario: "bancard_catastro_ok", debitoActivado: !!body.debitoActivado },
            });

            // Fix 3: éxito completo → limpiar contexto de intento fallido
            limpiarContextoFallo();
            window.location.href = `/gracias?${params.toString()}`;
          })
          .catch(() => {
            unlockModal();
            showResult(
              "Error de conexión",
              "No se pudo confirmar. Intentá de nuevo o contactanos por WhatsApp.",
              true,
            );
          });
      } else {
        // Error en catastro
        bancardContainer.style.display = "none";
        const storedClienteId = sessionStorage.getItem("formulang_idCliente");

        // Fix 3: persistir contexto del fallo en localStorage con TTL 24h.
        // Si el cliente cierra el navegador y vuelve más tarde con la misma CI,
        // el lookup podrá restaurar idCliente y evitar el 409 por CI duplicada.
        if (storedClienteId) {
          const ciActual = (document.getElementById("ruc") as HTMLInputElement | null)?.value || "";
          persistRecuperacionPostFallo(ciActual, storedClienteId);
        }

        const renderError = (msg: string) => {
          const currentMethod = (document.getElementById("metodoPago") as HTMLInputElement | null)?.value || "upay";
          const currentLabel  = currentMethod === "bancard" ? "Bancard" : "Upay";
          if (storedClienteId) {
            showResult(
              `Rechazo de ${currentLabel}`,
              `${msg} Podés reintentar con otra tarjeta o probar con el método alternativo.`,
              true,
            );
            const retryBtn = document.createElement("button");
            retryBtn.type = "button";
            retryBtn.style.cssText =
              "margin-top:1rem;padding:0.6rem 1.4rem;background:#f9a606;border:none;border-radius:8px;" +
              "color:#111;font-weight:700;cursor:pointer;font-size:0.95rem;display:block;width:100%;";
            retryBtn.textContent = "Reintentar con otra tarjeta";
            retryBtn.addEventListener("click", () => {
              if (retryBtn.disabled) return;
              retryBtn.disabled = true;
              startRetryCheckout(storedClienteId);
            });
            successDiv.appendChild(retryBtn);
            if (providerSelectorEnabled) {
              successDiv.appendChild(createAltMethodBtn(storedClienteId));
            }
          } else {
            showResult("Error al registrar tarjeta", msg, true);
          }
        };

        if (description) {
          // Mostrar el motivo real de Pagopar si lo tenemos; si no, el de Bancard
          const msjPrincipal = motivoPagopar || description;
          const msjSecundario = motivoPagopar
            ? `Bancard: ${description}`
            : null;
          renderError(msjPrincipal);
          if (msjSecundario) {
            const extra = document.createElement("p");
            extra.style.cssText = "margin-top:0.5rem;font-size:0.75rem;color:rgba(255,255,255,0.45);";
            extra.textContent = msjSecundario;
            successDiv.appendChild(extra);
          }
        } else if (storedClienteId) {
          // El SDK no entregó description; preguntar al backend el motivo real.
          showProcessing();
          fetch("/api/consultar-rechazo", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ idCliente: storedClienteId }),
          })
            .then(async (r) => {
              const body = await r.json().catch(() => ({}));
              const motivo = (r.ok && body?.motivo) || body?.error || "No se pudo registrar la tarjeta.";
              renderError(motivo);
            })
            .catch(() => {
              renderError("No se pudo registrar la tarjeta.");
            });
        } else {
          renderError("No se pudo registrar la tarjeta.");
        }
      }
    }

    /**
     * Shows the red loading spinner and hides #bancard-iframe while Bancard SDK
     * loads. Uses MutationObserver to detect the injected <iframe>, then waits
     * for its load event (or a 15 s fallback). Guarantees the spinner is visible
     * for at least 400 ms so the browser has time to paint it.
     */
    function waitForBancardIframe() {
      showBancardLoading();
      const container = document.getElementById("bancard-iframe") as HTMLElement;
      if (!container) return;

      const shownAt = Date.now();
      const MIN_VISIBLE_MS = 400;

      function done() {
        const elapsed = Date.now() - shownAt;
        const delay = Math.max(0, MIN_VISIBLE_MS - elapsed);
        setTimeout(hideBancardLoading, delay);
      }

      const fallbackTimer = setTimeout(done, 15000);

      function forceIframeHeight(iframe: HTMLIFrameElement) {
        iframe.style.setProperty("height", "480px", "important");
        iframe.style.setProperty("min-height", "480px", "important");
        iframe.setAttribute("height", "480");
        iframe.scrollTop = 0;
      }

      const observer = new MutationObserver(() => {
        const iframe = container.querySelector("iframe");
        if (!iframe) return;
        observer.disconnect();
        forceIframeHeight(iframe);

        // Cross-origin iframes still fire the load event even if contentDocument is inaccessible.
        iframe.addEventListener("load", () => {
          forceIframeHeight(iframe);
          clearTimeout(fallbackTimer);
          done();
        }, { once: true });
      });

      observer.observe(container, { childList: true, subtree: true });
    }

    // Crea el botón "Probar con [método alternativo]" para el caso de rechazo.
    // Cambia el hidden `metodoPago` al método opuesto y relanza el checkout.
    function createAltMethodBtn(storedClienteId: string): HTMLButtonElement {
      const currentMethod = (document.getElementById("metodoPago") as HTMLInputElement | null)?.value || "upay";
      const altMethod = currentMethod === "bancard" ? "upay" : "bancard";
      const altLabel  = altMethod === "bancard" ? "Bancard (débito/crédito)" : "Upay (Visa / Mastercard)";

      const btn = document.createElement("button");
      btn.type = "button";
      btn.style.cssText =
        "margin-top:0.5rem;padding:0.6rem 1.4rem;background:#2d5be3;border:none;border-radius:8px;" +
        "color:#fff;font-weight:700;cursor:pointer;font-size:0.95rem;display:block;width:100%;";
      btn.textContent = `Probar con ${altLabel}`;
      btn.addEventListener("click", () => {
        if (btn.disabled) return;
        btn.disabled = true;
        const hidden = document.getElementById("metodoPago") as HTMLInputElement | null;
        if (hidden) hidden.value = altMethod;
        startRetryCheckout(storedClienteId);
      });
      return btn;
    }


    // ---- Retry checkout with another card (same idCliente + idRegistroPendiente) ----
    // Guard contra disparos múltiples: cada llamada a /api/checkout genera un nuevo
    // process_id en Pagopar e invalida el anterior. Doble-click o re-renders crearían
    // process_ids huérfanos que rompen el iframe ya abierto con "ID form no válido".
    let _checkoutInFlight = false;
    async function startRetryCheckout(idCliente: string, metodoPago: string = "upay") {
      if (_checkoutInFlight) return;
      _checkoutInFlight = true;
      _bancardResponseHandled = false; // reset para nuevo intento

      const idMembresiaActivar = sessionStorage.getItem("formulang_idMembresiaActivar");
      const idsMembresiasActivar = sessionStorage.getItem("formulang_idsMembresiasActivar");
      const escenarioRetry = idsMembresiasActivar
        ? "multi_membresias_activar"
        : idMembresiaActivar
          ? "activar_debito_membresia_existente"
          : "retry_tarjeta";

      logEvent({
        paso: "submit_registro",
        severidad: "info",
        codigo: "RETRY_CHECKOUT_START",
        contexto: {
          escenario: escenarioRetry,
          metodoPagoSolicitado: metodoPago,
          idMembresiaActivar: idMembresiaActivar ?? null,
          idsMembresiasActivar: idsMembresiasActivar ?? null,
        },
      });

      // Remove old retry buttons and reset to iframe state
      successDiv.querySelectorAll("#btn-download-receipt").forEach(b => b.remove());
      successDiv.style.display = "none";
      bancardContainer.style.display = "none";
      // Mostrar paso 3 en el stepper (registro de tarjeta = último paso)
      goToStep(3);

      try {
        const _retryCbUrl = new URL(`${window.location.origin}/api/callback`);
        _retryCbUrl.searchParams.set("idCliente", idCliente);
        _retryCbUrl.searchParams.set("acceptTerminos", "true");
        const _rpId = sessionStorage.getItem("formulang_idRegistroPendiente") || "";
        if (_rpId) _retryCbUrl.searchParams.set("idRegistroPendiente", _rpId);
        const _idMemActivar = sessionStorage.getItem("formulang_idMembresiaActivar") || "";
        if (_idMemActivar) _retryCbUrl.searchParams.set("idMembresiaActivar", _idMemActivar);
        const _idsMemRaw = sessionStorage.getItem("formulang_idsMembresiasActivar") || "";
        if (_idsMemRaw) _retryCbUrl.searchParams.set("idsMembresiasActivar", _idsMemRaw);

        const _retryMetodoPago = metodoPago;
        const checkoutRes = await fetchWithTimeout("/api/checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            idCliente,
            diaDebito: new Date().getDate(),
            urlRedirect: _retryCbUrl.toString(),
            metodoPago: _retryMetodoPago,
          }),
        }, 30000);

        const checkoutBody = await checkoutRes.json().catch(() => ({}));
        if (!checkoutRes.ok || !checkoutBody.processId) {
          console.error("[startRetryCheckout] Error:", checkoutRes.status, checkoutBody);
          const errMsg: string = checkoutBody?.error || checkoutBody?.message || "";
          // Fix 3: mapear motivos específicos de fallo a UX accionable.
          const motivoPlan =
            /plan.*(no.*resolub|no.*encontr|inv[aá]l)/i.test(errMsg) ||
            checkoutBody?.code === "PLAN_NO_RESOLUBLE";
          const motivoRegPend =
            /registro.*pendiente.*(no.*encontr|no.*exist)/i.test(errMsg) ||
            checkoutBody?.code === "REGISTRO_PENDIENTE_NOT_FOUND";

          logEvent({
            paso: "checkout",
            severidad: "error",
            codigo: motivoPlan
              ? "CHECKOUT_FAIL_PLAN_NO_RESOLUBLE"
              : motivoRegPend
                ? "CHECKOUT_FAIL_REG_PENDIENTE_NOT_FOUND"
                : `HTTP_${checkoutRes.status}`,
            mensaje: errMsg || `checkout HTTP ${checkoutRes.status}`,
            contexto: {
              httpStatus: checkoutRes.status,
              escenario: escenarioRetry,
              idCliente,
              body: checkoutBody,
            },
          });

          if (motivoPlan) {
            showFallback409WhatsApp(
              "No pudimos resolver tu plan para iniciar el cobro. Contactanos por WhatsApp y lo solucionamos en minutos.",
            );
            showResult("Plan no disponible", "Necesitamos asistencia para activar tu plan. Te derivamos a WhatsApp.", true);
            return;
          }
          showResult("Error", `No pudimos iniciar el proceso de pago (${errMsg || checkoutRes.status}). Intentá de nuevo más tarde.`, true);
          return;
        }
        logEvent({
          paso: "checkout",
          severidad: "info",
          codigo: "CHECKOUT_OK",
          contexto: {
            escenario: escenarioRetry,
            proveedor: checkoutBody?.proveedor,
            processId: !!checkoutBody?.processId,
          },
        });

        bancardContainer.style.display = "block";

        (document.querySelector(".modal-container") as HTMLElement | null)?.scrollTo({ top: 0 });
        const iframeDiv = document.getElementById("bancard-iframe") as HTMLElement;
        if (iframeDiv) iframeDiv.innerHTML = "";

        const retryProveedor: "Bancard" | "uPay" = checkoutBody.proveedor === "Bancard" ? "Bancard" : "uPay";

        if (retryProveedor === "uPay") {
          const upayIframe = document.createElement("iframe");
          upayIframe.src = `https://www.pagopar.com/upay-iframe/?id-form=${encodeURIComponent(checkoutBody.processId)}`;
          upayIframe.style.cssText = "width:100%;height:520px;border:0;display:block;";
            upayIframe.allow = "payment";
          upayIframe.addEventListener("load", () => {
            try {
              const href = upayIframe.contentWindow?.location.href ?? "";
              if (!href.startsWith(window.location.origin)) return;
              const qs = new URL(href).searchParams;
              const status = qs.get("status") || qs.get("checkout") || "";
              const description = qs.get("description") || qs.get("checkout_msg") || "";
              if (!_bancardResponseHandled) {
                handleBancardResponse({
                  status: status.includes("success") || status === "ok" ? "add_new_card_success" : "add_new_card_fail",
                  description,
                });
              }
            } catch { /* cross-origin: ignorar */ }
          });
          if (iframeDiv) iframeDiv.appendChild(upayIframe);
          startBancardLifecycle("uPay");
        } else {
          if (!(window as any).Bancard) {
            await new Promise<void>((resolve, reject) => {
              const script = document.createElement("script");
              script.src = "/bancard-checkout-5.0.1.js";
              script.onload = () => resolve();
              script.onerror = () => {
                logEvent({
                  paso: "bancard_response",
                  severidad: "error",
                  codigo: "SDK_LOAD_FAILED",
                  mensaje: "El SDK de Bancard no se pudo cargar (probable problema de red o CDN)",
                  contexto: { proveedor: "Bancard", scriptSrc: "/bancard-checkout-5.0.1.js", flujo: "retry_tarjeta" },
                });
                reject(new Error("Error al cargar Bancard SDK"));
              };
              document.head.appendChild(script);
            });
          }
          waitForBancardIframe();
          (window as any).Bancard.Cards.createForm("bancard-iframe", checkoutBody.processId, {
            responseHandler: handleBancardResponse,
            styles: BANCARD_DARK_STYLES,
          });
          startBancardLifecycle("Bancard");
        }
      } catch (err: unknown) {
        showResult("Error", (err instanceof Error ? err.message : null) || "Error al intentar de nuevo.", true);
      } finally {
        _checkoutInFlight = false;
      }
    }

    // ---- Turnstile helpers ----
    function getCurrentTurnstileToken(): string {
      const field = form.querySelector("[name='cf-turnstile-response']") as HTMLInputElement | null;
      return field?.value || _tsTokenValue;
    }

    // Para confirmarCI: espera hasta timeoutMs que el widget del Step 1 emita token
    async function waitForTurnstileToken(timeoutMs = 15000): Promise<string | null> {
      const existing = getCurrentTurnstileToken();
      if (existing) return existing;

      return new Promise<string | null>((resolve) => {
        let resolved = false;

        const timer = setTimeout(() => {
          if (resolved) return;
          resolved = true;
          _tsPendingResolves = _tsPendingResolves.filter((r) => r !== resolver);
          resolve(null);
        }, timeoutMs);

        const resolver = () => {
          if (resolved) return;
          resolved = true;
          clearTimeout(timer);
          resolve(_tsTokenValue || null);
        };

        _tsPendingResolves.push(resolver);
      });
    }

    function showTurnstileStep3() {
      const box = document.getElementById("ts-refresh-box");
      const widgetEl = document.getElementById("ts-step3-widget");
      if (!box || !widgetEl) return;
      // No renderizar si ya está visible con un widget activo
      if (box.style.display !== "none" && widgetEl.hasChildNodes()) return;
      // Limpiar widget anterior CORRECTAMENTE con turnstile.remove() antes de
      // hacer innerHTML="" — Cloudflare mantiene state interno de cada widget
      // y solo innerHTML deja widgets huérfanos (warning "Cannot find Widget").
      const tsApi = (window as unknown as { turnstile?: TurnstileInstance }).turnstile;
      if (tsApi && typeof tsApi.remove === "function") {
        try { tsApi.remove(widgetEl); } catch { /* widget no existía aún */ }
      }
      widgetEl.innerHTML = "";
      box.style.display = "block";
      // Scrollear dentro del modal (no el viewport)
      const modalContainer = document.querySelector(".modal-container");
      if (modalContainer) {
        const boxTop = box.getBoundingClientRect().top - modalContainer.getBoundingClientRect().top;
        modalContainer.scrollTo({ top: modalContainer.scrollTop + boxTop - 20, behavior: "smooth" });
      } else {
        box.scrollIntoView({ behavior: "smooth", block: "center" });
      }
      if (tsApi && _tsSiteKey) {
        tsApi.render(widgetEl, {
          sitekey: _tsSiteKey,
          theme: "dark",
          callback: (token: string) => { _winAny.__tsOnSuccess(token); },
          "expired-callback": () => { _winAny.__tsOnExpired(); },
          "error-callback": () => { _winAny.__tsOnError(); },
        });
      } else if (!_tsSiteKey) {
        widgetEl.innerHTML = '<p style="color:var(--text-secondary,#94a3b8);font-size:13px;text-align:center;">No se pudo cargar la verificación. Recargá la página e intentá nuevamente.</p>';
      }
    }

    function hideTurnstileStep3() {
      const box = document.getElementById("ts-refresh-box");
      const widgetEl = document.getElementById("ts-step3-widget");
      if (box) box.style.display = "none";
      // Llamar turnstile.remove() antes de borrar el contenedor para que
      // Cloudflare libere el widget de su tracking interno. Sin esto, queda
      // un widget huérfano y aparece "Cannot find Widget cf-chl-widget-XXX"
      // al siguiente intento.
      if (widgetEl) {
        const tsApi = (window as unknown as { turnstile?: TurnstileInstance }).turnstile;
        if (tsApi && typeof tsApi.remove === "function") {
          try { tsApi.remove(widgetEl); } catch { /* widget ya fue removido */ }
        }
        widgetEl.innerHTML = "";
      }
    }

    function showTurnstileSubmitError(msg: string) {
      const el = document.getElementById("turnstile-submit-error");
      if (!el) return;
      el.textContent = msg;
      el.style.display = "block";
      el.scrollIntoView({ behavior: "smooth", block: "center" });
    }

    function clearTurnstileSubmitError() {
      const el = document.getElementById("turnstile-submit-error");
      if (!el) return;
      el.textContent = "";
      el.style.display = "none";
    }

    // ---- CI lookup ----
    const rucInput = document.getElementById("ruc") as HTMLInputElement;

    async function dispararLookupCI(ci: string) {
      // Guardia anti race-condition: no relanzar si ya está en curso o para el mismo CI
      if (lookupInProgress || ci === lastLookedUpCI) return;
      lookupInProgress = true;
      lastLookedUpCI = ci;

      // Mostrar loading, ocultar campos mientras busca
      const loadingEl = document.getElementById("ci-lookup-loading") as HTMLElement | null;
      if (loadingEl) loadingEl.style.display = "";

      // Clear previous lookup state
      document.getElementById("rp-resume-banner")?.remove();
      document.getElementById("rp-opciones-panel")?.remove();
      document.getElementById("rp-info-banner")?.remove();
      document.getElementById("rp-cerrada-banner")?.remove();
      document.getElementById("rp-expulsada-banner")?.remove();
      document.getElementById("rp-reingreso-vehiculo-panel")?.remove();
      sessionStorage.removeItem("formulang_idCliente");
      sessionStorage.removeItem("formulang_idRegistroPendiente");
      sessionStorage.removeItem("formulang_idPlanPendiente");
      sessionStorage.removeItem("formulang_idMembresiaAltaPendiente");
      sessionStorage.removeItem("formulang_idMembresiaActivar");
      sessionStorage.removeItem("formulang_idsMembresiasActivar");
      sessionStorage.removeItem("formulang_idVehiculo");
      modoNuevoVehiculo = false;
      modoVehiculoConservado = false;
      modoActualizarVehiculo = false;
      cuentaExpulsadaActual = false;

      // Fix 3: restaurar contexto de intento fallido reciente desde localStorage.
      // Si la CI coincide con un fallo de catastro en las últimas 24h, prepoblar
      // sessionStorage para que el flujo retome desde donde quedó (modoNuevoVehiculo
      // o flujo de retry de tarjeta).
      const ctxFallo = recuperarContextoFallo(ci);
      if (ctxFallo) {
        sessionStorage.setItem("formulang_idCliente", ctxFallo.idCliente);
        if (ctxFallo.idRegistroPendiente) {
          sessionStorage.setItem("formulang_idRegistroPendiente", ctxFallo.idRegistroPendiente);
        }
        logEvent({
          paso: "submit_registro",
          severidad: "info",
          codigo: "FAILED_ATTEMPT_RESTORED",
          mensaje: "Contexto de intento fallido restaurado desde localStorage",
          contexto: { hasIdRegPendiente: !!ctxFallo.idRegistroPendiente, ageMs: Date.now() - ctxFallo.ts },
        });
      }

      try {
        const res = await fetchWithTimeout(
          `/api/registro-pendiente?ci=${encodeURIComponent(ci)}`,
          {},
          12000,
        );
        if (!res.ok) {
          // Error de red/servidor → revelar campos igual para no bloquear al usuario
          revelarCamposPersonales();
          return;
        }
        const data = await res.json().catch(() => null);
        if (!data?.found) {
          // CI no registrada → cliente nuevo, revelar campos vacíos
          // Fix 5: log para correlacionar con 409s posteriores (Bug 3: cliente
          // existente que el lookup no detectó porque no tiene membresía activa).
          logEvent({
            paso: "submit_registro",
            severidad: "info",
            codigo: "LOOKUP_NO_ENCONTRADO",
            contexto: { ci },
          });
          revelarCamposPersonales();
          return;
        }

        if (typeof data.membresiasV2Enabled === "boolean") {
          membresiasV2EnabledCache = data.membresiasV2Enabled;
        }

        // ---- Cuenta dada de baja (soft-deleted) ----
        // Mostrar banner explicativo y NO ofrecer el formulario; si lo dejaramos
        // proceder, el submit fallaría con "ya existe un RUC" después de tipear todo.
        if (data.cuentaCerrada) {
          const loadingElCerr = document.getElementById("ci-lookup-loading") as HTMLElement | null;
          if (loadingElCerr) loadingElCerr.style.display = "none";

          const step1ElCerr = rucInput.closest(".form-step");
          // Limpiar cualquier banner previo
          step1ElCerr?.querySelectorAll("#rp-resume-banner, #rp-info-banner, #rp-cerrada-banner")
            .forEach((b) => b.remove());

          const fechaCierre = data.fechaCierre
            ? new Date(data.fechaCierre).toLocaleDateString("es-PY", { day: "2-digit", month: "2-digit", year: "numeric" })
            : null;
          const nombreCensurado = censurar(data.nombre || "", 4);

          const banner = document.createElement("div");
          banner.id = "rp-cerrada-banner";
          banner.style.cssText = "margin-top:1rem;padding:1rem 1.1rem;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.35);border-radius:12px;font-size:0.9rem;color:#fca5a5;";
          banner.innerHTML =
            `<strong>Encontramos tu cuenta (${nombreCensurado})${fechaCierre ? `, dada de baja el ${fechaCierre}` : ""}.</strong><br/>` +
            `Para reactivarla, comunicate con nosotros por WhatsApp o teléfono. ` +
            `No podés registrarte como nuevo cliente con este mismo documento.`;
          step1ElCerr?.appendChild(banner);

          // Mantener los campos personales ocultos
          logEvent({
            paso: "validation_fail",
            severidad: "warn",
            codigo: "CUENTA_DADA_DE_BAJA",
            contexto: { ci, fechaCierre: data.fechaCierre ?? null },
          });
          return;
        }

        // ---- Cuenta expulsada ----
        // Una expulsión es permanente para nuevas altas: no se debe ofrecer
        // reactivación ni el alta de otro vehículo, aunque la membresía
        // original todavía conserve cobertura hasta su vencimiento.
        const cuentaExpulsada = Boolean(
          data.cuentaExpulsada ||
          data.mensajeCuenta ||
          data.membresias?.some((m: any) => Boolean(m.expulsada)),
        );
        if (cuentaExpulsada) {
          cuentaExpulsadaActual = true;
          const loadingElExp = document.getElementById("ci-lookup-loading") as HTMLElement | null;
          if (loadingElExp) loadingElExp.style.display = "none";

          const step1ElExp = rucInput.closest(".form-step");
          step1ElExp?.querySelectorAll("#rp-resume-banner, #rp-info-banner, #rp-opciones-panel, #rp-cerrada-banner, #rp-expulsada-banner")
            .forEach((b) => b.remove());

          const nombreCensurado = censurar(data.nombre || "", 4);
          const banner = document.createElement("div");
          banner.id = "rp-expulsada-banner";
          banner.style.cssText = "margin-top:1rem;padding:1rem 1.1rem;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.4);border-radius:12px;font-size:0.9rem;color:#fca5a5;";
          banner.innerHTML =
            `<strong>Hola ${nombreCensurado}. Esta cuenta está restringida.</strong><br/>` +
            "Por decisión interna, no podés reactivar la membresía ni registrar otro vehículo o una nueva membresía con este documento. Comunicate con nosotros si necesitás más información.";
          step1ElExp?.appendChild(banner);

          logEvent({
            paso: "validation_fail",
            severidad: "warn",
            codigo: "CUENTA_EXPULSADA",
            contexto: { ci },
          });
          return;
        }

        // Identidad verificada (cliente existente) — alert success
        const rucSuccess = document.getElementById("ruc-success") as HTMLElement | null;
        if (rucSuccess) rucSuccess.style.display = "flex";
        const loadingEl0 = document.getElementById("ci-lookup-loading") as HTMLElement | null;
        if (loadingEl0) loadingEl0.style.display = "none";

        // Helper to set a field value by id
        const setVal = (id: string, val: string | number | null | undefined) => {
          const el = document.getElementById(id) as HTMLInputElement | null;
          if (el && val != null && val !== "") el.value = String(val);
        };

        const step1El = rucInput.closest(".form-step");

        // ---- Scenario A: has pending registration ----
        if (data.registroPendiente) {
          const rp = data.registroPendiente;

          // Pre-fill step 1
          setVal("nombre", data.nombre);
          setVal("telefono", data.telefono);
          setVal("email", data.email);

          // Pre-fill step 2
          setVal("chapa", rp.chapa ? String(rp.chapa).toUpperCase() : null);
          if (rp.anio) setVal("anio", rp.anio);
          setVal("color", rp.color);
          if (rp.idTipoVehiculo) {
            const tipoSel = document.getElementById("tipoVehiculo") as HTMLSelectElement | null;
            if (tipoSel) tipoSel.value = String(rp.idTipoVehiculo);
          }
          if (rp.idMarca) {
            const marcaSel = document.getElementById("idMarca") as HTMLSelectElement | null;
            if (marcaSel) {
              marcaSel.value = String(rp.idMarca);
              marcaSel.dispatchEvent(new Event("change"));
              if (rp.idModelo) setTimeout(() => setVal("idModelo", rp.idModelo), 800);
            }
          }
          if (rp.idPlan) {
            setVal("idPlan", rp.idPlan);
            const planCard = document.querySelector(`[data-plan-id="${rp.idPlan}"]`);
            if (planCard) {
              document.querySelectorAll(".plan-card").forEach(c => c.classList.remove("selected"));
              planCard.classList.add("selected");
            }
          }

          sessionStorage.setItem("formulang_idCliente", data.idCliente);
          sessionStorage.setItem("formulang_idRegistroPendiente", rp.idRegistroPendiente);
          if (rp.idVehiculo) {
            sessionStorage.setItem("formulang_idVehiculo", rp.idVehiculo);
          }
          if (rp.idPlan) sessionStorage.setItem("formulang_idPlanPendiente", rp.idPlan);
          if (rp.flujoV2?.idMembresia) {
            sessionStorage.setItem(
              "formulang_idMembresiaAltaPendiente",
              rp.flujoV2.idMembresia,
            );
          } else {
            sessionStorage.removeItem("formulang_idMembresiaAltaPendiente");
          }

          const nombreCensurado = censurar(data.nombre, 4);
          const emailCensurado = censurarEmail(data.email);
          const banner = document.createElement("div");
          banner.id = "rp-resume-banner";
          banner.style.cssText = "margin-top:1rem;padding:0.85rem 1rem;background:rgba(249,166,6,0.12);border:1px solid rgba(249,166,6,0.35);border-radius:10px;font-size:0.85rem;color:#f9a606;";
          banner.innerHTML = `<strong>Encontramos tu registro: ${nombreCensurado}, ${emailCensurado}</strong><br/>Tus datos fueron completados automáticamente. Revisalos y continuá al pago.`;
          step1El?.appendChild(banner);
          const accionRp = rp.flujoV2?.accion;
          const idCotizacionRp = rp.flujoV2?.idCotizacion;
          if (
            data.membresiasV2Enabled &&
            (accionRp === "PREPARAR_CATASTRO" ||
              accionRp === "CONTINUAR_CATASTRO") &&
            idCotizacionRp
          ) {
            const continuar = document.createElement("button");
            continuar.type = "button";
            continuar.className = "btn-next";
            continuar.style.marginTop = "0.75rem";
            continuar.textContent = "Actualizar importe y continuar →";
            continuar.addEventListener("click", () => {
              if (rp.flujoV2?.tipoOperacion === "REACTIVACION") {
                const idMembresia = rp.flujoV2?.idMembresia;
                if (idMembresia) {
                  void iniciarReactivacionMembresiaV2(
                    data.idCliente,
                    idMembresia,
                  );
                }
                return;
              }
              void iniciarAltaMembresiaV2(
                data.idCliente,
                rp.idRegistroPendiente,
              );
            });
            banner.appendChild(continuar);
          } else if (
            data.membresiasV2Enabled &&
            accionRp === "ESPERAR_COBRO"
          ) {
            banner.innerHTML =
              `<strong>Encontramos tu registro: ${nombreCensurado}</strong><br/>` +
              "Tu tarjeta ya fue confirmada y el cobro está siendo procesado. No vuelvas a registrar otra tarjeta.";
            return;
          }
          revelarCamposPersonales();
          return;
        }

        // ---- Scenario B: existing membership(s), no pending registration ----
        if (data.membresias && data.membresias.length > 0) {
          sessionStorage.setItem("formulang_idCliente", data.idCliente);

          const nombreCensurado = censurar(data.nombre, 4);
          const planSeleccionado = _pendingPlanId || "";
          const membresiasV2 = data.membresias.filter(
            (m: any) => m.billingVersion === "V2",
          );
          const membresiasLegacy = data.membresias.filter(
            (m: any) => m.billingVersion !== "V2",
          );
          const memPagopar = membresiasLegacy.filter((m: any) => m.renovacionAutomatica);
          const memEfectivo = membresiasLegacy.filter((m: any) => !m.renovacionAutomatica);
          const hayPagopar = memPagopar.length > 0;
          const hayEfectivo = memEfectivo.length > 0;

          const accionesV2HTML = data.membresiasV2Enabled
            ? membresiasV2
                .map((m: any) => {
                  const accion = m.flujoV2?.accion;
                  const detalle = `Membresía ${escapeHtml(m.codigo)} · Chapa ${escapeHtml(censurar(m.chapa ?? "", 2))}`;
                  if (accion === "COTIZAR_REACTIVACION") {
                    return `<button type="button" class="rp-v2-action" data-v2-accion="${accion}" data-id-membresia="${escapeHtml(m.idMembresia)}" style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem 1rem;background:rgba(249,166,6,0.08);border:1px solid rgba(249,166,6,0.4);border-radius:10px;color:#fff;cursor:pointer;text-align:left;"><span style="font-size:1.3rem;">↻</span><span><strong style="display:block;font-size:0.875rem;">Reactivar membresía</strong><small style="color:#aaa;font-size:0.78rem;">${detalle}</small></span></button>`;
                  }
                  if (
                    (accion === "PREPARAR_CATASTRO" ||
                      accion === "CONTINUAR_CATASTRO") &&
                    m.flujoV2?.idCotizacion
                  ) {
                    return `<button type="button" class="rp-v2-action" data-v2-accion="${accion}" data-id-membresia="${escapeHtml(m.idMembresia)}" data-id-cotizacion="${escapeHtml(m.flujoV2.idCotizacion)}" data-tipo-operacion="${escapeHtml(m.flujoV2.tipoOperacion ?? "REACTIVACION")}" style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem 1rem;background:rgba(79,70,229,0.12);border:1px solid rgba(99,102,241,0.45);border-radius:10px;color:#fff;cursor:pointer;text-align:left;"><span style="font-size:1.3rem;">💳</span><span><strong style="display:block;font-size:0.875rem;">Continuar registro de tarjeta</strong><small style="color:#aaa;font-size:0.78rem;">${detalle}</small></span></button>`;
                  }
                  if (accion === "ESPERAR_COBRO") {
                    return `<div style="padding:0.75rem 1rem;background:rgba(34,197,94,0.08);border:1px solid rgba(34,197,94,0.35);border-radius:10px;color:#fff;"><strong style="display:block;font-size:0.875rem;color:#86efac;">Pago en procesamiento</strong><small style="color:#aaa;font-size:0.78rem;">${detalle}. No es necesario volver a registrar la tarjeta.</small></div>`;
                  }
                  if (accion === "GESTIONAR_TARJETA") {
                    return `<button type="button" class="rp-v2-action" data-v2-accion="${accion}" data-id-membresia="${escapeHtml(m.idMembresia)}" style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem 1rem;background:rgba(255,255,255,0.05);border:1px solid rgba(249,166,6,0.4);border-radius:10px;color:#fff;cursor:pointer;text-align:left;"><span style="font-size:1.3rem;">💳</span><span><strong style="display:block;font-size:0.875rem;">Actualizar tarjeta</strong><small style="color:#aaa;font-size:0.78rem;">${detalle}. No genera un cobro adicional.</small></span></button>`;
                  }
                  return "";
                })
                .join("")
            : "";

          // Débito automático activo con plan DISTINTO al seleccionado → bloquear
          const membresiaDebitoConPlanDistinto = memPagopar.find(
            (m: any) => m.idEstado === 1 && planSeleccionado && m.idPlan !== planSeleccionado,
          );

          if (membresiaDebitoConPlanDistinto) {
            const planActualMeta = PLAN_META[membresiaDebitoConPlanDistinto.idPlan as string];
            const planActualNombre = planActualMeta?.name ?? "tu plan actual";
            const planNuevoMeta = PLAN_META[planSeleccionado];
            const planNuevoNombre = planNuevoMeta?.name ?? "el plan seleccionado";
            const bannerBloqueo = document.createElement("div");
            bannerBloqueo.id = "rp-info-banner";
            bannerBloqueo.style.cssText = "margin-top:1rem;padding:1rem 1.1rem;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.35);border-radius:12px;font-size:0.85rem;";
            bannerBloqueo.innerHTML = `
              <p style="margin:0 0 0.45rem;font-weight:700;color:#ef4444;">🔒 Ya tenés débito automático activo</p>
              <p style="margin:0;color:rgba(255,255,255,0.65);line-height:1.5;">Tenés el <strong style="color:#fff;">${planActualNombre}</strong> con débito automático activo. Los cambios de plan no están disponibles desde esta página.<br/>Para cambiar al <strong style="color:#fff;">${planNuevoNombre}</strong>, contactá a soporte por WhatsApp.</p>
            `;
            step1El?.appendChild(bannerBloqueo);
            if (loadingEl) loadingEl.style.display = "none";
            return;
          }

          const btnActualizarHTML = hayPagopar ? `
            <button id="rp-btn-actualizar" type="button" style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem 1rem;background:rgba(255,255,255,0.05);border:1px solid rgba(249,166,6,0.4);border-radius:10px;color:#fff;cursor:pointer;text-align:left;">
              <span style="font-size:1.3rem;">💳</span>
              <span><strong style="display:block;font-size:0.875rem;">Actualizar tarjeta de débito</strong><small style="color:#aaa;font-size:0.78rem;">Registrá una nueva tarjeta para tu débito automático</small></span>
            </button>` : "";

          // Para membresía única: siempre mostrar código + chapa visibles al usuario
          const membershipInfoHTML = (m: any) =>
            `<p style="margin:0.4rem 0 0;padding-left:2.2rem;font-size:0.78rem;color:rgba(255,255,255,0.55);">Membresía <strong style="color:#fff;">${m.codigo}</strong> · Chapa <strong style="color:#fff;">${censurar(m.chapa ?? "", 2)}</strong></p>`;

          const dropdownEfectivo = memEfectivo.length > 1
            ? `<div id="rp-select-membresia-multi" class="rp-mem-list">
                <label class="rp-mem-row rp-mem-row-master">
                  <span class="rp-mem-label"><strong>Seleccionar todas</strong></span>
                  <span class="rp-switch"><input type="checkbox" id="rp-chk-all" /><span class="rp-slider"></span></span>
                </label>
                ${memEfectivo.map((m: any) => `
                  <label class="rp-mem-row">
                    <span class="rp-mem-label">Chapa <strong>${censurar(m.chapa ?? "", 2)}</strong> — ${m.codigo}</span>
                    <span class="rp-switch"><input type="checkbox" class="rp-chk-mem" value="${m.idMembresia}" /><span class="rp-slider"></span></span>
                  </label>`).join("")}
                <p id="rp-multi-hint" class="rp-mem-hint">Podés activar débito automático en una o varias membresías a la vez. Todas las seleccionadas pasarán al mismo plan.</p>
              </div>`
            : `<input type="hidden" id="rp-select-membresia" value="${memEfectivo[0]?.idMembresia ?? ""}"/>`;

          // Botones "Actualizar datos del vehículo" — solo para membresías NO activas (idEstado ≠ 1)
          const botonesActualizarVehiculoHTML = memEfectivo.filter((m: any) => m.idEstado !== 1).map((m: any, i: number) => `
            <button id="rp-btn-actualizar-vehiculo-${i}" type="button"
              data-id-vehiculo="${m.idVehiculo}"
              data-id-membresia="${m.idMembresia}"
              data-chapa="${m.chapa ?? ""}"
              data-id-marca="${m.idMarca ?? ""}"
              data-id-modelo="${m.idModelo ?? ""}"
              data-anio="${m.anio ?? ""}"
              data-color="${m.color ?? ""}"
              data-id-tipo-vehiculo="${m.idTipoVehiculo ?? ""}"
              style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem 1rem;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.15);border-radius:10px;color:#fff;cursor:pointer;text-align:left;">
              <span style="font-size:1.3rem;">🔧</span>
              <span>
                <strong style="display:block;font-size:0.875rem;">Actualizar datos del vehículo</strong>
                <small style="color:#aaa;font-size:0.78rem;">Membresía ${m.codigo} · Chapa ${censurar(m.chapa ?? "", 2)}</small>
              </span>
            </button>`).join("");

          // El select NO puede estar dentro del <button> — el clic en el dropdown
          // propaga al botón y dispara el checkout sin que el usuario lo pida.
          // Se usa un <div> contenedor con el select separado y un botón de confirmar.
          const btnActivarHTML = hayEfectivo ? `
            <div style="display:flex;flex-direction:column;gap:0.1rem;padding:0.75rem 1rem;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.12);border-radius:10px;color:#fff;">
              <div style="display:flex;align-items:center;gap:0.75rem;">
                <span style="font-size:1.3rem;">🔄</span>
                <span><strong style="display:block;font-size:0.875rem;">Activar débito automático</strong><small style="color:#aaa;font-size:0.78rem;">Registrá tu tarjeta y automatizá el pago mensual</small></span>
              </div>
              ${memEfectivo.length > 1
                ? `<div style="padding-left:2.2rem;padding-right:0.2rem;">${dropdownEfectivo}</div>`
                : membershipInfoHTML(memEfectivo[0]) + dropdownEfectivo}
              <button id="rp-btn-activar" type="button" style="margin-top:0.6rem;margin-left:auto;padding:0.35rem 1.1rem;background:#f9a606;border:none;border-radius:6px;color:#1a1a1a;cursor:pointer;font-size:0.82rem;font-weight:700;">Activar →</button>
            </div>` : "";

          const panel = document.createElement("div");
          panel.id = "rp-opciones-panel";
          panel.style.cssText = "margin-top:1rem;padding:1rem;background:rgba(249,166,6,0.08);border:1px solid rgba(249,166,6,0.3);border-radius:12px;";
          panel.innerHTML = `
            <p style="font-size:0.9rem;color:#f9a606;font-weight:700;margin:0 0 0.75rem;">👋 Hola ${nombreCensurado}, ya sos cliente.</p>
            <div style="display:flex;flex-direction:column;gap:0.6rem;">
              ${accionesV2HTML}
              ${btnActualizarHTML}
              ${btnActivarHTML}
              ${botonesActualizarVehiculoHTML}
              <button id="rp-btn-nuevo-vehiculo" type="button" style="display:flex;align-items:center;gap:0.75rem;padding:0.75rem 1rem;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.15);border-radius:10px;color:#fff;cursor:pointer;text-align:left;">
                <span style="font-size:1.3rem;">🚗</span>
                <span><strong style="display:block;font-size:0.875rem;">Registrar un vehículo nuevo</strong><small style="color:#aaa;font-size:0.78rem;">Añadí otro vehículo con su propia membresía</small></span>
              </button>
            </div>
          `;
          step1El?.appendChild(panel);
          // Escenario B: el panel reemplaza el form — ocultar loading, NO revelar campos
          if (loadingEl) loadingEl.style.display = "none";

          document.getElementById("rp-btn-actualizar")?.addEventListener("click", async () => {
            panel.remove();
            form.style.display = "none";
            await startRetryCheckout(data.idCliente);
          });

          panel.querySelectorAll<HTMLButtonElement>(".rp-v2-action").forEach((btn) => {
            btn.addEventListener("click", () => {
              const accion = btn.dataset.v2Accion;
              const idMembresia = btn.dataset.idMembresia ?? "";
              const idCotizacion = btn.dataset.idCotizacion ?? "";
              if (!idMembresia) return;
              panel.remove();
              form.style.display = "none";
              if (accion === "COTIZAR_REACTIVACION") {
                void iniciarReactivacionMembresiaV2(
                  data.idCliente,
                  idMembresia,
                );
              } else if (
                (accion === "PREPARAR_CATASTRO" ||
                  accion === "CONTINUAR_CATASTRO") &&
                idCotizacion
              ) {
                void continuarCatastroMembresiaV2({
                  idCliente: data.idCliente,
                  idCotizacion,
                  tipoOperacion:
                    btn.dataset.tipoOperacion === "ALTA"
                      ? "ALTA"
                      : "REACTIVACION",
                });
              } else if (accion === "GESTIONAR_TARJETA") {
                void cambiarTarjetaMembresiaV2(
                  data.idCliente,
                  idMembresia,
                );
              }
            });
          });

          // Wire "Seleccionar todas" master checkbox + sync visual cuando cambian individuales
          const chkAllEl = document.getElementById("rp-chk-all") as HTMLInputElement | null;
          const chkItems = Array.from(document.querySelectorAll<HTMLInputElement>(".rp-chk-mem"));
          if (chkAllEl) {
            chkAllEl.addEventListener("change", () => {
              chkItems.forEach((c) => { c.checked = chkAllEl.checked; });
            });
            chkItems.forEach((c) =>
              c.addEventListener("change", () => {
                const total = chkItems.length;
                const checked = chkItems.filter((x) => x.checked).length;
                chkAllEl.checked = checked === total && total > 0;
                chkAllEl.indeterminate = checked > 0 && checked < total;
              }),
            );
          }

          document.getElementById("rp-btn-activar")?.addEventListener("click", () => {
            // Modo multi (varias membresías efectivo): leer checkboxes
            // Modo simple (una sola): leer hidden input
            let idsSeleccionadas: string[] = [];
            if (chkItems.length > 0) {
              idsSeleccionadas = chkItems.filter((c) => c.checked).map((c) => c.value);
              const hint = document.getElementById("rp-multi-hint");
              if (idsSeleccionadas.length === 0) {
                if (hint) {
                  hint.textContent = "Seleccioná al menos una membresía para continuar.";
                  (hint as HTMLElement).style.color = "#ef4444";
                }
                logEvent({
                  paso: "validation_fail",
                  severidad: "warn",
                  codigo: "ACTIVAR_DEBITO_SIN_SELECCION",
                  mensaje: "Cliente clickeó Activar sin seleccionar ninguna membresía",
                });
                return;
              }
              if (hint) {
                hint.textContent = "Podés activar débito automático en una o varias membresías a la vez. Todas las seleccionadas pasarán al mismo plan.";
                (hint as HTMLElement).style.color = "rgba(255,255,255,0.5)";
              }
            } else {
              const selectEl = document.getElementById("rp-select-membresia") as HTMLInputElement | null;
              const v = selectEl?.value;
              if (!v) return;
              idsSeleccionadas = [v];
            }
            const idMembresia = idsSeleccionadas[0];

            logEvent({
              paso: "submit_registro",
              severidad: "info",
              codigo: "ACTIVAR_DEBITO_CLICK",
              contexto: {
                escenario: "activar_debito_membresia_existente",
                cantidadMembresias: idsSeleccionadas.length,
                idsMembresias: idsSeleccionadas,
              },
            });

            // Ocultar el botón y mostrar aviso de migración de plan antes de continuar
            const btnActivar = document.getElementById("rp-btn-activar") as HTMLElement;
            btnActivar.style.display = "none";

            const aviso = document.createElement("div");
            aviso.id = "rp-aviso-upgrade";
            aviso.style.cssText = "margin-top:0.5rem;padding:0.75rem;background:rgba(249,166,6,0.1);border:1px solid rgba(249,166,6,0.4);border-radius:8px;font-size:0.82rem;";
            const _avisoId    = (document.getElementById("idPlan") as HTMLInputElement)?.value || "";
            const _avisoMeta  = PLAN_META[_avisoId] || { name: "Plan Fórmula", price: "200.000" };
            aviso.innerHTML = `
              <p style="margin:0 0 0.4rem;font-weight:600;color:#f9a606;">⚠️ Tu plan pasará a Gs. ${_avisoMeta.price}/mes</p>
              <p style="margin:0 0 0.65rem;color:rgba(255,255,255,0.65);font-size:0.78rem;">Al activar el débito automático, tu membresía se migra al ${_avisoMeta.name} (Gs. ${_avisoMeta.price}/mes). El primer cobro se realizará el próximo ciclo.</p>
              <label style="display:flex;align-items:flex-start;gap:0.5rem;margin:0.5rem 0 0.65rem;cursor:pointer;font-size:0.78rem;color:rgba(255,255,255,0.75);">
                <input type="checkbox" id="rp-accept-legal-b" style="margin-top:2px;accent-color:#4f46e5;" />
                <span>Acepto los <a href="/terminos-y-condiciones" target="_blank" rel="noopener noreferrer" style="color:#f9a606;">Términos y Condiciones</a>, <a href="/politica-de-privacidad" target="_blank" rel="noopener noreferrer" style="color:#f9a606;">Política de Privacidad</a> y la <a href="/debito-automatico" target="_blank" rel="noopener noreferrer" style="color:#f9a606;">autorización de débito automático</a>.</span>
              </label>
              <span id="rp-legal-b-error" style="color:#ef4444;font-size:0.75rem;display:none;">Debés aceptar los Términos y Condiciones para continuar.</span>
              <div style="display:flex;gap:0.5rem;justify-content:flex-end;">
                <button id="rp-aviso-cancelar" type="button" style="padding:0.3rem 0.75rem;background:transparent;border:1px solid rgba(255,255,255,0.25);border-radius:6px;color:#fff;cursor:pointer;font-size:0.78rem;">Cancelar</button>
                <button id="rp-aviso-confirmar" type="button" style="padding:0.3rem 0.9rem;background:#4f46e5;border:none;border-radius:6px;color:#fff;cursor:pointer;font-size:0.78rem;font-weight:600;">Confirmar y registrar tarjeta →</button>
              </div>
            `;
            btnActivar.parentElement?.appendChild(aviso);

            document.getElementById("rp-aviso-cancelar")?.addEventListener("click", () => {
              logEvent({
                paso: "submit_registro",
                severidad: "warn",
                codigo: "ACTIVAR_DEBITO_CANCELADO",
                mensaje: "Cliente vio el aviso de upgrade y canceló",
                contexto: { idsMembresias: idsSeleccionadas },
              });
              aviso.remove();
              btnActivar.style.display = "";
            });

            document.getElementById("rp-aviso-confirmar")?.addEventListener("click", async () => {
              const legalCheckbox = document.getElementById("rp-accept-legal-b") as HTMLInputElement;
              const legalError = document.getElementById("rp-legal-b-error") as HTMLElement;
              if (legalCheckbox && !legalCheckbox.checked) {
                if (legalError) legalError.style.display = "block";
                logEvent({
                  paso: "validation_fail",
                  severidad: "warn",
                  codigo: "ACTIVAR_DEBITO_TYC_NO_ACEPTADO",
                  mensaje: "Cliente intentó confirmar sin aceptar T&C",
                });
                return;
              }
              if (legalError) legalError.style.display = "none";
              logEvent({
                paso: "submit_registro",
                severidad: "info",
                codigo: "ACTIVAR_DEBITO_CONFIRMADO",
                mensaje: "Cliente aceptó T&C y confirmó registrar tarjeta",
                contexto: {
                  escenario: "activar_debito_membresia_existente",
                  cantidadMembresias: idsSeleccionadas.length,
                  idsMembresias: idsSeleccionadas,
                },
              });
              if (idsSeleccionadas.length > 1) {
                sessionStorage.setItem("formulang_idsMembresiasActivar", JSON.stringify(idsSeleccionadas));
                sessionStorage.removeItem("formulang_idMembresiaActivar");
              } else {
                sessionStorage.setItem("formulang_idMembresiaActivar", idMembresia);
                sessionStorage.removeItem("formulang_idsMembresiasActivar");
              }
              panel.remove();
              form.style.display = "none";

              // Crear RegistroPendiente con el plan elegido antes del checkout.
              // Necesario para que el backend (resolverPlanDebito) pueda leer el
              // plan que el cliente eligió en la landing al activar débito.
              const idPlanElegido = (document.getElementById("idPlan") as HTMLInputElement)?.value;
              if (idPlanElegido && !PLAN_META[idPlanElegido]) {
                errorMsg.textContent = "Plan no disponible. Seleccioná un plan válido para continuar.";
                errorBanner.style.display = "block";
                return;
              }
              const memObj = data.membresias?.find(
                (m: any) => m.idMembresia === idMembresia,
              );
              if (idPlanElegido && memObj && idPlanElegido !== memObj.idPlan) {
                try {
                  const regRes = await fetch("/api/registro-pendiente", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                      idCliente: data.idCliente,
                      idVehiculo: memObj.idVehiculo,
                      idPlan: idPlanElegido,
                    }),
                  });
                  if (regRes.ok) {
                    const regBody = await regRes.json();
                    if (regBody.idRegistroPendiente) {
                      sessionStorage.setItem(
                        "formulang_idRegistroPendiente",
                        regBody.idRegistroPendiente,
                      );
                    }
                  } else {
                    // Fix 5: tracking explícito — el catch previo enmascaraba
                    // este caso porque `regRes.ok === false` no lanza.
                    const errBody = await regRes.json().catch(() => ({}));
                    logEvent({
                      paso: "submit_registro",
                      severidad: "error",
                      codigo: "RP_CREATION_FAILED",
                      mensaje: errBody?.error || `HTTP ${regRes.status}`,
                      contexto: {
                        httpStatus: regRes.status,
                        idCliente: data.idCliente,
                        idVehiculo: memObj.idVehiculo,
                        idPlanElegido,
                        idPlanActual: memObj.idPlan,
                      },
                    });
                  }
                } catch (e) {
                  // Fix 5: log error en lugar de solo console.warn — esto
                  // explicaba "cobro fallido por plan no resoluble" sin trazabilidad.
                  logEvent({
                    paso: "submit_registro",
                    severidad: "error",
                    codigo: "RP_CREATION_EXCEPTION",
                    mensaje: e instanceof Error ? e.message : String(e),
                    contexto: {
                      idCliente: data.idCliente,
                      idVehiculo: memObj.idVehiculo,
                      idPlanElegido,
                    },
                  });
                }
              }

              await startRetryCheckout(data.idCliente, "upay");
            });
          });

          // Handlers para "Actualizar datos del vehículo" — solo membresías NO activas (idEstado ≠ 1)
          memEfectivo.filter((m: any) => m.idEstado !== 1).forEach((_m: any, i: number) => {
            document.getElementById(`rp-btn-actualizar-vehiculo-${i}`)?.addEventListener("click", (e) => {
              const btn = e.currentTarget as HTMLElement;
              const idVehiculo = btn.dataset.idVehiculo ?? "";
              const chapa = btn.dataset.chapa ?? "";
              const idMarca = btn.dataset.idMarca ? Number(btn.dataset.idMarca) : null;
              const idModelo = btn.dataset.idModelo ? Number(btn.dataset.idModelo) : null;
              const anio = btn.dataset.anio ? Number(btn.dataset.anio) : null;
              const color = btn.dataset.color ?? "";
              const idTipoVehiculo = btn.dataset.idTipoVehiculo ? Number(btn.dataset.idTipoVehiculo) : null;

              panel.remove();
              modoActualizarVehiculo = true;
              modoNuevoVehiculo = false;
              sessionStorage.setItem("formulang_idVehiculo", idVehiculo);

              // Pre-llenar datos del vehículo
              setVal("chapa", chapa);
              if (color) setVal("color", color);
              if (anio) setVal("anio", anio);
              if (idTipoVehiculo) {
                const tipoSel = document.getElementById("tipoVehiculo") as HTMLSelectElement | null;
                if (tipoSel) tipoSel.value = String(idTipoVehiculo);
              }
              if (idMarca) {
                const marcaSel = document.getElementById("idMarca") as HTMLSelectElement | null;
                if (marcaSel) {
                  marcaSel.value = String(idMarca);
                  marcaSel.dispatchEvent(new Event("change"));
                  if (idModelo) setTimeout(() => setVal("idModelo", idModelo), 800);
                }
              }

              const infoBanner = document.createElement("div");
              infoBanner.id = "rp-info-banner";
              infoBanner.style.cssText = "margin-top:1rem;padding:0.75rem 1rem;background:rgba(79,70,229,0.12);border:1px solid rgba(79,70,229,0.35);border-radius:10px;font-size:0.82rem;color:#a5b4fc;";
              infoBanner.innerHTML = `<strong>Actualizando datos del vehículo.</strong> Modificá los campos que necesitás y confirmá.`;
              step1El?.appendChild(infoBanner);
              goToStep(2);
            });
          });

          document.getElementById("rp-btn-nuevo-vehiculo")?.addEventListener("click", () => {
            panel.remove();
            modoNuevoVehiculo = true;
            setVal("nombre", data.nombre);
            setVal("telefono", data.telefono);
            setVal("email", data.email);
            const infoBanner = document.createElement("div");
            infoBanner.id = "rp-info-banner";
            infoBanner.style.cssText = "margin-top:1rem;padding:0.75rem 1rem;background:rgba(79,70,229,0.12);border:1px solid rgba(79,70,229,0.35);border-radius:10px;font-size:0.82rem;color:#a5b4fc;";
            infoBanner.innerHTML = `<strong>Tus datos personales ya están guardados.</strong> Completá los datos del nuevo vehículo.`;
            step1El?.appendChild(infoBanner);
            goToStep(2);
          });
          return;
        }

        // ---- Scenario C: client exists but no membership or pending registration ----
        // Una limpieza V2 conserva cliente y vehiculo. En ese caso se reutiliza
        // el vehiculo existente y solo se crea un nuevo RegistroPendiente.
        setVal("nombre", data.nombre);
        setVal("telefono", data.telefono);
        setVal("email", data.email);
        sessionStorage.setItem("formulang_idCliente", data.idCliente);

        const vehiculosDisponibles = Array.isArray(data.vehiculosDisponibles)
          ? data.vehiculosDisponibles
          : [];
        if (data.estadoCuenta === "CLIENTE_SIN_MEMBRESIA" && vehiculosDisponibles.length > 0) {
          const panel = document.createElement("div");
          panel.id = "rp-reingreso-vehiculo-panel";
          panel.style.cssText = "margin-top:1rem;padding:1rem 1.1rem;background:rgba(34,197,94,0.08);border:1px solid rgba(34,197,94,0.35);border-radius:12px;font-size:0.85rem;color:#d1fae5;";
          panel.innerHTML =
            `<strong>Encontramos tu vehiculo guardado.</strong><br/>` +
            `<span style="display:block;margin:0.35rem 0 0.75rem;color:rgba(255,255,255,0.7);">Elegilo para iniciar nuevamente el alta sin duplicar tus datos.</span>` +
            `<div id="rp-reingreso-vehiculos" style="display:grid;gap:0.55rem;"></div>`;
          step1El?.appendChild(panel);
          const lista = panel.querySelector("#rp-reingreso-vehiculos") as HTMLElement | null;
          vehiculosDisponibles.forEach((vehiculo: any) => {
            const button = document.createElement("button");
            button.type = "button";
            button.style.cssText = "display:flex;align-items:center;justify-content:space-between;gap:0.75rem;padding:0.75rem 0.9rem;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.18);border-radius:10px;color:#fff;cursor:pointer;text-align:left;";
            button.innerHTML =
              `<span><strong style="display:block;">${escapeHtml(String(vehiculo.chapa ?? ""))}</strong>` +
              `<small style="color:#aaa;">${escapeHtml(String(vehiculo.color ?? ""))}</small></span>` +
              `<span style="color:#86efac;font-weight:700;">Usar vehiculo →</span>`;
            button.addEventListener("click", () => {
              panel.remove();
              modoVehiculoConservado = true;
              modoNuevoVehiculo = false;
              modoActualizarVehiculo = false;
              sessionStorage.setItem("formulang_idCliente", data.idCliente);
              sessionStorage.setItem("formulang_idVehiculo", String(vehiculo.idVehiculo));
              setVal("chapa", vehiculo.chapa);
              setVal("anio", vehiculo.anio);
              setVal("color", vehiculo.color);
              if (vehiculo.idTipoVehiculo) {
                const tipoSel = document.getElementById("tipoVehiculo") as HTMLSelectElement | null;
                if (tipoSel) tipoSel.value = String(vehiculo.idTipoVehiculo);
              }
              if (vehiculo.idMarca) {
                const marcaSel = document.getElementById("idMarca") as HTMLSelectElement | null;
                if (marcaSel) {
                  marcaSel.value = String(vehiculo.idMarca);
                  marcaSel.dispatchEvent(new Event("change"));
                  if (vehiculo.idModelo) setTimeout(() => setVal("idModelo", vehiculo.idModelo), 800);
                }
              }
              const info = document.createElement("div");
              info.id = "rp-info-banner";
              info.style.cssText = "margin-top:1rem;padding:0.75rem 1rem;background:rgba(34,197,94,0.08);border:1px solid rgba(34,197,94,0.3);border-radius:10px;font-size:0.82rem;color:#bbf7d0;";
              info.innerHTML = `<strong>Vehiculo conservado seleccionado.</strong> No se creara otro cliente ni otra chapa.`;
              step1El?.appendChild(info);
              revelarCamposPersonales();
            });
            lista?.appendChild(button);
          });
          revelarCamposPersonales();
          return;
        }

        // Cliente sin vehiculo disponible: se permite registrar uno nuevo.
        modoNuevoVehiculo = true;

        const banner = document.createElement("div");
        banner.id = "rp-resume-banner";
        banner.style.cssText = "margin-top:1rem;padding:0.85rem 1rem;background:rgba(79,70,229,0.12);border:1px solid rgba(79,70,229,0.35);border-radius:10px;font-size:0.85rem;color:#a5b4fc;";
        banner.innerHTML = `<strong>Encontramos tu cuenta, ${censurar(data.nombre, 4)}.</strong><br/>Tus datos personales fueron cargados. Completá los datos de tu vehículo para continuar.`;
        step1El?.appendChild(banner);
        revelarCamposPersonales();
      } catch {
        // Error inesperado → revelar campos para no bloquear al usuario
        revelarCamposPersonales();
      } finally {
        // Siempre liberar la guardia al terminar el lookup
        lookupInProgress = false;
      }
    }

    // Lookup manual — se dispara al hacer clic en "Confirmar" o presionar Enter
    async function confirmarCI() {
      // Eliminar dígito verificador: "755014-6" → "755014", "1234567-8" → "1234567"
      const ci = rucInput.value.replace(/\s+/g, "").replace(/-\d+$/, "");
      if (!ci || ci.length < 5) {
        showFieldError("ruc", "Ingresá tu RUC o CI para continuar.");
        return;
      }
      // Esperar token de Turnstile (max 15s) antes de consultar
      const tsError = document.getElementById("turnstile-error");
      const token = await waitForTurnstileToken(15000);
      if (!token) {
        if (tsError) tsError.textContent = "Completá la verificación de seguridad para continuar.";
        return;
      }
      if (tsError) tsError.textContent = "";
      // Resetear lastLookedUpCI para permitir re-consulta aunque sea el mismo CI
      lastLookedUpCI = "";
      await dispararLookupCI(ci);
    }

    document.getElementById("btn-confirmar-ci")?.addEventListener("click", confirmarCI);

    rucInput?.addEventListener("keydown", (e) => {
      if ((e as KeyboardEvent).key === "Enter") {
        e.preventDefault();
        confirmarCI();
      }
    });

    // Quitar espacios en RUC/CI mientras el usuario escribe o pega
    rucInput?.addEventListener("input", () => {
      if (/\s/.test(rucInput.value)) {
        const pos = rucInput.selectionStart ?? rucInput.value.length;
        const before = rucInput.value.slice(0, pos).replace(/\s+/g, "").length;
        rucInput.value = rucInput.value.replace(/\s+/g, "");
        try { rucInput.setSelectionRange(before, before); } catch {}
      }
    });

    // Normalizar Chapa: sólo letras A-Z y dígitos 0-9 en mayúsculas (sin espacios ni símbolos).
    const chapaInput = document.getElementById("chapa") as HTMLInputElement | null;
    chapaInput?.addEventListener("input", () => {
      const original = chapaInput.value;
      const cleaned = original.toUpperCase().replace(/[^A-Z0-9]/g, "");
      if (cleaned !== original) {
        const pos = chapaInput.selectionStart ?? cleaned.length;
        const removedBefore = original.slice(0, pos).replace(/[^A-Za-z0-9]/g, "").length;
        chapaInput.value = cleaned;
        try { chapaInput.setSelectionRange(removedBefore, removedBefore); } catch {}
      }
    });

    // Filtrar Teléfono/WhatsApp: sólo dígitos.
    const telefonoInput = document.getElementById("telefono") as HTMLInputElement | null;
    const sanitizeTelefono = () => {
      if (!telefonoInput) return;
      const original = telefonoInput.value;
      const cleaned = original.replace(/[^0-9]/g, "");
      if (cleaned !== original) {
        const pos = telefonoInput.selectionStart ?? cleaned.length;
        const newPos = Math.min(pos, cleaned.length);
        telefonoInput.value = cleaned;
        try { telefonoInput.setSelectionRange(newPos, newPos); } catch {}
      }
    };
    telefonoInput?.addEventListener("input", sanitizeTelefono);
    telefonoInput?.addEventListener("change", sanitizeTelefono);
    telefonoInput?.addEventListener("blur", sanitizeTelefono);
    telefonoInput?.addEventListener("paste", () => {
      setTimeout(sanitizeTelefono, 0);
    });

    // Cuando el usuario modifica el CI, resetear el estado del lookup anterior
    rucInput?.addEventListener("input", () => {
      const ci = rucInput.value.trim();
      if (ci !== lastLookedUpCI && lastLookedUpCI) {
        lastLookedUpCI = "";
        ocultarCamposPersonales();
        document.getElementById("rp-resume-banner")?.remove();
        document.getElementById("rp-opciones-panel")?.remove();
        sessionStorage.removeItem("formulang_idCliente");
        sessionStorage.removeItem("formulang_idRegistroPendiente");
        sessionStorage.removeItem("formulang_idPlanPendiente");
        sessionStorage.removeItem("formulang_idMembresiaAltaPendiente");
        sessionStorage.removeItem("formulang_idMembresiaActivar");
        sessionStorage.removeItem("formulang_idsMembresiasActivar");
        modoNuevoVehiculo = false;
        modoVehiculoConservado = false;
      }
    });

    // ---- Persistencia de intentos fallidos (defensa en profundidad) ----
    // sessionStorage se pierde al cerrar la pestaña. Si el cliente cierra el
    // navegador después de un catastro fallido y vuelve más tarde, perdemos
    // `formulang_idCliente` y el lookup CI puede fallar (Bug 3). localStorage
    // con TTL de 24h actúa como red de seguridad.

    interface FailedAttemptCtx {
      ci: string;
      idCliente: string;
      idRegistroPendiente?: string;
      ts: number;
    }
    const FAILED_ATTEMPT_KEY = "formulang_failed_attempt";
    const FAILED_ATTEMPT_TTL_MS = 24 * 60 * 60 * 1000;

    function persistRecuperacionPostFallo(ci: string, idCliente: string): void {
      if (!ci || !idCliente) return;
      try {
        const payload: FailedAttemptCtx = {
          ci: ci.replace(/\s+/g, "").replace(/-\d+$/, ""),
          idCliente,
          idRegistroPendiente:
            sessionStorage.getItem("formulang_idRegistroPendiente") || undefined,
          ts: Date.now(),
        };
        localStorage.setItem(FAILED_ATTEMPT_KEY, JSON.stringify(payload));
        logEvent({
          paso: "submit_registro",
          severidad: "info",
          codigo: "FAILED_ATTEMPT_PERSISTED",
          contexto: { hasIdRegPendiente: !!payload.idRegistroPendiente },
        });
      } catch { /* localStorage puede estar bloqueado */ }
    }

    function recuperarContextoFallo(ci: string): FailedAttemptCtx | null {
      if (!ci) return null;
      try {
        const raw = localStorage.getItem(FAILED_ATTEMPT_KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw) as FailedAttemptCtx;
        const now = Date.now();
        if (!parsed.ts || now - parsed.ts > FAILED_ATTEMPT_TTL_MS) {
          localStorage.removeItem(FAILED_ATTEMPT_KEY);
          return null;
        }
        const ciLimpia = ci.replace(/\s+/g, "").replace(/-\d+$/, "");
        if (parsed.ci !== ciLimpia) return null;
        return parsed;
      } catch {
        return null;
      }
    }

    function limpiarContextoFallo(): void {
      try { localStorage.removeItem(FAILED_ATTEMPT_KEY); } catch { /* ignore */ }
    }

    // ---- Helpers de recuperación post-error ----

    /**
     * Construye el payload para POST /api/registro-vehiculo a partir de los
     * campos actuales del wizard. Reutilizable tanto para el flujo normal
     * (modoNuevoVehiculo) como para la recuperación del 409 por CI duplicada.
     */
    function buildVehiculoPayload(idCliente: string): Record<string, unknown> {
      const chapaInputVal = (document.getElementById("chapa") as HTMLInputElement)?.value.trim().toUpperCase() || "";
      // Si el usuario confirmó continuar tras detectar chapa duplicada,
      // marcamos con sufijo "DP" también en el endpoint /api/registro-vehiculo
      // (Fix 4 — sufijo letras para pasar regex /^[A-Z0-9]+$/ del backend).
      const chapaFinal = _chapaMarcadaParaRevisionManual ? `${chapaInputVal}DP` : chapaInputVal;
      const payload: Record<string, unknown> = {
        idCliente,
        chapa: chapaFinal,
        idPlan: (document.getElementById("idPlan") as HTMLInputElement)?.value,
      };
      const anioV = (document.getElementById("anio") as HTMLInputElement)?.value;
      if (anioV) payload.anio = Number(anioV);
      const colorV = (document.getElementById("color") as HTMLInputElement)?.value.trim();
      if (colorV) payload.color = colorV;
      const idMarcaV = (document.getElementById("idMarca") as HTMLSelectElement)?.value;
      if (idMarcaV && idMarcaV !== "otro") payload.idMarca = Number(idMarcaV);
      const idModeloV = (document.getElementById("idModelo") as HTMLSelectElement)?.value;
      if (idModeloV && idModeloV !== "otro") payload.idModelo = Number(idModeloV);
      const marcaNuevaV = (document.getElementById("marcaNueva") as HTMLInputElement)?.value.trim();
      if (idMarcaV === "otro" && marcaNuevaV) payload.marcaNueva = marcaNuevaV;
      const modeloNuevoV = (document.getElementById("modeloNuevo") as HTMLInputElement)?.value.trim();
      if ((idModeloV === "otro" || idMarcaV === "otro") && modeloNuevoV) payload.modeloNuevo = modeloNuevoV;
      const tipoV = (document.getElementById("tipoVehiculo") as HTMLSelectElement)?.value;
      if (tipoV) payload.idTipoVehiculo = Number(tipoV);
      return payload;
    }

    /**
     * Llama POST /api/registro-vehiculo para un cliente ya existente y retorna
     * el idRegistroPendiente que el caller necesita para iniciar el checkout.
     * Lanza Error con mensaje user-friendly si el backend rechaza la solicitud.
     */
    async function submitNuevoVehiculo(idCliente: string): Promise<string> {
      const vehiculoPayload = buildVehiculoPayload(idCliente);
      const chapaPayload = String(vehiculoPayload.chapa || "").trim();
      if (!chapaPayload || chapaPayload.length < 3) {
        throw new Error("Ingresá la chapa del vehículo.");
      }
      const idPlanPayload = String(vehiculoPayload.idPlan || "");
      if (!idPlanPayload) throw new Error("Seleccioná un plan para continuar.");
      if (!PLAN_META[idPlanPayload]) throw new Error("Plan no disponible. Seleccioná un plan válido.");

      const regVehRes = await fetchWithTimeout("/api/registro-vehiculo", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(vehiculoPayload),
      }, 20000);

      const regVehBody = await regVehRes.json().catch(() => {
        throw new Error("Error al registrar el vehículo. Intentá de nuevo.");
      });

      if (!regVehRes.ok) {
        const msg = regVehBody.error || regVehBody.message || "";
        if (regVehRes.status === 409) {
          // Se propaga al caller para que pueda ofrecer el flujo de chapa
          // duplicada con sufijo "*" (Fix 4). Adjuntamos los campos extra
          // que el proxy expone (code, chapa, field).
          const err = new Error(msg || "Esta chapa ya está registrada.") as Error & {
            status?: number;
            code?: string;
            chapa?: string;
            field?: string;
          };
          err.status = 409;
          if (regVehBody.code) err.code = String(regVehBody.code);
          if (regVehBody.chapa) err.chapa = String(regVehBody.chapa);
          if (regVehBody.field) err.field = String(regVehBody.field);
          throw err;
        }
        throw new Error(msg || "No se pudo registrar el vehículo. Intentá de nuevo.");
      }

      const idRegPendiente = regVehBody.idRegistroPendiente;
      if (!idRegPendiente) throw new Error("No pudimos iniciar el pago. Intentá de nuevo.");
      sessionStorage.setItem("formulang_idRegistroPendiente", idRegPendiente);
      return idRegPendiente;
    }

    /**
     * Recupera el flujo cuando POST /api/registro retorna 409 (CI duplicada).
     * Estrategia:
     *   1) Si el body del 409 ya trae idCliente → usar directo.
     *   2) Si no, re-consultar GET /api/registro-pendiente?ci=X&forceClient=true
     *      para que el backend retorne idCliente aunque no haya membresía.
     *   3) Si tampoco se obtiene, retornar null → el caller muestra CTA WhatsApp.
     *
     * Cuando obtiene idCliente: lo cachea, setea modoNuevoVehiculo y llama
     * submitNuevoVehiculo() para crear vehículo + RegistroPendiente.
     */
    async function recoverFrom409CiDuplicada(
      errorBody: { idCliente?: string },
      ci: string,
    ): Promise<{ idCliente: string; idRegistroPendiente: string } | null> {
      let idCliente = errorBody?.idCliente ? String(errorBody.idCliente) : "";

      if (!idCliente && ci) {
        try {
          const lookupRes = await fetchWithTimeout(
            `/api/registro-pendiente?ci=${encodeURIComponent(ci)}&forceClient=true`,
            {},
            12000,
          );
          if (lookupRes.ok) {
            const lookupBody = await lookupRes.json().catch(() => null);
            if (lookupBody?.idCliente) idCliente = String(lookupBody.idCliente);
          }
        } catch { /* swallow — caemos al return null */ }
      }

      if (!idCliente) {
        logEvent({
          paso: "submit_registro",
          severidad: "error",
          codigo: "RECUPERACION_409_FALLIDA",
          mensaje: "409 sin idCliente y forceClient lookup no devolvió cliente",
          contexto: { ci },
        });
        return null;
      }

      sessionStorage.setItem("formulang_idCliente", idCliente);
      modoNuevoVehiculo = true;
      modoActualizarVehiculo = false;
      logEvent({
        paso: "submit_registro",
        severidad: "warn",
        codigo: "RECUPERACION_409",
        mensaje: "409 CI duplicada recuperado — reintentando como cliente existente",
        contexto: { idCliente },
      });

      const idRegistroPendiente = await submitNuevoVehiculo(idCliente);
      return { idCliente, idRegistroPendiente };
    }

    /**
     * Diálogo inline (no `confirm()` nativo) que se muestra cuando el backend
     * rechaza el registro porque la chapa ingresada ya existe en BD. Permite
     * al cliente confirmar que la chapa es suya y continuar — el frontend
     * marca la chapa con sufijo "DP" (revisión manual desde el panel admin).
     */
    function mostrarDialogoChapaDuplicada(
      chapaOriginal: string,
      onConfirm: () => void,
      onCancel: () => void,
    ) {
      // Quitar diálogo previo si quedó huérfano
      document.getElementById("chapa-duplicada-dialogo")?.remove();
      const dialogo = document.createElement("div");
      dialogo.id = "chapa-duplicada-dialogo";
      dialogo.style.cssText =
        "margin-top:1rem;padding:1rem 1.1rem;background:rgba(249,166,6,0.1);" +
        "border:1px solid rgba(249,166,6,0.4);border-radius:12px;font-size:0.85rem;";
      dialogo.innerHTML =
        `<p style="margin:0 0 0.6rem;font-weight:700;color:#f9a606;">` +
        `⚠️ La chapa "${chapaOriginal}" ya figura registrada en nuestro sistema.</p>` +
        `<p style="margin:0 0 0.75rem;color:rgba(255,255,255,0.7);line-height:1.5;font-size:0.8rem;">` +
        `Si confirmás que esta chapa es tuya, podés continuar y un agente verificará ` +
        `los datos manualmente en las próximas 24 h. Si fue un error, revisá y corregí la chapa.</p>` +
        `<div style="display:flex;gap:0.5rem;justify-content:flex-end;flex-wrap:wrap;">` +
        `<button id="chapa-dup-revisar" type="button" ` +
        `style="padding:0.4rem 0.9rem;background:transparent;border:1px solid rgba(255,255,255,0.25);` +
        `border-radius:6px;color:#fff;cursor:pointer;font-size:0.82rem;">Revisar chapa</button>` +
        `<button id="chapa-dup-confirmar" type="button" ` +
        `style="padding:0.4rem 1rem;background:#f9a606;border:none;border-radius:6px;` +
        `color:#1a1a1a;cursor:pointer;font-size:0.82rem;font-weight:700;">Confirmar y continuar →</button>` +
        `</div>`;
      errorBanner.parentElement?.insertBefore(dialogo, errorBanner.nextSibling);
      dialogo.scrollIntoView({ behavior: "smooth", block: "center" });

      document.getElementById("chapa-dup-revisar")?.addEventListener("click", () => {
        dialogo.remove();
        logEvent({
          paso: "submit_registro",
          severidad: "info",
          codigo: "CHAPA_DUPLICADA_REVISADA",
          contexto: { chapaOriginal },
        });
        onCancel();
      });
      document.getElementById("chapa-dup-confirmar")?.addEventListener("click", () => {
        dialogo.remove();
        logEvent({
          paso: "submit_registro",
          severidad: "warn",
          codigo: "CHAPA_DUPLICADA_CONFIRMADA_MANUAL",
          contexto: { chapaOriginal },
        });
        onConfirm();
      });
    }

    /**
     * Activa la bandera de revisión manual y dispara un nuevo submit del form.
     * El submit handler detecta `_chapaMarcadaParaRevisionManual === true` y
     * reescribe el payload con `chapa + "DP"` (sufijo letras, no símbolo, para
     * pasar el validador regex del backend).
     */
    function reintentarConChapaMarcada() {
      _chapaMarcadaParaRevisionManual = true;
      errorBanner.style.display = "none";
      errorMsg.textContent = "";
      submitBtn.disabled = false;
      submitText.style.display = "inline";
      submitLoading.style.display = "none";
      form.requestSubmit();
    }

    /**
     * Muestra mensaje accionable cuando la recuperación automática del 409
     * falla. Incluye CTA a WhatsApp de soporte.
     */
    function showFallback409WhatsApp(errorMsgPrefix: string) {
      const waNumero = "595992789328";
      const waText = encodeURIComponent(
        "Hola, intenté registrarme en la landing y el sistema detectó mi cédula como duplicada. ¿Pueden ayudarme a continuar?",
      );
      const waUrl = `https://wa.me/${waNumero}?text=${waText}`;
      errorMsg.innerHTML =
        `${errorMsgPrefix} ` +
        `<a href="${waUrl}" target="_blank" rel="noopener noreferrer" ` +
        `style="display:inline-block;margin-top:0.5rem;padding:0.4rem 0.9rem;` +
        `background:#25D366;color:#fff;border-radius:6px;text-decoration:none;` +
        `font-weight:600;font-size:0.85rem;">Contactar por WhatsApp</a>`;
      errorBanner.style.display = "block";
    }

    // ---- Form Submission ----
    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (cuentaExpulsadaActual) {
        errorMsg.textContent =
          "Esta cuenta está restringida y no puede registrar otra membresía o vehículo.";
        errorBanner.style.display = "block";
        return;
      }
      if (!validateStep(currentStep)) {
        logEvent({
          paso: "validation_fail",
          severidad: "warn",
          codigo: `SUBMIT_STEP_${currentStep}_INVALID`,
          contexto: { step: currentStep },
        });
        return;
      }
      const idPlanFinal = (document.getElementById("idPlan") as HTMLInputElement | null)?.value;
      logEvent({
        paso: "submit_registro",
        severidad: "info",
        codigo: "SUBMIT_START",
        contexto: { idPlanFinal, modoNuevoVehiculo, modoActualizarVehiculo },
      });

      const emailVal = (document.getElementById("email") as HTMLInputElement).value.trim();
      if (!emailVal) {
        errorMsg.textContent = `El email es requerido para activar tu ${currentPlanMeta().name}. Volvé al paso 1 para completarlo.`;
        errorBanner.style.display = "block";
        goToStep(1);
        showFieldError("email", "El email es requerido para activar tu plan");
        return;
      }
      if (!emailVal.match(/^[^\s@]+@[^\s@]+\.[^\s@]+$/)) {
        errorMsg.textContent = "El email ingresado no es válido. Volvé al paso 1 para corregirlo.";
        errorBanner.style.display = "block";
        goToStep(1);
        showFieldError("email", "Email inválido");
        return;
      }

      // Verificar token de Turnstile antes de proceder
      const freshToken = getCurrentTurnstileToken();
      if (!freshToken) {
        // Token expirado — mostrar widget visible en Step 3 y esperar que el usuario lo complete.
        // __tsOnSuccess se encargará de reanudar el submit automáticamente.
        logEvent({
          paso: "turnstile",
          severidad: "warn",
          codigo: "TS_ON_SUBMIT_MISSING",
          mensaje: "Submit invocado sin token Turnstile fresco — mostrando widget de refresh",
          contexto: { currentStep },
        });
        _submitPendingAfterTs = true;
        clearTurnstileSubmitError();
        showTurnstileStep3();
        return;
      }

      clearTurnstileSubmitError();
      hideTurnstileStep3();

      // Disable submit
      submitBtn.disabled = true;
      submitText.style.display = "none";
      submitLoading.style.display = "inline";
      errorBanner.style.display = "none";

      // Collect form data
      const formData: Record<string, unknown> = {
        nombre: (document.getElementById("nombre") as HTMLInputElement).value.trim().toUpperCase(),
        ruc: (document.getElementById("ruc") as HTMLInputElement).value.replace(/\s+/g, ""),
        telefono: (document.getElementById("telefono") as HTMLInputElement).value.replace(/[^0-9]/g, ""),
      };

      const email = (document.getElementById("email") as HTMLInputElement).value.trim();
      formData.email = email;

      const chapa = (document.getElementById("chapa") as HTMLInputElement).value.trim();
      // Fix 4: si el usuario confirmó continuar después de detectar chapa
      // duplicada, marcamos con sufijo "DP" (Duplicada Pendiente). Notas:
      //  - Se usa "DP" en lugar de "*" porque el validador del backend exige
      //    /^[A-Z0-9]+$/ (rechaza símbolos).
      //  - NO se manda `requiereRevisionManual` porque el DTO usa
      //    `forbidNonWhitelisted: true` y lo rechaza con 400.
      //  - El panel admin detecta candidatos con `LIKE '%DP'`.
      if (_chapaMarcadaParaRevisionManual) {
        formData.chapa = `${chapa.toUpperCase()}DP`;
      } else {
        formData.chapa = chapa;
      }

      const idMarcaVal = (document.getElementById("idMarca") as HTMLSelectElement).value;
      const marcaNuevaVal = (document.getElementById("marcaNueva") as HTMLInputElement).value.trim();
      if (idMarcaVal === "otro") {
        if (marcaNuevaVal) formData.marcaNueva = marcaNuevaVal;
      } else if (idMarcaVal) {
        formData.idMarca = Number(idMarcaVal);
      }

      const idModeloVal = (document.getElementById("idModelo") as HTMLSelectElement).value;
      const modeloNuevoVal = (document.getElementById("modeloNuevo") as HTMLInputElement).value.trim();
      if (idModeloVal === "otro" || idMarcaVal === "otro") {
        if (modeloNuevoVal) formData.modeloNuevo = modeloNuevoVal;
      } else if (idModeloVal) {
        formData.idModelo = Number(idModeloVal);
      }

      const anio = (document.getElementById("anio") as HTMLInputElement).value;
      if (anio) formData.anio = Number(anio);

      const color = (document.getElementById("color") as HTMLInputElement).value.trim();
      if (color) formData.color = color;

      const tipoVehiculo = (document.getElementById("tipoVehiculo") as HTMLSelectElement).value;
      if (tipoVehiculo) formData.idTipoVehiculo = Number(tipoVehiculo);

      const idPlan = (document.getElementById("idPlan") as HTMLInputElement).value;
      if (!idPlan || !PLAN_META[idPlan]) {
        errorMsg.textContent = "Plan no disponible. Seleccioná un plan válido para continuar.";
        errorBanner.style.display = "block";
        submitBtn.disabled = false;
        submitText.style.display = "inline";
        submitLoading.style.display = "none";
        return;
      }
      formData.idPlan = idPlan;

      // Turnstile captcha token — garantizado fresco por ensureFreshTurnstileToken()
      formData.turnstileToken = freshToken;
      formData.acceptTerminos = true;

      // Adjuntar atribución UTM si está disponible
      try {
        const utmRaw = sessionStorage.getItem("fng_utm");
        if (utmRaw) formData.attribution = JSON.parse(utmRaw);
      } catch { /* ignorar errores de parsing */ }

      try {
        const idClienteExistente = sessionStorage.getItem("formulang_idCliente");
        const idRegPendienteExistente = sessionStorage.getItem("formulang_idRegistroPendiente");

        let idCliente: string;

        if (modoActualizarVehiculo && idClienteExistente) {
          // Actualizar datos de vehículo existente — sin checkout
          const idVehiculoExistente = sessionStorage.getItem("formulang_idVehiculo");
          if (!idVehiculoExistente) throw new Error("No se encontró el vehículo a actualizar.");
          const chapaMV = (document.getElementById("chapa") as HTMLInputElement)?.value.trim();
          if (!chapaMV || chapaMV.length < 3) throw new Error("Ingresá la chapa del vehículo.");

          const actualizarPayload: Record<string, unknown> = {
            idCliente: idClienteExistente,
            idVehiculo: idVehiculoExistente,
            chapa: chapaMV.toUpperCase(),
          };
          const colorMV = (document.getElementById("color") as HTMLInputElement)?.value.trim();
          if (colorMV) actualizarPayload.color = colorMV;
          const anioMV = (document.getElementById("anio") as HTMLInputElement)?.value;
          if (anioMV) actualizarPayload.anio = Number(anioMV);
          const marcaMV = (document.getElementById("idMarca") as HTMLSelectElement)?.value;
          if (marcaMV) actualizarPayload.idMarca = Number(marcaMV);
          const modeloMV = (document.getElementById("idModelo") as HTMLSelectElement)?.value;
          if (modeloMV) actualizarPayload.idModelo = Number(modeloMV);
          const tipoMV = (document.getElementById("tipoVehiculo") as HTMLSelectElement)?.value;
          if (tipoMV) actualizarPayload.idTipoVehiculo = Number(tipoMV);

          const actuRes = await fetchWithTimeout("/api/actualizar-vehiculo", {
            method: "PATCH",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(actualizarPayload),
          }, 15000);

          if (!actuRes.ok) {
            const errBody = await actuRes.json().catch(() => ({}));
            throw new Error(errBody.error || "No se pudieron actualizar los datos del vehículo.");
          }

          showResult(
            "Datos actualizados",
            "Los datos de tu vehículo fueron actualizados correctamente.",
            false,
          );
          return;

        } else if (modoVehiculoConservado && idClienteExistente) {
          const idVehiculoConservado = sessionStorage.getItem("formulang_idVehiculo");
          if (!idVehiculoConservado) {
            throw new Error("No pudimos identificar el vehiculo conservado. Volve a ingresar tu CI.");
          }
          const registroRes = await fetchWithTimeout("/api/registro-pendiente", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              idCliente: idClienteExistente,
              idVehiculo: idVehiculoConservado,
              idPlan,
            }),
          }, 20000);
          const registroBody = await registroRes.json().catch(() => ({}));
          if (!registroRes.ok || !registroBody.idRegistroPendiente) {
            throw new Error(
              registroBody.error || registroBody.message || "No pudimos iniciar nuevamente el alta.",
            );
          }
          sessionStorage.setItem("formulang_idRegistroPendiente", registroBody.idRegistroPendiente);
          sessionStorage.setItem("formulang_idPlanPendiente", idPlan);
          idCliente = idClienteExistente;

        } else if (idClienteExistente && idRegPendienteExistente) {
          // Resume existing registration — skip POST /api/registro.
          // El cliente ya existe en BD; el RegistroPendiente del intento anterior
          // está cacheado en sessionStorage. Dos casos:
          //   1) Mismo plan que antes → reusar todo, ir directo a checkout.
          //   2) Plan distinto → reemplazar el alta pendiente conservando
          //      el mismo cliente y el mismo vehículo.
          //
          // No se vuelve a registrar el cliente ni el vehículo. Cuando el alta
          // ya fue materializada se usa el reemplazo transaccional; antes de
          // eso solo se reemplaza el registro pendiente del mismo vehículo.
          const idPlanForm = (document.getElementById("idPlan") as HTMLInputElement)?.value;
          const idPlanPendienteCache = sessionStorage.getItem("formulang_idPlanPendiente");
          const idMembresiaAltaPendienteCache = sessionStorage.getItem(
            "formulang_idMembresiaAltaPendiente",
          );
          const planCambio =
            !!idPlanForm && !!idPlanPendienteCache && idPlanForm !== idPlanPendienteCache;
          if (planCambio) {
            if (!idPlanForm) {
              throw new Error("Seleccioná un plan para continuar.");
            }
            logEvent({
              paso: "submit_registro",
              severidad: "warn",
              codigo: "PLAN_CAMBIO_REUSA_CLIENTE",
              mensaje:
                "Plan elegido distinto al del registro pendiente — se reemplaza el alta sin duplicar cliente ni vehiculo",
              contexto: {
                idPlanForm,
                idPlanPendienteCache,
                idClienteCache: idClienteExistente,
                idRegPendienteCache: idRegPendienteExistente,
                hasIdMembresiaAltaPendiente:
                  !!idMembresiaAltaPendienteCache,
              },
            });
            submitLoading.textContent = "Actualizando el plan...";
            if (
              idMembresiaAltaPendienteCache &&
              (await membresiasV2Habilitadas())
            ) {
              const cambio = await cambiarPlanAltaPendienteMembresiaV2({
                idCliente: idClienteExistente,
                idMembresia: idMembresiaAltaPendienteCache,
                idPlanNuevo: idPlanForm,
              });
              sessionStorage.setItem(
                "formulang_idRegistroPendiente",
                cambio.idRegistroPendiente,
              );
              sessionStorage.setItem("formulang_idVehiculo", cambio.idVehiculo);
              limpiarContextoMembresiaV2(sessionStorage);
            } else {
              const idVehiculoExistente = sessionStorage.getItem(
                "formulang_idVehiculo",
              );
              if (!idVehiculoExistente) {
                throw new Error(
                  "No pudimos identificar el vehículo del registro pendiente. Volvé a ingresar tu CI para reanudarlo.",
                );
              }
              const cambioRes = await fetchWithTimeout(
                "/api/registro-pendiente",
                {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({
                    idCliente: idClienteExistente,
                    idVehiculo: idVehiculoExistente,
                    idPlan: idPlanForm,
                  }),
                },
                20000,
              );
              const cambioBody = await cambioRes.json().catch(() => ({}));
              if (!cambioRes.ok || !cambioBody.idRegistroPendiente) {
                throw new Error(
                  cambioBody.error ||
                    cambioBody.message ||
                    "No pudimos actualizar el plan. Intentá nuevamente.",
                );
              }
              sessionStorage.setItem(
                "formulang_idRegistroPendiente",
                cambioBody.idRegistroPendiente,
              );
            }
            sessionStorage.removeItem("formulang_idMembresiaAltaPendiente");
            idCliente = idClienteExistente;
            if (idPlanForm) sessionStorage.setItem("formulang_idPlanPendiente", idPlanForm);
          } else {
            idCliente = idClienteExistente;
          }
        } else if (modoNuevoVehiculo && idClienteExistente) {
          // Existing client adding a new vehicle — use /api/registro-vehiculo
          // (Lógica encapsulada en submitNuevoVehiculo para reutilizar también
          // en el flujo de recuperación del 409 por CI duplicada.)
          await submitNuevoVehiculo(idClienteExistente);
          idCliente = idClienteExistente;
        } else {
          // New client — full registration
          const res = await fetchWithTimeout("/api/registro", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(formData),
          }, 30000);

          const body = await res.json().catch(() => {
            throw new Error("Error al procesar la respuesta del servidor. Intentá de nuevo.");
          });

          if (!res.ok) {
            const serverMsg = body.error || body.message || "";
            if (res.status === 409) {
              // Distinguir entre CI duplicada (cliente ya existe) y chapa
              // duplicada (vehículo ya existe). Para CI → recuperar el flujo
              // como cliente existente. Para chapa → propagar al caller para
              // que ofrezca el diálogo de confirmación con sufijo "*" (Fix 4).
              const errorCode = String(body.code || "").toUpperCase();
              const looksLikeChapaError =
                errorCode === "CHAPA_DUPLICADA" ||
                /chapa/i.test(serverMsg) ||
                body.field === "chapa";

              if (looksLikeChapaError) {
                const err = new Error(serverMsg || "Esta chapa ya está registrada.") as Error & {
                  status?: number;
                  code?: string;
                  chapa?: string;
                  field?: string;
                };
                err.status = 409;
                err.code = "CHAPA_DUPLICADA";
                if (body.chapa) err.chapa = String(body.chapa);
                if (body.field) err.field = String(body.field);
                throw err;
              }

              // Asumimos CI duplicada — intentar recuperación automática.
              logEvent({
                paso: "submit_registro",
                severidad: "warn",
                codigo: "CI_DUPLICADA_DETECTADA",
                contexto: { hasIdCliente: !!body.idCliente },
              });
              const ciActual = String(formData.ruc || "")
                .replace(/\s+/g, "")
                .replace(/-\d+$/, "");
              const recovered = await recoverFrom409CiDuplicada(body, ciActual);
              if (recovered) {
                idCliente = recovered.idCliente;
                const idPlanFormVal = (document.getElementById("idPlan") as HTMLInputElement)?.value;
                if (idPlanFormVal) sessionStorage.setItem("formulang_idPlanPendiente", idPlanFormVal);
                // continuar el flujo: el código de abajo armará el checkout
              } else {
                showFallback409WhatsApp(
                  "Detectamos que tu CI ya está registrada pero no pudimos recuperar tu cuenta automáticamente.",
                );
                submitBtn.disabled = false;
                submitText.style.display = "inline";
                submitLoading.style.display = "none";
                return;
              }
            } else if (res.status === 400) {
              throw new Error(serverMsg || "Datos inválidos. Revisá los campos e intentá de nuevo.");
            } else {
              throw new Error(serverMsg || "Error inesperado al registrar. Intentá de nuevo más tarde.");
            }
          } else {
            // Respuesta exitosa de /api/registro — cliente nuevo creado.
            idCliente = body.data?.idCliente || body.idCliente;
            if (!idCliente) {
              throw new Error("No pudimos iniciar la activacion de tu plan. Intenta nuevamente.");
            }

            sessionStorage.setItem("formulang_idCliente", idCliente);
            sessionStorage.removeItem("formulang_idMembresiaAltaPendiente");
            const idRegistroPendiente = body.data?.idRegistroPendiente;
            if (idRegistroPendiente) sessionStorage.setItem("formulang_idRegistroPendiente", idRegistroPendiente);
            // Guardar también el plan asociado al registro para detectar cambios
            // de plan en intentos posteriores y forzar un nuevo registro si difieren.
            const idPlanForm = (document.getElementById("idPlan") as HTMLInputElement)?.value;
            if (idPlanForm) sessionStorage.setItem("formulang_idPlanPendiente", idPlanForm);
          }
        }

        const idRegistroParaV2 = sessionStorage.getItem(
          "formulang_idRegistroPendiente",
        );
        if (await membresiasV2Habilitadas()) {
          if (!idRegistroParaV2) {
            throw new Error(
              "El registro quedó incompleto y no puede cotizarse todavía. Intentá nuevamente.",
            );
          }
          logEvent({
            paso: "submit_registro",
            severidad: "info",
            codigo: "MEMBRESIA_V2_ALTA_INICIADA",
            contexto: {
              idRegistroPendiente: idRegistroParaV2,
              flujo: "V2",
            },
          });
          await iniciarAltaMembresiaV2(idCliente, idRegistroParaV2);
          return;
        }

        submitLoading.textContent = "Redirigiendo a Pagopar...";

        // Construir urlRedirect con contexto para el callback de uPay
        // (para Bancard responseHandler no se usa, pero no hace daño incluirlo)
        const _cbUrl = new URL(`${window.location.origin}/api/callback`);
        _cbUrl.searchParams.set("idCliente", idCliente);
        _cbUrl.searchParams.set("acceptTerminos", "true");
        const _rpId = sessionStorage.getItem("formulang_idRegistroPendiente") || "";
        if (_rpId) _cbUrl.searchParams.set("idRegistroPendiente", _rpId);
        const _idMemActivar = sessionStorage.getItem("formulang_idMembresiaActivar") || "";
        if (_idMemActivar) _cbUrl.searchParams.set("idMembresiaActivar", _idMemActivar);
        const _idsMemRaw = sessionStorage.getItem("formulang_idsMembresiasActivar") || "";
        if (_idsMemRaw) _cbUrl.searchParams.set("idsMembresiasActivar", _idsMemRaw);

        const _metodoPagoSubmit = providerSelectorEnabled
          ? (document.getElementById("metodoPago") as HTMLInputElement | null)?.value || "upay"
          : "upay";
        const checkoutRes = await fetchWithTimeout("/api/checkout", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            idCliente: idCliente,
            diaDebito: new Date().getDate(),
            urlRedirect: _cbUrl.toString(),
            metodoPago: _metodoPagoSubmit,
          }),
        }, 30000);

        const checkoutBody = await checkoutRes.json().catch(() => {
          throw new Error("Error al procesar la respuesta del checkout. Intentá de nuevo.");
        });

        if (!checkoutRes.ok) {
          console.error("[checkout] Error response:", checkoutRes.status, checkoutBody);
          logEvent({
            paso: "checkout",
            severidad: "error",
            codigo: `HTTP_${checkoutRes.status}`,
            mensaje: checkoutBody?.error || `checkout HTTP ${checkoutRes.status}`,
            contexto: { httpStatus: checkoutRes.status, body: checkoutBody },
          });
          sessionStorage.removeItem("formulang_idCliente");
          showResult(
            "Alta pendiente",
            `Tu registro fue recibido, pero no pudimos iniciar el pago automatico (${checkoutBody?.error || checkoutRes.status}). Tu membresia no quedo activa. Contactanos para completar el alta.`,
            true,
          );
          return;
        }
        logEvent({
          paso: "checkout",
          severidad: "info",
          codigo: "CHECKOUT_OK",
          contexto: { proveedor: checkoutBody?.proveedor, processId: !!checkoutBody?.processId },
        });

        const processId = checkoutBody.processId;
        // Guardar para incluir en telemetría de rechazos (el banco lo pide)
        if (processId) sessionStorage.setItem("formulang_processId", processId);
        const proveedor: "Bancard" | "uPay" = checkoutBody.proveedor === "Bancard" ? "Bancard" : "uPay";
        if (processId) {
          form.style.display = "none";
          bancardContainer.style.display = "block";

          (document.querySelector(".modal-container") as HTMLElement | null)?.scrollTo({ top: 0 });
          // Meta Pixel: AddPaymentInfo
          if (typeof (window as any).fbq === "function") {
            const _pm = currentPlanMeta();
            (window as any).fbq("track", "AddPaymentInfo", {
              content_name: _pm.name,
              value: Number(_pm.price.replace(/\./g, "")),
              currency: "PYG",
            });
          }

          const iframeDiv = document.getElementById("bancard-iframe") as HTMLElement;
          if (iframeDiv) iframeDiv.innerHTML = "";

          if (proveedor === "uPay") {
            // Render iframe nativo de uPay (sin SDK)
            const upayIframe = document.createElement("iframe");
            upayIframe.src = `https://www.pagopar.com/upay-iframe/?id-form=${encodeURIComponent(processId)}`;
            upayIframe.style.cssText = "width:100%;height:520px;border:0;display:block;";
            upayIframe.allow = "payment";
            upayIframe.addEventListener("load", () => {
              try {
                const href = upayIframe.contentWindow?.location.href ?? "";
                if (!href.startsWith(window.location.origin)) return;
                const qs = new URL(href).searchParams;
                const status = qs.get("status") || qs.get("checkout") || "";
                const description = qs.get("description") || qs.get("checkout_msg") || "";
                if (!_bancardResponseHandled) {
                  handleBancardResponse({
                    status: status.includes("success") || status === "ok" ? "add_new_card_success" : "add_new_card_fail",
                    description,
                  });
                }
              } catch { /* cross-origin: ignorar */ }
            });
            if (iframeDiv) iframeDiv.appendChild(upayIframe);
            startBancardLifecycle("uPay");
          } else {
            // Flujo Bancard: cargar SDK y renderizar form
            if (!(window as any).Bancard) {
              await new Promise<void>((resolve, reject) => {
                const script = document.createElement("script");
                script.src = "/bancard-checkout-5.0.1.js";
                script.onload = () => resolve();
                script.onerror = () => {
                  logEvent({
                    paso: "bancard_response",
                    severidad: "error",
                    codigo: "SDK_LOAD_FAILED",
                    mensaje: "El SDK de Bancard no se pudo cargar (probable problema de red o CDN)",
                    contexto: { proveedor: "Bancard", scriptSrc: "/bancard-checkout-5.0.1.js" },
                  });
                  reject(new Error("Error al cargar Bancard SDK"));
                };
                document.head.appendChild(script);
              });
            }
            _bancardResponseHandled = false;
            waitForBancardIframe();
            (window as any).Bancard.Cards.createForm("bancard-iframe", processId, {
              responseHandler: handleBancardResponse,
              styles: BANCARD_DARK_STYLES,
            });
            startBancardLifecycle("Bancard");
          }
        } else {
          sessionStorage.removeItem("formulang_idCliente");
          showResult(
            "Alta pendiente",
            "Tu registro fue recibido, pero no pudimos completar el cobro automatico. Tu membresia no quedo activa. Contactanos para continuar.",
            true,
          );
        }
        return;
      } catch (err: any) {
        // Fix 4: detectar 409 por chapa duplicada y ofrecer al usuario el
        // diálogo de confirmación (no bloquear el flujo).
        const isChapaDup =
          err?.code === "CHAPA_DUPLICADA" ||
          (err?.status === 409 && typeof err?.message === "string" && /chapa/i.test(err.message));
        if (isChapaDup && !_chapaMarcadaParaRevisionManual) {
          // Liberar el submit y mostrar el diálogo. NO limpiar sessionStorage
          // — si la recuperación del 409 ya creó idCliente, queremos preservarlo.
          submitBtn.disabled = false;
          submitText.style.display = "inline";
          submitLoading.style.display = "none";
          const chapaShown =
            err.chapa ||
            (document.getElementById("chapa") as HTMLInputElement)?.value.trim().toUpperCase() ||
            "tu chapa";
          logEvent({
            paso: "submit_registro",
            severidad: "warn",
            codigo: "CHAPA_DUPLICADA_DETECTADA",
            mensaje: err?.message || "Chapa duplicada detectada en el backend",
            contexto: { chapa: chapaShown, endpoint: err?.endpoint || null },
          });
          mostrarDialogoChapaDuplicada(
            chapaShown,
            () => reintentarConChapaMarcada(),
            () => {
              // Cancelar → volver al paso 2 y enfocar el campo chapa
              goToStep(2);
              const chapaEl = document.getElementById("chapa") as HTMLInputElement | null;
              if (chapaEl) {
                chapaEl.focus();
                chapaEl.select();
              }
            },
          );
          return;
        }

        // Filter out raw technical errors (SyntaxError, TypeError, etc.)
        const isTechnical = err instanceof SyntaxError || err instanceof TypeError ||
          (err.message && (err.message.includes("Unexpected token") || err.message.includes("undefined")));
        errorMsg.textContent = isTechnical
          ? "Error inesperado. Intente más tarde."
          : (err.message || "Error inesperado. Intente más tarde.");
        errorBanner.style.display = "block";
        logEvent({
          paso: "submit_registro",
          severidad: "error",
          codigo: isTechnical ? "TECHNICAL_ERROR" : "SUBMIT_ERROR",
          mensaje: err?.message || String(err),
          contexto: { stack: err?.stack, isTechnical },
        });
      } finally {
        submitBtn.disabled = false;
        submitText.style.display = "inline";
        submitLoading.style.display = "none";
        submitLoading.textContent = "Procesando...";

        // CRÍTICO: invalidar el token Turnstile tras cada submit (éxito o
        // fallo). El token es de UN SOLO USO — al validar contra Cloudflare,
        // el backend lo consume. Reintentos consecutivos con el mismo token
        // disparan "No se pudo validar el captcha" (400). El reset fuerza
        // un nuevo token para el próximo intento sin intervención del usuario.
        try {
          _tsTokenValue = "";
          _tsTokenReady = false;
          const ts = (window as unknown as { turnstile?: TurnstileInstance }).turnstile;
          if (ts && typeof ts.reset === "function") {
            ts.reset();
            logEvent({
              paso: "turnstile",
              severidad: "info",
              codigo: "TS_POST_SUBMIT_RESET",
              contexto: { currentStep },
            });
          }
        } catch { /* swallow — no romper UX si Turnstile no está disponible */ }
      }
    });
    // ---- Handle Pagopar Checkout Callback ----
    // When Pagopar redirects back via /api/callback, it sets ?checkout=ok|error on the landing
    (async function handleCheckoutCallback() {
      const params = new URLSearchParams(window.location.search);
      const checkoutStatus = params.get("checkout");
      if (!checkoutStatus) return;

      // Clean URL without reloading
      const cleanUrl = window.location.pathname;
      window.history.replaceState({}, "", cleanUrl);

      if (checkoutStatus === "ok") {
        // Show success notification
        openModal();
        showResult(
          "Plan activado",
          `Tu tarjeta fue registrada exitosamente. Tu ${currentPlanMeta().name} quedó activo y los débitos automáticos mensuales están habilitados.`,
        );

        // Confirm card + charge first installment in the backend
        const storedClienteId = sessionStorage.getItem("formulang_idCliente");
        const storedIdRegistroPendiente = sessionStorage.getItem("formulang_idRegistroPendiente");
        const storedIdMembresiaActivar = sessionStorage.getItem("formulang_idMembresiaActivar");
        const storedIdsMembresiasActivarRaw = sessionStorage.getItem("formulang_idsMembresiasActivar");
        let storedIdsMembresiasActivar: string[] = [];
        try {
          storedIdsMembresiasActivar = storedIdsMembresiasActivarRaw
            ? (JSON.parse(storedIdsMembresiasActivarRaw) as string[])
            : [];
        } catch { storedIdsMembresiasActivar = []; }
        if (storedClienteId) {
          try {
            const confirmPayload: Record<string, any> = { idCliente: storedClienteId, acceptTerminos: true };
            if (storedIdRegistroPendiente) confirmPayload.idRegistroPendiente = storedIdRegistroPendiente;
            if (storedIdsMembresiasActivar.length > 0) confirmPayload.idsMembresiasActivar = storedIdsMembresiasActivar;
            else if (storedIdMembresiaActivar) confirmPayload.idMembresiaActivar = storedIdMembresiaActivar;

            const confirmRes = await fetch("/api/confirmar", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(confirmPayload),
            });

            if (!confirmRes.ok) {
              const confirmBody = await confirmRes.json().catch(() => ({}));
              console.error("Error confirming card:", confirmBody);
              // Payment was rejected — offer retry with another card
              const errMsg = confirmBody.error || confirmBody.message || "Tu tarjeta fue rechazada.";
              showResult(
                "Pago rechazado",
                `${errMsg} Podés intentar registrar otra tarjeta.`,
                true,
              );
              // Inject retry button
              const retryBtn = document.createElement("button");
              retryBtn.type = "button";
              retryBtn.className = "btn-next";
              retryBtn.style.marginTop = "1rem";
              retryBtn.textContent = "Intentar con otra tarjeta";
              retryBtn.addEventListener("click", () => startRetryCheckout(storedClienteId));
              successDiv.appendChild(retryBtn);
              return;
            }
            // Success — fire Meta Pixel Purchase event and clean up
            const callbackBody = await confirmRes.json().catch(() => ({}));
            showResult(
              "Plan activado",
              `Tu tarjeta fue registrada exitosamente. Tu ${currentPlanMeta().name} quedó activo y los débitos automáticos mensuales están habilitados.`,
            );
            addReceiptButton(callbackBody.comprobante);
            if (typeof (window as any).fbq === "function") {
              const _pm = currentPlanMeta();
              (window as any).fbq("track", "Purchase", {
                value: Number(_pm.price.replace(/\./g, "")),
                currency: "PYG",
                content_name: `${_pm.name} - Débito Automático`,
                content_type: "product",
              });
            }
            sessionStorage.removeItem("formulang_idCliente");
            sessionStorage.removeItem("formulang_idRegistroPendiente");
            sessionStorage.removeItem("formulang_idPlanPendiente");
            sessionStorage.removeItem("formulang_idMembresiaAltaPendiente");
            sessionStorage.removeItem("formulang_idMembresiaActivar");
            sessionStorage.removeItem("formulang_idsMembresiasActivar");
            sessionStorage.removeItem("formulang_planId");
          } catch (err) {
            console.error("Error confirming card:", err);
            showResult(
              "Error de conexión",
              "Tu tarjeta fue registrada pero no pudimos confirmar el cobro. Contactanos para asistencia.",
              true,
            );
            sessionStorage.removeItem("formulang_idCliente");
            sessionStorage.removeItem("formulang_idRegistroPendiente");
      sessionStorage.removeItem("formulang_idPlanPendiente");
          }
        }
      } else {
        // Bancard enrollment error — offer retry if there's a pending registration
        const msg = params.get("checkout_msg") || "No se pudo registrar la tarjeta.";
        openModal();
        const storedClienteId = sessionStorage.getItem("formulang_idCliente");
        if (storedClienteId) {
          showResult("Error al registrar tarjeta", `${msg} Podés intentar con otra tarjeta.`, true);
          const retryBtn = document.createElement("button");
          retryBtn.type = "button";
          retryBtn.className = "btn-next";
          retryBtn.style.marginTop = "1rem";
          retryBtn.textContent = "Intentar con otra tarjeta";
          retryBtn.addEventListener("click", () => startRetryCheckout(storedClienteId));
          successDiv.appendChild(retryBtn);
        } else {
          showResult("Error al registrar tarjeta", msg, true);
        }
      }
    })();
  }
</script>
