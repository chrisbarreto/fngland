---
export const prerender = true;

import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const siteKey = import.meta.env.TURNSTILE_SITE_KEY;
---

<BaseLayout
  title="Reclamos y Reportes | Fórmula NG"
  description="Registrá tu reclamo o reporte en Fórmula NG. Revisamos cada caso en el mismo día para darte la mejor solución."
  noindex={true}
>
  <div class="page">
    <header class="header no-sidebar">
      <Header />
    </header>

    <main class="content">
      <section class="hero">
        <div class="hero-content">
          <p class="eyebrow">Atención al cliente</p>
          <h1>Reclamos y reportes</h1>
          <p class="subtitle">
            Contanos tu experiencia para que podamos ayudarte cuanto antes.
          </p>
        </div>
        <div class="hero-glow"></div>
      </section>

      <section class="form-section">
        <div class="form-card">
          <div class="form-header">
            <h2>Registrar un reclamo</h2>
            <p>Usa el código de tu membresía y describí el inconveniente.</p>
          </div>

          <form id="reclamo-form" novalidate>
            <div class="field">
              <label for="codigoMembresia">Código de membresía</label>
              <input
                id="codigoMembresia"
                name="codigoMembresia"
                type="text"
                placeholder="Ej: NG0001"
                autocomplete="off"
                required
                maxlength="20"
              />
              <span class="field-hint">Se encuentra en tu tarjeta o contrato.</span>
            </div>

            <div class="field">
              <label for="descripcion">Descripcion del reclamo</label>
              <textarea
                id="descripcion"
                name="descripcion"
                rows="5"
                placeholder="Ej: El ultimo lavado no incluyo aspirado interior..."
                required
                maxlength="1000"
              ></textarea>
              <span class="field-hint">Maximo 1000 caracteres.</span>
            </div>

            <div class="field">
              <label>Verificacion</label>
              <div class="turnstile">
                <div
                  class="cf-turnstile"
                  data-sitekey={siteKey}
                  data-theme="dark"
                ></div>
              </div>
            </div>

            <div class="form-actions">
              <button type="submit" id="reclamo-submit">
                Enviar reclamo
              </button>
              <span class="form-status" id="reclamo-status"></span>
            </div>
          </form>

          <div class="form-success" id="reclamo-success" style="display:none;">
            <h3>Reclamo recibido</h3>
            <p>Gracias por avisarnos. Nos pondremos en contacto contigo.</p>
          </div>
        </div>

        <aside class="info-card">
          <h3>Te respondemos rapido</h3>
          <ul>
            <li>Revisamos cada reclamo en el mismo dia.</li>
            <li>Si necesitas respuesta urgente, podes escribirnos por WhatsApp.</li>
            <li>Adjunta detalles claros para agilizar la solucion.</li>
          </ul>
        </aside>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>

<style>
  :global(:root) {
    --reclamos-bg: #0d0c0f;
    --reclamos-card: #15131a;
    --reclamos-border: rgba(255, 255, 255, 0.08);
    --reclamos-accent: #f92606;
    --reclamos-text: #f5f3f7;
    --reclamos-muted: #b5afbd;
  }

  .page {
    min-height: 100vh;
    background: radial-gradient(circle at top, rgba(249, 38, 6, 0.12), transparent 45%),
      var(--reclamos-bg);
    color: var(--reclamos-text);
  }

  .header {
    z-index: 10;
    position: sticky;
    inset-block-start: 0;
    background: rgba(13, 12, 15, 0.7);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--reclamos-border);
  }

  .content {
    padding: 3.5rem clamp(1.5rem, 4vw, 4rem) 4rem;
  }

  .hero {
    position: relative;
    padding: 2.5rem 0 3rem;
  }

  .hero-content {
    max-width: 560px;
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.7rem;
    color: var(--reclamos-muted);
    margin-bottom: 0.75rem;
  }

  h1 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    margin: 0 0 0.75rem;
  }

  .subtitle {
    color: var(--reclamos-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .hero-glow {
    position: absolute;
    top: 10%;
    right: 5%;
    width: 240px;
    height: 240px;
    background: radial-gradient(circle, rgba(249, 38, 6, 0.25), transparent 70%);
    filter: blur(20px);
    opacity: 0.7;
  }

  .form-section {
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
  }

  .form-card,
  .info-card {
    background: var(--reclamos-card);
    border: 1px solid var(--reclamos-border);
    border-radius: 20px;
    padding: 2rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35);
  }

  .form-header h2 {
    margin: 0 0 0.5rem;
  }

  .form-header p {
    margin: 0 0 1.5rem;
    color: var(--reclamos-muted);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.2rem;
  }

  label {
    font-size: 0.85rem;
    color: var(--reclamos-muted);
  }

  input,
  textarea {
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #100f14;
    color: var(--reclamos-text);
    padding: 0.85rem 1rem;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s ease;
  }

  input:focus,
  textarea:focus {
    border-color: var(--reclamos-accent);
  }

  .field-hint {
    font-size: 0.75rem;
    color: var(--reclamos-muted);
  }

  .turnstile {
    display: inline-flex;
    padding: 0.5rem;
    border-radius: 12px;
    background: #0f0e12;
    border: 1px dashed rgba(255, 255, 255, 0.1);
  }

  .form-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .form-actions button {
    border: none;
    background: linear-gradient(135deg, #f92606, #ff6b3d);
    color: white;
    padding: 0.85rem 1.8rem;
    border-radius: 999px;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .form-actions button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .form-actions button:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 10px 25px rgba(249, 38, 6, 0.35);
  }

  .form-status {
    font-size: 0.85rem;
    color: var(--reclamos-muted);
  }

  .form-success h3 {
    margin: 0 0 0.5rem;
  }

  .form-success p {
    margin: 0;
    color: var(--reclamos-muted);
  }

  .info-card h3 {
    margin-top: 0;
  }

  .info-card ul {
    padding-left: 1rem;
    color: var(--reclamos-muted);
    display: grid;
    gap: 0.6rem;
  }

  @media (max-width: 960px) {
    .form-section {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .content {
      padding: 2.5rem 1.25rem 3rem;
    }
    .form-card,
    .info-card {
      padding: 1.5rem;
    }
  }
</style>

<script is:inline>
  const form = document.getElementById("reclamo-form");
  const statusEl = document.getElementById("reclamo-status");
  const successEl = document.getElementById("reclamo-success");
  const submitBtn = document.getElementById("reclamo-submit");

  function getTurnstileToken() {
    const tokenField = form?.querySelector("[name='cf-turnstile-response']");
    return tokenField && "value" in tokenField ? tokenField.value : "";
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form || !submitBtn || !statusEl || !successEl) return;

    const codigo = form.querySelector("#codigoMembresia").value.trim();
    const descripcion = form.querySelector("#descripcion").value.trim();
    const token = getTurnstileToken();

    if (!codigo || !descripcion) {
      statusEl.textContent = "Completa todos los campos requeridos.";
      return;
    }
    if (!token) {
      statusEl.textContent = "Verifica el captcha para continuar.";
      return;
    }

    submitBtn.disabled = true;
    statusEl.textContent = "Enviando reclamo...";

    try {
      const res = await fetch("/api/reclamos", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          codigoMembresia: codigo,
          descripcion,
          turnstileToken: token,
        }),
      });

      const body = await res.json().catch(() => ({}));
      if (!res.ok) {
        statusEl.textContent = body.error || "No pudimos enviar el reclamo.";
        submitBtn.disabled = false;
        return;
      }

      form.style.display = "none";
      successEl.style.display = "block";
    } catch (err) {
      statusEl.textContent = "Error de red. Intenta nuevamente.";
      submitBtn.disabled = false;
    }
  });
</script>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
