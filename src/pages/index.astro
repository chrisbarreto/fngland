---
export const prerender = true;

import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Hero from "@/components/Hero.astro";
import Footer from "@/components/Footer.astro";

import Section from "@/components/sections/Section.astro";
import GoogleReviews from "@/components/sections/GoogleReviews.astro";
import AccordionContainer from "@/components/sections/AccordionContainer.astro";
import Accordion from "@/components/sections/Accordion.astro";
import CTA from "@/components/sections/CTA.astro";
import RegistroModal from "@/components/RegistroModal.astro";
---

<BaseLayout
  title="Club de cuidado automotriz | Fórmula NG"
  description="Membresías de lavado ilimitado en Asunción. Fórmula NG: planes desde Gs. 200.000 por mes con detailing profesional, protección, traslados y servicio a domicilio."
>
  <div class="page">
    <!-- Hero background video -->
    <div class="hero-bg">
      <video
        autoplay
        muted
        loop
        playsinline
        class="w-full h-full object-cover hero-video-desktop"
      >
        <source src="/hero-bg.webm" type="video/webm" />
      </video>
      <video
        autoplay
        muted
        loop
        playsinline
        poster="/movil-bg-im.webp"
        class="w-full h-full object-cover hero-video-mobile"
      >
        <source src="/movil-bg.webm" type="video/webm" />
      </video>
      <!-- Overlay oscuro sobre todo el video -->
      <div class="hero-bg-overlay"></div>
    </div>

    <!-- Header -->
    <header class="header no-sidebar">
      <Header />
    </header>

    <!-- Hero -->
    <Hero />

    <!-- Main content -->
    <div class="sl-markdown-content" style="position: relative; z-index: 2; background-color: var(--sl-color-black); margin-top: -120px; padding-top: 40px;">

      {/* Plans Section */}
      <section class="planes-section" id="planes">
        <h2 class="planes-title">Nuestros planes</h2>
        <p class="planes-sub">Todos los planes incluyen lavados ilimitados*, lavado exterior, aspirado, desinfección y revitalización de neumáticos.</p>
        <div class="planes-grid">

          <!-- Plan Fórmula -->
          <div class="plan-card" data-plan-id="a9ee77bc-96ce-4217-ad0f-c817b9e58687">
            <div class="plan-header">
              <span class="plan-tag">Plan Fórmula</span>
              <div class="plan-price-wrap">
                <span class="plan-price">Gs. 200.000</span>
                <span class="plan-price-mo">/mes</span>
              </div>
            </div>
            <ul class="plan-features">
              <li><span class="feat-check">✓</span><span>Lavados <strong>ilimitados</strong> (máx. 1/día)</span></li>
              <li><span class="feat-check">✓</span><span>Lavado exterior completo</span></li>
              <li><span class="feat-check">✓</span><span>Aspirado profundo</span></li>
              <li><span class="feat-check">✓</span><span>Desinfección de interiores</span></li>
              <li><span class="feat-check">✓</span><span>Revitalización de neumáticos</span></li>
              <li><span class="feat-check">✓</span><span>Cera líquida (prot. 4 meses) <em class="feat-freq">— una vez al mes</em></span></li>
              <li><span class="feat-check">✓</span><span>Lavado de motor profesional <em class="feat-freq">— una vez al mes</em></span></li>
              <li><span class="feat-check">✓</span><span>Hidratación de plásticos interiores <em class="feat-freq">— una vez al mes</em></span></li>
              <li><span class="feat-check">✓</span><span>Traslados GRATIS (retiro/entrega) <em class="feat-freq">— dos veces al mes</em></span></li>
            </ul>
            <button type="button" class="btn-plan" data-plan-id="a9ee77bc-96ce-4217-ad0f-c817b9e58687">Contratar Plan Fórmula</button>
          </div>

          <!-- Plan Premium -->
          <div class="plan-card plan-card-popular" data-plan-id="7ad4bfae-b1f2-47c9-8c3c-d4615607ad04">
            <div class="plan-badge">MÁS POPULAR</div>
            <div class="plan-header">
              <span class="plan-tag">Plan Premium</span>
              <div class="plan-price-wrap">
                <span class="plan-price">Gs. 250.000</span>
                <span class="plan-price-mo">/mes</span>
              </div>
            </div>
            <ul class="plan-features">
              <li><span class="feat-check">✓</span><span>Lavados <strong>ilimitados</strong> (máx. 1/día)</span></li>
              <li><span class="feat-check">✓</span><span>Lavado exterior completo</span></li>
              <li><span class="feat-check">✓</span><span>Aspirado profundo</span></li>
              <li><span class="feat-check">✓</span><span>Desinfección de interiores</span></li>
              <li><span class="feat-check">✓</span><span>Revitalización de neumáticos</span></li>
              <li><span class="feat-check">✓</span><span>Cera líquida (prot. 4 meses) <em class="feat-freq">— una vez al mes</em></span></li>
              <li><span class="feat-check">✓</span><span>Lavado de motor profesional <em class="feat-freq">— una vez al mes</em></span></li>
              <li><span class="feat-check">✓</span><span>Hidratación de plásticos interiores <em class="feat-freq">— una vez al mes</em></span></li>
              <li><span class="feat-check">✓</span><span>Lavado a domicilio <em class="feat-freq">— dos veces al mes</em></span></li>
            </ul>
            <button type="button" class="btn-plan btn-plan-featured" data-plan-id="7ad4bfae-b1f2-47c9-8c3c-d4615607ad04">Contratar Plan Premium</button>
          </div>

          <!-- Plan Gold -->
          <div class="plan-card plan-card-featured" data-plan-id="5a9b7b48-2e37-45f2-8ba9-f1a234b85f80">
            <div class="plan-badge plan-badge-featured">RECOMENDADO</div>
            <div class="plan-header">
              <span class="plan-tag">Plan Gold</span>
              <div class="plan-price-wrap">
                <span class="plan-price">Gs. 300.000</span>
                <span class="plan-price-mo">/mes</span>
              </div>
            </div>
            <ul class="plan-features">
              <li><span class="feat-check">✓</span><span>Lavados <strong>ilimitados</strong> (máx. 1/día)</span></li>
              <li><span class="feat-check">✓</span><span>Lavado exterior completo</span></li>
              <li><span class="feat-check">✓</span><span>Aspirado profundo</span></li>
              <li><span class="feat-check">✓</span><span>Desinfección de interiores</span></li>
              <li><span class="feat-check">✓</span><span>Revitalización de neumáticos</span></li>
              <li><span class="feat-check">✓</span><span>Cera líquida (prot. 4 meses) <em class="feat-freq">— una vez al mes</em></span></li>
              <li><span class="feat-check">✓</span><span>Lavado de tapizado <em class="feat-freq">— una vez al mes</em></span></li>
              <li><span class="feat-check">✓</span><span>Hidratación de plásticos interiores <em class="feat-freq">— una vez al mes</em></span></li>
              <li><span class="feat-check">✓</span><span>Traslado GRATIS (retiro/entrega) <em class="feat-freq">— una vez al mes</em></span></li>
              <li><span class="feat-check">✓</span><span>Pulida comercial <em class="feat-freq feat-freq-annual">— una vez al año</em></span></li>
            </ul>
            <button type="button" class="btn-plan btn-plan-featured" data-plan-id="5a9b7b48-2e37-45f2-8ba9-f1a234b85f80">Contratar Plan Gold</button>
          </div>

          <!-- Plan Lavado a Domicilio -->
          <div class="plan-card plan-card-domicilio" data-plan-id="ae949f1e-90c5-4d4e-879c-3e2724c89c79">
            <div class="plan-header">
              <span class="plan-tag">Plan Domicilio</span>
              <div class="plan-price-wrap">
                <span class="plan-price">Gs. 500.000</span>
                <span class="plan-price-mo">/mes</span>
              </div>
            </div>
            <ul class="plan-features">
              <li><span class="feat-check">✓</span><span>Lavado exterior con shampoo pH neutro</span></li>
              <li><span class="feat-check">✓</span><span>Aspirado profundo</span></li>
              <li><span class="feat-check">✓</span><span>Desinfección de interiores</span></li>
              <li><span class="feat-check">✓</span><span>Revitalización de neumáticos</span></li>
              <li><span class="feat-check">✓</span><span>Hidratación de plásticos interiores</span></li>
              <li><span class="feat-check">✓</span><span>Servicios de detailing <strong>a domicilio</strong> <em class="feat-freq">— cuatro veces al mes</em></span></li>
            </ul>
            <p class="plan-domicilio-note">Todo el servicio se realiza en tu casa u oficina.</p>
            <button type="button" class="btn-plan" data-plan-id="ae949f1e-90c5-4d4e-879c-3e2724c89c79">Contratar Plan Domicilio</button>
          </div>

        </div>
        <p class="planes-footnote">* Máximo 1 lavado por día por vehículo durante el ciclo mensual activo. Los servicios con límite (1/mes, 2/mes, 1/año) se renuevan según el período indicado.</p>
      </section>


      {/* Google Reviews Section */}
      <GoogleReviews />

      {/* FAQ Section */}
      <Section
        id="preguntas"
        title="Preguntas <span class='light-text'>frecuentes</span>"
        description="Todo lo que necesitás saber sobre los planes de Fórmula NG."
      >
        <AccordionContainer tabList={[
          {
            type: 'membresia',
            title: 'Membresía Fórmula NG',
            subtitle: 'Qué incluye y cómo funciona.',
            icon: 'rocket'
          },
          {
            type: 'pagos',
            title: 'Pagos y Suscripción',
            subtitle: 'Medios de pago y renovación.',
            icon: 'payment'
          },
          {
            type: 'agenda',
            title: 'Agenda y Logística',
            subtitle: 'Turnos y traslados.',
            icon: 'calendar'
          },
          {
            type: 'responsabilidad',
            title: 'Responsabilidad y Seguridad',
            subtitle: 'Cuidado de tu vehículo.',
            icon: 'shield'
          },
          {
            type: 'servicios',
            title: 'Servicios Adicionales',
            subtitle: 'Opciones extra y financiación.',
            icon: 'settings'
          },
          {
            type: 'condiciones',
            title: 'Condiciones Generales',
            subtitle: 'Límites y consideraciones.',
            icon: 'support'
          }
        ]}>
          {/* Membresía Fórmula NG */}
          <Accordion
            question="¿Qué planes de membresía ofrecen?"
            answer="Ofrecemos 4 planes: Plan Fórmula (Gs. 200.000/mes) con lavados ilimitados, cera, motor y 2 traslados; Plan Premium (Gs. 250.000/mes) con lavados ilimitados, cera, motor y 2 lavados a domicilio; Plan Gold (Gs. 300.000/mes) con lavados ilimitados, cera, tapizado, pulida comercial anual y 1 traslado; y Plan Lavado a Domicilio (Gs. 500.000/mes) con 4 servicios de detailing en tu casa. Todos incluyen lavado exterior, aspirado, desinfección y revitalización de neumáticos."
            type="membresia"
          />
          <Accordion
            question="¿Cuántas veces puedo lavar mi auto con la membresía?"
            answer="Podés lavar tu vehículo de forma ilimitada en cada ciclo mensual activo, con un máximo de 1 lavado por día por vehículo."
            type="membresia"
          />
          <Accordion
            question="¿La membresía sirve para más de un vehículo?"
            answer="No. Cada membresía es válida únicamente para un solo vehículo registrado."
            type="membresia"
          />
          <Accordion
            question="¿La membresía tiene vencimiento?"
            answer="Sí. Todos los planes tienen una permanencia mínima de 12 meses. Los beneficios se habilitan por ciclos mensuales de 30 días y se mantienen activos mientras los pagos estén al día."
            type="membresia"
          />
          <Accordion
            question="¿Puedo transferir mi membresía a otra persona o a otro vehículo?"
            answer="No. La membresía es personal e intransferible y está asociada a un vehículo específico."
            type="membresia"
          />

          {/* Pagos y Suscripción */}
          <Accordion
            question="¿Qué medios de pago aceptan?"
            answer="Aceptamos pagos a través de PagoPar y otros medios habilitados en nuestra plataforma."
            type="pagos"
          />
          <Accordion
            question="¿Puedo pagar con tarjeta de crédito o débito?"
            answer="Sí. Podés pagar con tarjeta de forma segura a través de PagoPar."
            type="pagos"
          />
          <Accordion
            question="¿La membresía se renueva automáticamente?"
            answer="Sí. Todos los planes se cobran por débito automático obligatorio y mantienen la membresía activa durante la vigencia contratada, siempre que los pagos mensuales estén aprobados."
            type="pagos"
          />
          <Accordion
            question="¿Cómo solicito la no renovación del plan?"
            answer="La no renovación debe solicitarse con al menos 60 días corridos de anticipación al vencimiento de la vigencia contractual."
            type="pagos"
          />
          <Accordion
            question="¿Qué pasa si se rechaza el pago mensual?"
            answer="Si el pago es rechazado, la membresía queda desactivada hasta regularizar el cobro correspondiente."
            type="pagos"
          />
          <Accordion
            question="¿Cuándo aplica un reembolso?"
            answer="Solo aplican reembolsos en casos de cobro duplicado, error de facturación, cobro no autorizado atribuible a Fórmula NG o imposibilidad de prestación del servicio por causa atribuible a la empresa."
            type="pagos"
          />
          <div class="accordion pagopar-badge" data-tab="pagos" style="display:none;">
            <div class="pagopar-content">
              <img src="/logo-pagopar.svg" alt="PagoPar" class="pagopar-logo" />
              <span>Pagos seguros y automáticos procesados por PagoPar&reg;</span>
            </div>
          </div>

          {/* Agenda y Logística */}
          <Accordion
            question="¿Necesito agendar turno para venir?"
            answer="Sí. Todos los servicios se realizan con turno previo para garantizar una mejor organización y atención."
            type="agenda"
          />
          <Accordion
            question="¿Cómo reservo mi turno?"
            answer="Una vez que sos socio, recibís el link de agendamiento para reservar según la disponibilidad del sistema."
            type="agenda"
          />
          <Accordion
            question="¿Qué incluyen los 2 traslados gratis?"
            answer="Incluyen el servicio de retiro o entrega de tu vehículo, con agenda previa y sujeto a disponibilidad."
            type="agenda"
          />
          <Accordion
            question="¿Qué pasa si llego tarde a mi turno?"
            answer="Existe una tolerancia de tiempo. Si el retraso es mayor, el turno puede reprogramarse según la disponibilidad del día."
            type="agenda"
          />

          {/* Responsabilidad y Seguridad */}
          <Accordion
            question="¿Mi vehículo está seguro en Fórmula NG?"
            answer="Sí. Trabajamos con personal capacitado, procesos de control de calidad y protocolos de cuidado para proteger tu vehículo."
            type="responsabilidad"
          />
          <Accordion
            question="¿Puedo dejar objetos dentro del auto?"
            answer="Recomendamos no dejar objetos de valor. Fórmula NG no se responsabiliza por pertenencias olvidadas dentro del vehículo."
            type="responsabilidad"
          />

          {/* Servicios Adicionales */}
          <Accordion
            question="¿Qué servicios no están incluidos en la membresía?"
            answer="No están incluidos trabajos especiales como: Suciedad extrema o incrustada, Eliminación de barro, insectos o residuos pesados, Detailing avanzado, pulidos especiales, tratamientos cerámicos, etc. Estos servicios se cotizan por separado según el estado del vehículo."
            type="servicios"
          />
          <Accordion
            question="¿Qué otros servicios ofrece Fórmula NG?"
            answer="Además de la membresía, ofrecemos: Pulido técnico y pulido comercial, Tratamientos nano cerámicos, Detailing profesional, Chapería y pintura, Restauración estética y todo tipo de servicios automotrices. Todos los trabajos se realizan con evaluación previa y presupuesto personalizado."
            type="servicios"
          />
          <Accordion
            question="¿Estos servicios se pueden financiar?"
            answer="Sí. Contamos con opciones de financiación en servicios seleccionados. Consultanos para conocer las condiciones."
            type="servicios"
          />

          {/* Condiciones Generales */}
          <Accordion
            question="¿Hay un límite de uso diario?"
            answer="Sí. La membresía permite un máximo de 1 lavado por día por vehículo."
            type="condiciones"
          />
          <Accordion
            question="¿Qué pasa si mi auto está en muy mal estado de suciedad?"
            answer="En casos de suciedad extrema o trabajos especiales, puede aplicarse un costo adicional bajo evaluación y confirmación del supervisor, con aprobación previa del cliente."
            type="condiciones"
          />
        </AccordionContainer>
      </Section>

      {/* CTA Section */}
      <CTA />
    </div>

    {/* Footer */}
    <Footer />
  </div>

  {/* Registration Modal */}
  <RegistroModal />
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  .hero-bg-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.55);
    pointer-events: none;
  }
  .header {
    z-index: 10;
    position: sticky;
    inset-inline-start: 0;
    inset-block-start: 0;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    background-color: color-mix(in srgb, var(--sl-color-black) 60%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid
      color-mix(in srgb, var(--sl-color-white) 10%, transparent);
    padding: 0;
    transition: background-color 0.3s ease;
  }
  .header.header-solid {
    background-color: var(--sl-color-black);
  }
  .header :global(.container) {
    max-width: 100%;
    padding-inline: clamp(1rem, 3vw, 3rem);
    box-sizing: border-box;
  }
  @media (max-width: 800px) {
    .header {
      padding: 6px 0;
      background-color: transparent !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
      border-bottom: none !important;
    }
  }
  .pagopar-badge {
    padding: 1.25rem 2rem;
    border-radius: 16px;
  }
  .pagopar-badge.show-accordion {
    display: block !important;
  }
  .pagopar-content {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .pagopar-logo {
    height: 32px;
    width: auto;
  }
  .pagopar-content span {
    font-size: 0.95rem;
    color: var(--sl-color-gray-3);
  }
  /* ─── Planes section ─── */
  .planes-section {
    padding: 4rem 1.5rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }
  .planes-title {
    text-align: center;
    margin: 0 0 0.6rem;
    font-size: clamp(1.4rem, 3.5vw, 1.9rem);
    color: #fff;
  }
  .planes-sub {
    text-align: center;
    color: rgba(255,255,255,0.5);
    font-size: 0.92rem;
    margin: 0 0 2.5rem;
  }
  /* ─── Plan cards ─── */
  .planes-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.1rem;
    align-items: start;
  }
  .plan-card {
    position: relative;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 18px;
    padding: 1.75rem 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .plan-card-popular {
    border-color: rgba(249,38,6,0.4);
  }
  .plan-card-featured {
    border-color: #f92606;
    background: rgba(249,38,6,0.07);
    box-shadow: 0 0 32px rgba(249,38,6,0.12);
  }
  .plan-card-domicilio {
    border-color: rgba(255,255,255,0.15);
    background: rgba(255,255,255,0.03);
  }
  .plan-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(249,38,6,0.85);
    color: #fff;
    font-size: 0.63rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    padding: 3px 14px;
    border-radius: 99px;
    white-space: nowrap;
  }
  .plan-badge-featured {
    background: linear-gradient(135deg, #f92606, #ff6b3d);
  }
  .plan-header { display: grid; gap: 0.4rem; }
  .plan-tag {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.45);
  }
  .plan-price-wrap {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
  }
  .plan-price {
    font-size: 1.55rem;
    font-weight: 900;
    color: #ff6b3d;
  }
  .plan-price-mo {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.4);
  }
  .plan-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
  }
  .plan-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.83rem;
    color: rgba(255,255,255,0.7);
    line-height: 1.4;
  }
  .feat-check {
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: 700;
    min-width: 28px;
    text-align: center;
    color: #22c55e;
    background: rgba(34,197,94,0.12);
    border-radius: 5px;
    padding: 1px 4px;
    margin-top: 1px;
  }
  .feat-freq {
    font-style: normal;
    color: rgba(255,255,255,0.38);
    font-size: 0.79em;
  }
  .feat-freq-annual {
    color: rgba(167,139,250,0.65);
  }
  .plan-domicilio-note {
    margin: 0;
    font-size: 0.78rem;
    color: rgba(255,255,255,0.35);
    font-style: italic;
  }
  .btn-plan {
    background: rgba(249,38,6,0.15);
    border: 1px solid rgba(249,38,6,0.4);
    color: #ff6b3d;
    border-radius: 10px;
    padding: 0.75rem 1rem;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    width: 100%;
  }
  .btn-plan:hover {
    background: rgba(249,38,6,0.25);
    border-color: #f92606;
  }
  .btn-plan-featured {
    background: linear-gradient(135deg, #f92606, #ff6b3d);
    border-color: transparent;
    color: #fff;
    box-shadow: 0 6px 20px rgba(249,38,6,0.3);
  }
  .btn-plan-featured:hover {
    background: linear-gradient(135deg, #d42005, #f55c2e);
