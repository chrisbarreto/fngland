                <td class="td-popular"><span class="comp-yes">✓</span></td>
                <td class="td-featured"><span class="comp-no">—</span></td>
                <td><span class="comp-no">—</span></td>
              </tr>
              <tr>
                <td>Limpieza de Tapizado Superficial <em class="comp-freq comp-freq-annual">— una vez al año</em></td>
                <td><span class="comp-no">—</span></td>
                <td class="td-popular"><span class="comp-no">—</span></td>
                <td class="td-featured"><span class="comp-yes">✓</span></td>
                <td><span class="comp-no">—</span></td>
