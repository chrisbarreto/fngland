---
// This component renders a full-screen registration modal.
// All logic is client-side JavaScript (no framework needed).
const siteKey = import.meta.env.TURNSTILE_SITE_KEY;
---

<!-- Registration Modal -->
<div id="registro-modal" class="modal-overlay" style="display:none;">
  <div class="modal-container">
    <!-- Overlay de procesamiento -->
    <div id="processing-overlay" class="processing-overlay" style="display:none;">
      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="processing-spinner"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
      <p class="processing-text">Procesando pago...</p>
      <p class="processing-subtext">Esperá un momento, no cierres esta ventana.</p>
    </div>
    <button id="modal-close" class="modal-close" aria-label="Cerrar">&times;</button>
    
    <div class="modal-header">
      <h2 class="modal-title">Activá tu <span id="modal-plan-name">plan</span></h2>
      <p class="modal-subtitle">Completá tus datos, registrá tu tarjeta y activá tu membresía de <span id="modal-plan-price">—</span> por mes.</p>
      <!-- Step indicators -->
      <div class="steps-indicator">
        <div class="step-dot active" data-step="1"><span>1</span></div>
        <div class="step-line"></div>
        <div class="step-dot" data-step="2"><span>2</span></div>
        <div class="step-line"></div>
        <div class="step-dot" data-step="3"><span>3</span></div>
      </div>
      <div class="steps-labels">
        <span class="step-label active" data-step="1">Tus datos</span>
        <span class="step-label" data-step="2">Tu vehículo</span>
        <span class="step-label" data-step="3">Plan y pago</span>
      </div>
    </div>

    <form id="registro-form" novalidate>
      <!-- Step 1: Personal Data -->
      <div class="form-step active" data-step="1">
        <div class="form-grid">
          <div class="form-group full">
            <label for="ruc">RUC / CI <span class="required">*</span></label>
            <div style="display:flex;gap:0.5rem;align-items:stretch;">
              <input type="text" id="ruc" name="ruc" required placeholder="Ej: 1234567-8" maxlength="20" style="flex:1;min-width:0;" />
              <button type="button" id="btn-confirmar-ci" style="padding:0 1.1rem;background:#f9a606;border:none;border-radius:8px;color:#111;font-weight:700;cursor:pointer;font-size:0.85rem;white-space:nowrap;flex-shrink:0;">Confirmar</button>
            </div>
            <span class="field-error"></span>
          </div>
          <!-- Turnstile captcha — validar antes de consultar CI -->
          <div class="form-group full" id="turnstile-step1">
            <div class="turnstile-wrapper" style="margin:0.5rem 0;">
              <div
                class="cf-turnstile"
                data-sitekey={siteKey}
                data-theme="dark"
                data-refresh-expired="auto"
              ></div>
            </div>
            <span class="field-error" id="turnstile-error"></span>
          </div>
          <!-- Loading indicator mientras se busca el CI -->
          <div class="form-group full" id="ci-lookup-loading" style="display:none;">
            <div style="display:flex;align-items:center;gap:0.6rem;padding:0.5rem 0;color:rgba(255,255,255,0.55);font-size:0.85rem;">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="animation:ci-spin 0.8s linear infinite;flex-shrink:0;"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
              Buscando tu registro...
            </div>
          </div>
          <!-- Campos personales — ocultos hasta resolver el lookup -->
          <div class="form-group full personal-field" style="display:none;">
            <label for="nombre">Nombre completo <span class="required">*</span></label>
            <input type="text" id="nombre" name="nombre" required placeholder="Ej: Juan Pérez" maxlength="200" />
            <span class="field-error"></span>
          </div>
          <div class="form-group personal-field" style="display:none;">
            <label for="telefono">Teléfono / WhatsApp <span class="required">*</span></label>
            <input type="tel" id="telefono" name="telefono" required placeholder="Ej: 0981123456" maxlength="20" minlength="10" />
            <span class="field-error"></span>
          </div>
          <div class="form-group personal-field" style="display:none;">
            <label for="email">Email <span class="required">*</span></label>
            <input type="email" id="email" name="email" required placeholder="tu@email.com" />
            <span class="field-error"></span>
          </div>
        </div>
        <!-- Acción oculta hasta resolver el lookup -->
        <div class="form-actions" id="step1-actions" style="display:none;">
          <button type="button" class="btn-next" data-next="2">Siguiente</button>
        </div>
      </div>

      <!-- Step 2: Vehicle Data -->
      <div class="form-step" data-step="2">
        <div class="form-grid">
          <div class="form-group">
            <label for="chapa">Chapa / Matrícula <span class="required">*</span></label>
            <input type="text" id="chapa" name="chapa" required placeholder="Ej: ABC 1234" maxlength="15" style="text-transform: uppercase;" />
            <span class="field-error"></span>
          </div>
          <div class="form-group">
            <label for="anio">Año</label>
            <input type="number" id="anio" name="anio" placeholder="Ej: 2024" min="1900" max="2100" />
            <span class="field-error"></span>
          </div>
          <div class="form-group">
            <label for="idMarca">Marca</label>
            <select id="idMarca" name="idMarca">
              <option value="">Seleccionar marca...</option>
            </select>
            <span class="field-error"></span>
          </div>
          <div class="form-group" id="marcaNueva-group" style="display:none;">
            <label for="marcaNueva">Especificá la marca</label>
            <input type="text" id="marcaNueva" name="marcaNueva" placeholder="Ej: BYD" maxlength="80" />
            <span class="field-error"></span>
          </div>
          <div class="form-group">
            <label for="idModelo">Modelo</label>
            <select id="idModelo" name="idModelo" disabled>
              <option value="">Primero seleccioná la marca</option>
            </select>
            <span class="field-error"></span>
          </div>
          <div class="form-group" id="modeloNuevo-group" style="display:none;">
            <label for="modeloNuevo">Especificá el modelo</label>
            <input type="text" id="modeloNuevo" name="modeloNuevo" placeholder="Ej: Dolphin" maxlength="80" />
            <span class="field-error"></span>
          </div>
          <div class="form-group">
            <label for="color">Color</label>
            <input type="text" id="color" name="color" placeholder="Ej: Blanco" maxlength="50" />
            <span class="field-error"></span>
          </div>
          <div class="form-group">
            <label for="tipoVehiculo">Tipo</label>
            <select id="tipoVehiculo" name="tipoVehiculo">
              <option value="">Seleccionar...</option>
              <option value="1">Auto</option>
              <option value="2">Camioneta</option>
              <option value="3">SUV</option>
              <option value="4">Moto</option>
              <option value="5">Doble Cabina</option>
            </select>
            <span class="field-error"></span>
          </div>
        </div>
        <div class="form-actions">
          <button type="button" class="btn-prev" data-prev="1">Atrás</button>
          <button type="button" class="btn-next" data-next="3">Siguiente</button>
        </div>
      </div>

      <!-- Step 3: Plan Selection -->
      <div class="form-step" data-step="3">
        <div id="planes-container" class="planes-grid">
          <div class="planes-loading">Cargando planes...</div>
        </div>
        <input type="hidden" id="idPlan" name="idPlan" />

        <!-- Auto-debit section -->
        <div class="auto-debit-section">
          <p class="auto-debit-eyebrow">Débito automático obligatorio</p>
          <h3 class="auto-debit-title">Tu membresía se activa con pago inmediato</h3>
          <p class="auto-debit-copy">
            El plan seleccionado tiene permanencia mínima de 12 meses y se cobra automáticamente por <span id="auto-debit-price">Gs. 200.000</span> en cada ciclo mensual activo.
          </p>
          <ul class="auto-debit-list">
            <li>Tu primer débito se realizará un mes después de la activación, siempre en el mismo día del mes.</li>
            <li>Si un pago es rechazado, la membresía queda desactivada hasta regularizar.</li>
            <li>Para cambiar la fecha de débito contactá a soporte por WhatsApp.</li>
          </ul>
        </div>

        <!-- Aceptación legal -->
        <div class="legal-accept-wrapper">
          <label class="legal-accept-label">
            <input type="checkbox" id="acceptLegal" name="acceptLegal" />
            <span>
              Acepto los
              <a href="/terminos-y-condiciones" target="_blank" rel="noopener noreferrer">Términos y Condiciones</a>,
              <a href="/politica-de-privacidad" target="_blank" rel="noopener noreferrer">Política de Privacidad</a>
              y la <a href="/debito-automatico" target="_blank" rel="noopener noreferrer">autorización de débito automático</a>.
            </span>
          </label>
          <span class="field-error" id="legal-accept-error"></span>
        </div>

        <div class="form-actions">
          <button type="button" class="btn-prev" data-prev="2">Atrás</button>
          <button type="submit" class="btn-submit" id="btn-submit">
            <span class="btn-submit-text">Continuar al pago</span>
            <span class="btn-submit-loading" style="display:none;">Procesando...</span>
          </button>
        </div>
      </div>
    </form>

    <!-- Success state -->
    <div id="registro-success" class="success-message" style="display:none;">
      <div class="success-icon">&#10003;</div>
      <h3>Plan activado</h3>
      <p>Tu membresía quedó activa correctamente. Ya podés disfrutar de tus beneficios y agendar tus servicios.</p>
      <button type="button" class="btn-next btn-receipt-green" id="btn-download-receipt" style="display:none;">Descargar comprobante</button>
    </div>

    <!-- Bancard Checkout iframe container -->
    <div id="bancard-checkout-container" style="display:none;">
      <div class="checkout-header">
        <h3>Registrá tu tarjeta de pago</h3>
        <p id="checkout-plan-info">Ingresá los datos de tu tarjeta para habilitar el débito automático obligatorio y activar tu membresía.</p>
      </div>
      <!-- Loading spinner — visible while Bancard iframe is loading -->
      <div id="bancard-loading" style="display:none;text-align:center;padding:3rem 0;">
        <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="animation:ci-spin 0.8s linear infinite;display:inline-block;"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
        <p style="margin:0.75rem 0 0;color:rgba(255,255,255,0.55);font-size:0.88rem;">Cargando formulario de pago seguro…</p>
      </div>
      <div id="bancard-iframe"></div>
      <p class="checkout-secure-note">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Conexión segura. Tus datos de tarjeta son procesados directamente por Bancard.
      </p>
    </div>

    <!-- Error state -->
    <div id="registro-error" class="error-banner" style="display:none;">
      <span id="error-message"></span>
    </div>
  </div>
</div>

<style>
  /* Modal overlay */
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    animation: modalFadeIn 0.3s ease;
    overflow-y: auto;
  }

  @keyframes modalFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes ci-spin {
    to { transform: rotate(360deg); }
  }

  .modal-container {
    position: relative;
    width: 100%;
    max-width: 580px;
    background: var(--sl-color-gray-6, #1a1a1a);
    border: 1px solid var(--sl-color-hairline, rgba(255,255,255,0.1));
    border-radius: 20px;
    padding: 2.5rem 2rem;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
    max-height: 90vh;
    overflow-y: auto;
  }

  .processing-overlay {
    position: absolute;
    inset: 0;
    z-index: 100;
    background: rgba(26, 26, 26, 0.92);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }
  .processing-spinner {
    animation: proc-spin 0.8s linear infinite;
  }
  @keyframes proc-spin {
    to { transform: rotate(360deg); }
  }
  .processing-text {
    color: #fff;
    font-size: 1.2rem;
    font-weight: 600;
    margin: 0;
  }
  .processing-subtext {
    color: rgba(255,255,255,0.5);
    font-size: 0.9rem;
    margin: 0;
  }

  .modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    color: var(--sl-color-gray-3, #888);
    font-size: 1.8rem;
    cursor: pointer;
    line-height: 1;
    padding: 0.25rem;
    transition: color 0.2s;
  }
  .modal-close:hover {
    color: var(--sl-color-white, #fff);
  }

  /* Header */
  .modal-header {
    text-align: center;
    margin-bottom: 2rem;
  }
  .modal-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--sl-color-white, #fff);
    margin: 0 0 0.5rem;
  }
  .modal-subtitle {
    font-size: 0.9rem;
    color: var(--sl-color-gray-3, #888);
    margin: 0 0 1.5rem;
  }

  /* Steps */
  .steps-indicator {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    margin-bottom: 0.5rem;
  }
  .step-dot {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid var(--sl-color-gray-4, #555);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--sl-color-gray-4, #555);
    transition: all 0.3s;
  }
  .step-dot.active {
    border-color: #f92606;
    background: linear-gradient(135deg, #f92606, #ff6b3d);
    color: white;
  }
  .step-dot.completed {
    border-color: #22c55e;
    background: #22c55e;
    color: white;
  }
  .step-line {
    width: 40px;
    height: 2px;
    background: var(--sl-color-gray-5, #333);
    margin: 0 4px;
  }
  .steps-labels {
    display: flex;
    justify-content: center;
    gap: 2rem;
  }
  .step-label {
    font-size: 0.75rem;
    color: var(--sl-color-gray-4, #555);
    transition: color 0.3s;
  }
  .step-label.active {
    color: var(--sl-color-white, #fff);
  }

  /* Form steps */
  .form-step {
    display: none;
  }
  .form-step.active {
    display: block;
    animation: stepFadeIn 0.3s ease;
  }
  @keyframes stepFadeIn {
    from { opacity: 0; transform: translateX(20px); }
    to { opacity: 1; transform: translateX(0); }
  }

  /* Form grid */
  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .form-group.full {
    grid-column: 1 / -1;
  }
  .form-group label {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--sl-color-gray-2, #ccc);
  }
  .required {
    color: #f92606;
  }
  .optional {
    font-size: 0.75rem;
    color: var(--sl-color-gray-4, #555);
    font-weight: 400;
  }
  .form-group input,
  .form-group select {
    background: var(--sl-color-gray-5, #2a2a2a);
    border: 1px solid var(--sl-color-hairline, rgba(255,255,255,0.1));
    border-radius: 10px;
    padding: 0.75rem 1rem;
    color: var(--sl-color-white, #fff);
    font-size: 0.95rem;
    transition: border-color 0.2s;
    outline: none;
    font-family: inherit;
  }
  .form-group input::placeholder {
    color: var(--sl-color-gray-4, #555);
  }
  .form-group input:focus,
  .form-group select:focus {
    border-color: #f92606;
  }
  .form-group input.invalid,
  .form-group select.invalid {
    border-color: #ef4444;
  }
  .field-error {
    font-size: 0.75rem;
    color: #ef4444;
    min-height: 1rem;
  }

  .form-group select option {
    background: var(--sl-color-gray-5, #2a2a2a);
    color: var(--sl-color-white, #fff);
  }

  /* Form actions */
  .form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .btn-next, .btn-submit {
    background: linear-gradient(135deg, #f92606, #ff6b3d);
    color: white;
    padding: 0.75rem 2rem;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.95rem;
    border: none;
    cursor: pointer;
    transition: all 0.3s;
    box-shadow: 0 4px 15px rgba(249, 38, 6, 0.3);
  }
  .btn-next:hover, .btn-submit:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(249, 38, 6, 0.5);
  }
  .btn-submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }
  .btn-prev {
    background: transparent;
    border: 1px solid var(--sl-color-gray-4, #555);
    color: var(--sl-color-gray-2, #ccc);
    padding: 0.75rem 1.5rem;
    border-radius: 10px;
    font-weight: 500;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  .btn-prev:hover {
    border-color: var(--sl-color-gray-2, #ccc);
    color: var(--sl-color-white, #fff);
  }

  /* Plans grid — :global() needed because plan cards are rendered via innerHTML */
  .planes-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  :global(.planes-loading) {
    text-align: center;
    color: var(--sl-color-gray-3, #888);
    padding: 2rem;
  }
  :global(.plan-card) {
    position: relative;
    border: 2px solid var(--sl-color-hairline, rgba(255,255,255,0.1));
    border-radius: 14px;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    transition: all 0.3s;
    background: var(--sl-color-gray-5, #2a2a2a);
  }
  :global(.plan-card:hover) {
    border-color: var(--sl-color-gray-3, #888);
  }
  :global(.plan-card.selected) {
    border-color: #f92606;
    background: rgba(249, 38, 6, 0.08);
    box-shadow: 0 0 20px rgba(249, 38, 6, 0.15);
  }
  :global(.plan-card.destacado) {
    border-color: #ff6b3d;
  }
  :global(.plan-card-badge) {
    position: absolute;
    top: -10px;
    right: 16px;
    background: linear-gradient(135deg, #f92606, #ff6b3d);
    color: white;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 2px 12px;
    border-radius: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  :global(.plan-name) {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--sl-color-white, #fff);
    margin-bottom: 0.25rem;
  }
  :global(.plan-price) {
    font-size: 0.95rem;
    color: #ff6b3d;
    font-weight: 600;
  }
  :global(.plan-desc) {
    font-size: 0.8rem;
    color: var(--sl-color-gray-3, #888);
    margin-top: 0.35rem;
  }
  :global(.plan-check) {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid var(--sl-color-gray-4, #555);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    color: transparent;
    transition: all 0.3s;
  }
  :global(.plan-card.selected .plan-check) {
    background: #f92606;
    border-color: #f92606;
    color: white;
  }
  :global(.btn-cambiar-plan) {
    width: 100%;
    background: none;
    border: 1px dashed rgba(255,255,255,0.18);
    border-radius: 10px;
    color: rgba(255,255,255,0.45);
    font-size: 0.82rem;
    font-weight: 500;
    padding: 0.65rem 1rem;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
    margin-top: 0.25rem;
  }
  :global(.btn-cambiar-plan:hover) {
    color: #ff6b3d;
    border-color: rgba(249,38,6,0.4);
  }

  /* Success */
  .success-message {
    text-align: center;
    padding: 2rem 0;
  }
  .success-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #22c55e;
    color: white;
    font-size: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
  }
  .btn-receipt-green {
    background: linear-gradient(135deg, #16a34a, #22c55e) !important;
    box-shadow: 0 4px 15px rgba(22, 163, 74, 0.3) !important;
  }
  .btn-receipt-green:hover {
    box-shadow: 0 6px 20px rgba(22, 163, 74, 0.5) !important;
  }
  .btn-receipt-green:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }
  .success-message h3 {
    font-size: 1.3rem;
    color: var(--sl-color-white, #fff);
    margin: 0 0 0.5rem;
  }
  .success-message p {
    color: var(--sl-color-gray-3, #888);
