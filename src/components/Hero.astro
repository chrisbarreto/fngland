---
import logoDark from "@/assets/logos/logo-dark.svg";
---

<div
  class="hero flex flex-col items-center justify-center mx-auto px-4 sm:px-6 lg:px-8"
  style="min-height: calc(100vh + 40px);"
>
  <div class="hero-content max-w-4xl text-center">
    <!-- Logo móvil -->
    <img src={logoDark.src} alt="Fórmula NG" class="hero-logo-mobile" />
    
    <!-- Título Principal - SEO + Gancho -->
    <h1 class="hero-title">
      <span class="hero-title-main">El primer club de cuidado automotriz</span>
      <span class="hero-title-sub">premium en Paraguay</span>
    </h1>
    
    <!-- Subtítulo - Refuerzo Psicológico -->
    <p class="hero-subtitle">
      Lavados ilimitados, detailing profesional y servicios de alto nivel para quienes quieren que su auto esté siempre impecable.
    </p>

    <!-- Botón de Acción -->
    <div class="hero-cta">
      <a href="#planes" class="btn btn-outline-primary">Quiero mi plan</a>
    </div>
  </div>
</div>

<script>
  const heroSection = document.querySelector(".hero");
  const header = document.querySelector(".header");
  const heroBG = document.querySelector(".hero-bg") as HTMLElement;

  const totalHeight =
    (heroSection?.clientHeight || 0) + (header?.clientHeight || 0);

  if (heroBG) {
    heroBG.style.height = `${totalHeight}px`;
  }

</script>

<style>
  .hero {
    position: relative;
    z-index: 1;
  }
  
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    animation: fadeInUp 0.8s ease-out;
    position: relative;
    z-index: 2;
  }
  
  .hero-title {
    font-size: 4.8rem;
    line-height: 4.7rem;
    letter-spacing: -3px;
    font-weight: 700;
    color: var(--sl-color-white);
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  
  .hero-title-main {
    color: var(--sl-color-white);
    display: block;
  }
  
  .hero-title-sub {
    color: var(--sl-color-text);
    opacity: 0.5;
    display: block;
    font-size: 0.9em;
  }
  
  /* Desktop: títulos en una sola línea */
  @media (min-width: 1041px) {
    .hero-title-main,
    .hero-title-sub {
      white-space: nowrap;
    }
  }
  
  .hero-subtitle {
    font-size: 1.125rem;
    line-height: 1.75rem;
    letter-spacing: -0.2px;
    font-weight: 400;
    color: var(--sl-color-gray-2);
    margin: 0;
    max-width: 700px;
  }

  .hero-cta {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 1rem;
  }
  
  .btn-outline-primary {
    background: transparent;
    color: white;
    padding: 1rem 2.5rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    display: inline-block;
    transition: all 0.3s ease;
    border: 2px solid rgba(249, 38, 6, 0.7);
  }

  .btn-outline-primary:hover {
    transform: translateY(-2px);
    background: rgba(249, 38, 6, 0.1);
    border-color: #f92606;
    box-shadow: 0 8px 30px rgba(249, 38, 6, 0.3);
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .hero-logo-mobile {
    display: none;
  }
  
  @media (max-width: 1040px) {
    .hero-title {
      font-size: 3.8rem;
      line-height: 3.7rem;
      letter-spacing: -2px;
    }
  }
  
  @media (max-width: 800px) {
    .hero {
      justify-content: flex-start;
      padding-top: 15vh;
    }
    
    .hero-content {
      flex: 1;
    }
    
    .hero-logo-mobile {
      display: block;
      width: 77%;
      max-width: 286px;
      margin: 0 auto 4rem;
      margin-top: -3rem;
    }
    
    .hero-subtitle {
      margin-top: 5rem;
    }

    .hero-cta {
      margin-top: auto;
      padding-bottom: 10vh;
    }
  }
  
  @media (max-width: 548px) {
    .hero-title {
      font-size: clamp(1.45rem, 5.2vw, 1.85rem);
      line-height: 1.1;
      letter-spacing: -0.2px;
      gap: 0.35rem;
      margin-top: -1rem;
    }

    .hero-title-main,
    .hero-title-sub {
      white-space: nowrap;
    }

    .hero-title-main {
      color: var(--sl-color-white);
    }

    .hero-title-sub {
      color: var(--sl-color-gray-3);
      opacity: 1;
      font-size: 1.12em;
    }
    
    .hero-subtitle {
      font-size: 1.14rem;
      line-height: 1.72rem;
    }

    .hero-content {
      gap: 0.75rem;
    }
    
    .hero-cta {
      margin-top: 0.5rem;
    }
  }

  @media (max-width: 380px) {
    .hero-title-sub {
      font-size: 1.08em;
    }

    .hero-subtitle {
      font-size: 1.04rem;
      line-height: 1.6rem;
    }

  }
  
</style>
