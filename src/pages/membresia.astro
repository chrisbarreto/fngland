---
export const prerender = true;

import BaseLayout from "@/layouts/BaseLayout.astro";
import Footer from "@/components/Footer.astro";
import RegistroModal from "@/components/RegistroModal.astro";
import RegistroFinanciadoModal from "@/components/RegistroFinanciadoModal.astro";
import { PUBLIC_PLANS, formatGuaranies } from "@/lib/public-plans";
import PricingCards from "@/components/PricingCards.astro";
import logoDark from "@/assets/logos/logo-dark.svg";
import reviews from "@/config/reviews.json" assert { type: "json" };
const [essential, plus, black, domicilio] = PUBLIC_PLANS;
---

<BaseLayout
  title="Planes de lavado automotriz | Fórmula NG"
  description="Conocé Essential, Plus, Black, Domicilio y Gold financiado con tratamiento nanocerámico. Planes de cuidado automotriz en Asunción y Gran Asunción."
  canonicalPath="/membresia"
>
  <div class="membresia-page">

    <!-- Header mínimo -->
    <header class="lp-header">
      <a href="/" aria-label="Ir al inicio">
        <img src={logoDark.src} alt="Fórmula NG" width="148" height="37" class="lp-logo" />
      </a>
    </header>

    <main>

      <!-- HERO -->
      <section class="hero">
        <div class="hero-inner">
          <p class="eyebrow">Membresía oficial · Asunción, Paraguay</p>
          <h1>Elegí el plan ideal<br />para tu auto.</h1>
          <p class="hero-sub">
            Lavados mensuales, protección profesional y la opción ilimitada de Black.
            Desde Gs. 200.000 por mes.
          </p>
          <a href="#planes" class="btn-hero">Ver los planes</a>
          <p class="legal-note">
            Al contratar aceptás los
            <a href="/terminos-y-condiciones" target="_blank">Términos y Condiciones</a>,
            <a href="/politica-de-privacidad" target="_blank">Política de Privacidad</a>
            y la <a href="/debito-automatico" target="_blank">autorización de débito automático</a>.
          </p>
        </div>
      </section>

      <!-- PLANES -->
      <section class="planes-section" id="planes">
        <h2>Nuestros planes</h2>
        <p class="planes-sub">Elegí entre lavados mensuales, lavados ilimitados, atención a domicilio o Gold financiado con nanocerámico.</p>
        <PricingCards />
        <p class="planes-footnote">En las membresías, el valor por día se calcula sobre 30 días y se abona mensualmente. Gold se paga en 15 cuotas de Gs. 400.000, sin prorrateo. El socio no paga un precio adicional por las bonificaciones; están sujetas a coordinación y disponibilidad operativa durante el ciclo vigente.</p>
      </section>

      <!-- COMPARATIVO -->
      <section class="comparativo-section" id="comparativo">
        <h2>Comparativo de membresías</h2>
        <p class="comparativo-sub">Compará las cuatro membresías mensuales. Gold, con nanocerámico, se ofrece como financiación de 15 cuotas y se detalla en su tarjeta.</p>
        <div class="table-wrap">
          <table class="comp-table">
            <thead>
              <tr>
                <th class="comp-feature-col">Servicio</th>
                <th><span class="th-plan-name">Essential</span><span class="th-plan-price">Gs. {formatGuaranies(essential.monthlyPrice)}/mes</span></th>
                <th class="th-popular"><span class="th-plan-name">Plus</span><span class="th-plan-price">Gs. {formatGuaranies(plus.monthlyPrice)}/mes</span></th>
                <th class="th-featured"><span class="th-plan-name">Black</span><span class="th-plan-price">Gs. {formatGuaranies(black.monthlyPrice)}/mes</span></th>
                <th><span class="th-plan-name">Domicilio</span><span class="th-plan-price">Gs. {formatGuaranies(domicilio.monthlyPrice)}/mes</span></th>
              </tr>
            </thead>
            <tbody>
              <tr class="comp-category-row"><td colspan="5">Lavados incluidos</td></tr>
              <tr><td>Lavados por mes</td><td>4</td><td class="td-popular">6</td><td class="td-featured">Ilimitados</td><td>4 a domicilio</td></tr>
              <tr><td>Prelavado</td><td>Incluido</td><td class="td-popular">—</td><td class="td-featured">—</td><td>—</td></tr>
              <tr><td>Lavado pH neutro, aspirado, desinfección y neumáticos</td><td>Incluido</td><td class="td-popular">Incluido</td><td class="td-featured">Incluido</td><td>Incluido</td></tr>
              <tr><td>Higienización de ventilación</td><td>—</td><td class="td-popular">Incluida</td><td class="td-featured">Incluida</td><td>—</td></tr>
              <tr class="comp-category-row"><td colspan="5">Valor agregado incluido</td></tr>
              <tr><td>Cera: duración de protección</td><td>Hasta 30 días</td><td class="td-popular">Hasta 60 días</td><td class="td-featured">Hasta 4 meses</td><td>—</td></tr>
              <tr><td>Hidratación de plásticos interiores</td><td>1 tratamiento</td><td class="td-popular">1</td><td class="td-featured">1</td><td>Incluida</td></tr>
              <tr><td>Lavado profesional de motor</td><td>—</td><td class="td-popular">1</td><td class="td-featured">1</td><td>—</td></tr>
              <tr><td>Pick up en Asunción y Gran Asunción</td><td>—</td><td class="td-popular">1</td><td class="td-featured">Hasta 2 usos compartidos*</td><td>—</td></tr>
              <tr><td>Lavado a domicilio</td><td>—</td><td class="td-popular">—</td><td class="td-featured">Hasta 2 usos compartidos*</td><td>4 servicios</td></tr>
            </tbody>
            <tfoot>
              <tr class="comp-cta-row">
                <td></td>
                <td><button type="button" class="btn-table-cta" data-plan-id={essential.id} disabled={!essential.id}>Elegir</button></td>
                <td class="td-popular"><button type="button" class="btn-table-cta" data-plan-id={plus.id} disabled={!plus.id}>Elegir</button></td>
                <td class="td-featured"><button type="button" class="btn-table-cta btn-table-cta-featured" data-plan-id={black.id} disabled={!black.id}>Elegir</button></td>
                <td><button type="button" class="btn-table-cta" data-plan-id={domicilio.id} disabled={!domicilio.id}>Elegir</button></td>
              </tr>
            </tfoot>
          </table>
        </div>
        <p class="planes-footnote">* En Black, pick up y lavado a domicilio comparten un máximo de dos usos totales por mes. Ambos son bonificaciones sin costo adicional para el socio, sujetas a coordinación y disponibilidad operativa.</p>
      </section>

      <!-- PRUEBA SOCIAL -->
      <section class="reviews-section">
        <h2>Lo que dicen nuestros miembros</h2>
        <div class="reviews-grid">
          {reviews.map((r) => (
            <div class="review-card">
              <div class="review-header">
                <div class="review-avatar">{r.name.charAt(0)}</div>
                <div>
                  <p class="review-name">{r.name}</p>
                  {r.badge && <p class="review-badge">{r.badge}</p>}
                </div>
                <div class="review-stars" aria-label={`${r.rating} estrellas`}>
                  {"★".repeat(r.rating)}
                </div>
              </div>
              <p class="review-text">{r.text}</p>
              <p class="review-date">{r.date}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- CONFIANZA -->
      <section class="trust-section">
        <div class="trust-items">
          <div class="trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>Pago seguro<br/>vía Bancard</span>
          </div>
          <div class="trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>Activación<br/>inmediata</span>
          </div>
          <div class="trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.1 12.62a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>Soporte vía<br/>WhatsApp</span>
          </div>
          <div class="trust-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Asunción,<br/>Paraguay</span>
          </div>
        </div>
      </section>

      <!-- CTA FINAL -->
      <section class="final-cta">
        <h2>Empezá hoy mismo</h2>
        <p>Registrate en minutos. Tu auto te lo va a agradecer.</p>
        <a href="#planes" class="btn-cta">Elegir mi plan</a>
        <p class="legal-note">
          Al continuar aceptás los <a href="/terminos-y-condiciones" target="_blank">Términos y Condiciones</a>.
        </p>
      </section>

    </main>

    <Footer />
  </div>

  <RegistroModal />
  <RegistroFinanciadoModal />
</BaseLayout>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  function openModal(planId?: string) {
    if (typeof (window as any).__openRegistroModal === "function") {
      (window as any).__openRegistroModal(planId ? { planId } : undefined);
    }
  }

  // ViewContent Meta Pixel event
  if (typeof (window as any).fbq === "function") {
    (window as any).fbq("track", "ViewContent", {
      content_name: "Planes Membresia",
      content_category: "Membresia",
    });
  }

  // Bind all "Contratar" buttons (plan cards + comparison table)
  document.querySelectorAll<HTMLButtonElement>("button[data-plan-id]").forEach((btn) => {
    btn.addEventListener("click", () => {
      openModal(btn.getAttribute("data-plan-id") || undefined);
    });
  });
</script>

<style>
  .membresia-page {
    min-height: 100vh;
    background: #060606;
    color: var(--sl-color-white, #fff);
    display: flex;
    flex-direction: column;
  }

  /* Header mínimo */
  .lp-header {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .lp-logo { height: 36px; width: auto; }

  main {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* ─── HERO ─── */
  .hero {
    background: radial-gradient(ellipse at top center, rgba(249,38,6,0.22) 0%, transparent 60%);
    padding: 4rem 1.5rem 3.5rem;
    text-align: center;
  }
  .hero-inner {
    max-width: 680px;
    margin: 0 auto;
    display: grid;
    gap: 1rem;
  }
  .eyebrow {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: #ff6b3d;
    font-weight: 700;
  }
  h1 {
    margin: 0;
    font-size: clamp(2rem, 6vw, 3.2rem);
    line-height: 1.1;
    font-weight: 900;
    color: #fff;
  }
  .hero-sub {
    margin: 0;
    font-size: clamp(1rem, 2.5vw, 1.15rem);
    color: rgba(255,255,255,0.7);
    line-height: 1.55;
    max-width: 520px;
    justify-self: center;
  }
  .btn-hero {
    margin-top: 0.5rem;
    justify-self: center;
    display: inline-block;
    background: linear-gradient(135deg, #f92606, #ff6b3d);
    color: #fff;
    border: none;
    border-radius: 12px;
    padding: 1rem 2.2rem;
    font-size: 1.05rem;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 8px 28px rgba(249,38,6,0.35);
    transition: transform 0.2s, box-shadow 0.2s;
    letter-spacing: 0.01em;
    text-decoration: none;
  }
  .btn-hero:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 36px rgba(249,38,6,0.5);
  }
  .legal-note {
    margin: 0.15rem 0 0;
    font-size: 0.73rem;
    color: rgba(255,255,255,0.35);
    line-height: 1.45;
  }
  .legal-note a {
    color: rgba(255,255,255,0.5);
    text-decoration: underline;
  }
  .legal-note a:hover { color: #ff6b3d; }

  /* ─── PLANES SECTION ─── */
  .planes-section {
    padding: 4rem 1.5rem 2rem;
    max-width: 1480px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }
  .planes-section h2,
  .comparativo-section h2,
  .reviews-section h2,
  .final-cta h2 {
    text-align: center;
    margin: 0 0 0.6rem;
    font-size: clamp(1.4rem, 3.5vw, 1.9rem);
    color: #fff;
  }
  .planes-sub, .comparativo-sub {
    text-align: center;
    color: rgba(255,255,255,0.5);
    font-size: 0.92rem;
    margin: 0 0 2.5rem;
  }
  .planes-footnote {
    margin: 1.75rem 0 0;
    text-align: center;
    font-size: 0.75rem;
    color: rgba(255,255,255,0.72);
    line-height: 1.6;
  }

  /* ─── COMPARATIVO ─── */
  .comparativo-section {
    padding: 3.5rem 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }
  .table-wrap {
    overflow-x: auto;
    border-radius: 16px;
    border: 1px solid rgba(255,255,255,0.08);
  }
  .comp-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.86rem;
    min-width: 640px;
  }
  .comp-table thead tr {
    background: rgba(255,255,255,0.05);
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  .comp-table th {
    padding: 1.1rem 0.9rem;
    text-align: center;
    vertical-align: bottom;
    font-weight: 600;
  }
  .comp-feature-col {
    text-align: left;
    min-width: 220px;
    color: rgba(255,255,255,0.6);
    font-size: 0.78rem;
    font-weight: 500;
  }
  .th-plan-name {
    display: block;
    font-size: 0.95rem;
    font-weight: 800;
    color: #fff;
  }
  .th-plan-price {
    display: block;
    font-size: 0.78rem;
    color: #ff6b3d;
    margin-top: 2px;
    font-weight: 600;
  }
  .th-plan-badge {
    display: inline-block;
    background: rgba(249,38,6,0.7);
    color: #fff;
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 2px 8px;
    border-radius: 99px;
    margin-bottom: 5px;
  }
  .th-plan-badge-featured {
    background: linear-gradient(135deg, #f92606, #ff6b3d);
  }
  .th-popular { background: rgba(249,38,6,0.05); }
  .th-featured { background: rgba(249,38,6,0.1); border-left: 1px solid rgba(249,38,6,0.3); border-right: 1px solid rgba(249,38,6,0.3); }
  .comp-table tbody tr {
    border-bottom: 1px solid rgba(255,255,255,0.05);
    transition: background 0.15s;
  }
  .comp-table tbody tr:hover { background: rgba(255,255,255,0.03); }
  .comp-table td {
    padding: 0.75rem 0.9rem;
    text-align: center;
    color: rgba(255,255,255,0.65);
  }
  .comp-table td:first-child {
    text-align: left;
    color: rgba(255,255,255,0.75);
    font-weight: 500;
  }
  .td-popular { background: rgba(249,38,6,0.03); }
  .td-featured { background: rgba(249,38,6,0.06); border-left: 1px solid rgba(249,38,6,0.2); border-right: 1px solid rgba(249,38,6,0.2); }
  .comp-category-row td {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: rgba(255,255,255,0.3);
    background: rgba(255,255,255,0.03);
    padding: 0.55rem 0.9rem;
    text-align: left;
    border-top: 1px solid rgba(255,255,255,0.07);
  }
  .comp-yes { color: #22c55e; font-weight: 700; font-size: 1rem; }
  .comp-no { color: rgba(255,255,255,0.2); font-size: 1rem; }
  .comp-freq {
    font-style: normal;
    color: rgba(255,255,255,0.35);
    font-size: 0.78em;
    font-weight: 400;
  }
  .comp-freq-annual {
    color: rgba(167,139,250,0.6);
  }
  .comp-cta-row td {
    padding: 1.1rem 0.9rem;
    border-top: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.02);
  }
  .btn-table-cta {
    background: rgba(249,38,6,0.15);
    border: 1px solid rgba(249,38,6,0.35);
    color: #ff6b3d;
    border-radius: 8px;
    padding: 0.55rem 1rem;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }
  .btn-table-cta:hover { background: rgba(249,38,6,0.25); }
  .btn-table-cta-featured {
    background: linear-gradient(135deg, #f92606, #ff6b3d);
    border-color: transparent;
    color: #fff;
  }
  .btn-table-cta-featured:hover {
    background: linear-gradient(135deg, #d42005, #f55c2e);
    transform: translateY(-1px);
  }

  /* ─── REVIEWS ─── */
  .reviews-section {
    padding: 3.5rem 1.5rem;
    max-width: 1080px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }
  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.1rem;
  }
  .review-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    padding: 1.35rem;
    display: grid;
    gap: 0.7rem;
  }
  .review-header {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .review-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: linear-gradient(135deg, #f92606, #ff6b3d);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.95rem;
    color: #fff;
    flex-shrink: 0;
  }
  .review-name {
    margin: 0;
    font-weight: 700;
    font-size: 0.88rem;
    color: #fff;
  }
  .review-badge {
    margin: 0;
    font-size: 0.7rem;
    color: rgba(255,255,255,0.4);
  }
  .review-stars {
    margin-left: auto;
    color: #facc15;
    font-size: 0.85rem;
    flex-shrink: 0;
  }
  .review-text {
    margin: 0;
    font-size: 0.84rem;
    color: rgba(255,255,255,0.65);
    line-height: 1.55;
  }
  .review-date {
    margin: 0;
    font-size: 0.72rem;
    color: rgba(255,255,255,0.3);
  }

  /* ─── TRUST ─── */
  .trust-section {
    padding: 2.5rem 1.5rem;
    border-top: 1px solid rgba(255,255,255,0.06);
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .trust-items {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    gap: 2.5rem;
    flex-wrap: wrap;
  }
  .trust-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    color: rgba(255,255,255,0.55);
    font-size: 0.8rem;
    text-align: center;
    line-height: 1.4;
  }
  .trust-item svg { color: #ff6b3d; }

  /* ─── FINAL CTA ─── */
  .final-cta {
    padding: 4rem 1.5rem;
    text-align: center;
    display: grid;
    gap: 1rem;
    background: radial-gradient(ellipse at bottom, rgba(249,38,6,0.12), transparent 60%);
  }
  .final-cta p {
    margin: 0;
    color: rgba(255,255,255,0.6);
    font-size: 1rem;
  }
  .btn-cta {
    justify-self: center;
    display: inline-block;
    background: linear-gradient(135deg, #f92606, #ff6b3d);
    color: #fff;
    border: none;
    border-radius: 12px;
    padding: 1rem 2.5rem;
    font-size: 1.05rem;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 8px 28px rgba(249,38,6,0.35);
    transition: transform 0.2s, box-shadow 0.2s;
    text-decoration: none;
  }
  .btn-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 36px rgba(249,38,6,0.5);
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 1000px) {
  }
  @media (max-width: 860px) {
    .reviews-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .reviews-grid { grid-template-columns: 1fr; }
    .hero { padding: 3rem 1.25rem 2.5rem; }
    .planes-section, .comparativo-section, .reviews-section { padding: 2.5rem 1.25rem; }
    .final-cta { padding: 2.5rem 1.25rem; }
    .trust-items { gap: 1.5rem; }
  }

  /* ─── COMPARATIVO: solo desktop ─── */
  @media (max-width: 700px) {
    .comparativo-section { display: none; }
  }
</style>
