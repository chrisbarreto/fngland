    top: 17px;
    left: calc(50% + 20px);
    right: calc(-50% + 20px);
    height: 2px;
    background: var(--stepper-inactive);
    transition: background 0.4s;
    border-radius: 2px;
  }
  .step-item.done:not(:last-child)::after { background: var(--stepper-done); }
  .step-item.active:not(:last-child)::after {
    background: linear-gradient(90deg, var(--stepper-active), var(--stepper-inactive));
