---
// UtmCapture — captura UTMs y fbclid de la URL y los guarda en sessionStorage.
// No hace nada si no hay parámetros. No sobreescribe una captura anterior (primera fuente gana).
// Los datos quedan disponibles en sessionStorage como "fng_utm" (JSON).
---

<script>
  (function () {
    const STORAGE_KEY = "fng_utm";

    // No sobreescribir si ya existe una captura anterior
    if (sessionStorage.getItem(STORAGE_KEY)) return;

    const params = new URLSearchParams(window.location.search);
    const UTM_KEYS = ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term", "fbclid"] as const;

    const hasAny = UTM_KEYS.some((k) => params.get(k));
    if (!hasAny) return;

    const data: Record<string, string> = {};
    UTM_KEYS.forEach((k) => {
      const v = params.get(k);
      if (v) data[k] = v;
    });

    data["captured_at"] = new Date().toISOString();
    data["landing_url"] = window.location.href;

    sessionStorage.setItem(STORAGE_KEY, JSON.stringify(data));
  })();
</script>
