  .agenda-success-reset {
    color: #d3fae9;
    background: rgba(22, 56, 40, 0.85);
    border: 1px solid rgba(107, 236, 175, 0.22);
  }

  .agenda-success-link:hover,
  .agenda-success-reset:hover {
    transform: translateY(-1px);
  }

  .agenda-success-link:hover {
    box-shadow: 0 12px 26px rgba(16, 185, 129, 0.38);
  }

  .agenda-success-reset:hover {
    background: rgba(26, 69, 49, 0.95);
  }

  @keyframes successBounceIn {
    0% {
      transform: scale(0.5);
      opacity: 0;
    }
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }

  @keyframes successDrawCheck {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes successFadeInUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .info-card h3 {
    margin-top: 0;
  }

  .info-card ul {
    padding-left: 1rem;
    color: var(--agenda-muted);
    display: grid;
    gap: 0.6rem;
  }

  @media (max-width: 960px) {
    .form-section {
      grid-template-columns: 1fr;
    }

    .cedula-input-group {
      grid-template-columns: 1fr;
    }

    .cedula-validate-btn {
      width: 100%;
    }
  }

  @media (max-width: 640px) {
    .content {
      padding: 2.5rem 1.25rem 3rem;
    }
    .form-card,
    .info-card {
      padding: 1.5rem;
    }

    .agenda-success-modal {
      padding: 0;
    }

    .agenda-success-panel {
      width: 100vw;
      min-height: 100vh;
      border-radius: 0;
      border: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 2rem 1.2rem;
    }

    .agenda-success-icon {
      width: 190px;
      height: 190px;
    }

    .agenda-success-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .agenda-success-link,
    .agenda-success-reset {
      width: 100%;
      text-align: center;
    }
  }
</style>

<script is:inline>
  // ─── State ─────────────────────────────────────────────────────────
  let selectedSlot = null;
  const form = document.getElementById("agenda-form");
  const statusEl = document.getElementById("agenda-status");
  const successEl = document.getElementById("agenda-success");
  const successDetailsEl = document.getElementById("success-details");
  const successTrasladoEl = document.getElementById("success-traslado");
  const successResetBtn = document.getElementById("agenda-success-reset");
  const submitBtn = document.getElementById("agenda-submit");
  const slotsContainer = document.getElementById("slots-container");
  const slotsGrid = document.getElementById("slots-grid");
  const slotsHint = document.getElementById("slots-hint");
  const horaInput = document.getElementById("horaInicio");
  const codigoInput = document.getElementById("codigoMembresia");
  const cedulaInput = document.getElementById("cedulaTitular");
  const validarCedulaBtn = document.getElementById("validar-cedula-btn");
  const validarCedulaText = document.getElementById("validar-cedula-text");
  const membresiasContainer = document.getElementById("membresias-container");
  const membresiasList = document.getElementById("membresias-list");
  const membresiasHint = document.getElementById("membresias-hint");
  const serviciosHint = document.getElementById("servicios-hint");
  const serviciosExtraAlert = document.getElementById("servicios-extra-alert");
  let codigoServiciosCargado = "";
  let cedulaMembresiasCargada = "";
  let membresiasFetchToken = 0;

  function formatGs(value) {
    const num = Number(value);
    if (!Number.isFinite(num)) return "0 Gs.";
    return `${new Intl.NumberFormat("es-PY").format(Math.round(num))} Gs.`;
  }

  function escapeHtml(value) {
    return String(value)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/\"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  function normalizeCedula(value) {
    return String(value || "").replace(/\D/g, "");
  }

  function normalizeCodigoMembresia(value) {
    return String(value || "").trim().toUpperCase();
  }

  function maskPlate(chapa) {
    const value = String(chapa || "")
      .trim()
      .toUpperCase()
      .replace(/[^A-Z0-9]/g, "");
    if (!value) return "";
    if (value.length <= 3) return "***";
    return `***${value.slice(3)}`;
  }

  function setCedulaLoading(loading) {
    if (!validarCedulaBtn) return;

    validarCedulaBtn.disabled = loading;
    validarCedulaBtn.classList.toggle("loading", loading);

    if (validarCedulaText) {
      validarCedulaText.textContent = loading
        ? "Validando..."
        : "Confirmar";
    }
  }

  function extractMembresias(payload) {
    if (Array.isArray(payload)) return payload;
    if (Array.isArray(payload?.membresias)) return payload.membresias;
    if (Array.isArray(payload?.data)) return payload.data;
    if (Array.isArray(payload?.items)) return payload.items;
    return [];
  }

  function renderMembresiaMeta(item, codigo) {
    const marca = item?.vehiculo?.marca || item?.marca || "";
    const modelo = item?.vehiculo?.modelo || item?.modelo || "";
    const chapa = item?.vehiculo?.chapa || item?.chapa || "";
    return {
      codigoVisible: normalizeCodigoMembresia(codigo),
      vehiculoVisible: [marca, modelo].filter(Boolean).join(" ").trim(),
      chapaVisible: maskPlate(chapa),
    };
  }

  function showServiciosExtraAlert() {
    if (!serviciosExtraAlert) return;

    const selectedWithExtra = Array.from(
      document.querySelectorAll('input[name="idServicios"]:checked'),
    ).filter((input) => input.dataset.requierePagoExtra === "1");

    if (!selectedWithExtra.length) {
      serviciosExtraAlert.style.display = "none";
      serviciosExtraAlert.textContent = "";
      return;
    }

    const mensajes = selectedWithExtra.map((input) => {
      const nombre = input.dataset.servicioNombre || "Servicio";
      const precio = input.dataset.precioExtraTexto || "0 Gs.";
      return `${nombre}: se cobrará extra ${precio} por uso.`;
    });

    serviciosExtraAlert.style.display = "block";
    serviciosExtraAlert.textContent = mensajes.join(" ");
  }

  const ANTICIPACION_POR_TIPO_SERVICIO = {
    "17": { horas: 16, nombre: "lavado de motor" },
    "20": { horas: 24, nombre: "traslado" },
  };

  function getMaxAnticipacionRequerida() {
    const checked = Array.from(
      document.querySelectorAll('input[name="idServicios"]:checked'),
    );
    let max = null;
    for (const cb of checked) {
      const regla = ANTICIPACION_POR_TIPO_SERVICIO[cb.dataset.idTipoServicio];
      if (regla && (!max || regla.horas > max.horas)) {
        max = regla;
      }
    }
    return max;
  }

  function setStatus(message, type = "error") {
    if (!statusEl) return;
    statusEl.textContent = message || "";
    statusEl.classList.remove("error", "success");
    if (message) {
      statusEl.classList.add(type);
    }
  }

  function restarUnaHora(hora) {
    const horaTexto = String(hora || "").trim();
    const partes = horaTexto.split(":");
    if (partes.length < 2) return "";

    const horas = Number(partes[0]);
    const minutos = Number(partes[1]);

    if (!Number.isInteger(horas) || !Number.isInteger(minutos)) {
      return "";
    }

    const fechaBase = new Date();
    fechaBase.setHours(horas, minutos, 0, 0);
    fechaBase.setHours(fechaBase.getHours() - 1);

    const horasSalida = String(fechaBase.getHours()).padStart(2, "0");
    const minutosSalida = String(fechaBase.getMinutes()).padStart(2, "0");
    return `${horasSalida}:${minutosSalida}`;
  }

  function formatHoraSimple(hora) {
    const horaTexto = String(hora || "").trim();
    const partes = horaTexto.split(":");
    if (partes.length < 2) return horaTexto;

    const horas = Number(partes[0]);
    const minutos = Number(partes[1]);
    if (!Number.isInteger(horas) || !Number.isInteger(minutos)) return horaTexto;

    return `${horas}:${String(minutos).padStart(2, "0")}`;
  }

  function normalizeSearchText(value) {
    return String(value || "")
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .trim();
  }

  function formatFechaLargaEs(fecha) {
    const fechaTexto = String(fecha || "").trim();
    if (!fechaTexto) return "";

    const isoMatch = fechaTexto.match(/^(\d{4})-(\d{2})-(\d{2})$/);
    let dateObj;

    if (isoMatch) {
      const year = Number(isoMatch[1]);
      const month = Number(isoMatch[2]) - 1;
      const day = Number(isoMatch[3]);
      dateObj = new Date(year, month, day);
    } else {
      dateObj = new Date(fechaTexto);
    }

    if (Number.isNaN(dateObj.getTime())) {
      return fechaTexto;
    }

    return new Intl.DateTimeFormat("es-PY", {
      day: "numeric",
      month: "long",
      year: "numeric",
    }).format(dateObj);
  }

  // ─── Load sedes & servicios on page load ──────────────────────────
  async function loadSedes() {
    const sel = document.getElementById("idSede");
    try {
      const res = await fetch("/proxy/agenda/sedes");
      const sedes = await res.json();
      sel.innerHTML = '<option value="">Seleccioná una sede</option>';
      if (Array.isArray(sedes)) {
        sedes.forEach((s) => {
          const opt = document.createElement("option");
          opt.value = s.idSede;
          opt.textContent = s.nombre + (s.direccion ? ` — ${s.direccion}` : "");
          sel.appendChild(opt);
        });
      }
    } catch {
      sel.innerHTML = '<option value="">Error al cargar sedes</option>';
    }
  }

  async function loadServicios(codigoMembresia) {
    const container = document.getElementById("servicios-list");
    const codigo = normalizeCodigoMembresia(codigoMembresia);

    if (!container) return;

    if (!codigo) {
      container.innerHTML = '<span class="field-hint">Seleccioná una membresía para ver tus servicios incluidos.</span>';
      if (serviciosHint) {
        serviciosHint.textContent = "Solo se muestran servicios limitados del plan de tu membresía.";
      }
      if (serviciosExtraAlert) {
        serviciosExtraAlert.style.display = "none";
      }
      codigoServiciosCargado = "";
      return;
    }

    try {
      container.innerHTML = '<span class="field-hint">Cargando servicios de tu plan...</span>';
      if (serviciosHint) {
        serviciosHint.textContent = "";
      }

      const res = await fetch(
        `/proxy/agenda/servicios?codigoMembresia=${encodeURIComponent(codigo)}`,
      );
      const body = await res.json().catch(() => ({}));
      const servicios = Array.isArray(body) ? body : [];

      if (!res.ok) {
        container.innerHTML =
          `<span class="field-hint">${escapeHtml(body.error || "No se pudieron cargar los servicios.")}</span>`;
        if (serviciosHint) {
          serviciosHint.textContent = "Verificá la membresía seleccionada.";
        }
        if (serviciosExtraAlert) {
          serviciosExtraAlert.style.display = "none";
        }
        return;
      }

      container.innerHTML = "";
      if (Array.isArray(servicios) && servicios.length > 0) {
        servicios.forEach((s) => {
          const label = document.createElement("label");
          label.className = "servicio-check";
          const input = document.createElement("input");
          input.type = "checkbox";
          input.name = "idServicios";
          input.value = s.idServicio;
          input.dataset.requierePagoExtra = s.requierePagoExtra ? "1" : "0";
          input.dataset.idTipoServicio = String(s.idTipoServicio ?? "");
          input.dataset.servicioNombre = s.nombre || "Servicio";
          input.dataset.precioExtraTexto = s.precioAplicadoTexto || formatGs(s.precioAplicado);
          input.addEventListener("change", showServiciosExtraAlert);
          input.addEventListener("change", () => {
            const fecha = document.getElementById("fechaCita")?.value;
            if (fecha) loadSlots(fecha);
          });

          const checkMark = document.createElement("span");
          checkMark.className = "check-mark";

          const textWrap = document.createElement("span");
          textWrap.className = "check-label";
          textWrap.innerHTML = `${escapeHtml(s.nombre || "Servicio")}`;

          if (typeof s.cantidadIncluida === "number") {
            const meta = document.createElement("div");
            meta.className = "check-meta";
            meta.textContent = `Incluido: ${s.cantidadIncluida} | Usados: ${s.usados ?? 0} | Reservados: ${s.reservados ?? 0} | Te quedan: ${s.restantes ?? 0}`;
            textWrap.appendChild(meta);

            if (s.requierePagoExtra) {
              const extra = document.createElement("span");
              extra.className = "check-extra";
              extra.textContent = `Costo extra: ${s.precioAplicadoTexto || formatGs(s.precioAplicado)} por uso`;
              textWrap.appendChild(extra);
            }
          }

          label.appendChild(input);
          label.appendChild(checkMark);
          label.appendChild(textWrap);
          container.appendChild(label);
        });

        if (serviciosHint) {
          serviciosHint.textContent =
            "Se muestran solo los servicios limitados de tu plan. Si elegís uno sin cupo, se cobrará como extra.";
        }
        codigoServiciosCargado = codigo;
      } else {
        container.innerHTML = '<span class="field-hint">Tu plan no tiene servicios limitados disponibles.</span>';
        if (serviciosHint) {
          serviciosHint.textContent = "Contactanos para revisar tu plan de membresía.";
        }
      }
    } catch {
      container.innerHTML = '<span class="field-hint">Error al cargar servicios.</span>';
      if (serviciosHint) {
        serviciosHint.textContent = "Intentá nuevamente en unos segundos.";
      }
    }

    if (serviciosExtraAlert) {
      serviciosExtraAlert.style.display = "none";
    }
  }

  function resetMembresiaSeleccion() {
    if (codigoInput) {
      codigoInput.value = "";
    }
    if (membresiasList) {
      membresiasList.innerHTML = "";
    }
    if (membresiasHint) {
      membresiasHint.textContent = "";
    }
    if (membresiasContainer) {
      membresiasContainer.style.display = "none";
    }
    loadServicios("");
  }

  async function loadMembresiasByCedula(cedulaValue) {
    const cedula = normalizeCedula(cedulaValue);

    if (!cedulaInput || !membresiasList || !membresiasContainer) return;

    if (cedulaInput.value !== cedula) {
      cedulaInput.value = cedula;
    }

    if (!cedula) {
      cedulaMembresiasCargada = "";
      resetMembresiaSeleccion();
      return;
    }

    const fetchToken = ++membresiasFetchToken;
    setCedulaLoading(true);
    cedulaMembresiasCargada = "";
    if (codigoInput) {
      codigoInput.value = "";
    }
    codigoServiciosCargado = "";
    loadServicios("");

    membresiasContainer.style.display = "block";
    membresiasList.innerHTML = '<span class="field-hint">Buscando membresías asociadas...</span>';
    if (membresiasHint) {
      membresiasHint.textContent = "";
    }

    try {
      const res = await fetch(`/proxy/agenda/membresias?cedula=${encodeURIComponent(cedula)}`);
      const body = await res.json().catch(() => ({}));

      if (fetchToken !== membresiasFetchToken) {
        return;
      }

      if (!res.ok) {
        membresiasList.innerHTML = `<span class="field-hint">${escapeHtml(body.error || "No se pudieron cargar tus membresías.")}</span>`;
        if (membresiasHint) {
          membresiasHint.textContent = "Verificá tu número de cédula.";
        }
        return;
      }

      const membresias = extractMembresias(body)
        .map((item) => {
          const codigo = normalizeCodigoMembresia(
            item?.codigoMembresia ||
            item?.codigo ||
            item?.numeroMembresia ||
            item?.numero ||
            item?.nroMembresia,
          );
          const meta = renderMembresiaMeta(item, codigo);

          return {
            codigo,
            ...meta,
          };
        })
        .filter((item) => item.codigo);

      if (!membresias.length) {
        membresiasList.innerHTML = '<span class="field-hint">No encontramos membresías activas para esta cédula.</span>';
        if (membresiasHint) {
          membresiasHint.textContent = "Si creés que es un error, escribinos por WhatsApp.";
        }
        return;
      }

      membresiasList.innerHTML = "";
      membresias.forEach((membresia, index) => {
        const label = document.createElement("label");
        label.className = "membresia-option";

        const input = document.createElement("input");
        input.type = "radio";
        input.name = "membresiaSeleccionada";
        input.value = membresia.codigo;
        input.addEventListener("change", () => {
          if (codigoInput) {
            codigoInput.value = membresia.codigo;
          }
          loadServicios(membresia.codigo);
        });

        const mark = document.createElement("span");
        mark.className = "membresia-mark";

        const content = document.createElement("span");
        content.className = "membresia-content";

        const code = document.createElement("span");
        code.className = "membresia-code";
        const partes = [
          `Membresía <strong>${escapeHtml(membresia.codigoVisible || membresia.codigo)}</strong>`,
        ];

        if (membresia.vehiculoVisible) {
          partes.push(`Vehículo: ${escapeHtml(membresia.vehiculoVisible)}`);
        }

        if (membresia.chapaVisible) {
          partes.push(`Chapa: ${escapeHtml(membresia.chapaVisible)}`);
        }

        code.innerHTML = partes.join(" | ");
        content.appendChild(code);

        label.appendChild(input);
        label.appendChild(mark);
        label.appendChild(content);
        membresiasList.appendChild(label);

        if (index === 0) {
          input.checked = true;
          input.dispatchEvent(new Event("change"));
        }
      });

      cedulaMembresiasCargada = cedula;
      if (membresiasHint) {
        membresiasHint.textContent = "Seleccioná la membresía que vas a usar para este turno. Solo podés agendar una a la vez.";
      }
    } catch {
      if (fetchToken !== membresiasFetchToken) {
        return;
      }
      membresiasList.innerHTML = '<span class="field-hint">Error al buscar membresías. Intentá nuevamente.</span>';
      if (membresiasHint) {
        membresiasHint.textContent = "Revisá tu conexión e intentá de nuevo.";
      }
    } finally {
      setCedulaLoading(false);
    }
  }

  // ─── Set date min/max ──────────────────────────────────────────────
  function setupDateInput() {
    const dateInput = document.getElementById("fechaCita");
    if (!dateInput) return;

    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const yyyy = today.getFullYear();
    const mm = String(today.getMonth() + 1).padStart(2, "0");
    const dd = String(today.getDate()).padStart(2, "0");
    const minDate = `${yyyy}-${mm}-${dd}`;
    dateInput.min = minDate;

    // Max: 30 days from now
    const max = new Date(today);
    max.setDate(max.getDate() + 30);
    const maxYyyy = max.getFullYear();
    const maxMm = String(max.getMonth() + 1).padStart(2, "0");
    const maxDd = String(max.getDate()).padStart(2, "0");
    const maxDate = `${maxYyyy}-${maxMm}-${maxDd}`;
    dateInput.max = maxDate;

    if (typeof dateInput.showPicker === "function") {
      dateInput.addEventListener("focus", () => {
        try {
          dateInput.showPicker();
        } catch {
          // no-op
        }
      });
    }
  }

  // ─── Load slots when date changes ─────────────────────────────────
  const SLOTS_MAX_RETRIES = 2;
  const SLOTS_RETRY_DELAYS = [1500, 3000]; // ms before each retry

  async function fetchSlotsWithRetry(fecha, idSede) {
    let lastError = null;

    for (let attempt = 0; attempt <= SLOTS_MAX_RETRIES; attempt++) {
      if (attempt > 0) {
        slotsHint.textContent = `Reintentando... (${attempt}/${SLOTS_MAX_RETRIES})`;
        await new Promise((r) => setTimeout(r, SLOTS_RETRY_DELAYS[attempt - 1]));
      }

      try {
        const res = await fetch(`/proxy/agenda/slots?fecha=${fecha}&idSede=${encodeURIComponent(idSede)}`);

        // Non-JSON response (e.g. Cloudflare HTML page, 502, etc.)
        const ct = res.headers.get("content-type") || "";
        if (!ct.includes("application/json")) {
          lastError = {
            retryable: true,
            message: `El servidor respondió con un formato inesperado (HTTP ${res.status}). Intentá de nuevo en unos segundos.`,
          };
          continue;
        }

        const body = await res.json();

        // Server-returned error in JSON
        if (body.error) {
          // Server errors (5xx) are retryable, client errors (4xx) are not
          const isServerError = res.status >= 500;
          lastError = { retryable: isServerError, message: body.error };
          if (isServerError) continue;
          return { error: body.error };
        }

        // Success
        return { slots: body.slots || [] };
      } catch (err) {
        // Network-level failures: offline, DNS, CORS, timeout
        const isOffline = !navigator.onLine;
        lastError = {
          retryable: !isOffline, // no point retrying if offline
          message: isOffline
            ? "Sin conexión a internet. Verificá tu conexión e intentá de nuevo."
            : "No se pudo conectar con el servidor. Intentá de nuevo en unos segundos.",
        };
        if (!isOffline) continue;
        break;
      }
    }

    return { error: lastError?.message || "Error al cargar horarios." };
  }

  async function loadSlots(fecha) {
    selectedSlot = null;
    horaInput.value = "";
    submitBtn.disabled = true;
    slotsGrid.innerHTML = "";
    slotsHint.textContent = "";

    const idSede = document.getElementById("idSede")?.value;
    if (!idSede) {
      slotsContainer.style.display = "block";
      slotsHint.textContent = "Seleccioná una sede antes de elegir horario.";
      return;
    }

    // Check if Sunday
    const d = new Date(fecha + "T12:00:00");
    if (d.getDay() === 0) {
      slotsContainer.style.display = "block";
      slotsHint.textContent = "No se atiende los domingos. Elegí otro día.";
      return;
    }

    slotsContainer.style.display = "block";
    slotsHint.textContent = "Cargando horarios...";

    const result = await fetchSlotsWithRetry(fecha, idSede);

    if (result.error) {
      slotsHint.textContent = result.error;
      return;
    }

    const slots = result.slots;
    let availableSlots = slots.filter((slot) => Number(slot.disponibles) > 0);

    // Filter out slots that don't meet anticipation requirements (lavado de motor 16h, traslado 24h)
    let slotsFilteredByAnticipacion = 0;
    let anticipacionRegla = null;
    const regla = getMaxAnticipacionRequerida();
    if (regla) {
      anticipacionRegla = regla;
      const now = new Date();
      const cutoff = new Date(now.getTime() + regla.horas * 60 * 60 * 1000);
      const beforeCount = availableSlots.length;
      availableSlots = availableSlots.filter((slot) => {
        const slotDate = new Date(`${fecha}T${slot.hora}:00`);
        return slotDate.getTime() >= cutoff.getTime();
      });
      slotsFilteredByAnticipacion = beforeCount - availableSlots.length;
    }

    if (availableSlots.length === 0) {
      slotsHint.textContent = slotsFilteredByAnticipacion > 0
        ? `No hay horarios disponibles. El servicio de ${anticipacionRegla.nombre} requiere al menos ${anticipacionRegla.horas} horas de anticipación.`
        : "No hay horarios disponibles para esta fecha.";
      return;
    }

    slotsHint.textContent = slotsFilteredByAnticipacion > 0
      ? `Seleccioná un horario (algunos no están disponibles por la anticipación requerida para ${anticipacionRegla.nombre}):`
      : "Seleccioná un horario:";

    availableSlots.forEach((slot) => {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "slot-btn";
      btn.innerHTML = `${slot.hora}<span class="slot-cupos">${slot.disponibles} cupo${slot.disponibles !== 1 ? "s" : ""}</span>`;
      btn.dataset.hora = slot.hora;

      btn.addEventListener("click", () => {
        // Deselect previous
        slotsGrid.querySelectorAll(".slot-btn").forEach((b) => b.classList.remove("selected"));
        btn.classList.add("selected");
        selectedSlot = slot.hora;
        horaInput.value = slot.hora;
        submitBtn.disabled = false;
      });

      slotsGrid.appendChild(btn);
    });
  }

  // ─── Date change listener ─────────────────────────────────────────
  const fechaInput = document.getElementById("fechaCita");
  if (fechaInput) {
    fechaInput.addEventListener("change", (e) => {
      const fecha = e.target.value;
      if (fecha) loadSlots(fecha);
    });
  }

  // ─── Sede change listener (reload slots) ──────────────────────────
  const sedeSelect = document.getElementById("idSede");
  if (sedeSelect) {
    sedeSelect.addEventListener("change", () => {
      const fecha = document.getElementById("fechaCita")?.value;
      if (fecha) loadSlots(fecha);
    });
  }

  // ─── Membership lookup listeners ────────────────────────────────────
  cedulaInput?.addEventListener("input", () => {
    const cedula = normalizeCedula(cedulaInput.value);
    if (cedulaInput.value !== cedula) {
      cedulaInput.value = cedula;
    }

    if (!cedula) {
      cedulaMembresiasCargada = "";
      resetMembresiaSeleccion();
      return;
    }

    if (cedula !== cedulaMembresiasCargada) {
      if (codigoInput) {
        codigoInput.value = "";
      }
      codigoServiciosCargado = "";
      loadServicios("");
      if (membresiasHint) {
        membresiasHint.textContent = "Presioná \"Validar cédula\" para cargar membresías asociadas.";
      }
    }
  });

  validarCedulaBtn?.addEventListener("click", () => {
    const cedula = normalizeCedula(cedulaInput.value);
    if (!cedula) {
      setStatus("Ingresá tu número de cédula.");
      return;
    }

    setStatus("");
    loadMembresiasByCedula(cedula);
  });

  cedulaInput?.addEventListener("keydown", (event) => {
    if (event.key !== "Enter") return;
    event.preventDefault();
    validarCedulaBtn?.click();
  });

  // ─── Turnstile helper ─────────────────────────────────────────────
  function getTurnstileToken() {
    const tokenField = form?.querySelector("[name='cf-turnstile-response']");
    return tokenField && "value" in tokenField ? tokenField.value : "";
  }

  function resetTurnstile() {
    try {
      if (window.turnstile && typeof window.turnstile.reset === "function") {
        window.turnstile.reset();
      }
    } catch {
      // no-op
    }

    const tokenField = form?.querySelector("[name='cf-turnstile-response']");
    if (tokenField && "value" in tokenField) {
      tokenField.value = "";
    }
  }

  // ─── Submit ────────────────────────────────────────────────────────
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form || !submitBtn || !statusEl || !successEl) return;

    const cedulaIngresada = normalizeCedula(form.querySelector("#cedulaTitular").value);
    let codigoMembresia = normalizeCodigoMembresia(
      form.querySelector("#codigoMembresia").value,
    );
    const idSede = form.querySelector("#idSede").value;
    const idServicios = Array.from(form.querySelectorAll('input[name="idServicios"]:checked')).map((cb) => cb.value);
    const fechaCita = form.querySelector("#fechaCita").value;
    const horaInicio = horaInput.value;
    const observaciones = form.querySelector("#observaciones").value.trim();
    const turnstileToken = getTurnstileToken();

    // Validation
    if (!cedulaIngresada) {
      setStatus("Ingresá tu número de cédula.");
      return;
    }

    if (cedulaIngresada !== cedulaMembresiasCargada) {
      await loadMembresiasByCedula(cedulaIngresada);
      codigoMembresia = normalizeCodigoMembresia(form.querySelector("#codigoMembresia").value);
    }

    if (!codigoMembresia) {
      setStatus("Seleccioná una membresía asociada a tu cédula.");
      return;
    }

    if (!idSede) {
      setStatus("Seleccioná una sede.");
      return;
    }
    if (!fechaCita) {
      setStatus("Seleccioná una fecha.");
      return;
    }
    if (!horaInicio) {
      setStatus("Seleccioná un horario disponible.");
      return;
    }
    if (!turnstileToken) {
      setStatus("Verificá el captcha para continuar.");
      return;
    }

    submitBtn.disabled = true;
    setStatus("Agendando turno...", "success");

    try {
      const res = await fetch("/proxy/agenda/citas", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          codigoMembresia,
          idSede,
          idServicios,
          fechaCita,
          horaInicio,
          observaciones: observaciones || undefined,
          turnstileToken,
        }),
      });

      const body = await res.json().catch(() => ({}));

      if (!res.ok) {
        const backendError = String(body.error || "");

        if (backendError.includes("Solo se permite una cita por dia")) {
          setStatus(
            "Esta membresía ya tiene una cita para ese día. Solo se permite 1 cita diaria por membresía.",
          );
        } else if (backendError.includes("horas de anticipacion")) {
          setStatus(
            backendError.replace("minimo", "mínimo").replace("anticipacion", "anticipación"),
          );
        } else if (backendError.toLowerCase().includes("captcha")) {
          setStatus("No se pudo validar el captcha. Marcá nuevamente la verificación.");
          resetTurnstile();
        } else {
          setStatus(backendError || "No pudimos agendar tu turno.");
          resetTurnstile();
        }
        submitBtn.disabled = false;
        return;
      }

      // Success
      form.style.display = "none";
      successEl.hidden = false;
      document.body.classList.add("agenda-success-open");
      setStatus("");

      const d = body.data || body;
      const extraServicios = Array.isArray(d.serviciosConCostoExtra)
        ? d.serviciosConCostoExtra
            .map((extra) => {
              const nombre = escapeHtml(extra.nombre || "Servicio");
              const unidades = escapeHtml(String(extra.unidadesExtra || 0));
              const monto = escapeHtml(extra.montoExtraTexto || formatGs(extra.montoExtra));
              return `<li>${nombre}: ${unidades} uso(s) extra - ${monto}</li>`;
            })
            .join("")
        : "";

      const warningHtml = body.warning
        ? `<p class="success-warning">${escapeHtml(body.warning)}</p>`
        : "";

      const extraListHtml = extraServicios
        ? `<ul class="success-extra-list">${extraServicios}</ul>`
        : "";

      const fechaMostrada = formatFechaLargaEs(d.fecha || fechaCita);

      successDetailsEl.innerHTML = `
        <p><strong>Fecha:</strong> ${escapeHtml(fechaMostrada || d.fecha || fechaCita)}</p>
        <p><strong>Horario:</strong> ${escapeHtml(d.horaInicio || horaInicio)} - ${escapeHtml(d.horaFin || "")}</p>
        <p><strong>Sede:</strong> ${escapeHtml(d.sede || "")}</p>
        <p><strong>Servicios:</strong> ${escapeHtml(d.servicios || "")}</p>
        ${warningHtml}
        ${extraListHtml}
      `;

      if (successTrasladoEl) {
        const serviciosSeleccionados = Array.from(
          form.querySelectorAll('input[name="idServicios"]:checked'),
        );
        const serviciosDesdeSeleccion = serviciosSeleccionados
          .map((input) => input.dataset.servicioNombre || "")
          .join(" ");
        const serviciosDesdeRespuesta = Array.isArray(d.servicios)
          ? d.servicios.join(" ")
          : String(d.servicios || "");
        const textoServicios = normalizeSearchText(`${serviciosDesdeSeleccion} ${serviciosDesdeRespuesta}`);
        const incluyeTraslado = textoServicios.includes("traslad");

        if (incluyeTraslado) {
          const horaTurno = d.horaInicio || horaInicio;
          const horaEntrega = restarUnaHora(horaTurno);
          const horaTurnoMostrada = formatHoraSimple(horaTurno);
          const horaEntregaMostrada = formatHoraSimple(horaEntrega);

          successTrasladoEl.innerHTML = horaEntrega
            ? `Importante (servicio de traslado): debés entregar el vehículo al chofer una hora antes de la cita. Tu cita es a las ${escapeHtml(horaTurnoMostrada)}, por lo tanto la entrega debe ser a las <strong>${escapeHtml(horaEntregaMostrada)}</strong>.`
            : "Importante (servicio de traslado): debés entregar el vehículo al chofer una hora antes de la cita.";
          successTrasladoEl.style.display = "block";
          successTrasladoEl.style.opacity = "1";
        } else {
          successTrasladoEl.style.display = "none";
          successTrasladoEl.textContent = "";
          successTrasladoEl.style.opacity = "";
        }
      }
    } catch {
      setStatus("Error de red. Intentá nuevamente.");
      resetTurnstile();
      submitBtn.disabled = false;
    }
  });

  successResetBtn?.addEventListener("click", () => {
    window.location.reload();
  });

  // ─── Init ──────────────────────────────────────────────────────────
  loadSedes();
  loadServicios();
  setupDateInput();
</script>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
