---
export const prerender = true;

import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Hero from "@/components/Hero.astro";
import Footer from "@/components/Footer.astro";

import Section from "@/components/sections/Section.astro";
import GoogleReviews from "@/components/sections/GoogleReviews.astro";
import AccordionContainer from "@/components/sections/AccordionContainer.astro";
import Accordion from "@/components/sections/Accordion.astro";
import CTA from "@/components/sections/CTA.astro";
import RegistroModal from "@/components/RegistroModal.astro";
import RegistroFinanciadoModal from "@/components/RegistroFinanciadoModal.astro";
import PricingCards from "@/components/PricingCards.astro";
---

<BaseLayout
  title="Club de cuidado automotriz | Fórmula NG"
  description="Planes de cuidado automotriz en Asunción: Essential, Plus, Black, Domicilio y Gold financiado con nanocerámico. Membresías desde Gs. 200.000 al mes."
>
  <div class="page">
    <!-- Hero background video -->
    <div class="hero-bg">
      <video
        autoplay
        muted
        loop
        playsinline
        class="w-full h-full object-cover hero-video-desktop"
      >
        <source src="/hero-bg.webm" type="video/webm" />
      </video>
      <video
        autoplay
        muted
        loop
        playsinline
        poster="/movil-bg-im.webp"
        class="w-full h-full object-cover hero-video-mobile"
      >
        <source src="/movil-bg.webm" type="video/webm" />
      </video>
      <!-- Overlay oscuro sobre todo el video -->
      <div class="hero-bg-overlay"></div>
    </div>

    <!-- Header -->
    <header class="header no-sidebar">
      <Header />
    </header>

    <!-- Hero -->
    <Hero />

    <!-- Main content -->
    <div class="sl-markdown-content" style="position: relative; z-index: 2; background-color: var(--sl-color-black); margin-top: -120px; padding-top: 40px;">

      {/* Plans Section */}
      <section class="planes-section" id="planes">
        <h2 class="planes-title">Nuestros planes</h2>
        <p class="planes-sub">Elegí entre lavados mensuales, lavados ilimitados, atención a domicilio o Gold financiado con nanocerámico.</p>
        <PricingCards />
        <p class="planes-footnote">En las membresías, el valor por día se calcula sobre 30 días y se abona mensualmente. Gold se paga en 15 cuotas de Gs. 400.000, sin prorrateo. El socio no paga un precio adicional por las bonificaciones; están sujetas a coordinación y disponibilidad operativa durante el ciclo vigente.</p>
      </section>


      {/* Google Reviews Section */}
      <GoogleReviews />

      {/* FAQ Section */}
      <Section
        id="preguntas"
        title="Preguntas <span class='light-text'>frecuentes</span>"
        description="Todo lo que necesitás saber sobre los planes de Fórmula NG."
      >
        <AccordionContainer tabList={[
          {
            type: 'membresia',
            title: 'Membresía Fórmula NG',
            subtitle: 'Qué incluye y cómo funciona.',
            icon: 'rocket'
          },
          {
            type: 'pagos',
            title: 'Pagos y Suscripción',
            subtitle: 'Medios de pago y renovación.',
            icon: 'payment'
          },
          {
            type: 'agenda',
            title: 'Agenda y Logística',
            subtitle: 'Turnos y traslados.',
            icon: 'calendar'
          },
          {
            type: 'responsabilidad',
            title: 'Responsabilidad y Seguridad',
            subtitle: 'Cuidado de tu vehículo.',
            icon: 'shield'
          },
          {
            type: 'servicios',
            title: 'Servicios Adicionales',
            subtitle: 'Opciones extra y financiación.',
            icon: 'settings'
          },
          {
            type: 'condiciones',
            title: 'Condiciones Generales',
            subtitle: 'Límites y consideraciones.',
            icon: 'support'
          }
        ]}>
          {/* Membresía Fórmula NG */}
          <Accordion
            question="¿Qué planes de membresía ofrecen?"
            answer="Essential: 4 lavados por mes por Gs. 200.000; Plus: 6 lavados por mes por Gs. 250.000; Black: lavados ilimitados por Gs. 300.000; y Domicilio: 4 servicios a domicilio por Gs. 500.000. Todos los importes son mensuales."
            type="membresia"
          />
          <Accordion
            question="¿Cuántas veces puedo lavar mi auto con la membresía?"
            answer="Essential incluye 4 lavados al mes, hasta 1 por semana. Plus incluye 6 lavados al mes. Black ofrece lavados ilimitados durante el ciclo vigente. El Plan Domicilio incluye 4 servicios a domicilio al mes."
            type="membresia"
          />
          <Accordion
            question="¿La membresía sirve para más de un vehículo?"
            answer="No. Cada membresía es válida únicamente para un solo vehículo registrado."
            type="membresia"
          />
          <Accordion
            question="¿La membresía tiene vencimiento?"
            answer="Sí. Cada ciclo termina el último día del mes calendario. Los beneficios no usados no se acumulan."
            type="membresia"
          />
          <Accordion
            question="¿Puedo transferir mi membresía a otra persona o a otro vehículo?"
            answer="No. La membresía es personal e intransferible y está asociada a un vehículo específico."
            type="membresia"
          />

          {/* Pagos y Suscripción */}
          <Accordion
            question="¿Qué medios de pago aceptan?"
            answer="Aceptamos pagos a través de PagoPar y otros medios habilitados en nuestra plataforma."
            type="pagos"
          />
          <Accordion
            question="¿Puedo pagar con tarjeta de crédito o débito?"
            answer="Sí. Podés pagar con tarjeta de forma segura a través de PagoPar."
            type="pagos"
          />
          <Accordion
            question="¿La membresía se renueva automáticamente?"
            answer="La cobertura se renueva por meses calendario al confirmarse el pago del siguiente período. Los medios de pago disponibles se informan durante la contratación."
            type="pagos"
          />
          <Accordion
            question="¿Cómo solicito la no renovación del plan?"
            answer="Consultá la política de cancelaciones para solicitar la baja con la anticipación aplicable."
            type="pagos"
          />
          <Accordion
            question="¿Qué pasa si se rechaza el pago mensual?"
            answer="Durante los primeros tres días posteriores al vencimiento se conserva la cobertura. En los días cuatro y cinco no se pueden usar servicios mientras el pago esté pendiente; desde el sexto día se pierde la continuidad de antigüedad."
            type="pagos"
          />
          <Accordion
            question="¿Cuándo aplica un reembolso?"
            answer="Solo aplican reembolsos en casos de cobro duplicado, error de facturación, cobro no autorizado atribuible a Fórmula NG o imposibilidad de prestación del servicio por causa atribuible a la empresa."
            type="pagos"
          />
          <div class="accordion pagopar-badge" data-tab="pagos" style="display:none;">
            <div class="pagopar-content">
              <img src="/logo-pagopar.svg" alt="PagoPar" class="pagopar-logo" />
              <span>Pagos seguros y automáticos procesados por PagoPar&reg;</span>
            </div>
          </div>

          {/* Agenda y Logística */}
          <Accordion
            question="¿Necesito agendar turno para venir?"
            answer="Sí. Todos los servicios se realizan con turno previo para garantizar una mejor organización y atención."
            type="agenda"
          />
          <Accordion
            question="¿Cómo reservo mi turno?"
            answer="Una vez que sos socio, recibís el link de agendamiento para reservar según la disponibilidad del sistema."
            type="agenda"
          />
          <Accordion
            question="¿Cómo funcionan el pick up y el domicilio incluidos en Black?"
            answer="Black permite elegir hasta dos servicios logísticos por mes en total entre pick up y lavado a domicilio, en cualquier combinación. Son bonificaciones sin costo adicional para el socio y requieren coordinación y disponibilidad operativa en Asunción y Gran Asunción."
            type="agenda"
          />
          <Accordion
            question="¿Qué pasa si llego tarde a mi turno?"
            answer="Existe una tolerancia de tiempo. Si el retraso es mayor, el turno puede reprogramarse según la disponibilidad del día."
            type="agenda"
          />

          {/* Responsabilidad y Seguridad */}
          <Accordion
            question="¿Mi vehículo está seguro en Fórmula NG?"
            answer="Sí. Trabajamos con personal capacitado, procesos de control de calidad y protocolos de cuidado para proteger tu vehículo."
            type="responsabilidad"
          />
          <Accordion
            question="¿Puedo dejar objetos dentro del auto?"
            answer="Recomendamos no dejar objetos de valor. Fórmula NG no se responsabiliza por pertenencias olvidadas dentro del vehículo."
            type="responsabilidad"
          />

          {/* Servicios Adicionales */}
          <Accordion
            question="¿Qué servicios no están incluidos en la membresía?"
            answer="No están incluidos trabajos especiales como: Suciedad extrema o incrustada, Eliminación de barro, insectos o residuos pesados, Detailing avanzado, pulidos especiales, tratamientos cerámicos, etc. Estos servicios se cotizan por separado según el estado del vehículo."
            type="servicios"
          />
          <Accordion
            question="¿Qué otros servicios ofrece Fórmula NG?"
            answer="Además de la membresía, ofrecemos: Pulido técnico y pulido comercial, Tratamientos nano cerámicos, Detailing profesional, Chapería y pintura, Restauración estética y todo tipo de servicios automotrices. Todos los trabajos se realizan con evaluación previa y presupuesto personalizado."
            type="servicios"
          />
          <Accordion
            question="¿Estos servicios se pueden financiar?"
            answer="Sí. Contamos con opciones de financiación en servicios seleccionados. Consultanos para conocer las condiciones."
            type="servicios"
          />

          {/* Condiciones Generales */}
          <Accordion
            question="¿Necesito coordinar cada visita?"
            answer="Sí. Los servicios requieren una cita confirmada y se prestan según la disponibilidad operativa y la cobertura vigente."
            type="condiciones"
          />
          <Accordion
            question="¿Qué pasa si mi auto está en muy mal estado de suciedad?"
            answer="En casos de suciedad extrema o trabajos especiales, puede aplicarse un costo adicional bajo evaluación y confirmación del supervisor, con aprobación previa del cliente."
            type="condiciones"
          />
        </AccordionContainer>
      </Section>

      {/* CTA Section */}
      <CTA />
    </div>

    {/* Footer */}
    <Footer />
  </div>

  {/* Registration Modal */}
  <RegistroModal />
  <RegistroFinanciadoModal />
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  .hero-bg-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.55);
    pointer-events: none;
  }
  .header {
    z-index: 10;
    position: sticky;
    inset-inline-start: 0;
    inset-block-start: 0;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    background-color: color-mix(in srgb, var(--sl-color-black) 60%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid
      color-mix(in srgb, var(--sl-color-white) 10%, transparent);
    padding: 0;
    transition: background-color 0.3s ease;
  }
  .header.header-solid {
    background-color: var(--sl-color-black);
  }
  .header :global(.container) {
    max-width: 100%;
    padding-inline: clamp(1rem, 3vw, 3rem);
    box-sizing: border-box;
  }
  @media (max-width: 800px) {
    .header {
      padding: 6px 0;
      background-color: transparent !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
      border-bottom: none !important;
    }
  }
  .pagopar-badge {
    padding: 1.25rem 2rem;
    border-radius: 16px;
  }
  .pagopar-badge.show-accordion {
    display: block !important;
  }
  .pagopar-content {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .pagopar-logo {
    height: 32px;
    width: auto;
  }
  .pagopar-content span {
    font-size: 0.95rem;
    color: var(--sl-color-gray-3);
  }
  /* ─── Planes section ─── */
  .planes-section {
    padding: 4rem 1.5rem 2rem;
    max-width: 1480px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }
  .planes-title {
    text-align: center;
    margin: 0 0 0.6rem;
    font-size: clamp(1.4rem, 3.5vw, 1.9rem);
    color: #fff;
  }
  .planes-sub {
    text-align: center;
    color: rgba(255,255,255,0.5);
    font-size: 0.92rem;
    margin: 0 0 2.5rem;
  }
  .planes-footnote {
    margin: 1.75rem 0 0;
    text-align: center;
    font-size: 0.75rem;
    color: rgba(255,255,255,0.72);
    line-height: 1.6;
  }
  @media (max-width: 1000px) {
  }
  @media (max-width: 560px) {
  }

  .hero-video-mobile {
    display: none;
  }
  @media (max-width: 768px) {
    .hero-video-desktop {
      display: none;
    }
    .hero-video-mobile {
      display: block;
    }
  }
</style>

<script>
  // Make header fully opaque once user scrolls past the hero
  {
    const headerEl = document.querySelector(".header") as HTMLElement;
    const heroEl = document.querySelector(".hero") as HTMLElement;

    if (headerEl && heroEl) {
      const updateHeader = () => {
        const heroBottom = heroEl.getBoundingClientRect().bottom;
        if (heroBottom <= headerEl.offsetHeight) {
          headerEl.classList.add("header-solid");
        } else {
          headerEl.classList.remove("header-solid");
        }
      };
      window.addEventListener("scroll", updateHeader, { passive: true });
      updateHeader();
    }
  }

  // accordion toggle
  const accordions = document.querySelectorAll(
    ".accordion"
  ) as NodeListOf<HTMLElement>;

  accordions.forEach((accordion) => {
    accordion.addEventListener("click", () => {
      accordions.forEach((otherAccordion) => {
        if (otherAccordion !== accordion) {
          otherAccordion.classList.remove("active");
        }
      });
      accordion.classList.toggle("active");
    });
  });
</script>

<script>
  // Plan buttons → open modal with planId
  document.querySelectorAll<HTMLButtonElement>("button[data-plan-id]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const planId = btn.getAttribute("data-plan-id") || undefined;
      if (typeof (window as any).__openRegistroModal === "function") {
        (window as any).__openRegistroModal(planId ? { planId } : undefined);
      }
    });
  });
</script>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
