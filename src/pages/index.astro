---
export const prerender = true;

import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Hero from "@/components/Hero.astro";
import Footer from "@/components/Footer.astro";

import Section from "@/components/sections/Section.astro";
import Card from "@/components/ui/Card.astro";
import Grid from "@/components/ui/Grid.astro";
import GoogleReviews from "@/components/sections/GoogleReviews.astro";
import AccordionContainer from "@/components/sections/AccordionContainer.astro";
import Accordion from "@/components/sections/Accordion.astro";
import CTA from "@/components/sections/CTA.astro";
import RegistroModal from "@/components/RegistroModal.astro";
---

<BaseLayout
  title="Fórmula NG | Membresía de Estética Automotriz en Paraguay"
  description="Membresía de estética automotriz en Asunción, Paraguay. Detailing premium con lavado exterior y aspirado. Estrená tu vehículo cada mañana."
>
  <div class="page">
    <!-- Hero background video -->
    <div class="hero-bg">
      <video
        autoplay
        muted
        loop
        playsinline
        class="w-full h-full object-cover hero-video-desktop"
      >
        <source src="/hero-bg.webm" type="video/webm" />
      </video>
      <video
        autoplay
        muted
        loop
        playsinline
        poster="/movil-bg-im.webp"
        class="w-full h-full object-cover hero-video-mobile"
      >
        <source src="/movil-bg.webm" type="video/webm" />
      </video>
      <!-- Overlay oscuro sobre todo el video -->
      <div class="hero-bg-overlay"></div>
    </div>

    <!-- Header -->
    <header class="header no-sidebar">
      <Header />
    </header>

    <!-- Hero -->
    <Hero />

    <!-- Main content -->
    <div class="sl-markdown-content" style="position: relative; z-index: 2; background-color: var(--sl-color-black); margin-top: -120px; padding-top: 40px;">

      {/* Features Section */}
      <Section
        id="beneficios"
        title="Beneficios <span class='light-text'>de tu membresía</span>"
        description="Todo lo que incluye tu membresía de estética automotriz"
      >
        <Grid columns={4}>
          <Card title="Lavado Ilimitado" icon="car-wash" iconColor="#FF8585">
            Lavados ilimitados durante 30 días: exterior completo, aspirado profundo y desinfección de interiores. Máximo 1 lavado por día.
          </Card>
          <Card title="Protección & Brillo" icon="shine-protection" iconColor="#7BE1A4">
            1 aplicación de cera líquida con protección de hasta 4 meses y 1 lavado de motor profesional incluidos al mes.
          </Card>
          <Card title="Servicio de Chofer" icon="driver-service" iconColor="#FFD97B">
            2 traslados gratis para retiro o entrega de tu vehículo, con agenda previa y sujeto a disponibilidad.
          </Card>
          <Card title="Cuidado Interior" icon="interior-care" iconColor="#979BFF">
            1 tratamiento de hidratación de plásticos interiores y revitalización de neumáticos incluidos al mes.
          </Card>
        </Grid>
      </Section>


      {/* Google Reviews Section */}
      <GoogleReviews />

      {/* FAQ Section */}
      <Section
        id="preguntas"
        title="Preguntas <span class='light-text'>frecuentes</span>"
        description="Todo lo que necesitás saber sobre tu membresía de estética automotriz."
      >
        <AccordionContainer tabList={[
          {
            type: 'membresia',
            title: 'Membresía Fórmula NG',
            subtitle: 'Qué incluye y cómo funciona.',
            icon: 'rocket'
          },
          {
            type: 'pagos',
            title: 'Pagos y Suscripción',
            subtitle: 'Medios de pago y renovación.',
            icon: 'payment'
          },
          {
            type: 'agenda',
            title: 'Agenda y Logística',
            subtitle: 'Turnos y traslados.',
            icon: 'calendar'
          },
          {
            type: 'responsabilidad',
            title: 'Responsabilidad y Seguridad',
            subtitle: 'Cuidado de tu vehículo.',
            icon: 'shield'
          },
          {
            type: 'servicios',
            title: 'Servicios Adicionales',
            subtitle: 'Opciones extra y financiación.',
            icon: 'settings'
          },
          {
            type: 'condiciones',
            title: 'Condiciones Generales',
            subtitle: 'Límites y consideraciones.',
            icon: 'support'
          }
        ]}>
          {/* Membresía Fórmula NG */}
          <Accordion
            question="¿Qué incluye la Membresía Fórmula NG de Gs. 200.000?"
            answer="Incluye lavados ILIMITADOS durante 30 días (máximo 1 lavado por día por vehículo) y los siguientes servicios: Lavado exterior completo, Aspirado profundo, Desinfección de interiores, Revitalización de neumáticos, 1 aplicación de cera líquida (protección hasta 4 meses), 1 lavado de motor profesional al mes, 1 tratamiento de hidratación de plásticos interiores, 2 traslados GRATIS (con agenda previa)."
            type="membresia"
          />
          <Accordion
            question="¿Cuántas veces puedo lavar mi auto con la membresía?"
            answer="Podés lavar tu vehículo de forma ilimitada durante los 30 días de vigencia, con un máximo de 1 lavado por día por vehículo."
            type="membresia"
          />
          <Accordion
            question="¿La membresía sirve para más de un vehículo?"
            answer="No. Cada membresía es válida únicamente para un solo vehículo registrado."
            type="membresia"
          />
          <Accordion
            question="¿La membresía tiene vencimiento?"
            answer="Sí. La membresía tiene una vigencia de 30 días corridos desde la fecha de activación."
            type="membresia"
          />
          <Accordion
            question="¿Puedo transferir mi membresía a otra persona o a otro vehículo?"
            answer="No. La membresía es personal e intransferible y está asociada a un vehículo específico."
            type="membresia"
          />

          {/* Pagos y Suscripción */}
          <Accordion
            question="¿Qué medios de pago aceptan?"
            answer="Aceptamos pagos a través de PagoPar y otros medios habilitados en nuestra plataforma."
            type="pagos"
          />
          <Accordion
            question="¿Puedo pagar con tarjeta de crédito o débito?"
            answer="Sí. Podés pagar con tarjeta de forma segura a través de PagoPar."
            type="pagos"
          />
          <Accordion
            question="¿La membresía se renueva automáticamente?"
            answer="Solo si elegís la opción de débito automático. En caso contrario, la renovación se realiza de forma manual."
            type="pagos"
          />
          <Accordion
            question="¿Puedo renovar mi membresía antes de que venza?"
            answer="Sí. Podés renovarla en cualquier momento para seguir disfrutando del servicio sin interrupciones."
            type="pagos"
          />
          <div class="accordion pagopar-badge" data-tab="pagos" style="display:none;">
            <div class="pagopar-content">
              <img src="/logo-pagopar.svg" alt="PagoPar" class="pagopar-logo" />
              <span>Pagos seguros y automáticos procesados por PagoPar&reg;</span>
            </div>
          </div>

          {/* Agenda y Logística */}
          <Accordion
            question="¿Necesito agendar turno para venir?"
            answer="Sí. Todos los servicios se realizan con turno previo para garantizar una mejor organización y atención."
            type="agenda"
          />
          <Accordion
            question="¿Cómo reservo mi turno?"
            answer="Una vez que sos socio, recibís el link de agendamiento para reservar según la disponibilidad del sistema."
            type="agenda"
          />
          <Accordion
            question="¿Qué incluyen los 2 traslados gratis?"
            answer="Incluyen el servicio de retiro o entrega de tu vehículo, con agenda previa y sujeto a disponibilidad."
            type="agenda"
          />
          <Accordion
            question="¿Qué pasa si llego tarde a mi turno?"
            answer="Existe una tolerancia de tiempo. Si el retraso es mayor, el turno puede reprogramarse según la disponibilidad del día."
            type="agenda"
          />

          {/* Responsabilidad y Seguridad */}
          <Accordion
            question="¿Mi vehículo está seguro en Fórmula NG?"
            answer="Sí. Trabajamos con personal capacitado, procesos de control de calidad y protocolos de cuidado para proteger tu vehículo."
            type="responsabilidad"
          />
          <Accordion
            question="¿Puedo dejar objetos dentro del auto?"
            answer="Recomendamos no dejar objetos de valor. Fórmula NG no se responsabiliza por pertenencias olvidadas dentro del vehículo."
            type="responsabilidad"
          />

          {/* Servicios Adicionales */}
          <Accordion
            question="¿Qué servicios no están incluidos en la membresía?"
            answer="No están incluidos trabajos especiales como: Suciedad extrema o incrustada, Eliminación de barro, insectos o residuos pesados, Detailing avanzado, pulidos especiales, tratamientos cerámicos, etc. Estos servicios se cotizan por separado según el estado del vehículo."
            type="servicios"
          />
          <Accordion
            question="¿Qué otros servicios ofrece Fórmula NG?"
            answer="Además de la membresía, ofrecemos: Pulido técnico y pulido comercial, Tratamientos nano cerámicos, Detailing profesional, Chapería y pintura, Restauración estética y todo tipo de servicios automotrices. Todos los trabajos se realizan con evaluación previa y presupuesto personalizado."
            type="servicios"
          />
          <Accordion
            question="¿Estos servicios se pueden financiar?"
            answer="Sí. Contamos con opciones de financiación en servicios seleccionados. Consultanos para conocer las condiciones."
            type="servicios"
          />

          {/* Condiciones Generales */}
          <Accordion
            question="¿Hay un límite de uso diario?"
            answer="Sí. La membresía permite un máximo de 1 lavado por día por vehículo."
            type="condiciones"
          />
          <Accordion
            question="¿Qué pasa si mi auto está en muy mal estado de suciedad?"
            answer="En casos de suciedad extrema o trabajos especiales, puede aplicarse un costo adicional previo aviso y aprobación del cliente."
            type="condiciones"
          />
        </AccordionContainer>
      </Section>

      {/* CTA Section */}
      <CTA />
    </div>

    {/* Footer */}
    <Footer />
  </div>

  {/* Registration Modal */}
  <RegistroModal />
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  .hero-bg-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.55);
    pointer-events: none;
  }
  .header {
    z-index: 10;
    position: sticky;
    inset-inline-start: 0;
    inset-block-start: 0;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    background-color: color-mix(in srgb, var(--sl-color-black) 60%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid
      color-mix(in srgb, var(--sl-color-white) 10%, transparent);
    padding: 0;
    transition: background-color 0.3s ease;
  }
  .header.header-solid {
    background-color: var(--sl-color-black);
  }
  .header :global(.container) {
    max-width: 100%;
    padding-inline: clamp(1rem, 3vw, 3rem);
    box-sizing: border-box;
  }
  @media (max-width: 800px) {
    .header {
      padding: 6px 0;
      background-color: transparent !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
      border-bottom: none !important;
    }
  }
  .pagopar-badge {
    padding: 1.25rem 2rem;
    border-radius: 16px;
  }
  .pagopar-badge.show-accordion {
    display: block !important;
  }
  .pagopar-content {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .pagopar-logo {
    height: 32px;
    width: auto;
  }
  .pagopar-content span {
    font-size: 0.95rem;
    color: var(--sl-color-gray-3);
  }
  .hero-video-mobile {
    display: none;
  }
  @media (max-width: 768px) {
    .hero-video-desktop {
      display: none;
    }
    .hero-video-mobile {
      display: block;
    }
  }
</style>

<script>
  // Make header fully opaque once user scrolls past the hero
  {
    const headerEl = document.querySelector(".header") as HTMLElement;
    const heroEl = document.querySelector(".hero") as HTMLElement;

    if (headerEl && heroEl) {
      const updateHeader = () => {
        const heroBottom = heroEl.getBoundingClientRect().bottom;
        if (heroBottom <= headerEl.offsetHeight) {
          headerEl.classList.add("header-solid");
        } else {
          headerEl.classList.remove("header-solid");
        }
      };
      window.addEventListener("scroll", updateHeader, { passive: true });
      updateHeader();
    }
  }

  // accordion toggle
  const accordions = document.querySelectorAll(
    ".accordion"
  ) as NodeListOf<HTMLElement>;

  accordions.forEach((accordion) => {
    accordion.addEventListener("click", () => {
      accordions.forEach((otherAccordion) => {
        if (otherAccordion !== accordion) {
          otherAccordion.classList.remove("active");
        }
      });
      accordion.classList.toggle("active");
    });
  });
</script>
